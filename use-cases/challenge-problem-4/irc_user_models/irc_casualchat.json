{
  "markov": {
    "casual_chat": {
      "casual_chat": 1.0 
    },
    "initialization": {
      "casual_chat": 1.0
    }
  },
  "states": {
    "initialization": {
      "type": "state",
      "initial_action": "set_room_numbers",
      "dwell_steps": {
        "random": "uniform",
        "min": 2,
        "max": 2
      },
      "actions": {
        "set_room_numbers": {
          "type": "set_room_numbers",
          "rooms": {
            "#chat": 0,
            "#general": 1,
            "#random": 2
          }
        },
        "select_room": {
          "type": "select_room",
          "choice": {
            "random": "uniform",
            "min": 0,
            "max": 2,
            "domain": "positive_int"
          }
        }
      },
      "markov": {
        "set_room_numbers": {
          "select_room": 1.0
        },
        "select_room": {
          "select_room": 1.0
        }
      },
      "burst_steps": {
        "random": "uniform",
        "min": 2,
        "max": 2
      },
      "intra_burst_delay": {
        "random": "uniform",
        "min": 0,
        "max": 0
      },
      "inter_burst_delay": {
        "random": "uniform",
        "min": 0,
        "max": 0
      }
    },
    "casual_chat": {
      "type": "state",
      "initial_action": "send_message",
      "dwell_steps": {
        "random": "uniform",
        "min": 1,
        "max": 1
      },
      "actions": {
        "send_message": {
          "type": "roommsg",
          "message_length_bytes": {
            "random": "beta",
            "alpha": 1.0865,
            "beta": 11.4066,
            "scale": 467.0,
            "floor": 4
          }
        }
      },
      "markov": {
        "send_message": {
          "send_message": 1.0
        }
      },
      "burst_steps": {
        "random": "uniform",
        "min": 1.0,
        "max": 1.0
      },
      "intra_burst_delay": {
        "random": "uniform",
        "min": 1.0,
        "max": 1.0
      },
      "inter_burst_delay": {
        "random": "uniform",
        "min": 0,
        "max": 16.0 
      }
    }
  },
  "parameters": {
    "model_steps": 10000,
    "irc_server": "irc.pwnd.com",
    "initial_state": "initialization",
    "wait_remove": true
  }
}
