{
    "markov": {
        "post": {
            "post_wait": 1.0
        },
        "post_wait": {
            "fetch": 1.0,
            "post": 0
        },
        "fetch": {
            "fetch_wait": 1.0
        },
        "fetch_wait": {
            "post": 1.0,
            "fetch": 0
        }
    },
    "actions": {
        "post_wait": {
