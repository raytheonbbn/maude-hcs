  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =
    *** Since this is aiming to be generated via Python script or AI, no need
    *** for a Maude counter. Python or AI can use their own counter.
    rCtr(j + 154)

    --- Baseline actor
    baselineAct

    --- Core Infrastructure
    ircServer s3SrvAct iodineMonitor masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    --- Webtunnel Client 1
    wtCl1Irc wtCl1Um wtCl1Iface wtCl1SrvIface wtCl1Client wtCl1Proxy
    wtCl1NetClient wtCl1NetServer
    --- Webtunnel Client 2
    wtCl2Irc wtCl2Um wtCl2Iface wtCl2SrvIface wtCl2Client wtCl2Proxy
    wtCl2NetClient wtCl2NetServer
    corpRtDns corpRtNetCl

    --- Skyhook Client 3
    skyCl3Irc skyCl3Um skyCl3Iface skyCl3UmacAct skyCl3CmacAct skyCl3PuaAct skyCl3SdkacAct
    skyCl3SrvIface skyCl3UmasAct skyCl3CmasAct skyCl3AhaAct skyCl3SdkasAct
    skyCl3ClNet skyCl3NetSrv skyCl3SrvNetCl
    --- Skyhook Client 4
    skyCl4Irc skyCl4Um skyCl4Iface skyCl4UmacAct skyCl4CmacAct skyCl4PuaAct skyCl4SdkacAct
    skyCl4SrvIface skyCl4UmasAct skyCl4CmasAct skyCl4AhaAct skyCl4SdkasAct
