  --- Mastodon HCS Client 9 (IRC profile: irc_6)
  ops masCl9Irc masCl9Um masCl9Iface masCl9SrvIface : -> Actor .
  ops masCl9UmacAct masCl9CmacAct masCl9McacAct masCl9EdacAct : -> Actor .
  ops masCl9UmasAct masCl9CmasAct masCl9McasAct masCl9EdasAct : -> Actor .
  ops masCl9ClNet masCl9SrvNetCl masNetSrv masSrvAct : -> Actor .
  eq masCl9Irc       = mkIrcClient-v2(masCl9IrcAddr, masCl9IfaceAddr, "MasClient9") .
  eq masCl9Um        = mkIrcUMV2Actor(masCl9UmAddr, "irc-irc-6", masCl9IrcAddr, ircServerAddr, masCl9SrvIfaceAddr) .
  eq masCl9Iface     = mkIrcByteSeqIface(masCl9IfaceAddr, masCl9IrcAddr, masCl9CmacAddr) .
  eq masCl9UmacAct   = mkUMactor(masCl9UmacAddr, mastodon-client-scenario-1-ma, masCl9CmacAddr) .
  eq masCl9CmacAct   = mkCMSndRcvActor(masCl9CmacAddr, masCl9EdacAddr, masCl9McacAddr, masCl9IfaceAddr, "client9", "server9") .
  eq masCl9McacAct   = makeMastodonClient(masCl9McacAddr, masSrvAddr, masCl9CmacAddr) .
  eq masCl9EdacAct   = makeDestiniActor(masCl9EdacAddr, ed-images) .
  eq masCl9SrvIface  = mkIrcByteSeqIface(masCl9SrvIfaceAddr, ircServerAddr, masCl9CmasAddr) .
  eq masCl9UmasAct   = mkUMactor(masCl9UmasAddr, mastodon-server-scenario-1-ma, masCl9CmasAddr) .
  eq masCl9CmasAct   = mkCMSndRcvActor(masCl9CmasAddr, masCl9EdasAddr, masCl9McasAddr, masCl9SrvIfaceAddr, "server9", "client9") .
  eq masCl9McasAct   = makeMastodonClient(masCl9McasAddr, masSrvAddr, masCl9CmasAddr) .
  eq masCl9EdasAct   = makeDestiniActor(masCl9EdasAddr, ed-images) .
  eq masCl9ClNet     = makeNetClient(masCl9ClNetAddr,
                                       masSrvAddr,
                                       masCl9McacAddr,
                                       false,
                                       corpMasDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq masNetSrv       = makeNetServer(masNetSrvAddr, masSrvAddr) .
  eq masCl9SrvNetCl  = makeNetClient(masCl9SrvNetClAddr,
                                       masSrvAddr,
                                       masCl9McasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Base Infrastructure
  ops ircServer s3SrvAct iodineMonitor advActor : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq s3SrvAct       = 
    < s3SrvAddr : AwsS3HttpServer |
        thisAddr: s3SrvAddr,
        s3DataMap: (
          ("/tgen/list-1" -> restToByteSeq("obj1.zip;obj2.zip;data/")) ;
          ("/tgen/stat-1" -> restToByteSeq("obj1.zip:1024:2025-01-01")) ;
          ("/tgen/cd-1" -> restToByteSeq("subdir1/;subdir2/")) ;
          ("/tgen/retr-1" -> restToByteSeq("mock_file_content_bytes"))
        )
    >
  .
  eq masSrvAct      = makeMastodonServer(masSrvAddr) .
  eq iodineMonitor  = mkWMonitor(iodineMonitorAddr) .
  eq advActor       = mkAdversaryCp3(advAddr) .

  --- DNS Infrastructure
  ops corpMasDns corpRtDns corpIodDns corpObfsDns corpSkyDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpMasNetCl corpRtNetCl corpIodNetCl corpObfsNetCl corpSkyNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpMasDns   = mkNameServer(corpMasDnsAddr, (zoneMasCom), corpMasNetClAddr) .
  eq corpRtDns    = mkNameServer(corpRtDnsAddr, (zoneRtCom), corpRtNetClAddr) .
  eq corpIodDns   = mkNameServer(corpIodDnsAddr, (zoneIodCom), corpIodNetClAddr) .
  eq corpObfsDns  = mkNameServer(corpObfsDnsAddr, (zoneObfsCom), corpObfsNetClAddr) .
  eq corpSkyDns   = mkNameServer(corpSkyDnsAddr, (zoneSkyCom), corpSkyNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpMasNetCl = mkFwdDnsNetC(corpMasNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpMasDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpRtNetCl  = mkFwdDnsNetC(corpRtNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpRtDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpIodNetCl = mkFwdDnsNetC(corpIodNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpIodDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpObfsNetCl  = mkFwdDnsNetC(corpObfsNetClAddr,
                                   publicResolverNetSrvAddr,
                                   publicDnsAddr,
                                   corpObfsDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .
  eq corpSkyNetCl = mkFwdDnsNetC(corpSkyNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr, 
                                 corpSkyDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- TGEN Actor Definitions
  ---------------------------------------------------
  --- Shared TGEN Servers
  ops ftpSrvAct ftpNetSrvAct : -> Actor .
  eq ftpSrvAct     = mkFtpServerA(ftpSrvAddr) .
  eq ftpNetSrvAct  = makeNetServer(ftpNetSrvAddr, ftpSrvAddr) .

  ops gorillaSrvAct gorillaNetSrvAct : -> Actor .
  eq gorillaSrvAct   = mkGorillaChatServer(gorillaSrvAddr, (gorTgenMas1TgAddr addr gorTgenMas2TgAddr addr gorTgenMas3TgAddr addr gorTgenMas4TgAddr addr gorTgenRt1TgAddr addr gorTgenRt2TgAddr addr gorTgenRt3TgAddr addr gorTgenRt4TgAddr addr gorTgenIod1TgAddr addr gorTgenIod2TgAddr addr gorTgenIod3TgAddr addr gorTgenIod4TgAddr addr gorTgenObfs1TgAddr addr gorTgenObfs2TgAddr addr gorTgenObfs3TgAddr addr gorTgenObfs4TgAddr addr gorTgenSky1TgAddr addr gorTgenSky2TgAddr addr gorTgenSky3TgAddr addr gorTgenSky4TgAddr)) .
  eq gorillaNetSrvAct = makeNetServer(gorillaNetSrvAddr, gorillaSrvAddr) .

  ops ircTgenSrvNet : -> Actor .
  eq ircTgenSrvNet = makeNetServer(ircTgenSrvNetAddr, ircServerAddr) .

