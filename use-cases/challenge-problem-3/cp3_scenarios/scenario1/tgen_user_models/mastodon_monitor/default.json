{
    "markov": {
        "wait": {"monitor_post": 1.0},
        "monitor_post": {"monitor_download": 1.0},
        "monitor_download": {"wait": 1.0}
    },
    "actions": {
        "monitor_post": {
            "type": "monitor_post",
            "start": true,
            "sleep": {"random": "uniform","min": 0,"max": 0}
        },
        "monitor_download": {
            "type": "monitor_download",
            "sleep": {"random": "uniform","min": 0,"max": 0}
        },
        "wait": {
            "type": "wait",
            "sleep": {"random": "uniform","min": 15, "max": 15}
        }
    },
    "parameters": {
        "mastodon_server": "mastodon.pwnd.com",
        "username": "user5",
        "password": "password1234",
        "image_repo": "/images"
    }
}
