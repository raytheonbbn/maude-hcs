{
    "markov": {
        "wait": {"monitor_upload": 1.0},
        "monitor_upload": {"monitor_download": 1.0},
        "monitor_download": {"wait": 1.0}
    },
    "actions": {
        "monitor_upload": {
            "type": "monitor_upload",
            "start": true,
            "sleep": {"random": "uniform","min": 0,"max": 0}
        },
        "monitor_download": {
            "type": "monitor_download",
            "sleep": {"random": "uniform","min": 0,"max": 0}
        },
        "wait": {
            "type": "wait",
            "sleep": {"random": "uniform","min": 15, "max": 15}
        }
    },
    "parameters": {}
}