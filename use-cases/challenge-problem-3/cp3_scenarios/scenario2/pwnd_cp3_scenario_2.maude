  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =

    --- Baseline actor
    baseLineAct

    --- Core Infrastructure
    ircServer s3SrvAct iodineMonitor masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    --- Webtunnel Client 1
    wtCl1Irc wtCl1Um wtCl1Iface wtCl1SrvIface wtCl1Client wtCl1Proxy
    wtCl1NetClient wtCl1NetServer
    corpRtDns corpRtNetCl

    --- Skyhook Client 2
    skyCl2Irc skyCl2Um skyCl2Iface skyCl2UmacAct skyCl2CmacAct skyCl2PuaAct skyCl2SdkacAct
    skyCl2SrvIface skyCl2UmasAct skyCl2CmasAct skyCl2AhaAct skyCl2SdkasAct
    skyCl2ClNet skyCl2NetSrv skyCl2SrvNetCl
    corpSkyDns corpSkyNetCl

    --- OBFS4 Client 3
    obfsCl3Irc obfsCl3Um obfsCl3Iface obfsCl3SrvIface obfsCl3Cl obfsCl3Srv
    obfsCl3NetCl obfsCl3NetSrv
    corpObfsDns corpObfsNetCl

    corpIodDns corpIodNetCl

    --- Mastodon HCS Client 4
    masCl4Irc masCl4Um masCl4Iface masCl4SrvIface
    masCl4UmacAct masCl4CmacAct masCl4McacAct masCl4EdacAct
    masCl4UmasAct masCl4CmasAct masCl4McasAct masCl4EdasAct
    masCl4ClNet masNetSrv masCl4SrvNetCl
    corpMasDns corpMasNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- TGEN Shared Servers
    ftpSrvAct ftpNetSrvAct
    gorillaSrvAct gorillaNetSrvAct
    ircTgenSrvNet

    --- TGEN Instances
    masTgenMas1UmAct masTgenMas1Act masTgenMas1McAct masTgenMas1NetClAct
    masTgenMas2UmAct masTgenMas2Act masTgenMas2McAct masTgenMas2NetClAct
    masTgenMas3UmAct masTgenMas3Act masTgenMas3McAct masTgenMas3NetClAct
