  ---------------------------------------------------
  --- Visibility Map
  ---------------------------------------------------
  eq visibilityMap =
  (cl[1] |-> (
      masCl4McacAddr ;; corpMasNetClAddr ;; corpMasDnsAddr ;; masTgenMas1McAddr
      ;; masTgenMas2McAddr ;; masTgenMas3McAddr ;; masTgenMas4McAddr ;; ftpTgenMas1TgAddr
      ;; ftpTgenMas2TgAddr ;; ftpTgenMas3TgAddr ;; ftpTgenMas4TgAddr ;; minTgenMas1S3ClAddr
      ;; minTgenMas2S3ClAddr ;; minTgenMas3S3ClAddr ;; minTgenMas4S3ClAddr ;; gorTgenMas1TgAddr
      ;; gorTgenMas2TgAddr ;; gorTgenMas3TgAddr ;; gorTgenMas4TgAddr ;; ircTgenMas1TgAddr
      ;; ircTgenMas2TgAddr ;; ircTgenMas3TgAddr ;; ircTgenMas4TgAddr
    )) ,
  (cl[3] |-> (
      obfsCl3ClientAddr ;; corpObfsNetClAddr ;; corpObfsDnsAddr ;; masTgenObfs1McAddr
      ;; masTgenObfs2McAddr ;; masTgenObfs3McAddr ;; masTgenObfs4McAddr ;; ftpTgenObfs1TgAddr
      ;; ftpTgenObfs2TgAddr ;; ftpTgenObfs3TgAddr ;; ftpTgenObfs4TgAddr ;; minTgenObfs1S3ClAddr
      ;; minTgenObfs2S3ClAddr ;; minTgenObfs3S3ClAddr ;; minTgenObfs4S3ClAddr ;; gorTgenObfs1TgAddr
      ;; gorTgenObfs2TgAddr ;; gorTgenObfs3TgAddr ;; gorTgenObfs4TgAddr ;; ircTgenObfs1TgAddr
      ;; ircTgenObfs2TgAddr ;; ircTgenObfs3TgAddr ;; ircTgenObfs4TgAddr
    )) ,
  (cl[2] |-> (
      wtCl1ClientAddr ;; corpRtNetClAddr ;; corpRtDnsAddr ;; masTgenRt1McAddr
      ;; masTgenRt2McAddr ;; masTgenRt3McAddr ;; masTgenRt4McAddr ;; ftpTgenRt1TgAddr
      ;; ftpTgenRt2TgAddr ;; ftpTgenRt3TgAddr ;; ftpTgenRt4TgAddr ;; minTgenRt1S3ClAddr
      ;; minTgenRt2S3ClAddr ;; minTgenRt3S3ClAddr ;; minTgenRt4S3ClAddr ;; gorTgenRt1TgAddr
      ;; gorTgenRt2TgAddr ;; gorTgenRt3TgAddr ;; gorTgenRt4TgAddr ;; ircTgenRt1TgAddr
      ;; ircTgenRt2TgAddr ;; ircTgenRt3TgAddr ;; ircTgenRt4TgAddr
    )) ,
  (cl[4] |-> (
      skyCl2SdkacAddr ;; corpSkyNetClAddr ;; corpSkyDnsAddr ;; masTgenSky1McAddr
      ;; masTgenSky2McAddr ;; masTgenSky3McAddr ;; masTgenSky4McAddr ;; ftpTgenSky1TgAddr
      ;; ftpTgenSky2TgAddr ;; ftpTgenSky3TgAddr ;; ftpTgenSky4TgAddr ;; minTgenSky1S3ClAddr
      ;; minTgenSky2S3ClAddr ;; minTgenSky3S3ClAddr ;; minTgenSky4S3ClAddr ;; gorTgenSky1TgAddr
      ;; gorTgenSky2TgAddr ;; gorTgenSky3TgAddr ;; gorTgenSky4TgAddr ;; ircTgenSky1TgAddr
      ;; ircTgenSky2TgAddr ;; ircTgenSky3TgAddr ;; ircTgenSky4TgAddr
    )) ,
  (dnsN |-> (
      publicResolverNetSrvAddr ;; publicDnsAddr
    )) ,
  (masN |-> masSrvAddr) ,
  (minN |-> s3SrvAddr) ,
  (srvN |-> (
      wtCl1ProxyAddr ;; obfsCl3ServerAddr ;; skyCl2SdkasAddr ;; masCl4McasAddr
      ;; servDnsAddr ;; servNetClAddr ;; ircServerAddr ;; masTgenSrv1McAddr
      ;; masTgenSrv2McAddr ;; masTgenSrv3McAddr ;; masTgenSrv4McAddr ;; minTgenSrv1S3ClAddr
      ;; minTgenSrv2S3ClAddr ;; minTgenSrv3S3ClAddr ;; minTgenSrv4S3ClAddr ;; ftpSrvAddr
      ;; gorillaSrvAddr
    ))
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- Webtunnel Client 1 (IRC profile: irc_8)
  ops wtCl1Irc wtCl1Um wtCl1Iface wtCl1SrvIface : -> Actor .
  ops wtCl1Client wtCl1Proxy : -> Actor .
  ops wtCl1NetClient wtCl1NetServer : -> Actor .
  eq wtCl1Irc       = mkIrcClient-v2(wtCl1IrcAddr, wtCl1IfaceAddr, "WtClient1") .
  eq wtCl1Um        = mkIrcUMV2Actor(wtCl1UmAddr, "irc-irc-8", wtCl1IrcAddr, ircServerAddr, wtCl1SrvIfaceAddr) .
  eq wtCl1Iface     = mkIrcByteSeqIface(wtCl1IfaceAddr, wtCl1IrcAddr, wtCl1ClientAddr) .
  eq wtCl1SrvIface  = mkIrcByteSeqIface(wtCl1SrvIfaceAddr, ircServerAddr, wtCl1ProxyAddr) .
  eq wtCl1Client =
    < wtCl1ClientAddr : WtClient |
        thisAddr:        wtCl1ClientAddr,
        serverProxyAddr: wtCl1ProxyAddr,
        ircServerAddr:   ircServerAddr,
        ircClientAddr:   wtCl1IfaceAddr,
        tlsServerName:   "irc.example.com",
        upgradePath:     "secret/path/v1",
        tunnelState:     Closed,
        pendingMsgs:     emptyQueue > .
  eq wtCl1Proxy      = makeWtServerProxy(wtCl1ProxyAddr, wtCl1SrvIfaceAddr) .
  eq wtCl1NetClient  = makeNetClient(wtCl1NetClientAddr,
                                       wtCl1ProxyAddr,
                                       wtCl1ClientAddr,
                                       true,
                                       corpRtDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq wtCl1NetServer  = makeNetServer(wtCl1NetServerAddr, wtCl1ProxyAddr) .

  --- Skyhook Client 2 (IRC profile: irc_12)
  ops skyCl2Irc skyCl2Um skyCl2Iface skyCl2SrvIface : -> Actor .
  ops skyCl2UmacAct skyCl2CmacAct skyCl2PuaAct skyCl2SdkacAct : -> Actor .
  ops skyCl2UmasAct skyCl2CmasAct skyCl2AhaAct skyCl2SdkasAct : -> Actor .
  ops skyCl2ClNet skyCl2SrvNetCl skyCl2NetSrv : -> Actor .
  eq skyCl2Irc       = mkIrcClient-v2(skyCl2IrcAddr, skyCl2IfaceAddr, "SkyClient2") .
  eq skyCl2Um        = mkIrcUMV2Actor(skyCl2UmAddr, "irc-irc-12", skyCl2IrcAddr, ircServerAddr, skyCl2SrvIfaceAddr) .
  eq skyCl2Iface     = mkIrcByteSeqIface(skyCl2IfaceAddr, skyCl2IrcAddr, skyCl2CmacAddr) .
  eq skyCl2UmacAct   = mkUMactor(skyCl2UmacAddr, skyhook-client-scenario-2-ma, skyCl2CmacAddr) .
  eq skyCl2CmacAct   = mkCMSimpleBi(skyCl2CmacAddr, skyCl2IfaceAddr, skyCl2PuaAddr) .
  eq skyCl2PuaAct    = makeSkyhookPU(skyCl2PuaAddr, skyCl2CmacAddr, skyCl2SdkacAddr, "s_to_c_bucket_2", "c_to_s_bucket_2", "s_to_c_uuid_2", "c_to_s_uuid_2-hash") .
  eq skyCl2SdkacAct  = makeS3Client(skyCl2SdkacAddr, s3SrvAddr) .
  eq skyCl2SrvIface  = mkIrcByteSeqIface(skyCl2SrvIfaceAddr, ircServerAddr, skyCl2CmasAddr) .
  eq skyCl2UmasAct   = mkUMactor(skyCl2UmasAddr, skyhook-server-scenario-2-ma, skyCl2CmasAddr) .
  eq skyCl2CmasAct   = mkCMSimpleBi(skyCl2CmasAddr, skyCl2SrvIfaceAddr, skyCl2AhaAddr) .
  eq skyCl2AhaAct    = mkSkyhookAH(skyCl2AhaAddr, skyCl2CmasAddr, skyCl2SdkasAddr, "c_to_s_bucket_2", "s_to_c_bucket_2", "c_to_s_uuid_2", "s_to_c_uuid_2", "s_to_c_uuid_2", 100) .
  eq skyCl2SdkasAct  = makeS3Client(skyCl2SdkasAddr, s3SrvAddr) .
  eq skyCl2ClNet     = makeNetClient(skyCl2ClNetAddr,
                                       s3SrvAddr,
                                       skyCl2SdkacAddr,
                                       false,
                                       corpSkyDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq skyCl2NetSrv    = makeNetServer(skyCl2NetSrvAddr, s3SrvAddr) .
  eq skyCl2SrvNetCl  = makeNetClient(skyCl2SrvNetClAddr,
                                       s3SrvAddr,
                                       skyCl2SdkasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- OBFS4 Client 3 (IRC profile: irc_3)
  ops obfsCl3Irc obfsCl3Um obfsCl3Iface obfsCl3SrvIface : -> Actor .
  ops obfsCl3Cl obfsCl3Srv : -> Actor .
  ops obfsCl3NetCl obfsCl3NetSrv : -> Actor .
  eq obfsCl3Irc      = mkIrcClient-v2(obfsCl3IrcAddr, obfsCl3IfaceAddr, "ObfsClient3") .
  eq obfsCl3Um       = mkIrcUMV2Actor(obfsCl3UmAddr, "irc-irc-3", obfsCl3IrcAddr, ircServerAddr, obfsCl3SrvIfaceAddr) .
  eq obfsCl3Iface    = mkIrcByteSeqIface(obfsCl3IfaceAddr, obfsCl3IrcAddr, obfsCl3ClientAddr) .
  eq obfsCl3Cl       = makeObfs4Node(obfsCl3ClientAddr, obfsCl3IfaceAddr, obfsCl3ServerAddr) .
  eq obfsCl3SrvIface = mkIrcByteSeqIface(obfsCl3SrvIfaceAddr, ircServerAddr, obfsCl3ServerAddr) .
  eq obfsCl3Srv      = makeObfs4Node(obfsCl3ServerAddr, obfsCl3SrvIfaceAddr, obfsCl3ClientAddr) .
  eq obfsCl3NetCl    = makeNetClient(obfsCl3NetClientAddr,
                                       obfsCl3ServerAddr,
                                       obfsCl3ClientAddr,
                                       true,
                                       corpObfsDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq obfsCl3NetSrv   = makeNetServer(obfsCl3NetServerAddr, obfsCl3ServerAddr) .

  --- Mastodon HCS Client 4 (IRC profile: irc_11)
  ops masCl4Irc masCl4Um masCl4Iface masCl4SrvIface : -> Actor .
  ops masCl4UmacAct masCl4CmacAct masCl4McacAct masCl4EdacAct : -> Actor .
  ops masCl4UmasAct masCl4CmasAct masCl4McasAct masCl4EdasAct : -> Actor .
  ops masCl4ClNet masCl4SrvNetCl : -> Actor .
  eq masCl4Irc       = mkIrcClient-v2(masCl4IrcAddr, masCl4IfaceAddr, "MasClient4") .
  eq masCl4Um        = mkIrcUMV2Actor(masCl4UmAddr, "irc-irc-11", masCl4IrcAddr, ircServerAddr, masCl4SrvIfaceAddr) .
  eq masCl4Iface     = mkIrcByteSeqIface(masCl4IfaceAddr, masCl4IrcAddr, masCl4CmacAddr) .
  eq masCl4UmacAct   = mkUMactor(masCl4UmacAddr, mastodon-client-scenario-2-ma, masCl4CmacAddr) .
  eq masCl4CmacAct   = mkCMSndRcvActor(masCl4CmacAddr, masCl4EdacAddr, masCl4McacAddr, masCl4IfaceAddr, "client4", "server4") .
  eq masCl4McacAct   = makeMastodonClient(masCl4McacAddr, masSrvAddr, masCl4CmacAddr) .
  eq masCl4EdacAct   = makeDestiniActor(masCl4EdacAddr, ed-images) .
  eq masCl4SrvIface  = mkIrcByteSeqIface(masCl4SrvIfaceAddr, ircServerAddr, masCl4CmasAddr) .
  eq masCl4UmasAct   = mkUMactor(masCl4UmasAddr, mastodon-server-scenario-2-ma, masCl4CmasAddr) .
  eq masCl4CmasAct   = mkCMSndRcvActor(masCl4CmasAddr, masCl4EdasAddr, masCl4McasAddr, masCl4SrvIfaceAddr, "server4", "client4") .
  eq masCl4McasAct   = makeMastodonClient(masCl4McasAddr, masSrvAddr, masCl4CmasAddr) .
  eq masCl4EdasAct   = makeDestiniActor(masCl4EdasAddr, ed-images) .
  eq masCl4ClNet     = makeNetClient(masCl4ClNetAddr,
                                       masSrvAddr,
                                       masCl4McacAddr,
                                       false,
                                       corpMasDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq masCl4SrvNetCl  = makeNetClient(masCl4SrvNetClAddr,
                                       masSrvAddr,
                                       masCl4McasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Base Infrastructure
  ops ircServer s3SrvAct iodineMonitor advActor masNetSrv masSrvAct : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq s3SrvAct       = 
    < s3SrvAddr : AwsS3HttpServer |
        thisAddr: s3SrvAddr,
        s3DataMap: (
          ("/tgen/list-1" -> restToByteSeq("obj1.zip;obj2.zip;data/")) ;
          ("/tgen/stat-1" -> restToByteSeq("obj1.zip:1024:2025-01-01")) ;
          ("/tgen/cd-1" -> restToByteSeq("subdir1/;subdir2/")) ;
          ("/tgen/retr-1" -> restToByteSeq("mock_file_content_bytes"))
        )
    >
  .
  eq masSrvAct      = makeMastodonServer(masSrvAddr) .
  eq masNetSrv       = makeNetServer(masNetSrvAddr, masSrvAddr) .
  eq iodineMonitor  = mkWMonitor(iodineMonitorAddr) .
  eq advActor       = mkAdversaryCp3(advAddr, true) .

  --- DNS Infrastructure
  ops corpMasDns corpRtDns corpIodDns corpObfsDns corpSkyDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpMasNetCl corpRtNetCl corpIodNetCl corpObfsNetCl corpSkyNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpMasDns   = mkNameServer(corpMasDnsAddr, (zoneMasCom), corpMasNetClAddr) .
  eq corpRtDns    = mkNameServer(corpRtDnsAddr, (zoneRtCom), corpRtNetClAddr) .
  eq corpIodDns   = mkNameServer(corpIodDnsAddr, (zoneIodCom), corpIodNetClAddr) .
  eq corpObfsDns  = mkNameServer(corpObfsDnsAddr, (zoneObfsCom), corpObfsNetClAddr) .
  eq corpSkyDns   = mkNameServer(corpSkyDnsAddr, (zoneSkyCom), corpSkyNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpMasNetCl = mkFwdDnsNetC(corpMasNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpMasDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpRtNetCl  = mkFwdDnsNetC(corpRtNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpRtDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpIodNetCl = mkFwdDnsNetC(corpIodNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpIodDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpObfsNetCl  = mkFwdDnsNetC(corpObfsNetClAddr,
                                   publicResolverNetSrvAddr,
                                   publicDnsAddr,
                                   corpObfsDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .
  eq corpSkyNetCl = mkFwdDnsNetC(corpSkyNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr, 
                                 corpSkyDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- TGEN Actor Definitions
  ---------------------------------------------------
  --- Shared TGEN Servers
  ops ftpSrvAct ftpNetSrvAct : -> Actor .
  eq ftpSrvAct     = mkFtpServerA(ftpSrvAddr) .
  eq ftpNetSrvAct  = makeNetServer(ftpNetSrvAddr, ftpSrvAddr) .

  ops gorillaSrvAct gorillaNetSrvAct : -> Actor .
  eq gorillaSrvAct   = mkGorillaChatServer(gorillaSrvAddr, (gorTgenMas1TgAddr addr gorTgenMas2TgAddr addr gorTgenMas3TgAddr addr gorTgenMas4TgAddr addr gorTgenRt1TgAddr addr gorTgenRt2TgAddr addr gorTgenRt3TgAddr addr gorTgenRt4TgAddr addr gorTgenObfs1TgAddr addr gorTgenObfs2TgAddr addr gorTgenObfs3TgAddr addr gorTgenObfs4TgAddr addr gorTgenSky1TgAddr addr gorTgenSky2TgAddr addr gorTgenSky3TgAddr addr gorTgenSky4TgAddr)) .
  eq gorillaNetSrvAct = makeNetServer(gorillaNetSrvAddr, gorillaSrvAddr) .

  ops ircTgenSrvNet : -> Actor .
  eq ircTgenSrvNet = makeNetServer(ircTgenSrvNetAddr, ircServerAddr) .

