    [tgenDelay + genRandomX(j + 117, 0.0, 0.009), (to ircTgenSky3UmAddr from ircTgenSky3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 118, 0.0, 0.009), (to ircTgenSky4UmAddr from ircTgenSky4UmAddr : burstDelayTO), 0]

[ksWindowDelay + genRandomX(j + 119, 0.0, 0.009), (to baseLineAddr from baseLineAddr : initKs),0]
    rCtr(j + 120)
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 11700.0 [owise] .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = wtCl1IrcAddr ; skyCl2IrcAddr ; obfsCl3IrcAddr ; masCl4IrcAddr .
endm
eof
--- set print attribute on .
--- rew initConfig .
--- q