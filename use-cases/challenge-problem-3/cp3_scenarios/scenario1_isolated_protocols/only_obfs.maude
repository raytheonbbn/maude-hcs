  op LinkType-DnsComposed : -> AttributeSet .
  eq LinkType-DnsComposed =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.),
  (delayConst: 0.001),
  (noiseMin: 0.02),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
