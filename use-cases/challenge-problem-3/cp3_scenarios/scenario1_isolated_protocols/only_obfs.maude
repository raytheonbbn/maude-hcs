  ---------------------------------------------------
  --- Transport Equations (Readable Addresses Only)
  ---------------------------------------------------
  eq transport(obfsCl5ClientAddr) = tcp(obfsCl5ClientAddr) .
  eq transport(obfsCl5ServerAddr) = tcp(obfsCl5ServerAddr) .
  eq transport(obfsCl6ClientAddr) = tcp(obfsCl6ClientAddr) .
  eq transport(obfsCl6ServerAddr) = tcp(obfsCl6ServerAddr) .
  eq transport(ircServerAddr) = tcp(ircServerAddr) .

  --- UDP transport for DNS resolvers
  eq transport(publicDnsAddr) = publicDnsAddr .
  eq transport(corpObfsDnsAddr) = corpObfsDnsAddr .
  eq transport(servDnsAddr) = servDnsAddr .

  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- OBFS4 Client 5
    aaa(obfsCl5ClientAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, obfsCl5ClientAddr, LinkType-ClientNetObfs)
    aaa(obfsCl5ServerAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, obfsCl5ServerAddr, LinkType-ClientNetObfs)
    --- OBFS4 Client 6
    aaa(obfsCl6ClientAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, obfsCl6ClientAddr, LinkType-ClientNetObfs)
    aaa(obfsCl6ServerAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, obfsCl6ServerAddr, LinkType-ClientNetObfs)

    aaa(corpObfsNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsNetClAddr, LinkType-Dns)

    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-Dns)

    aaa(publicResolverNetSrvAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicResolverNetSrvAddr, LinkType-Dns)

    *** IRC Server enclave DNS server ***
    aaa(servDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servDnsAddr, LinkType-DnsComposed)
    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servDnsAddr, LinkType-Dns)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-DnsComposed)
    aaa(servNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servNetClAddr, LinkType-Dns)

    *** Obfs4 IRC Client enclave DNS server ***
    aaa(corpObfsDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpObfsDnsAddr, LinkType-DnsComposed)
    aaa(corpObfsDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsDnsAddr, LinkType-Dns)
    aaa(corpObfsNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpObfsNetClAddr, LinkType-DnsComposed)
    aaa(corpObfsNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsNetClAddr, LinkType-Dns)
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- OBFS4 Client 5 (IRC profile: irc_11)
  ops obfsCl5Irc obfsCl5Um obfsCl5Iface obfsCl5SrvIface : -> Actor .
  ops obfsCl5Cl obfsCl5Srv : -> Actor .
  ops obfsCl5NetCl obfsCl5NetSrv : -> Actor .
  eq obfsCl5Irc      = mkIrcClient-v2(obfsCl5IrcAddr, obfsCl5IfaceAddr, "ObfsClient5") .
  eq obfsCl5Um       = mkIrcUMV2Actor(obfsCl5UmAddr, "irc-irc-11", obfsCl5IrcAddr, ircServerAddr, obfsCl5SrvIfaceAddr) .
  eq obfsCl5Iface    = mkIrcByteSeqIface(obfsCl5IfaceAddr, obfsCl5IrcAddr, obfsCl5ClientAddr) .
  eq obfsCl5Cl       = makeObfs4Node(obfsCl5ClientAddr, obfsCl5IfaceAddr, obfsCl5ServerAddr) .
  eq obfsCl5SrvIface = mkIrcByteSeqIface(obfsCl5SrvIfaceAddr, ircServerAddr, obfsCl5ServerAddr) .
  eq obfsCl5Srv      = makeObfs4Node(obfsCl5ServerAddr, obfsCl5SrvIfaceAddr, obfsCl5ClientAddr) .
  eq obfsCl5NetCl    = makeNetClient(obfsCl5NetClientAddr,
                                       obfsCl5ServerAddr,
                                       obfsCl5ClientAddr,
                                       true,
                                       corpObfsDnsAddr,
                                       'mastodon . 'pwnd . 'com . root)
  .
  eq obfsCl5NetSrv   = makeNetServer(obfsCl5NetServerAddr, obfsCl5ServerAddr) .

  --- OBFS4 Client 6 (IRC profile: irc_11)
  ops obfsCl6Irc obfsCl6Um obfsCl6Iface obfsCl6SrvIface : -> Actor .
  ops obfsCl6Cl obfsCl6Srv : -> Actor .
  ops obfsCl6NetCl obfsCl6NetSrv : -> Actor .
  eq obfsCl6Irc      = mkIrcClient-v2(obfsCl6IrcAddr, obfsCl6IfaceAddr, "ObfsClient6") .
  eq obfsCl6Um       = mkIrcUMV2Actor(obfsCl6UmAddr, "irc-irc-11", obfsCl6IrcAddr, ircServerAddr, obfsCl6SrvIfaceAddr) .
  eq obfsCl6Iface    = mkIrcByteSeqIface(obfsCl6IfaceAddr, obfsCl6IrcAddr, obfsCl6ClientAddr) .
  eq obfsCl6Cl       = makeObfs4Node(obfsCl6ClientAddr, obfsCl6IfaceAddr, obfsCl6ServerAddr) .
  eq obfsCl6SrvIface = mkIrcByteSeqIface(obfsCl6SrvIfaceAddr, ircServerAddr, obfsCl6ServerAddr) .
  eq obfsCl6Srv      = makeObfs4Node(obfsCl6ServerAddr, obfsCl6SrvIfaceAddr, obfsCl6ClientAddr) .
  eq obfsCl6NetCl    = makeNetClient(obfsCl6NetClientAddr,
                                       obfsCl6ServerAddr,
                                       obfsCl6ClientAddr,
                                       true,
                                       corpObfsDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq obfsCl6NetSrv   = makeNetServer(obfsCl6NetServerAddr, obfsCl6ServerAddr) .

  --- Base Infrastructure
  ops ircServer advActor : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq advActor       = mkAdversaryCp3(advAddr) .

  --- DNS Infrastructure
  ops corpObfsDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpObfsNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpObfsDns  = mkNameServer(corpObfsDnsAddr, (zoneObfsCom), corpObfsNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpObfsNetCl  = mkFwdDnsNetC(corpObfsNetClAddr,
                                   publicResolverNetSrvAddr,
                                   publicDnsAddr,
                                   corpObfsDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =
    rCtr(j + 154)

    --- Core Infrastructure
    ircServer
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    --- OBFS4 Client 5
    obfsCl5Irc obfsCl5Um obfsCl5Iface obfsCl5SrvIface obfsCl5Cl obfsCl5Srv
    obfsCl5NetCl obfsCl5NetSrv
    --- OBFS4 Client 6
    obfsCl6Irc obfsCl6Um obfsCl6Iface obfsCl6SrvIface obfsCl6Cl obfsCl6Srv
    obfsCl6NetCl obfsCl6NetSrv
    corpObfsDns corpObfsNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- Startup Timers
    [hcsDelay + 10.0 + genRandomX(j + 18, 0.0, 0.0001), (to obfsCl5UmAddr from obfsCl5UmAddr : burstDelayTO), 0]
    [hcsDelay + 10.0 + genRandomX(j + 19, 0.0, 0.0001), (to obfsCl6UmAddr from obfsCl6UmAddr : burstDelayTO), 0]
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 11700.0 .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = obfsCl5IrcAddr ; obfsCl6IrcAddr .
endm
set print attribute on .
rew initConfig .
q