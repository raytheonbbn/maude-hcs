--- MAUDE_HCS: CP3 Scenario 1 Experiment ---
--- Autogenerated from scenario YAML ---

set clear rules off .
set print attribute off .
set show advisories off .

--- Core Infrastructure
sload ../../../../maude_hcs/lib/webtunnel/webtunnel_prob.maude
sload ../../../../maude_hcs/lib/irc/irc_prob-v2
sload ../../../../maude_hcs/lib/irc/ircMonitor
sload ../../../../maude_hcs/lib/irc/irc-byteseq-interface
sload ../../../../maude_hcs/lib/common/maude/irc-action-actor-v2.maude
sload ../../../../maude_hcs/lib/irc/common/irc_name
sload ../../../../maude_hcs/lib/irc/common/_aux
sload ../../../../maude_hcs/lib/irc/common/app_chat
sload ../../../../maude_hcs/lib/irc/_irc_aux
sload ../../../../maude_hcs/deps/dns_formalization/Maude/common/apmaude.maude
sload ../../../../maude_hcs/lib/common/maude/user-action-actor
sload ../../../../maude_hcs/lib/common/maude/http-overhead.maude
sload ../../../../maude_hcs/lib/irc/common/irc-msg-model
sload ../../../../maude_hcs/lib/dns/maude/probabilistic/iodine_dns.maude
sload ../../../../maude_hcs/lib/dns/maude/common/_aux.maude
sload ../../../../maude_hcs/lib/network/net_prob.maude
sload ../../../../maude_hcs/lib/network/net-dns_prob.maude
sload ../../../../maude_hcs/lib/common/maude/structured-addresses.maude

--- For SMC
sload ../../../../maude_hcs/lib/common/maude/visibility

--- HCS IRC User Models (v2)
sload irc_user_models/irc_2.maude
sload irc_user_models/irc_6.maude

--- Address mapping
sload scenario1_addresses

mod HCS_TEST is
  pr SCHEDULER .
  pr USER-ACTION-ACTOR .
  pr IRC-V2 .
  pr IRC-USER-ACTION-ACTOR-V2 .
  pr IRC-BYTESEQ-INTERFACE .
  pr IRC_MONITOR .
  pr APP_CHATS .
  pr IRC_NODE .
  pr WEBTUNNEL .
  pr IRC_NAMES .
  pr IODINE_NODE .
  pr IODINE_DNS .
  pr TCP_SOCKET .
  pr NET-DNS .
  pr NETWORK_NODE .
  pr NETWORK_CONNECTION .
  inc STRUCTURED-ADDRESSES .
  inc VISIBILITY .
  inc SCENARIO1-ADDRESSES .

  --- HCS IRC Profile Modules
  inc IRC-IRC-6-MAMODEL-V2 .
  inc IRC-IRC-2-MAMODEL-V2 .

  vars j : Nat .

  ---------------------------------------------------
  --- Global Constants
  ---------------------------------------------------
  eq encOH(fsize:Nat,ksize:Nat) = 0 .
  eq noiseMin(msg:Msg)          = 0.00001 .
  eq noiseMax(msg:Msg)          = 0.001 .
  eq maxMinimiseCount           = 0 .
  --- how much to delay the HCS
  ops hcsDelay : -> Float .
  eq hcsDelay  = 0. [owise] .

  --- User Model Database (MAModelMap)
  eq MAModelMap =
    ("irc-irc-6" |-> irc-irc-6-ma-v2,
     "irc-irc-2" |-> irc-irc-2-ma-v2)
  .

  ---------------------------------------------------
  --- DNS Zone Configurations
  ---------------------------------------------------
  op zone : -> List{Record} .
  eq zone =
    < root, soa, 360000.0, soaData(360000.0) >
    < root, ns, 360000.0, 'a . 'root-servers . 'net . root >
    < 'a . 'root-servers . 'net . root, a, 360000.0, rootDnsAddr >
    < 'com . root, ns, 360000.0, 'ns . 'com . root >
    < 'ns . 'com . root, a, 360000.0, tldDnsAddr >
  .

  op zoneCom : -> List{Record} .
  eq zoneCom =
    < 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'com . root, ns, 360000.0, 'ns . 'com . root >
    < 'ns . 'com . root, a, 360000.0, tldDnsAddr >
    < 'pwnd . 'com . root, ns, 360000.0, 'ns . 'pwnd . 'com . root >
    < 'ns . 'pwnd . 'com . root, a, 360000.0, authDnsAddr >
    < 'rt . 'com . root, ns, 360000.0, 'ns . 'rt . 'com . root >
    < 'ns . 'rt . 'com . root, a, 360000.0, corpRtDnsAddr >
    < 'serv . 'com . root, ns, 360000.0, 'ns . 'serv . 'com . root >
    < 'ns . 'serv . 'com . root, a, 360000.0, servDnsAddr >
  .

  op zoneInternetCom : -> List{Record} .
  eq zoneInternetCom =
    < 'internet . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >
    < 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >
    < 'tmp0 . 'internet . 'com . root, a, 0.0, 1 . 0 . 1 . 2 >
    < 'mastodon . 'pwnd . 'com . root, a, 0.0, masSrvAddr >
    < wildcard . 'internet . 'com . root, a, 0.0, 1 . 1 . 1 . 2 >
  .

  op zoneRtCom : -> List{Record} .
  eq zoneRtCom =
    < 'rt . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'rt . 'com . root, ns, 360000.0, 'ns . 'rt . 'com . root >
    < 'ns . 'rt . 'com . root, a, 360000.0, corpRtDnsAddr >
    < 'tmp0 . 'rt . 'com . root, a, 0.0, 3 . 0 . 1 . 2 >
    < wildcard . 'rt . 'com . root, a, 0.0, 3 . 1 . 1 . 2 >
  .

  op zoneServCom : -> List{Record} .
  eq zoneServCom =
    < 'serv . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'serv . 'com . root, ns, 360000.0, 'ns . 'serv . 'com . root >
    < 'ns . 'serv . 'com . root, a, 360000.0, servDnsAddr >
    < 'tmp0 . 'serv . 'com . root, a, 0.0, 3 . 0 . 1 . 2 >
    < wildcard . 'serv . 'com . root, a, 0.0, 3 . 1 . 1 . 2 >
  .

  op sb : -> ZoneState .
  eq sb = < root ('a . 'root-servers . 'net . root |-> rootDnsAddr) > .

  op resolverCache : -> Cache .
  eq resolverCache =
    cacheEntry(< root, ns, 360000.0, 'a . 'root-servers . 'net . root >, 1)
    cacheEntry(< 'a . 'root-servers . 'net . root, a, 360000.0, rootDnsAddr >, 1)
    cacheEntry(< 'com . root, ns, 360000.0, 'ns . 'com . root >, 1)
    cacheEntry(< 'ns . 'com . root, a, 360000.0, tldDnsAddr >, 1)
    cacheEntry(< 'pwnd . 'com . root, ns, 360000.0, 'ns . 'pwnd . 'com . root >, 1)
    cacheEntry(< 'ns . 'pwnd . 'com . root, a, 360000.0, authDnsAddr >, 1)
    cacheEntry(< 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >, 1)
    cacheEntry(< 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >, 1)
    cacheEntry(< 'rt . 'com . root, ns, 360000.0, 'ns . 'rt . 'com . root >, 1)
    cacheEntry(< 'ns . 'rt . 'com . root, a, 360000.0, corpRtDnsAddr >, 1)
    cacheEntry(< 'serv . 'com . root, ns, 360000.0, 'ns . 'serv . 'com . root >, 1)
    cacheEntry(< 'ns . 'serv . 'com . root, a, 360000.0, servDnsAddr >, 1)
  .

  ---------------------------------------------------
  --- Link Model Parameters
  ---------------------------------------------------
  op LinkType-ClientNetRacetunnel : -> AttributeSet .
  eq LinkType-ClientNetRacetunnel =
  (4stateLoss:
     (p13: 0.0219,
      p31: 6.67,
      p32: 26.7,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.03)
  )
  .

  op LinkType-ServerNet : -> AttributeSet .
  eq LinkType-ServerNet =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.005)
  )
  .

  op LinkType-Ixp : -> AttributeSet .
  eq LinkType-Ixp =
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.005)
  )
  .

  op LinkType-Dns : -> AttributeSet .
  eq LinkType-Dns =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.01),
  (delayConst: 0.001),
  (noiseMin: 0.),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.01)
  )
  .

  op LinkType-DnsComposed : -> AttributeSet .
  eq LinkType-DnsComposed =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.),
  (delayConst: 0.001),
  (noiseMin: 0.02),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.02)
  )
  .

  ---------------------------------------------------
  --- Transport Equations (Readable Addresses Only)
  ---------------------------------------------------
  eq transport(wtCl1ClientAddr) = tcp(wtCl1ClientAddr) .
  eq transport(wtCl1ProxyAddr) = tcp(wtCl1ProxyAddr) .
  eq transport(wtCl2ClientAddr) = tcp(wtCl2ClientAddr) .
  eq transport(wtCl2ProxyAddr) = tcp(wtCl2ProxyAddr) .

  --- UDP transport for DNS resolvers
  eq transport(publicDnsAddr) = publicDnsAddr .
  eq transport(corpRtDnsAddr) = corpRtDnsAddr .
  eq transport(servDnsAddr) = servDnsAddr .

  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- Webtunnel Client 1
    aaa(wtCl1ClientAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetRacetunnel)
    aaa(IXP-DEFAULT-ADDR, wtCl1ClientAddr, LinkType-ClientNetRacetunnel)
    aaa(wtCl1ProxyAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, wtCl1ProxyAddr, LinkType-ServerNet)
    --- Webtunnel Client 2
    aaa(wtCl2ClientAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetRacetunnel)
    aaa(IXP-DEFAULT-ADDR, wtCl2ClientAddr, LinkType-ClientNetRacetunnel)
    aaa(wtCl2ProxyAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, wtCl2ProxyAddr, LinkType-ServerNet)

    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-Dns)

    aaa(publicResolverNetSrvAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicResolverNetSrvAddr, LinkType-Dns)

    *** IRC Server enclave DNS server ***
    aaa(servDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servDnsAddr, LinkType-DnsComposed)
    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servDnsAddr, LinkType-Dns)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-DnsComposed)
    aaa(servNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servNetClAddr, LinkType-Dns)

    *** WebTunnel IRC Client enclave DNS server ***
    aaa(corpRtDnsAddr, publicDnsAddr, LinkType-DnsComposed)
    aaa(publicDnsAddr, corpRtDnsAddr, LinkType-DnsComposed)
    aaa(corpRtDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpRtDnsAddr, LinkType-DnsComposed)
    aaa(corpRtDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpRtDnsAddr, LinkType-Dns)
    aaa(corpRtNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpRtNetClAddr, LinkType-DnsComposed)
    aaa(corpRtNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpRtNetClAddr, LinkType-Dns)
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- Webtunnel Client 1 (IRC profile: irc_6)
  ops wtCl1Irc wtCl1Um wtCl1Iface wtCl1SrvIface : -> Actor .
  ops wtCl1Client wtCl1Proxy : -> Actor .
  ops wtCl1NetClient wtCl1NetServer : -> Actor .
  eq wtCl1Irc       = mkIrcClient-v2(wtCl1IrcAddr, wtCl1IfaceAddr, "WtClient1") .
  eq wtCl1Um        = mkIrcUMV2Actor(wtCl1UmAddr, "irc-irc-6", wtCl1IrcAddr, ircServerAddr, wtCl1SrvIfaceAddr) .
  eq wtCl1Iface     = mkIrcByteSeqIface(wtCl1IfaceAddr, wtCl1IrcAddr, wtCl1ClientAddr) .
  eq wtCl1SrvIface  = mkIrcByteSeqIface(wtCl1SrvIfaceAddr, ircServerAddr, wtCl1ProxyAddr) .
  eq wtCl1Client =
    < wtCl1ClientAddr : WtClient |
        thisAddr:        wtCl1ClientAddr,
        serverProxyAddr: wtCl1ProxyAddr,
        ircServerAddr:   ircServerAddr,
        ircClientAddr:   wtCl1IfaceAddr,
        tlsServerName:   "irc.example.com",
        upgradePath:     "secret/path/v1",
        tunnelState:     Closed,
        pendingMsgs:     emptyQueue >
  .
  eq wtCl1Proxy      = makeWtServerProxy(wtCl1ProxyAddr, wtCl1SrvIfaceAddr) .
  eq wtCl1NetClient  = makeNetClient(wtCl1NetClientAddr,
                                       wtCl1ProxyAddr,
                                       wtCl1ClientAddr,
                                       true,
                                       corpRtDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq wtCl1NetServer  = makeNetServer(wtCl1NetServerAddr, wtCl1ProxyAddr) .

  --- Webtunnel Client 2 (IRC profile: irc_2)
  ops wtCl2Irc wtCl2Um wtCl2Iface wtCl2SrvIface : -> Actor .
  ops wtCl2Client wtCl2Proxy : -> Actor .
  ops wtCl2NetClient wtCl2NetServer : -> Actor .
  eq wtCl2Irc       = mkIrcClient-v2(wtCl2IrcAddr, wtCl2IfaceAddr, "WtClient2") .
  eq wtCl2Um        = mkIrcUMV2Actor(wtCl2UmAddr, "irc-irc-2", wtCl2IrcAddr, ircServerAddr, wtCl2SrvIfaceAddr) .
  eq wtCl2Iface     = mkIrcByteSeqIface(wtCl2IfaceAddr, wtCl2IrcAddr, wtCl2ClientAddr) .
  eq wtCl2SrvIface  = mkIrcByteSeqIface(wtCl2SrvIfaceAddr, ircServerAddr, wtCl2ProxyAddr) .
  eq wtCl2Client =
    < wtCl2ClientAddr : WtClient |
        thisAddr:        wtCl2ClientAddr,
        serverProxyAddr: wtCl2ProxyAddr,
        ircServerAddr:   ircServerAddr,
        ircClientAddr:   wtCl2IfaceAddr,
        tlsServerName:   "irc.example.com",
        upgradePath:     "secret/path/v1",
        tunnelState:     Closed,
        pendingMsgs:     emptyQueue >
  .
  eq wtCl2Proxy      = makeWtServerProxy(wtCl2ProxyAddr, wtCl2SrvIfaceAddr) .
  eq wtCl2NetClient  = makeNetClient(wtCl2NetClientAddr,
                                       wtCl2ProxyAddr,
                                       wtCl2ClientAddr,
                                       true,
                                       corpRtDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq wtCl2NetServer  = makeNetServer(wtCl2NetServerAddr, wtCl2ProxyAddr) .

  --- Base Infrastructure
  ops ircServer advActor : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq advActor       = mkAdversaryCp3(advAddr) .

  --- DNS Infrastructure
  ops corpRtDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpRtNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpRtDns    = mkNameServer(corpRtDnsAddr, (zoneRtCom), corpRtNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpRtNetCl  = mkFwdDnsNetC(corpRtNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpRtDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =
    rCtr(j + 154)

    --- Core Infrastructure
    ircServer
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    --- Webtunnel Client 1
    wtCl1Irc wtCl1Um wtCl1Iface wtCl1SrvIface wtCl1Client wtCl1Proxy
    wtCl1NetClient wtCl1NetServer
    --- Webtunnel Client 2
    wtCl2Irc wtCl2Um wtCl2Iface wtCl2SrvIface wtCl2Client wtCl2Proxy
    wtCl2NetClient wtCl2NetServer
    corpRtDns corpRtNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- Startup Timers
    [hcsDelay + genRandomX(j + 2, 0.0, 0.0001), (to wtCl1ClientAddr from wtCl1ClientAddr : WtStartCmd), 0]
    [hcsDelay + genRandomX(j + 3, 0.0, 0.0001), (to wtCl2ClientAddr from wtCl2ClientAddr : WtStartCmd), 0]

    --- IRC User Model Burst Delay Timers (staggered)
    [hcsDelay + 10.0 + genRandomX(j + 14, 0.0, 0.0001), (to wtCl1UmAddr from wtCl1UmAddr : burstDelayTO), 0]
    [hcsDelay + 10.0 + genRandomX(j + 15, 0.0, 0.0001), (to wtCl2UmAddr from wtCl2UmAddr : burstDelayTO), 0]
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 11700.0 .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = wtCl1IrcAddr ; wtCl2IrcAddr .
endm
set print attribute on .
rew initConfig .
q
