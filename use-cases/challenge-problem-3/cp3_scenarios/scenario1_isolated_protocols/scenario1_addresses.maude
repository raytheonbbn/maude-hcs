  ---------------------------------------------------
  --- Address Equations
  ---------------------------------------------------
***(
  eq ircServerAddr     = a(srvN, srv, irc, srv, 0) .
  eq s3SrvAddr         = a(minN, srv, min, srv, 0) .
  eq ircMonitorAddr    = a(srvN, srv, irc, cl, 99) .
  eq iodineMonitorAddr = a(srvN, srv, iod, cl, 99) .
  eq masSrvAddr        = a(masN, srv, mas, srv, 0) .
  eq advAddr           = a(ixpN, srv, irc, cl, 0) .

  eq publicDnsAddr     = a(dnsN, dns, dns, srv, 0) .
  eq rootDnsAddr       = a(dnsN, dns, dns, srv, 1) .
  eq tldDnsAddr        = a(dnsN, dns, dns, srv, 2) .
  eq authDnsAddr       = a(dnsN, dns, dns, srv, 3) .
  eq corpMasDnsAddr    = a(cl[1], dns, dns, cl, 0) .
  eq corpRtDnsAddr     = a(cl[2], dns, dns, cl, 0) .
  eq corpIodDnsAddr    = a(cl[3], dns, dns, cl, 0) .
  eq corpObfsDnsAddr   = a(cl[4], dns, dns, cl, 0) .
  eq corpSkyDnsAddr    = a(cl[5], dns, dns, cl, 0) .
  eq servDnsAddr       = a(srvN, dns, dns, cl, 0) .

  eq corpMasNetClAddr        = a(cl[1], udp, dns, cl, 0) .
  eq corpRtNetClAddr         = a(cl[2], udp, dns, cl, 0) .
  eq corpIodNetClAddr        = a(cl[3], udp, dns, cl, 0) .
  eq corpObfsNetClAddr       = a(cl[4], udp, dns, cl, 0) .
  eq corpSkyNetClAddr        = a(cl[5], udp, dns, cl, 0) .
  eq servNetClAddr           = a(srvN, udp, dns, cl, 0) .
  eq publicResolverNetClAddr = a(dnsN, udp, dns, cl, 0) .

  --- Webtunnel Client 1
  eq wtCl1IrcAddr        = a(cl[2], hcs, irc, cl, 1) .
  eq wtCl1UmAddr         = a(cl[2], hcs, irc, um, 1) .
  eq wtCl1IfaceAddr      = a(cl[2], hcs, irc, if, 1) .
  eq wtCl1SrvIfaceAddr   = a(srvN[1], hcs, irc, if, 1) .
  eq wtCl1ClientAddr     = a(cl[2], hcs, wt, cl, 1) .
  eq wtCl1ProxyAddr      = a(srvN[1], hcs, wt, srv, 1) .
  eq wtCl1NetClientAddr  = a(cl[2], tcp, wt, cl, 1) .
  eq wtCl1NetServerAddr  = a(srvN[1], tcp, wt, srv, 1) .

  --- Webtunnel Client 2
  eq wtCl2IrcAddr        = a(cl[2], hcs, irc, cl, 2) .
  eq wtCl2UmAddr         = a(cl[2], hcs, irc, um, 2) .
  eq wtCl2IfaceAddr      = a(cl[2], hcs, irc, if, 2) .
  eq wtCl2SrvIfaceAddr   = a(srvN[2], hcs, irc, if, 2) .
  eq wtCl2ClientAddr     = a(cl[2], hcs, wt, cl, 2) .
  eq wtCl2ProxyAddr      = a(srvN[2], hcs, wt, srv, 2) .
  eq wtCl2NetClientAddr  = a(cl[2], tcp, wt, cl, 2) .
  eq wtCl2NetServerAddr  = a(srvN[2], tcp, wt, srv, 2) .

  --- Skyhook Client 3
  eq skyCl3IrcAddr       = a(cl[5], hcs, irc, cl, 1) .
