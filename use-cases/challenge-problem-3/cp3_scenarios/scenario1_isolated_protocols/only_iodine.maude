--- MAUDE_HCS: CP3 Scenario 1 Experiment ---
--- Autogenerated from scenario YAML ---

set clear rules off .
set print attribute off .
set show advisories off .

--- Core Infrastructure
sload ../../../../maude_hcs/lib/irc/irc_prob-v2
sload ../../../../maude_hcs/lib/irc/ircMonitor
sload ../../../../maude_hcs/lib/irc/irc-byteseq-interface
sload ../../../../maude_hcs/lib/common/maude/irc-action-actor-v2.maude
sload ../../../../maude_hcs/lib/irc/common/irc_name
sload ../../../../maude_hcs/lib/irc/common/_aux
sload ../../../../maude_hcs/lib/irc/common/app_chat
sload ../../../../maude_hcs/lib/irc/_irc_aux
sload ../../../../maude_hcs/deps/dns_formalization/Maude/common/apmaude.maude
sload ../../../../maude_hcs/lib/common/maude/user-action-actor
sload ../../../../maude_hcs/lib/dns/maude/probabilistic/iodine_dns.maude
sload ../../../../maude_hcs/lib/dns/maude/common/_aux.maude
sload ../../../../maude_hcs/lib/network/net_prob.maude
sload ../../../../maude_hcs/lib/network/net-dns_prob.maude
sload ../../../../maude_hcs/lib/common/maude/structured-addresses.maude

--- For SMC
sload ../../../../maude_hcs/lib/common/maude/visibility

--- User model
sload irc_user_models/irc_2.maude
sload irc_user_models/irc_7.maude

--- Address mapping
sload scenario1_addresses

mod HCS_TEST is
  pr SCHEDULER .
  pr USER-ACTION-ACTOR .
  pr IRC-V2 .
  pr IRC-USER-ACTION-ACTOR-V2 .
  pr IRC-BYTESEQ-INTERFACE .
  pr IRC_MONITOR .
  pr APP_CHATS .
  pr IRC_NODE .
  pr IRC_NAMES .
  pr IODINE_NODE .
  pr IODINE_DNS .
  pr TCP_SOCKET .
  pr NET-DNS .
  pr NETWORK_NODE .
  pr NETWORK_CONNECTION .
  inc STRUCTURED-ADDRESSES .
  inc VISIBILITY .
  inc SCENARIO1-ADDRESSES .
  inc IRC-IRC-2-MAMODEL-V2 .
  inc IRC-IRC-7-MAMODEL-V2 .

  vars j : Nat .

  ---------------------------------------------------
  --- Global Constants
  ---------------------------------------------------
  eq encOH(fsize:Nat,ksize:Nat) = 0 .
  eq noiseMin(msg:Msg)          = 0.00001 .
  eq noiseMax(msg:Msg)          = 0.001 .
  eq packetSize                 = 1000 .
  eq maxPacketSize              = 967 .
  eq maxMinimiseCount           = 0 .
  --- how much to delay the HCS and TGENs
  ops hcsDelay tgenDelay : -> Float .
  eq hcsDelay  = 0. [owise] .
  eq tgenDelay = 30.0 [owise] .

  --- User Model Database (MAModelMap)
  eq MAModelMap =
    ("irc-irc-2" |-> irc-irc-2-ma-v2,
     "irc-irc-7" |-> irc-irc-7-ma-v2)
  .

  ---------------------------------------------------
  --- DNS Zone Configurations
  ---------------------------------------------------
  op zone : -> List{Record} .
  eq zone =
    < root, soa, 360000.0, soaData(360000.0) >
    < root, ns, 360000.0, 'a . 'root-servers . 'net . root >
    < 'a . 'root-servers . 'net . root, a, 360000.0, rootDnsAddr >
    < 'com . root, ns, 360000.0, 'ns . 'com . root >
    < 'ns . 'com . root, a, 360000.0, tldDnsAddr >
  .

  op zoneCom : -> List{Record} .
  eq zoneCom =
    < 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'com . root, ns, 360000.0, 'ns . 'com . root >
    < 'ns . 'com . root, a, 360000.0, tldDnsAddr >
    < 'pwnd . 'com . root, ns, 360000.0, 'ns . 'pwnd . 'com . root >
    < 'ns . 'pwnd . 'com . root, a, 360000.0, authDnsAddr >
    < 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >
    < 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >
    < 'iod . 'com . root, ns, 360000.0, 'ns . 'iod . 'com . root >
    < 'ns . 'iod . 'com . root, a, 360000.0, corpIodDnsAddr >
  .

  op zoneInternetCom : -> List{Record} .
  eq zoneInternetCom =
    < 'internet . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >
    < 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >
    < 'tmp0 . 'internet . 'com . root, a, 0.0, 1 . 0 . 1 . 2 >
    < 't1 . 'pwnd . 'com . root, ns, 360000.0, 'ns . 't1 . 'pwnd . 'com . root >
    < 'ns . 't1 . 'pwnd . 'com . root, a, 360000.0, iodCl7SrvNetClAddr >
    < 't2 . 'pwnd . 'com . root, ns, 360000.0, 'ns . 't2 . 'pwnd . 'com . root >
    < 'ns . 't2 . 'pwnd . 'com . root, a, 360000.0, iodCl8SrvNetClAddr >
    < wildcard . 'internet . 'com . root, a, 0.0, 1 . 1 . 1 . 2 >
  .

  op zonePwndCom7 : -> List{Record} .
  eq zonePwndCom7 =
    < 'pwnd . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'pwnd . 'com . root, ns, 360000.0, 'ns . 't1 . 'pwnd . 'com . root >
    < 'ns . 't1 . 'pwnd . 'com . root, a, 360000.0, iodCl7SrvNetClAddr >
    < 'www0 . 't1 . 'pwnd . 'com . root, a, 360000.0, 2 . 0 . 1 . 2 >
    < 'www1 . 't1 . 'pwnd . 'com . root, a, 360000.0, 2 . 1 . 1 . 2 >
    < wildcard . 't1 . 'pwnd . 'com . root, txt, 360000.0, nullAddr > .

  op zonePwndCom8 : -> List{Record} .
  eq zonePwndCom8 =
    < 'pwnd . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'pwnd . 'com . root, ns, 360000.0, 'ns . 't2 . 'pwnd . 'com . root >
    < 'ns . 't2 . 'pwnd . 'com . root, a, 360000.0, iodCl8SrvNetClAddr >
    < 'www0 . 't2 . 'pwnd . 'com . root, a, 360000.0, 2 . 0 . 1 . 2 >
    < 'www1 . 't2 . 'pwnd . 'com . root, a, 360000.0, 2 . 1 . 1 . 2 >
    < wildcard . 't2 . 'pwnd . 'com . root, txt, 360000.0, nullAddr > .

  op zoneIodCom : -> List{Record} .
  eq zoneIodCom =
    < 'iod . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'iod . 'com . root, ns, 360000.0, 'ns . 'iod . 'com . root >
    < 'ns . 'iod . 'com . root, a, 360000.0, corpIodDnsAddr >
    < 'tmp0 . 'iod . 'com . root, a, 0.0, 3 . 0 . 1 . 2 >
    < wildcard . 'iod . 'com . root, a, 0.0, 3 . 1 . 1 . 2 >
  .

  op sb : -> ZoneState .
  eq sb = < root ('a . 'root-servers . 'net . root |-> rootDnsAddr) > .

  op resolverCache : -> Cache .
  eq resolverCache =
    cacheEntry(< root, ns, 360000.0, 'a . 'root-servers . 'net . root >, 1)
    cacheEntry(< 'a . 'root-servers . 'net . root, a, 360000.0, rootDnsAddr >, 1)
    cacheEntry(< 'com . root, ns, 360000.0, 'ns . 'com . root >, 1)
    cacheEntry(< 'ns . 'com . root, a, 360000.0, tldDnsAddr >, 1)
    cacheEntry(< 'pwnd . 'com . root, ns, 360000.0, 'ns . 'pwnd . 'com . root >, 1)
    cacheEntry(< 'ns . 'pwnd . 'com . root, a, 360000.0, authDnsAddr >, 1)
    cacheEntry(< 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >, 1)
    cacheEntry(< 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >, 1)
    cacheEntry(< 't1 . 'pwnd . 'com . root, ns, 360000.0, 'ns . 't1 . 'pwnd . 'com . root >, 1)
    cacheEntry(< 'ns . 't1 . 'pwnd . 'com . root, a, 360000.0, iodCl7SrvNetClAddr >, 1)
    cacheEntry(< 't2 . 'pwnd . 'com . root, ns, 360000.0, 'ns . 't2 . 'pwnd . 'com . root >, 1)
    cacheEntry(< 'ns . 't2 . 'pwnd . 'com . root, a, 360000.0, iodCl8SrvNetClAddr >, 1)
    cacheEntry(< 'iod . 'com . root, ns, 360000.0, 'ns . 'iod . 'com . root >, 1)
    cacheEntry(< 'ns . 'iod . 'com . root, a, 360000.0, corpIodDnsAddr >, 1)
  .

  ---------------------------------------------------
  --- Link Model Parameters
  ---------------------------------------------------
  op LinkType-ClientNetIodine : -> AttributeSet .
  eq LinkType-ClientNetIodine =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.01)
  )
  .

  op LinkType-ServerNet : -> AttributeSet .
  eq LinkType-ServerNet =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.005)
  )
  .

  op LinkType-DnsNet : -> AttributeSet .
  eq LinkType-DnsNet =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.005)
  )
  .

  op LinkType-Dns : -> AttributeSet .
  eq LinkType-Dns =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.01),
  (delayConst: 0.01),
  (noiseMin: 0.01),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.01)
  )
  .

  op LinkType-DnsComposed : -> AttributeSet .
  eq LinkType-DnsComposed =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.02),
  (delayConst: 0.02),
  (noiseMin: 0.01),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.02)
  )
  .

  ---------------------------------------------------
  --- Transport Equations (Readable Addresses Only)
  ---------------------------------------------------
  eq transport(publicDnsAddr)       = publicDnsAddr .
  eq transport(corpIodDnsAddr)      = corpIodDnsAddr .
  eq transport(iodCl7ServerAddr)    = iodCl7ServerAddr .
  eq transport(iodCl7NetServerAddr) = iodCl7NetServerAddr .
  eq transport(iodCl8ServerAddr)    = iodCl8ServerAddr .
  eq transport(iodCl8NetServerAddr) = iodCl8NetServerAddr .

  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- Iodine Client 7
    aaa(iodCl7ServerAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl7ServerAddr, LinkType-Dns)
    aaa(iodCl7ClientAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl7ClientAddr, LinkType-Dns)
    aaa(iodCl7SendAppAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl7SendAppAddr, LinkType-Dns)
    aaa(iodCl7RcvAppAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl7RcvAppAddr, LinkType-Dns)
    --- Iodine Client 8
    aaa(iodCl8ServerAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl8ServerAddr, LinkType-Dns)
    aaa(iodCl8ClientAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl8ClientAddr, LinkType-Dns)
    aaa(iodCl8SendAppAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl8SendAppAddr, LinkType-Dns)
    aaa(iodCl8RcvAppAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl8RcvAppAddr, LinkType-Dns)

    aaa(corpIodDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpIodDnsAddr, LinkType-Dns)

    aaa(corpIodNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpIodNetClAddr, LinkType-DnsComposed)
    aaa(iodCl7SrvNetClAddr, iodCl7SrvNetSrvAddr, LinkType-DnsComposed)
    aaa(iodCl7SrvNetSrvAddr, iodCl7SrvNetClAddr, LinkType-DnsComposed)
    aaa(iodCl8SrvNetClAddr, iodCl8SrvNetSrvAddr, LinkType-DnsComposed)
    aaa(iodCl8SrvNetSrvAddr, iodCl8SrvNetClAddr, LinkType-DnsComposed)
    aaa(corpIodDnsAddr, publicDnsAddr, LinkType-DnsComposed)
    aaa(publicDnsAddr, corpIodDnsAddr, LinkType-DnsComposed)
    aaa(iodCl7ServerAddr, publicDnsAddr, LinkType-DnsComposed)
    aaa(publicDnsAddr, iodCl7ServerAddr, LinkType-DnsComposed)
    aaa(iodCl8ServerAddr, publicDnsAddr, LinkType-DnsComposed)
    aaa(publicDnsAddr, iodCl8ServerAddr, LinkType-DnsComposed)

    --- UDP DNS Links
    aaa(iodCl7SrvNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl7SrvNetClAddr, LinkType-Dns)
    aaa(iodCl8SrvNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, iodCl8SrvNetClAddr, LinkType-Dns)
    aaa(corpIodNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpIodNetClAddr, LinkType-Dns)

    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-Dns)

    aaa(publicResolverNetSrvAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicResolverNetSrvAddr, LinkType-Dns)
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- Iodine Client 7 (IRC profile: irc_2)
  ops iodCl7Irc iodCl7Um iodCl7Iface iodCl7SrvIface : -> Actor .
  ops iodCl7SendApp iodCl7RcvApp iodCl7Cl iodCl7Srv : -> Actor .
  ops iodCl7SrvNetCl iodCl7SrvNetSrv : -> Actor .
  eq iodCl7Irc       = mkIrcClient-v2(iodCl7IrcAddr, iodCl7IfaceAddr, "IodClient7") .
  eq iodCl7Um        = mkIrcUMV2Actor(iodCl7UmAddr, "irc-irc-2", iodCl7IrcAddr, ircServerAddr, iodCl7SrvIfaceAddr) .
  eq iodCl7Iface     = mkIrcByteSeqIface(iodCl7IfaceAddr, iodCl7IrcAddr, iodCl7SendAppAddr) .
  eq iodCl7SrvIface  = mkIrcByteSeqIface(iodCl7SrvIfaceAddr, ircServerAddr, iodCl7RcvAppAddr) .
  eq iodCl7SendApp   = mkSendApp(iodCl7SendAppAddr, iodCl7RcvAppAddr, iodCl7IfaceAddr, iodCl7ClientAddr) .
  eq iodCl7RcvApp    = mkRcvApp(iodCl7RcvAppAddr, iodCl7SendAppAddr, iodCl7SrvIfaceAddr, iodCl7ServerAddr) .
  eq iodCl7Cl        = makeWClient(iodCl7ClientAddr, corpIodDnsAddr, 't1 . 'pwnd . 'com . root, a, 0.0) .
  eq iodCl7Srv       = makeWNameServer(iodCl7ServerAddr, 0.0, zonePwndCom7) .
  eq iodCl7SrvNetSrv = mkPubDnsNetS(iodCl7SrvNetSrvAddr,
                                    iodCl7ServerAddr,
                                    IXP-DEFAULT-ADDR)
  .
  **** pubDns as client side 
  eq iodCl7SrvNetCl = mkFwdDnsNetC(iodCl7SrvNetClAddr,
                                   iodCl7SrvNetSrvAddr,
                                   iodCl7ServerAddr, 
                                   publicDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .

  --- Iodine Client 8 (IRC profile: irc_7)
  ops iodCl8Irc iodCl8Um iodCl8Iface iodCl8SrvIface : -> Actor .
  ops iodCl8SendApp iodCl8RcvApp iodCl8Cl iodCl8Srv : -> Actor .
  ops iodCl8SrvNetCl iodCl8SrvNetSrv : -> Actor .
  eq iodCl8Irc       = mkIrcClient-v2(iodCl8IrcAddr, iodCl8IfaceAddr, "IodClient8") .
  eq iodCl8Um        = mkIrcUMV2Actor(iodCl8UmAddr, "irc-irc-7", iodCl8IrcAddr, ircServerAddr, iodCl8SrvIfaceAddr) .
  eq iodCl8Iface     = mkIrcByteSeqIface(iodCl8IfaceAddr, iodCl8IrcAddr, iodCl8SendAppAddr) .
  eq iodCl8SrvIface  = mkIrcByteSeqIface(iodCl8SrvIfaceAddr, ircServerAddr, iodCl8RcvAppAddr) .
  eq iodCl8SendApp   = mkSendApp(iodCl8SendAppAddr, iodCl8RcvAppAddr, iodCl8IfaceAddr, iodCl8ClientAddr) .
  eq iodCl8RcvApp    = mkRcvApp(iodCl8RcvAppAddr, iodCl8SendAppAddr, iodCl8SrvIfaceAddr, iodCl8ServerAddr) .
  eq iodCl8Cl        = makeWClient(iodCl8ClientAddr, corpIodDnsAddr, 't2 . 'pwnd . 'com . root, a, 0.0) .
  eq iodCl8Srv       = makeWNameServer(iodCl8ServerAddr, 0.0, zonePwndCom8) .
  eq iodCl8SrvNetSrv = mkPubDnsNetS(iodCl8SrvNetSrvAddr,
                                    iodCl8ServerAddr,
                                    IXP-DEFAULT-ADDR)
  .
  **** pubDns as client side 
  eq iodCl8SrvNetCl = mkFwdDnsNetC(iodCl8SrvNetClAddr,
                                   iodCl8SrvNetSrvAddr,
                                   iodCl8ServerAddr,
                                   publicDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .

  --- Base Infrastructure
  ops ircServer iodineMonitor advActor : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq iodineMonitor  = mkWMonitor(iodineMonitorAddr) .
  eq advActor       = mkAdversaryCp3(advAddr) .

  --- DNS Infrastructure
  ops corpIodDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpIodNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpIodDns   = mkNameServer(corpIodDnsAddr, (zoneIodCom), corpIodNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpIodNetCl = mkFwdDnsNetC(corpIodNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpIodDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =
    rCtr(j + 154)

    --- Core Infrastructure
    ircServer iodineMonitor
    mkIrcMonitor(ircMonitorAddr)
    advActor

    --- Iodine Client 7
    iodCl7Irc iodCl7Um iodCl7Iface iodCl7SrvIface
    iodCl7SendApp iodCl7RcvApp iodCl7Cl iodCl7Srv
    iodCl7SrvNetSrv iodCl7SrvNetCl
    --- Iodine Client 8
    iodCl8Irc iodCl8Um iodCl8Iface iodCl8SrvIface
    iodCl8SendApp iodCl8RcvApp iodCl8Cl iodCl8Srv
    iodCl8SrvNetSrv iodCl8SrvNetCl
    corpIodDns corpIodNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- Startup Timers
    [hcsDelay + 1.0 + genRandomX(j + 8, 0.0, 0.0001), (to iodCl7SendAppAddr : start), 0]
    [hcsDelay + 1.0 + genRandomX(j + 9, 0.0, 0.0001), (to iodCl7RcvAppAddr : start), 0]
    [hcsDelay + 1.0 + genRandomX(j + 10, 0.0, 0.0001), (to iodCl8SendAppAddr : start), 0]
    [hcsDelay + 1.0 + genRandomX(j + 11, 0.0, 0.0001), (to iodCl8RcvAppAddr : start), 0]

    --- IRC User Model Burst Delay Timers (staggered)
    [hcsDelay + 10.0 + genRandomX(j + 20, 0.0, 0.0001), (to iodCl7UmAddr from iodCl7UmAddr : burstDelayTO), 0]
    [hcsDelay + 10.0 + genRandomX(j + 21, 0.0, 0.0001), (to iodCl8UmAddr from iodCl8UmAddr : burstDelayTO), 0]
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 11700.0 .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = iodCl7IrcAddr ; iodCl8IrcAddr .
endm
set print attribute on .
rew initConfig .
q