  ---------------------------------------------------
  --- Transport Equations (Readable Addresses Only)
  ---------------------------------------------------
  eq transport(skyCl3SdkacAddr) = tcp(skyCl3SdkacAddr) .
  eq transport(skyCl3SdkasAddr) = tcp(skyCl3SdkasAddr) .
  eq transport(skyCl4SdkacAddr) = tcp(skyCl4SdkacAddr) .
  eq transport(skyCl4SdkasAddr) = tcp(skyCl4SdkasAddr) .
  eq transport(s3SrvAddr) = tcp(s3SrvAddr) .

  --- UDP transport for DNS resolvers
  eq transport(publicDnsAddr) = publicDnsAddr .
  eq transport(corpSkyDnsAddr) = corpSkyDnsAddr .
  eq transport(servDnsAddr) = servDnsAddr .

  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- Skyhook Client 3
    aaa(skyCl3SdkacAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, skyCl3SdkacAddr, LinkType-ClientNetSky)
    aaa(skyCl3SdkasAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, skyCl3SdkasAddr, LinkType-ClientNetSky)
    aaa(skyCl3AhaAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, skyCl3AhaAddr, LinkType-ServerNet)
    --- Skyhook Client 4
    aaa(skyCl4SdkacAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, skyCl4SdkacAddr, LinkType-ClientNetSky)
    aaa(skyCl4SdkasAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, skyCl4SdkasAddr, LinkType-ClientNetSky)
    aaa(skyCl4AhaAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, skyCl4AhaAddr, LinkType-ServerNet)

    aaa(s3SrvAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, s3SrvAddr, LinkType-ClientNetSky)

    --- UDP DNS Links
    aaa(servNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servNetClAddr, LinkType-Dns)
    aaa(corpSkyNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyNetClAddr, LinkType-Dns)

    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-Dns)

    aaa(publicResolverNetSrvAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicResolverNetSrvAddr, LinkType-Dns)

    *** IRC Server enclave DNS server ***
    aaa(servDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servDnsAddr, LinkType-DnsComposed)
    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servDnsAddr, LinkType-Dns)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-DnsComposed)
    aaa(servNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servNetClAddr, LinkType-Dns)
    *** Skyhook IRC Client enclave DNS server ***
    aaa(corpSkyDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpSkyDnsAddr, LinkType-DnsComposed)
    aaa(corpSkyDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyDnsAddr, LinkType-Dns)
    aaa(corpSkyNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpSkyNetClAddr, LinkType-DnsComposed)
    aaa(corpSkyNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyNetClAddr, LinkType-Dns)
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- Skyhook Client 3 (IRC profile: irc_3)
  ops skyCl3Irc skyCl3Um skyCl3Iface skyCl3SrvIface : -> Actor .
  ops skyCl3UmacAct skyCl3CmacAct skyCl3PuaAct skyCl3SdkacAct : -> Actor .
  ops skyCl3UmasAct skyCl3CmasAct skyCl3AhaAct skyCl3SdkasAct : -> Actor .
  ops skyCl3ClNet skyCl3SrvNetCl skyCl3NetSrv : -> Actor .
  eq skyCl3Irc       = mkIrcClient-v2(skyCl3IrcAddr, skyCl3IfaceAddr, "SkyClient3") .
  eq skyCl3Um        = mkIrcUMV2Actor(skyCl3UmAddr, "irc-irc-3", skyCl3IrcAddr, ircServerAddr, skyCl3SrvIfaceAddr) .
  eq skyCl3Iface     = mkIrcByteSeqIface(skyCl3IfaceAddr, skyCl3IrcAddr, skyCl3CmacAddr) .
  eq skyCl3UmacAct   = mkUMactor(skyCl3UmacAddr, skyhook-client-scenario-1-ma, skyCl3CmacAddr) .
  eq skyCl3CmacAct   = mkCMSimpleBi(skyCl3CmacAddr, skyCl3IfaceAddr, skyCl3PuaAddr) .
  eq skyCl3PuaAct    = makeSkyhookPU(skyCl3PuaAddr, skyCl3CmacAddr, skyCl3SdkacAddr, "s_to_c_bucket_3", "c_to_s_bucket_3", "s_to_c_uuid_3", "c_to_s_uuid_3-hash") .
  eq skyCl3SdkacAct  = makeS3Client(skyCl3SdkacAddr, s3SrvAddr) .
  eq skyCl3SrvIface  = mkIrcByteSeqIface(skyCl3SrvIfaceAddr, ircServerAddr, skyCl3CmasAddr) .
  eq skyCl3UmasAct   = mkUMactor(skyCl3UmasAddr, skyhook-server-scenario-1-ma, skyCl3CmasAddr) .
  eq skyCl3CmasAct   = mkCMSimpleBi(skyCl3CmasAddr, skyCl3SrvIfaceAddr, skyCl3AhaAddr) .
  eq skyCl3AhaAct    = mkSkyhookAH(skyCl3AhaAddr, skyCl3CmasAddr, skyCl3SdkasAddr, "c_to_s_bucket_3", "s_to_c_bucket_3", "c_to_s_uuid_3", "s_to_c_uuid_3", "s_to_c_uuid_3", 6) .
  eq skyCl3SdkasAct  = makeS3Client(skyCl3SdkasAddr, s3SrvAddr) .
  eq skyCl3ClNet     = makeNetClient(skyCl3ClNetAddr,
                                       s3SrvAddr,
                                       skyCl3SdkacAddr,
                                       false,
                                       corpSkyDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq skyCl3NetSrv    = makeNetServer(skyCl3NetSrvAddr, s3SrvAddr) .
  eq skyCl3SrvNetCl  = makeNetClient(skyCl3SrvNetClAddr,
                                       s3SrvAddr,
                                       skyCl3SdkasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Skyhook Client 4 (IRC profile: irc_10)
  ops skyCl4Irc skyCl4Um skyCl4Iface skyCl4SrvIface : -> Actor .
  ops skyCl4UmacAct skyCl4CmacAct skyCl4PuaAct skyCl4SdkacAct : -> Actor .
  ops skyCl4UmasAct skyCl4CmasAct skyCl4AhaAct skyCl4SdkasAct : -> Actor .
  ops skyCl4ClNet skyCl4SrvNetCl skyCl4NetSrv : -> Actor .
  eq skyCl4Irc       = mkIrcClient-v2(skyCl4IrcAddr, skyCl4IfaceAddr, "SkyClient4") .
  eq skyCl4Um        = mkIrcUMV2Actor(skyCl4UmAddr, "irc-irc-10", skyCl4IrcAddr, ircServerAddr, skyCl4SrvIfaceAddr) .
  eq skyCl4Iface     = mkIrcByteSeqIface(skyCl4IfaceAddr, skyCl4IrcAddr, skyCl4CmacAddr) .
  eq skyCl4UmacAct   = mkUMactor(skyCl4UmacAddr, skyhook-client-scenario-1-ma, skyCl4CmacAddr) .
  eq skyCl4CmacAct   = mkCMSimpleBi(skyCl4CmacAddr, skyCl4IfaceAddr, skyCl4PuaAddr) .
  eq skyCl4PuaAct    = makeSkyhookPU(skyCl4PuaAddr, skyCl4CmacAddr, skyCl4SdkacAddr, "s_to_c_bucket_4", "c_to_s_bucket_4", "s_to_c_uuid_4", "c_to_s_uuid_4-hash") .
  eq skyCl4SdkacAct  = makeS3Client(skyCl4SdkacAddr, s3SrvAddr) .
  eq skyCl4SrvIface  = mkIrcByteSeqIface(skyCl4SrvIfaceAddr, ircServerAddr, skyCl4CmasAddr) .
  eq skyCl4UmasAct   = mkUMactor(skyCl4UmasAddr, skyhook-server-scenario-1-ma, skyCl4CmasAddr) .
  eq skyCl4CmasAct   = mkCMSimpleBi(skyCl4CmasAddr, skyCl4SrvIfaceAddr, skyCl4AhaAddr) .
  eq skyCl4AhaAct    = mkSkyhookAH(skyCl4AhaAddr, skyCl4CmasAddr, skyCl4SdkasAddr, "c_to_s_bucket_4", "s_to_c_bucket_4", "c_to_s_uuid_4", "s_to_c_uuid_4", "s_to_c_uuid_4", 6) .
  eq skyCl4SdkasAct  = makeS3Client(skyCl4SdkasAddr, s3SrvAddr) .
  eq skyCl4ClNet     = makeNetClient(skyCl4ClNetAddr,
                                       s3SrvAddr,
                                       skyCl4SdkacAddr,
                                       false,
                                       corpSkyDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq skyCl4NetSrv    = makeNetServer(skyCl4NetSrvAddr, s3SrvAddr) .
  eq skyCl4SrvNetCl  = makeNetClient(skyCl4SrvNetClAddr,
                                       s3SrvAddr,
                                       skyCl4SdkasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Base Infrastructure
  ops ircServer s3SrvAct advActor : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq s3SrvAct       = 
    < s3SrvAddr : AwsS3HttpServer |
        thisAddr: s3SrvAddr,
        s3DataMap: (
          ("/tgen/list-1" -> restToByteSeq("obj1.zip;obj2.zip;data/")) ;
          ("/tgen/stat-1" -> restToByteSeq("obj1.zip:1024:2025-01-01")) ;
          ("/tgen/cd-1" -> restToByteSeq("subdir1/;subdir2/")) ;
          ("/tgen/retr-1" -> restToByteSeq("mock_file_content_bytes"))
        )
    >
  .
  eq advActor       = mkAdversaryCp3(advAddr) .

  --- DNS Infrastructure
  ops corpSkyDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpSkyNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpSkyDns   = mkNameServer(corpSkyDnsAddr, (zoneSkyCom), corpSkyNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpSkyNetCl = mkFwdDnsNetC(corpSkyNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr, 
                                 corpSkyDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =
    rCtr(j + 154)

    --- Core Infrastructure
    ircServer s3SrvAct
    servDns servNetCl
    advActor

    --- Skyhook Client 3
    skyCl3Irc skyCl3Um skyCl3Iface skyCl3UmacAct skyCl3CmacAct skyCl3PuaAct skyCl3SdkacAct
    skyCl3SrvIface skyCl3UmasAct skyCl3CmasAct skyCl3AhaAct skyCl3SdkasAct
    skyCl3ClNet skyCl3NetSrv skyCl3SrvNetCl
    --- Skyhook Client 4
    skyCl4Irc skyCl4Um skyCl4Iface skyCl4UmacAct skyCl4CmacAct skyCl4PuaAct skyCl4SdkacAct
    skyCl4SrvIface skyCl4UmasAct skyCl4CmasAct skyCl4AhaAct skyCl4SdkasAct
    skyCl4ClNet skyCl4NetSrv skyCl4SrvNetCl
    corpSkyDns corpSkyNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- Startup Timers

    [hcsDelay + genRandomX(j + 0, 0.0, 0.0001), (to skyCl3AhaAddr from skyCl3AhaAddr : SkyhookStartCmd), 0]
    [hcsDelay + genRandomX(j + 1, 0.0, 0.0001), (to skyCl4AhaAddr from skyCl4AhaAddr : SkyhookStartCmd), 0]

    [hcsDelay + 1.0 + genRandomX(j + 4, 0.0, 0.0001), (to skyCl3UmacAddr from skyCl3UmacAddr : actionR("ok")), 0]
    [hcsDelay + 1.0 + genRandomX(j + 5, 0.0, 0.0001), (to skyCl3UmasAddr from skyCl3UmasAddr : actionR("ok")), 0]
    [hcsDelay + 1.0 + genRandomX(j + 6, 0.0, 0.0001), (to skyCl4UmacAddr from skyCl4UmacAddr : actionR("ok")), 0]
    [hcsDelay + 1.0 + genRandomX(j + 7, 0.0, 0.0001), (to skyCl4UmasAddr from skyCl4UmasAddr : actionR("ok")), 0]

    --- IRC User Model Burst Delay Timers (staggered)
    [hcsDelay + 10.0 + genRandomX(j + 16, 0.0, 0.0001), (to skyCl3UmAddr from skyCl3UmAddr : burstDelayTO), 0]
    [hcsDelay + 10.0 + genRandomX(j + 17, 0.0, 0.0001), (to skyCl4UmAddr from skyCl4UmAddr : burstDelayTO), 0]
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 1000.0 .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = skyCl3IrcAddr ; skyCl4IrcAddr .
endm
set print attribute on .
rew initConfig .
q