sload ../../../../maude_hcs/lib/network/net-dns_prob.maude
sload ../../../../maude_hcs/lib/common/maude/structured-addresses.maude
--- HCS IRC User Models (v2)
sload irc_user_models/irc_10.maude
sload irc_user_models/irc_3.maude

--- For SMC
sload ../../../../maude_hcs/lib/common/maude/visibility

--- Address mapping
sload scenario1_addresses

mod HCS_TEST is
  pr SCHEDULER .
  pr USER-ACTION-ACTOR .
  inc SKYHOOK-CLIENT-SCENARIO-1-MAMODEL .
  inc SKYHOOK-SERVER-SCENARIO-1-MAMODEL .
  pr IRC-V2 .
  pr IRC-USER-ACTION-ACTOR-V2 .
  pr IRC-BYTESEQ-INTERFACE .
  pr CONTENT-MANAGER-SIMPLE-BI .
  --- inc ENC-DEC .
  pr SKYHOOK .
  pr S3_PROTOCOL .
  pr IRC_MONITOR .
  pr APP_CHATS .
  pr IRC_NODE .
  pr IRC_NAMES .
  pr IODINE_NODE .
  pr IODINE_DNS .
  pr TCP_SOCKET .
  pr NET-DNS .
  pr NETWORK_NODE .
  pr NETWORK_CONNECTION .
  inc STRUCTURED-ADDRESSES .
  inc VISIBILITY .
  inc SCENARIO1-ADDRESSES .

  --- HCS IRC Profile Modules
  inc IRC-IRC-3-MAMODEL-V2 .
  inc IRC-IRC-10-MAMODEL-V2 .

  vars j : Nat .

  ---------------------------------------------------
  --- Global Constants
  ---------------------------------------------------
  eq encOH(fsize:Nat,ksize:Nat) = 0 .
  eq noiseMin(msg:Msg)          = 0.00001 .
  eq noiseMax(msg:Msg)          = 0.001 .
  eq maxMinimiseCount           = 0 .
  --- how much to delay the HCS and TGENs
  ops hcsDelay tgenDelay : -> Float .
  eq hcsDelay  = 0. [owise] .
  eq tgenDelay = 30.0 [owise] .

  --- User Model Database (MAModelMap)
  eq MAModelMap =
    ("irc-irc-3" |-> irc-irc-3-ma-v2,
     "irc-irc-10" |-> irc-irc-10-ma-v2)
  .

  op ed-images : -> ByteSeqL .
  eq ed-images =
       image(1, 3779, 500)
    :: image(2, 2405, 1000)
    :: image(3, 36861, 1000)
    :: image(4, 25377, 500)
    :: image(5, 2440, 300)
    :: image(6, 1275, 300)
    :: image(7, 7710, 1000)
    :: image(8, 3577, 500)
    :: image(9, 3415, 300)
    :: image(10, 74123, 600)
  .

  ---------------------------------------------------
