// Confidentiality 
//////////////////

// getCUSUM (adversary, vantage_point, feature, Tstart, Tend, window_size (seconds), bin_size (seconds), baselineCDF, K) 
// getBaselineCDF(baseline, vantage_point, feature, baseline Tstart, baseline Tend, bin_size) 
// getBaselineK(baseline, vantage_point, feature, baseline Tstart, baseline Tend, window_size, bin_size) 

// Cumulative t0_15 : Tstart = 0.0, Tend = 900.0, offset by hcsDelay 
// Cumulative t0_30 : Tstart = 0.0, Tend = 1800.0, offset by hcsDelay  

// feature : dnsQueryRate dnsQuerySize dnsRespSize tcpUpRate tcpDownRate tcpUpToDownRate tcpOutPktRate tcpInPktRate tcpOutToInPktRate tcpPktSizeStdDev tcpPktSize tcpPktInterarrival tcpDirectionChange tcpActiveFlow tcpNewCnx  

CumulativeCUSUMTcpOutPktRate() = s.rval("getCUSUM (getAdversary(C), ixpN, tcpOutPktRate, 100.0, 300.0, 60.0, 10.0, 
                                     getBaselineCDF(getBaseline(C), ixpN, tcpOutPktRate, 0.0, 100.0, 10.0), 
                                       getBaselineK(getBaseline(C), ixpN, tcpOutPktRate, 0.0, 100.0, 60.0, 10.0))");

// srvN masN minN dnsN ixpN cl[i] in visibilityMap

CumulativeCUSUMTcpOutPktRateSrvN() = s.rval("getCUSUM (getAdversary(C), srvN, tcpOutPktRate, 100.0, 300.0, 60.0, 10.0, 
                                         getBaselineCDF(getBaseline(C), srvN, tcpOutPktRate, 0.0, 100.0, 10.0), 
                                           getBaselineK(getBaseline(C), srvN, tcpOutPktRate, 0.0, 100.0, 60.0, 10.0))");

// Independent t0_15 : Tstart = 0.0, Tend = 900.0, offset by hcsDelay 
// Independent t15_30 : Tstart = 900.0, Tend = 1800.0, offset by hcsDelay 

IndependentCUSUMTcpOutPktRate() = s.rval("getCUSUM (getAdversary(C), ixpN, tcpOutPktRate, 100.0, 300.0, 60.0, 10.0, 
                                     getBaselineCDF(getBaseline(C), ixpN, tcpOutPktRate, 0.0, 100.0, 10.0), 
                                       getBaselineK(getBaseline(C), ixpN, tcpOutPktRate, 0.0, 100.0, 60.0, 10.0))");

