sload ../irc/ircMonitor.maude
sload ../irc/common/_aux.maude

view TimesObsList from TRIV to ADVERSARY-CP3-DATA is
  sort Elt to TimesObsList .
endv

mod TEST-UTILS is

  inc IRC_MONITOR .
  inc IRC_NODE .
  inc VISIBILITY .
  inc STRUCTURED-ADDRESSES .
  inc ADVERSARY-CP3 .
  inc LIST{TimesObsList} .
  inc LIST{Bool} .

  op all-msgs-received _ : Config -> Bool .
  op non-zero-msgs-received _ : Config -> Bool .
  op len-msg-timestamp-list _ : MessageTimestampList -> Nat .

  vars attrs : AttributeSet .
  vars C : Config .
  var M : MessageTimestamp .
  vars MTL0 MTL1 : MessageTimestampList .
  vars sum : Nat .

  eq len-msg-timestamp-list nilMessageTimestampList = 0 .
  eq len-msg-timestamp-list (M ; MTL0) = 1 + len-msg-timestamp-list MTL0 .

  ****            List of messages     CurrentCount
  op $sumBytes  : MessageTimestampList Nat -> Nat .
  eq $sumBytes((messageTimestamp(T:Float, SRC:Address, DST:Address, SIZE:Nat, NAME:IrcName, ID:Nat)
                  ; MTL0),
                sum) = $sumBytes(MTL0, sum + SIZE:Nat) .
  eq $sumBytes(nilMessageTimestampList, sum) = sum .

  **** Function that combines summing the packet sizes and filtering by source.
  **** (logically it would make sense to keep them separate but it would incur
  **** more passes through the data).
  ****                List of messages      FromAddr  CurrentCount
  op $sumBytesFrom :  MessageTimestampList  Address   Nat -> Nat .
  eq $sumBytesFrom((messageTimestamp(T:Float, SRC:Address, DST:Address, SIZE:Nat, NAME:IrcName, ID:Nat)
                      ; MTL0),
                    SRC:Address,
                    sum) = $sumBytesFrom(MTL0, SRC:Address, SIZE:Nat + sum)
  .
  eq $sumBytesFrom((M ; MTL0), SRC:Address, sum)
    = $sumBytesFrom(MTL0, SRC:Address, sum) [owise]
  .
  eq $sumBytesFrom(nilMessageTimestampList, SRC:Address, sum) = sum .

  **** Function that combines summing the packet sizes and filtering by dest.
  **** (logically it would make sense to keep them separate but it would incur
  **** more passes through the data).
  ****              List of messages      ToAddr  CurrentCount
  op $sumBytesTo  : MessageTimestampList  Address Nat -> Nat .
  eq $sumBytesTo((messageTimestamp(T:Float, SRC:Address, DST:Address, SIZE:Nat, NAME:IrcName, ID:Nat)
                      ; MTL0),
                    DST:Address,
                    sum) = $sumBytesTo(MTL0, DST:Address, SIZE:Nat + sum)
  .
  eq $sumBytesTo((M ; MTL0), DST:Address, sum)
    = $sumBytesTo(MTL0, DST:Address, sum) [owise]
  .
  eq $sumBytesTo(nilMessageTimestampList, DST:Address, sum) = sum .

  eq all-msgs-received (
    < addr:Address : IrcMonitor |
        msgSent: MTL0,
        msgRcvd: MTL1 >
    C
  ) = (len-msg-timestamp-list MTL0 == len-msg-timestamp-list MTL1) .

  eq non-zero-msgs-received (
    < addr:Address : IrcMonitor |
        msgSent: MTL0,
        msgRcvd: MTL1 >
    C
  ) = (len-msg-timestamp-list MTL0 > 0) .

  --- Get the total number of bytes sent.
  --- TODO: This currently includes messages repeated by the Server.  A test 
  --- will need to filter these out.
  ---                     ExperimentConfig
  op getTotalBytesSent :  Config -> Nat .
  eq getTotalBytesSent (
    < ircCl1:Address : IrcClient | attrs1:AttributeSet >
    < ircCl2:Address : IrcClient | attrs2:AttributeSet >
    < addr:Address : IrcMonitor | attrs, msgSent: MTL0 >
    C)
    =  $sumBytesFrom(MTL0, ircCl1:Address, 0)
        + $sumBytesFrom(MTL0, ircCl2:Address, 0)
  .
  eq getTotalBytesSent (
    < addr:Address : IrcMonitor | attrs, msgSent: MTL0 > C) = $sumBytes(MTL0, 0)
    [owise]
  .

  op getTotalBytesRcvd : Config -> Nat .
  eq getTotalBytesRcvd(
    < ircCl1:Address : IrcClient | attrs1:AttributeSet >
    < ircCl2:Address : IrcClient | attrs2:AttributeSet >
    < addr:Address : IrcMonitor | attrs, msgRcvd: MTL0 >
    C)
    =  $sumBytesTo(MTL0, ircCl1:Address, 0)
        + $sumBytesTo(MTL0, ircCl2:Address, 0)
  .
  eq getTotalBytesRcvd(
    < addr:Address : IrcMonitor | attrs, msgRcvd: MTL0 > C) = $sumBytes(MTL0, 0)
    [owise]
  .

  vars TOL0 TOL1 : TimesObsList .
  var TO : TimesObs .
  var B : Bool .
  var NID : NetId .
  var ADDR : Address .
  var S : String .
  var N : Nat .

  op filter-visible : NetId TimesObsList -> TimesObsList .
  op filter-visible-all : NetId TimesObsList -> TimesObsList .
  op filter-visible-in : NetId TimesObsList -> TimesObsList .
  op filter-visible-out : NetId TimesObsList -> TimesObsList .

  eq filter-visible(NID, nilTO) = nilTO .
  eq filter-visible(NID, (TO ;; TOL0)) =
    if visible(NID, TO, 0.0, 100000.0, outgoing)
    then TO ;; filter-visible(NID, TOL0)
    else filter-visible(NID, TOL0)
    fi .

  op obs-printer : Nat String TimesObsList -> Bool .
  --- eq obs-printer(N, S, TOL0) = true [print "\n" N " PACKETS AT " S ":    " TOL0 "\n"] .
  eq obs-printer(N, S, TOL0) = true [print "\n" N " PACKETS AT " S "\n"] .

  op print-visible-pkts : Config -> List{Bool} .
  op print-visible-pkts-aux : TimesObsList String -> Bool .

  eq print-visible-pkts (
    < ADDR : Adversary | dns: TOL0, tcp: TOL1, useTcpTPL: B > C
  ) =
    --- print-visible-pkts-aux(filter-visible(ixpN, TOL1), "ixpN")
    --- print-visible-pkts-aux(filter-visible(ixpN, TOL1), "ixpNasg")
    print-visible-pkts-aux(filter-visible(srvN, TOL1), "srvN") 
    --- print-visible-pkts-aux(filter-visible(dnsN, TOL1), "dnsN") 
    print-visible-pkts-aux(filter-visible(cl[1], TOL1), "cl[1]") 
    --- print-visible-pkts-aux(filter-visible(cl[2], TOL1), "cl[2]") 
    --- print-visible-pkts-aux(filter-visible(cl[3], TOL1), "cl[3]") 
  .

  eq print-visible-pkts-aux(TOL0, S) = obs-printer(len(TOL0), S, TOL0) .

endm

mod TEST-UTILS_TEST is
  inc TEST-UTILS .

  ops SRC-ADDR DST-ADDR : -> Address .
endm

eof

rew getTotalBytesSent(< MON:Address : IrcMonitor |
                          msgSent: (messageTimestamp(1.0, SRC-ADDR, DST-ADDR, 90, makeIrcChannelName("BBN"), 44354)
                                    ; messageTimestamp(2.0, SRC-ADDR, DST-ADDR, 10, makeIrcChannelName("BBN"), 44355))
                      >) 
 == 100
.
rew $sumBytesFrom(messageTimestamp(1.0, SRC-ADDR, DST-ADDR, 90, makeIrcChannelName("BBN"), 44354)
                                      ; messageTimestamp(2.0, DST-ADDR, DST-ADDR, 10, makeIrcChannelName("BBN"), 44355)
                                      ; messageTimestamp(2.0, SRC-ADDR, DST-ADDR, 110, makeIrcChannelName("BBN"), 44356),
                  SRC-ADDR, 0) .

rew getTotalBytesSent(< SRC-ADDR : IrcClient | attrs1:AttributeSet >
                      < DST-ADDR : IrcClient | attrs2:AttributeSet >
                      < MON:Address : IrcMonitor |
                             msgSent: (messageTimestamp(1.0, SRC-ADDR, DST-ADDR, 90, makeIrcChannelName("BBN"), 44354)
                                      ; messageTimestamp(2.0, SERVER:Address, DST-ADDR, 10, makeIrcChannelName("BBN"), 44355)
                                      ; messageTimestamp(2.0, SRC-ADDR, DST-ADDR, 110, makeIrcChannelName("BBN"), 44356))
                      >)
  == 200
.
