sload structured-addresses 
sload adversary-cp3

***(
  op ept : -> AddrSet [ctor] .
  op _;;_ : AddrSet AddrSet -> AddrSet [ctor comm assoc id: ept] .
  )

view NetId from TRIV to STRUCTURED-ADDRESSES is
  sort Elt to NetId .
endv  
  
view AddrSet from TRIV to ADDRESS is
  sort Elt to AddrSet .
 endv  
  
mod VISIBILITY is
  inc ADVERSARY-CP3-DATA .
  inc STRUCTURED-ADDRESSES .
  inc MAP{NetId,AddrSet} .

vars vp nid : NetId .
vars tobs : TimesObs .
vars tmin tmax  obst : FloatInf .
vars dir : Dir .
vars j : Nat .
vars nidAddrsM : Map{NetId,AddrSet} .
vars addrs : AddrSet .
vars addr : Address .

**** to be defined in each scenario file
op visibilityMap : -> Map{NetId,AddrSet} . 

op hasAddr : AddrSet Address -> Bool .
eq hasAddr(addrs ;; addr,addr) = true .
eq hasAddr(addrs,addr) = false [owise] .

op vpSees : Map{NetId,AddrSet} NetId Address -> Bool .
ceq vpSees(nidAddrsM,vp,addr) = hasAddr(addrs,addr)
if addrs := (if $hasMapping(nidAddrsM, vp) 
             then nidAddrsM[vp]
             else ept
             fi)
.

***(
A vantage point is a network identifier, one of
   cl[j] srvN masN minN dnsN ixpN
)

sort Dir .
ops incoming outgoing : -> Dir [ctor] .

**** test if tmsg is visible at given vantage point 
**** in a given time interval with a given direction.

op visible : Map{NetId,AddrSet} NetId TimesObs 
             Float Float Dir -> Bool .
op visible : NetId TimesObs Float Float Dir -> Bool .
op visTime : Map{NetId,AddrSet} NetId TimesObs 
             Float Float Dir -> Bool .
op visNet : Map{NetId,AddrSet} NetId TimesObs Dir -> Bool .

**** nidAddrsM
eq visible(vp,tobs,tmin,tmax,dir) =
 visible(visibilityMap,vp,tobs,tmin,tmax,dir) .

eq visible(nidAddrsM,vp,tobs,tmin,tmax,dir)
     = false [owise] .
eq visible(nidAddrsM,vp,tobs,tmin,tmax,dir) =
    visNet(nidAddrsM,vp,tobs,dir) and visTime(nidAddrsM,vp,tobs,tmin,tmax,dir) .
    
eq visNet(nidAddrsM,ixpN,tobs,dir)  = true .
ceq visNet(nidAddrsM,vp,tobs,dir)  = 
          vpSees(nidAddrsM,vp,addr)
if addr := (if dir == incoming
          then getReceiver(tobs)
          else getSender(tobs)
          fi)  [owise] 
    .

ceq visTime(nidAddrsM,vp,tobs,tmin,tmax,dir) = 
      (tmin <= obst) and (obst <= tmax)
if obst := (if vp == ixpN
            then getIXPTime(tobs)
            else (if dir == incoming
                  then getRecvTime(tobs)
                  else getSendTime(tobs)
                  fi) fi)
  .                       

endm


