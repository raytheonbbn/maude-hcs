eq visibilityMap = 
  (dnsN |-> pDnsAd),
  (cl[1] |-> cDns1Ad ;; cl1CAd),
  (srvN |-> cDnsSrvAd) ,
  (masN |-> masSAd) .

op body : -> Content .
ops tM0 tM1 tM2 : -> TimesMsg .
ops tP0 tP1 tP2 tP3 : -> TimesPkt .

**** vis ixpN i/o  dnsN i, srvN o
eq tM0 = ***** t0 dnsN from srvN
tm(1.16e-3, 6.24e-3, 6.47e-3, 
    to pDnsAd from cDnsSrvAd : body) .

