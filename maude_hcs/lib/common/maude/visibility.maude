red visible(masN,tP0,2.e-2,8.e-2,outgoing) .    --- f
red visible(cl[1],tP0,1.e-3,8.e-2,outgoing) .    --- t
red visible(cl[1],tP0,2.e-2,8.e-2,outgoing) .    --- f

)

**** vis srvN i minN o
**** to masN from cl[1]
eq tP1 = 
tp(4.13e-2, 5.634e-2, 7.134e-2, pkt(cl1CAd,masSAd, false, 0, 200)) .
***(
red visible(cl[1],tP1,2.e-2,8.e-2,incoming) .   --- t
red visible(cl[1],tP1,2.e-2,8.e-2,outgoing) .   --- f
red visible(masN,tP1,2.e-2,8.e-2,outgoing) .   --- t
red visible(masN,tP1,1.e-3,8.e-2,incoming) .   --- f

red visible(dnsN,tP1,1.e-3,8.e-2,incoming) .   --- f
red visible(cl[2],tP1,1.e-3,8.e-2,incoming) .   --- f
)


endm
