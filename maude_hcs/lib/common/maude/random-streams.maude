--- Counter-based Philox4x32-10. Requires Philox-enabled Maude executables or bindings.
--- A run seed is supplied once with -random-seed (or setRandomSeed in bindings).
--- Stream 0: explicit application cursor; 1: implicit network/timer cursor;
--- Stream 3: explicit link jitter using allocated rCtr indices.
--- 2^32 + actor ordinal: packet sizes; 2^33 + identifier token: string chars.
--- Re-evaluation/order cannot advance or rewind another consumer's RNG.
fmod RANDOM-STREAMS is
  protecting RANDOM .
  op streamRandom : Nat Nat -> Nat
    [special (id-hook RandomOpSymbol
              op-hook succSymbol (s_ : Nat ~> NzNat))] .
  op workloadRandom : Nat -> Nat .
  var I : Nat .
  eq workloadRandom(I) = streamRandom(0, I) .
  --- Modeling choice: remove extra constant-delay local conversion noise.
  --- Set false to retain that noise; counter streams do not require trimming.
  op trimAdapterJitter : -> Bool .
  eq trimAdapterJitter = true [owise] .
endfm
