**** translation of SAMPLER to use explicit random indices

sload mgDistributions-w-beta

fmod SAMPLER-X is
  inc MGDISTRIBUTIONS-WITH-BETA .
***  pr RANDOM .
***  pr CONVERSION .
  inc MAP{String,Float} .
  

  vars MEAN SD RAND R Min Max  A B : Float .  
  var j n  j1 seed strLen : Nat .
  var weights : Map{String,Float} .
  vars wt wtsum rnd scale : Float .
  vars sid : String .
  
  op randX : Nat -> [Float] .
  eq randX(j) = float(random(j) / 4294967296) .

  op sampleBerWithPX :  Nat Float -> [Bool] .
  eq sampleBerWithPX(j,R) = if randX(j) < R then true else false fi .

  op sampleUniformX : Nat Float Float -> [Float] .
  eq sampleUniformX(j,Min, Max) = 
   (if (Min == Max) 
    then Min 
    else Min +  (float(random(j) / 4294967296) * (Max - Min))
    fi) .
  
  --- Acklam's rational approximation to the standard normal quantile.
  --- Defined for probabilities strictly between 0 and 1.
  **** https://github.com/lballabio/QuantLib/blob/master/ql/math/distributions/normaldistribution.hpp
  op inverseNormalCDF : Float -> [Float] .
  op $inverseNormalCentral : Float Float -> Float .
  op $inverseNormalTail : Float -> Float .

  ceq inverseNormalCDF(RAND) = $inverseNormalTail(sqrt(- 2.0 * log(RAND)))
    if 0.0 < RAND and RAND < 0.02425
  .
  ceq inverseNormalCDF(RAND) =
      $inverseNormalCentral(RAND - 0.5, (RAND - 0.5) * (RAND - 0.5))
    if 0.02425 <= RAND and RAND <= 0.97575
  .
  ceq inverseNormalCDF(RAND) = - $inverseNormalTail(sqrt(- 2.0 * log(1.0 - RAND)))
    if 0.97575 < RAND and RAND < 1.0
  .

  --- Q is the centered probability; R is its square.
  eq $inverseNormalCentral(Q:Float, R) =
    (((((- 3.969683028665376e+1 * R + 2.209460984245205e+2)
        * R - 2.759285104469687e+2)
        * R + 1.383577518672690e+2)
        * R - 3.066479806614716e+1)
        * R + 2.506628277459239) * Q:Float
    / (((((- 5.447609879822406e+1 * R + 1.615858368580409e+2)
        * R - 1.556989798598866e+2)
        * R + 6.680131188771972e+1)
        * R - 1.328068155288572e+1) * R + 1.0) .

  --- Q is sqrt(-2 log(p)) for the lower tail; use symmetry above 0.5.
  eq $inverseNormalTail(Q:Float) =
    (((((- 7.784894002430293e-3 * Q:Float - 3.223964580411365e-1)
        * Q:Float - 2.400758277161838)
        * Q:Float - 2.549732539343734)
        * Q:Float + 4.374664141464968)
        * Q:Float + 2.938163982698783)
    / ((((7.784695709041462e-3 * Q:Float + 3.224671290700398e-1)
        * Q:Float + 2.445134137142996)
        * Q:Float + 3.754408661907416) * Q:Float + 1.0) .

  op sampleNormalX : Nat -> [Float] .
  op $sampleNormalX : Float -> [Float] .
  --- One random draw, mapped to (0,1) to keep both tail endpoints finite.
  eq sampleNormalX(j) =
      $sampleNormalX((float(random(j)) + 0.5) / 4294967296.0) .
  eq $sampleNormalX(RAND) = inverseNormalCDF(RAND) .
  --- Get a sample from a Normal distribution using Box-Muller.
  --- Note: This code contains a defect: RAND should not be reused twice.
  op $sampleNormalXBM : Float -> [Float] .
  eq $sampleNormalXBM(RAND) = 
    sqrt(- 2.0 * log(RAND)) * cos(2.0 * pi * RAND) .

  op sampleNormalWithMeanSdX : Float Float Nat -> [Float] .
  eq sampleNormalWithMeanSdX(MEAN, SD, j) 
    = MEAN + (SD * sampleNormalX(j)) .

  --- Get a random nat between in [0, n-1].
  op sampleUniWithIntX : Nat Nat -> [Nat] .
  eq sampleUniWithIntX(j, n) = random(j) rem n .

  op genRandomX : Nat Float Float -> [Float] .
  eq genRandomX(j,Min, Max) = 
       float(random(j) / 4294967296) * (Max - Min) + Min .

  op genRandomX : Nat -> [Nat] .
  eq genRandomX(j) = random(j) .
 
  sort StringNat .
  op `{_`,_`} : String Nat -> StringNat [ctor] .
  --- Generate a Random
  ---               Seed  Length
  op genRandomString : Nat   Nat -> StringNat .
  ---                 Seed  Length  CurrentStr
  op $randomString :  Nat   Nat     String -> String .

  --- Base case: length reached
****  eq randomString(seed, strLen) = $randomString(seed, strLen, "") .
  ceq genRandomString(seed, strLen) =
    {rndStr:String, newSeed:Nat}
    if rndStr:String := $randomString(seed, strLen, "")
      /\ newSeed:Nat := seed + length(rndStr:String)
  .
  
  --- Recursive step: 
  --- 1. Get a random number from the current seed
  --- 2. Map it to a lowercase char (97-122)
  --- 3. Use the new random number as the next seed
  ceq $randomString(seed, s(strLen), currentStr:String) = 
    $randomString(randm:Nat,
                  strLen,
                  currentStr:String + char(97 + (randm:Nat rem 26)))
    if randm:Nat := sampleUniWithIntX(seed, seed + 26)
    .

  eq $randomString(seed, 0, currentStr:String) = currentStr:String .

 **** probabalistic version
 op chooseWt : Map{String,Float}  Nat -> String .
 op chooseWtX : Map{String,Float} Float Float
               -> String .

 eq chooseWt(weights,j) =
  chooseWtX(weights, float(random(j) / 4294967296), 0.0) .
 
 eq chooseWtX((weights, sid |-> wt), rnd, wtsum)
     =
  (if (wtsum < rnd) and (rnd <= wtsum + wt)
   then sid
   else chooseWtX(weights,rnd,wtsum + wt)
   fi)
  .

 **** shouldn't happen
eq chooseWtX(weights, rnd,wtsum) = "idle" [owise] .
 

 
endfm
