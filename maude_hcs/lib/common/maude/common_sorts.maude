sload ../../../deps/dns_formalization/Maude/common/parameters.maude

mod COMMON_SORTS is
  pr NAT .
  pr INT .
  pr FLOAT .
  pr CONVERSION .
  pr PARAMETERS-BASE-COMMON .
  --- ============================================================
  ---  FloatList
  --- ============================================================
  sorts NatList FloatList .
  subsort Nat < NatList .
  op nilNatList : -> NatList [ctor] .
  op _::_ : NatList NatList -> NatList [ctor assoc id: nilNatList] .
  op nilFloatList : -> FloatList [ctor] .
  subsort Float < FloatList .
  op _::_ : FloatList FloatList -> FloatList [ctor assoc id: nilFloatList] .

  vars F G : Float .
  vars L L1 L2 : FloatList .

  op lenFL : FloatList -> Nat .
  eq lenFL(nilFloatList) = 0 .
  eq lenFL(F :: L) = s(lenFL(L)) .

  op maxFL : FloatList -> Float .
  eq maxFL(nilFloatList) = 0.0 .
  eq maxFL(F :: L) = max(F, maxFL(L)) .

  op _++_ : FloatList FloatList -> FloatList .
  eq nilFloatList ++ L = L .
  eq (F :: L1) ++ L2 = F :: (L1 ++ L2) .

  sorts MsgQueue .
  subsort Msg < MsgQueue .
  op emptyMsgQueue : -> MsgQueue [ctor] .
  op _::_ : MsgQueue MsgQueue -> MsgQueue  [ctor assoc id: emptyMsgQueue] .

  op queuedMsgs:_ : MsgQueue -> Attribute [ctor] .

  sort AttrsAttrsMsgsNat .
  op `{_`,_`,_`,_`} : AttributeSet AttributeSet Config Nat -> AttrsAttrsMsgsNat [ctor] .
endm

