***(

Different actors (developed by different team
members) need to agree on some data structures. One
example is data structures for files, fragments,
text, images, keys ... . I propose thinking of all
of these as byte sequences, sort ByteSeq.

We need to compute the size of a byte sequence 
from basic byte sequence contructions and the
results of transformation  by operations
such as encryption, hashing, encoding in an image ...

We could define subsorts File, Image .... but I
don't think it helps. If needed we can define
isFile, isImage, isText, isKey... rather than having
separate subsorts.

The module BYTESEQ defines constructors for the
various kinds of byte sequence and equations to
extract information. I think the only thing Mastadon
should care about is that it gets requests
with parameters of sort ByteSeq  and the size
computed by the function getSize.

In addition to the file/image related data structures
we need to agree on content exchanged in messages
i.e. content received and sent by each actor type.
TBD

)

sload ../../../deps/dns_formalization/Maude/common/actor

fmod GENERAL_BYTESEQ is    
  inc CONVERSION .
  inc ACTOR-MODEL .
  
  sorts ByteSeq ByteSeqL ByteSeqChunk TwoByteSeqL .
  subsorts ByteSeq < Content .
  subsort ByteSeq < ByteSeqL .
  subsort ByteSeqChunk < ByteSeq .
  op nilBS : ->   ByteSeqL [ctor] .
  op emptyFileList : -> ByteSeqL [ctor] .
  op _::_ : ByteSeqL ByteSeqL -> ByteSeqL [ctor assoc id: nilBS] .
  op `{_`,_`} : ByteSeqL ByteSeqL -> TwoByteSeqL [ctor] .

  op noBytes : -> ByteSeq [ctor] .

  ops getFirst getSecond : TwoByteSeqL -> ByteSeqL .
  eq getFirst({first:ByteSeqL, second:ByteSeqL}) = first:ByteSeqL .
  eq getSecond({first:ByteSeqL, second:ByteSeqL}) = second:ByteSeqL .

  --- Make a ByteSeqList into a ByteSeq.
  op pack : ByteSeqL -> ByteSeq [ctor] .
  eq pack(pack(data:ByteSeqL)) = pack(data:ByteSeqL) .
  eq pack(dataL:ByteSeq :: pack(data:ByteSeqL) :: dataR:ByteSeq)
    = pack(dataL:ByteSeq :: data:ByteSeqL :: dataR:ByteSeq)
  .
  eq pack(data:ByteSeq) = data:ByteSeq .
  eq pack(nilBS) = noBytes .
  op unpack : ByteSeq -> ByteSeqL [ctor] .
  eq unpack(pack(data:ByteSeqL)) = data:ByteSeqL .
  eq unpack(data:ByteSeq) = data:ByteSeq [owise] .
  eq unpack(noBytes) = nilBS .

  --- Unpack a ByteSeq that may have been packed directly to messages.
  ---               Data    To      From
  op unpackToMsgs : ByteSeq Address Address -> Config .
  --- Keep this first, otherwise other eqs will match on empty byteSeqs.
  eq unpackToMsgs(noBytes, to:Address, from:Address) = null .
  eq unpackToMsgs(pack(data:ByteSeqL),
                  to:Address,
                  from:Address)
    = unpackToMsgs(data:ByteSeqL, to:Address, from:Address)
  .
  eq unpackToMsgs(data:ByteSeq, to:Address, from:Address)
    = (to to:Address from from:Address : data:ByteSeq)
  .

  --- Unpack a ByteSeq list directly to messages.
  ---               Data      To      From
  op unpackToMsgs : ByteSeqL  Address Address -> Config .
  --- Keep this first, otherwise other eqs will match on empty byteSeqs.
  eq unpackToMsgs(nilBS, to:Address, from:Address) = null .
  eq unpackToMsgs((first:ByteSeq :: rest:ByteSeqL),
                  to:Address,
                  from:Address)
    = (to to:Address from from:Address : first:ByteSeq)
      unpackToMsgs(rest:ByteSeqL, to:Address, from:Address)
  .

  op getSize : ByteSeq -> Nat .
  op getSize : ByteSeqL -> Nat .
  eq getSize(noBytes) = 0 .
  eq getSize(nilBS) = 0 .
  ceq getSize(bytes:ByteSeq :: restOfBytes:ByteSeqL)
    = getSize(bytes:ByteSeq) + getSize(restOfBytes:ByteSeqL)
    --- Because ByteSeqChunk is also a ByteSeq, it could send this into an 
    --- infinite recursion, so make sure no op for nilBS.
    if restOfBytes:ByteSeqL =/= nilBS
  .
  eq getSize(pack(bytes:ByteSeqL)) = getSize(bytes:ByteSeqL) .
  eq getSize(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat)) = size:Nat .
  op getExpectedSize : ByteSeq -> Nat .
  eq getExpectedSize(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat))
    = getSize(data:ByteSeq)
  .
  eq getExpectedSize(data:ByteSeq) = getSize(data:ByteSeq) [ owise ] .
  
  ---                   Data    Size  Index
  op makeByteSeqChunk : ByteSeq Nat   Nat -> ByteSeqChunk .
  --- Chunking a byteSeq for at least its original size is a noop.
  ceq makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat) = data:ByteSeq
    if getSize(data:ByteSeq) <= size:Nat
  .
  --- Chunking a chunk is still just a chunk.
  ceq makeByteSeqChunk(makeByteSeqChunk(data:ByteSeq, size0:Nat, index0:Nat),
                        size1:Nat,
                        index1:Nat)
    = makeByteSeqChunk(data:ByteSeq, size1:Nat, index0:Nat + index1:Nat)
    if size0:Nat > size1:Nat
  .
  eq makeByteSeqChunk(data:ByteSeq, 0, index:Nat) = noBytes .

  op getData : ByteSeq -> ByteSeq .
  eq getData(pack(data:ByteSeq)) = data:ByteSeq .
  eq getData(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat)) = data:ByteSeq .

  op getIndex : ByteSeq -> Nat .
  eq getIndex(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat)) = index:Nat .
  eq getIndex(data:ByteSeq) = 0 .

  op getHashString : ByteSeq -> String .
  eq getHashString(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat))
    = getHashString(data:ByteSeq)
      + "-" + string(size:Nat, 10)
      + "-" + string(index:Nat, 10)
  .
  eq getHashString(pack(first:ByteSeq :: data:ByteSeqL))
    = getHashString(first:ByteSeq) + ":" + getHashString(pack(data:ByteSeqL))
  .
  eq getHashString(pack(nilBS)) = "" .
  eq getHashString(noBytes) = "" .

  --- Fallback filename label for payloads without a specialized hash.
  --- Upload URL uniqueness is supplied by the Mastodon media ID.
  eq getHashString(data:ByteSeq) = "opaque" [owise] .

  --- Determine if a ByteSeq preceeds another.
  ---           Base    Test
  --- Returns true if Test comes before Base.
  op preceeds : ByteSeq ByteSeq -> Bool .
  eq preceeds(makeByteSeqChunk(data:ByteSeq, size0:Nat, index0:Nat),
              makeByteSeqChunk(data:ByteSeq, size1:Nat, index1:Nat))
    = (index1:Nat < index0:Nat)
  .
  eq preceeds(data0:ByteSeq, data1:ByteSeq) = false [owise] .

  --- Check if two ByteSeqs are the same.
  op matches : ByteSeq ByteSeq -> Bool .
  eq matches(data:ByteSeq, data:ByteSeq) = true .
  eq matches(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat),
              makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat)) = true .
  eq matches(data0:ByteSeq, data1:ByteSeq) = false [owise] .
  op matches : ByteSeqL ByteSeq -> Bool .
  eq matches((baseL:ByteSeqL :: data:ByteSeq :: baseR:ByteSeqL),
              data:ByteSeq)
    = true
  .
  eq matches(dataList:ByteSeqL, data:ByteSeq) = false [owise] .
  
  --- Insert a ByteSeq in a list of ByteSeqs, in order and without duplicates.
  ---                 Base      ToInsert
  op insertInOrder :  ByteSeqL  ByteSeq -> ByteSeqL .
  eq insertInOrder((baseL:ByteSeqL :: base:ByteSeq :: baseR:ByteSeqL),
                    base:ByteSeq)
    = (baseL:ByteSeqL :: base:ByteSeq :: baseR:ByteSeqL)
  .
  ceq insertInOrder((baseL:ByteSeqL :: base:ByteSeq :: baseR:ByteSeqL),
                    insert:ByteSeq)
    = (baseL:ByteSeqL :: insert:ByteSeq :: base:ByteSeq :: baseR:ByteSeqL)
    if preceeds(base:ByteSeq, insert:ByteSeq)
  .
  eq insertInOrder(base:ByteSeqL, insert:ByteSeq)
    = (base:ByteSeqL :: insert:ByteSeq) [owise]
  .
  --- Insert a list in a list of ByteSeqs, in order and without duplicates.
  op $insertInOrder : ByteSeqL ByteSeqL -> ByteSeqL .
  eq $insertInOrder(base:ByteSeqL, (pack(packed:ByteSeqL) :: rest:ByteSeqL))
    = $insertInOrder(base:ByteSeqL, (packed:ByteSeqL :: rest:ByteSeqL))
  .
  eq $insertInOrder(base:ByteSeqL, (first:ByteSeq :: rest:ByteSeqL))
    = $insertInOrder(insertInOrder(base:ByteSeqL, first:ByteSeq), rest:ByteSeqL)
    [owise]
  .
  eq $insertInOrder(base:ByteSeqL, nilBS) = base:ByteSeqL .

  --- Decode a list of received byteseqs. It will recombine chunks if it can.
  --- !!! This expects the list to be ordered with unique chunks !!!
  --- Pending: List of byteseqs that have been received and are currently pending.
  --- Decoded: List of byteseqs that have been decoded, removed from pendings,
  ---           and need to be passed to the application.
  --- Processed: List of byteseqs that have been processed and can go back in
  ---             the pending list for later processing.
  ---           Pending   Decoded   Processed   {ReceivedAndDecoded, Leftovers}
  op $decode :  ByteSeqL  ByteSeqL  ByteSeqL -> TwoByteSeqL .
  ceq $decode((reference:ByteSeq :: pendingRest:ByteSeqL),
                decoded:ByteSeqL,
                done:ByteSeqL)
    = (if (getExpectedSize(combinedChunk:ByteSeq) == getSize(combinedChunk:ByteSeq))
        then $decode(pendingProcessed:ByteSeqL,
                      (decoded:ByteSeqL :: combinedChunk:ByteSeq),
                      done:ByteSeqL)
        else $decode(pendingProcessed:ByteSeqL,
                      decoded:ByteSeqL,
                      (done:ByteSeqL :: combinedChunk:ByteSeq))
      fi)
    if {combinedChunk:ByteSeq, pendingProcessed:ByteSeqL} :=
      $combineChunks(reference:ByteSeq, pendingRest:ByteSeqL)
  .
  eq $decode(nilBS, decoded:ByteSeqL, done:ByteSeqL)
    = {decoded:ByteSeqL, done:ByteSeqL}
  .

  --- Combine chunks together to make a (big) byteseq.
  --- Assumes the chunks are ordered and unique.
  ---                 RefChnk Candidates
  op $combineChunks : ByteSeq ByteSeqL    -> TwoByteSeqL .
  eq $combineChunks(makeByteSeqChunk(data:ByteSeq, size0:Nat, index0:Nat),
                    (dataL:ByteSeqL
                      :: makeByteSeqChunk(data:ByteSeq, size1:Nat, s index0:Nat)
                      :: dataR:ByteSeqL))
    = $combineChunks(makeByteSeqChunk(data:ByteSeq,
                                      size0:Nat + size1:Nat,
                                      s index0:Nat),
                    dataL:ByteSeqL :: dataR:ByteSeqL)
  .
  ceq $combineChunks(reference:ByteSeqChunk, candidates:ByteSeqL)
    = {reference:ByteSeqChunk, candidates:ByteSeqL}
    if getExpectedSize(reference:ByteSeqChunk)
        == getSize(reference:ByteSeqChunk)
  .
  eq $combineChunks(reference:ByteSeqChunk, nilBS)
    = {reference:ByteSeqChunk, nilBS}
  .
  eq $combineChunks(nonChunkedData:ByteSeq, data:ByteSeqL)
    = {nonChunkedData:ByteSeq, data:ByteSeqL}
    [ owise ]
  .
  eq $combineChunks(noBytes, data:ByteSeqL) = {noBytes, data:ByteSeqL}
    [ print "ERROR: Reference chunk in combination is empty." ]
  .

  op getByteSeqFromChunk : ByteSeqChunk -> ByteSeq .
  eq getByteSeqFromChunk(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat))
    = data:ByteSeq
  .
  eq getByteSeqFromChunk(data:ByteSeqChunk) = noBytes [ owise ] .

  --- Encode the pending bytes into a ByteSeq, splitting elements that are too 
  --- big and combining the other ones.
  --- It returns the list of byteseqs that need to go out and fit in capacity,
  --- and the remaining byteseqs (even split) that did not fit.
  ---         Data      CapacityBytes 
  op encode : ByteSeqL  Nat -> TwoByteSeqL .
  ceq encode(pending:ByteSeqL, capacity:Nat) =
    (if pendingSize:Nat > capacity:Nat
      --- Not all pending will fit in capacity. Break up.
      then $encode({nilBS, pending:ByteSeqL}, capacity:Nat)
      --- Else everything fits, done.
      else {pending:ByteSeqL, nilBS}
    fi)
    if pendingSize:Nat := getSize(pending:ByteSeqL)
    [ print "Encode found size " pendingSize:Nat " cap: " capacity:Nat ]
  .

  --- Encode pending byteseqs into a current bag of byteseqs given a remaining
  --- capacity.
  --- It returns the next current list of byteseqs and what was lefover.
  ---           Current,Pending RemCapacity
  op $encode :  TwoByteSeqL     Nat -> TwoByteSeqL .
  ceq $encode({current:ByteSeqL, (firstPending:ByteSeq :: pending:ByteSeqL)},
              remainingCapacity:Nat)
    = (if firstPendingSize:Nat > remainingCapacity:Nat
        --- The first element does not all fit, chunk and stop.
        then {(current:ByteSeqL :: makeByteSeqChunk(firstPending:ByteSeq, remainingCapacity:Nat, 0)),
              (makeByteSeqChunk(firstPending:ByteSeq, firstPendingSize:Nat - remainingCapacity:Nat, 1)
                :: pending:ByteSeqL)}
        --- Else the first element fits, continue.
        else $encode({(current:ByteSeqL :: firstPending:ByteSeq), pending:ByteSeqL},
                      remainingCapacity:Nat - firstPendingSize:Nat)
      fi)
      if remainingCapacity:Nat > 0
        /\ firstPendingSize:Nat := getSize(firstPending:ByteSeq)
    [ print "$encode current: " current:ByteSeqL " remainingCap: " remainingCapacity:Nat "B." ]
  .
  eq $encode({current:ByteSeqL, nilBS}, remainingCapacity:Nat)
    = {current:ByteSeqL, nilBS}
  .
  eq $encode({current:ByteSeqL, pending:ByteSeqL}, 0)
    = {current:ByteSeqL, pending:ByteSeqL}
  .
endfm

fmod BYTESEQ is
  inc GENERAL_BYTESEQ .
vars id i j j1 k k1 l l0 n n0 n1 last last0 r d ix ix0 cap : Nat .
vars tot bpf nf : Nat .
vars d1 : Rat .
*** vars tot oh fragMx accum : Nat .
vars bytes bytes0 bs : ByteSeq .
vars file efrag efile image key ef ef0 : ByteSeq .
vars efl efl1 efl0 bsl bsl0 bsl1 bytesl : ByteSeqL .

op lenBSL : ByteSeqL -> Nat .
op lenBSLX : ByteSeqL Nat -> Nat .
eq lenBSL(bsl) = lenBSLX(bsl,0) .
eq lenBSLX(nilBS,n) = n .
eq lenBSLX(bytes :: bsl,n) = lenBSLX(bsl,s n) .


op getNthBS : ByteSeqL Nat -> ByteSeq .
eq getNthBS(bytes :: bsl, 0) = bytes .
eq getNthBS(bytes :: bsl, s n) = getNthBS(bsl, n) .

------- generating distinct benign and weird hash tags
---op wHashTag : Nat -> ByteSeq [ctor] .
---op bHashTag : Nat -> ByteSeq [ctor] .
op restToByteSeq : String -> ByteSeq [ctor] .

op hashTag : String -> ByteSeq [ctor] .

*********** text
**** index/id  size
op text : Nat Nat -> ByteSeq [ctor] .

***** files 
--- A file should at least have a size (and only a size is necessary to be
--- backward compatible with Iodine CP1).
**** op file : Nat -> ByteSeq [ctor] .

****      id  size
op file : Nat Nat -> ByteSeq [ctor] .

--- Make a file from a size and filename.
op file : Nat String -> ByteSeq [ctor] .

---       Id  Size Filename
op file : Nat Nat String -> ByteSeq [ctor] .

--- A Control Channel file.
--- From Alice to Bob.
---         Key Hash Tag
op ccFile : Nat Nat String -> ByteSeq [ctor] .
--- Same but with ByteSeqs.
op ccFile : ByteSeq ByteSeq ByteSeq -> ByteSeq [ctor] .
--- From Bob to Alice.
---          Status Hashtag
op ackFile : String ByteSeq -> ByteSeq [ctor] .


**** encrypted file 
   --- not strictly needed, but maybe compacts notation
****       id  fsize, key index, key len
op efile : Nat Nat Nat Nat -> ByteSeq [ctor] .

****  keys
****     ix  len
op key : Nat Nat -> ByteSeq [ctor] . --- key generator

**** encryption
op encrypt : ByteSeq ByteSeq -> ByteSeq .
eq encrypt(file(id,n),key(j,k)) = efile(id,n,j,k) .

op decrypt : ByteSeq ByteSeq -> ByteSeq .
eq decrypt(efile(id,n,j,k),key(j,k)) = file(id,n) .
eq decrypt(encrypt(bytes,key(j,k)), key(j,k)) = 
       bytes [owise] .
 
**** decrypt fails
eq decrypt(bytes, key(j,k)) = noBytes [owise] .
 
****       file len 
op hash : ByteSeq Nat -> ByteSeq .

op getId : ByteSeq -> Nat .
eq getId(bytes) = 0 [owise] .

eq getId(efile(id,n,j,k)) = id .
eq getId(file(id,n)) = id .
eq getId(text(id,n)) = id .
eq getId(key(id,n)) = id .

***(
getSize defined for
hashTag
hash(file:ByteSeq)
ccFile
ackFile
image
getSize equated explicitly to getSize for missing cases

getSize defined for
noBytes
key(j,k)
file(id,n)
ccFile >> getSize
text(id,n)
efile(id,n,j,k)
hash(file(id,n),k)
hash(bytes,k)
efrag(bytes,last,ix,l)
image(j,n,k)
)

**** computing len/size of ByteSeq terms
eq getSize(noBytes) = 0 .
eq getSize(key(j, k)) = k .
eq getSize(file(id, n)) = n .
eq getSize(text(id,n)) = n .

eq getSize(restToByteSeq(TEXT:String)) = length(TEXT:String) .
--- TODO: Change when hashtags are strings.
---eq getSize(wHashTag(index:Nat)) = 2 .
eq getSize(hashTag(hashtag:String)) = length(hashtag:String) .
eq getSize(hash(file:ByteSeq, size:Nat)) = size:Nat .
**** eq getSize(file(size:Nat)) = size:Nat .
eq getSize(file(size:Nat, filename:String)) = size:Nat .
eq getSize(ccFile(key:Nat, hash:Nat, hashtag:String)) =
  length(hashtag:String) + 4 + 4
  .
eq getSize(ccFile(key(index:Nat, keySize:Nat), hash(FILE:ByteSeq, hashSize:Nat), hashtag:ByteSeq)) =
  *** TODO: Change when hashtags are strings.
  keySize:Nat + hashSize:Nat + 2
  .
eq getSize(ackFile(status:String, hashtag:ByteSeq)) = length(status:String) + getSize(hashtag:ByteSeq) .
eq getSize(image(fragNum:Nat, size:Nat, cap:Nat)) = size:Nat .

--- Get a filename.
op getFilename : ByteSeq -> String .
eq getFilename(file(size:Nat, name:String)) = name:String .
eq getFilename(ccFile(key:Nat, hash:Nat, hashtag:String)) =
  hashtag:String + ".txt"
  .
eq getFilename(image(fragNum:Nat, size:Nat, cap:Nat)) = 
  "img_" + string(fragNum:Nat, 10) + ".jpg"
  .

--- Get a hashtag from a CcFile.
op getHashtag : ByteSeq -> String .
eq getHashtag(ccFile(key:Nat, hash:Nat, hashtag:String)) = hashtag:String .
---eq getHashtag(ccFile(key:ByteSeq, hash:ByteSeq, wHashTag(index:Nat))) = string(index:Nat, 10) .
eq getHashtag(ccFile(key:ByteSeq, hash:ByteSeq, hashTag(hashtag:String))) = hashtag:String .
---eq getHashtag(wHashTag(index:Nat)) = string(index:Nat, 10) .
---eq getHashtag(bHashTag(index:Nat)) = string(index:Nat, 10) .
eq getHashtag(hashTag(hashtag:String)) = hashtag:String .

op getHashtagAsByteSeq : ByteSeq -> ByteSeq .
eq getHashtagAsByteSeq(ccFile(key:ByteSeq, hash:ByteSeq, hashtag:ByteSeq)) = hashtag:ByteSeq .

--- Get a hash from a CcFile.
op getHash : ByteSeq -> Nat .
eq getHash(ccFile(key:Nat, hash:Nat, hashtag:String)) = hash:Nat .
eq getHash(makeByteSeqChunk(data:ByteSeq, size:Nat, index:Nat)) = getHash(data:ByteSeq) .
eq getHash(data:ByteSeq) = 0 [owise] .
--- TODO: Create a hash match function.
op readHash : ByteSeq -> ByteSeq .
eq readHash(ccFile(key:ByteSeq, hash:ByteSeq, hashtag:ByteSeq)) = hash:ByteSeq .
eq readHash(CC_FILE:ByteSeq) = noBytes [owise] .

--- Get a key from a CcFile.
op getKey : ByteSeq -> Nat .
eq getKey(ccFile(key:Nat, hash:Nat, hashtag:String)) = key:Nat .
eq getKey(ccFile(key(index:Nat, length:Nat), hash:ByteSeq, hashtag:ByteSeq)) = index:Nat .

op readKey : ByteSeq -> ByteSeq .
eq readKey(ccFile(key:ByteSeq, hash:ByteSeq, hashtag:ByteSeq)) = key:ByteSeq .
eq readKey(CC_FILE:ByteSeq) = noBytes [owise] .

***(
--- Get a fragment number from an image.
op getFragmentNumber : ByteSeq -> Nat .
eq getFragmentNumber(image(fragNum:Nat, cap:Nat, size:Nat)) = fragNum:Nat .
)

*** we need to know the encryption algorithm overhead
*** give input size and key length
op encOH : Nat Nat -> Nat .
eq getSize(efile(id,n,j,k))  = n + encOH(n,k) .
eq getSize(hash(file(id,n),k)) = k .
eq getSize(hash(bytes,k)) = k [owise].

****  efile fragment constructor
***(  
 efrag(efile,last, ix ,l)
  ix in [0,last] the fragment index 
  l the fragment length (number of efile bytes)
  last is the index of the last fragment
    so last+1 is the number of fragments
)    
op efrag : ByteSeq Nat Nat Nat -> ByteSeq [ctor] .
--- overhead of file metadata in efrag --- TBD
op efragOH : ByteSeq -> Nat .  
eq efragOH(bytes) = 0 [owise] .
eq getSize(efrag(bytes,last,ix,l)) = l + efragOH(bytes) .

*********  image sorts functions ********************
**** image(j,n,k)  image j with cap k size n

op image : Nat Nat Nat -> ByteSeq .
eq getSize(image(j,n,k)) = n .

***(
*******     image  efrag  rand density
op encode : ByteSeq ByteSeq Nat Nat -> ByteSeq .
---- decoder will need to know what the params should be
---- decoder can't see the constructor params
op decode : ByteSeq Nat Nat -> ByteSeq .
eq decode(encode(image,efrag, r,d),r,d) = efrag .

eq getSize(encode(image(j,k,n),
         efrag(efile(id,n1,j,k),n0,ix,l),r,d))
     =  n + bloat(k,n,l) .
)
***(
bpf  -bit per frequency
nfreqs nf --- # frequencies per mcu
mcudensity  d fraction of mcus  used (d : Rat in [0,1])
mcu - 8x8 codeing unit
#mcus * d * nfreqs * bpf  == number of bits encoded
)
*******     image  efrag   bpf nfreq density
op encode : ByteSeq ByteSeq Nat Nat Rat -> ByteSeq .
---- decoder will need to know what the params should be
---- decoder can't see the constructor params
op decode : ByteSeq Nat Nat Rat -> ByteSeq .
eq decode(encode(image,efrag,bpf,nf,d1),bpf,nf,d1) = efrag .

--- Determine if an image has a payload.
op isWeird : ByteSeq -> Bool .
eq isWeird(encode(img:ByteSeq, noBytes, bpf, nf, d1)) = false .
eq isWeird(encodedImg:ByteSeq) = true [owise] .

eq getSize(encode(image(j,n,k),
         bytes, bpf, nf, d1))
  =  n + bloat(n, k, getSize(bytes))
.


**** bloat(k,n,l) is the increase in size of an image of
    ----size n with capacity k when l bytes are embedded.

**** TBDefined
op bloat : Nat Nat Nat -> Nat .
eq bloat(n,k,l) = 0 [owise] . 

op imageId : ByteSeq -> Nat .
eq imageId(image(j,n,k)) = j .
eq imageId(encode(image(j,n,k),
                   bytes, bpf, nf, d1))
     = j .
eq imageId(bytes)  = 0 [owise] .


***** from masTGen
op getNthBS : ByteSeqL Nat -> ByteSeq .
eq getNthBS(bytes :: bytesl,0) = bytes .
eq getNthBS(bytes :: bytesl, s n) 
      =  getNthBS(bytesl, n) .
eq getNthBS(bytesl,n) = noBytes [owise] .

***** from masTGen
op removeByteSeq : ByteSeqL ByteSeq -> ByteSeqL .
eq removeByteSeq(bsl0 :: bs :: bsl1, bs) = bsl0 :: bsl1 .
eq removeByteSeq(bsl0, bs) = bsl0 [owise] .


endfm

