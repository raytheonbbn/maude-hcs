--- CP4 active-adversary policy and event state.
--- Predicates describe observable IP/port traffic, not hidden channel labels.
--- The importer resolves node/service/subnet selectors into these predicates.
sload ../../deps/dns_formalization/Maude/common/apmaude.maude

mod ACTIVE-ADVERSARY is
  inc APMAUDE .
  pr STRING .
  pr RANDOM .
  pr CONVERSION .

  sorts AaPacket AaMatch AaPath AaFlow AaFlows AaRule AaRules AaEvent AaTimeline .
  subsort AaFlow < AaFlows .
  subsort AaRule < AaRules .
  subsort AaEvent < AaTimeline .
  op aaPacket : Nat Nat Nat Nat Bool -> AaPacket [ctor] .
  ops aaAny aaNone aaTcp aaUdp : -> AaMatch [ctor] .
  ops aaSrc aaDst : Nat Nat -> AaMatch [ctor] .
  ops aaSport aaDport : Nat -> AaMatch [ctor] .
  ops aaAnd aaOr : AaMatch AaMatch -> AaMatch [ctor] .
  op aaNot : AaMatch -> AaMatch [ctor] .
  op nilAaPath : -> AaPath [ctor] .
  op aaVantage : String -> AaPath [ctor] .
  op _;aav_ : AaPath AaPath -> AaPath [ctor assoc id: nilAaPath] .
  op aaFlow : Nat Nat AaPacket AaPath -> AaFlow [ctor] .
  op nilAaFlows : -> AaFlows [ctor] .
  op __ : AaFlows AaFlows -> AaFlows [ctor assoc id: nilAaFlows] .
  op aaDrop : String String AaMatch Float -> AaRule [ctor] .
  --- A reset lease is keyed by the actual 4-tuple, as in the nftables tool.
  --- A later connection with a reused tuple is affected until lease expiry.
  op aaResetLease : String String AaPacket Float -> AaRule [ctor] .
  op nilAaRules : -> AaRules [ctor] .
  op __ : AaRules AaRules -> AaRules [ctor assoc id: nilAaRules] .
  op aaAt : Float Content -> AaEvent [ctor] .
  op nilAaTimeline : -> AaTimeline [ctor] .
  op _;aat_ : AaTimeline AaTimeline -> AaTimeline [ctor assoc id: nilAaTimeline] .

  vars SI DI SP DP LO HI N I G J H K : Nat .
  vars B : Bool .
  vars P Q : AaPacket .
  vars M M1 M2 : AaMatch .
  vars V V1 ID ID1 : String .
  vars PATH : AaPath .
  vars F : AaFlow .
  vars FS : AaFlows .
  vars R : AaRule .
  vars RS : AaRules .
  vars T T1 PROB D : Float .
  vars E : Content .
  vars TL : AaTimeline .
  vars AS AS1 : AttributeSet .
  vars A A1 : Address .

  op aaReverse : AaPacket -> AaPacket .
  eq aaReverse(aaPacket(SI,DI,SP,DP,B)) = aaPacket(DI,SI,DP,SP,B) .
  op aaIsBgp : AaPacket -> Bool .
  eq aaIsBgp(aaPacket(SI,DI,SP,DP,B)) = B and (SP == 179 or DP == 179) .
  op aaMatches : AaMatch AaPacket -> Bool .
  eq aaMatches(aaAny,P) = true .
  eq aaMatches(aaNone,P) = false .
  eq aaMatches(aaTcp,aaPacket(SI,DI,SP,DP,B)) = B .
  eq aaMatches(aaUdp,aaPacket(SI,DI,SP,DP,B)) = not B .
  eq aaMatches(aaSrc(LO,HI),aaPacket(SI,DI,SP,DP,B)) = LO <= SI and SI <= HI .
  eq aaMatches(aaDst(LO,HI),aaPacket(SI,DI,SP,DP,B)) = LO <= DI and DI <= HI .
  eq aaMatches(aaSport(N),aaPacket(SI,DI,SP,DP,B)) = SP == N .
  eq aaMatches(aaDport(N),aaPacket(SI,DI,SP,DP,B)) = DP == N .
  eq aaMatches(aaAnd(M1,M2),P) = aaMatches(M1,P) and aaMatches(M2,P) .
  eq aaMatches(aaOr(M1,M2),P) = aaMatches(M1,P) or aaMatches(M2,P) .
  eq aaMatches(aaNot(M),P) = not aaMatches(M,P) .
  op aaOnPath : String AaPath -> Bool .
  eq aaOnPath(V,nilAaPath) = false .
  eq aaOnPath(V,aaVantage(V1) ;aav PATH) = V == V1 or aaOnPath(V,PATH) .

  --- Sequential independent DROP rules compound: survival = product(1-p).
  op aaLoss : AaRules AaPacket String Float -> Float .
  eq aaLoss(RS,P,V,T) = if aaIsBgp(P) then 0.0 else 1.0 - aaSurvival(RS,P,V) fi .
  op aaSurvival : AaRules AaPacket String -> Float .
  eq aaSurvival(nilAaRules,P,V) = 1.0 .
  eq aaSurvival(aaDrop(ID,V1,M,PROB) RS,P,V) =
    (if V == V1 and aaMatches(M,P) then 1.0 - PROB else 1.0 fi) * aaSurvival(RS,P,V) .
  eq aaSurvival(aaResetLease(ID,V1,Q,T1) RS,P,V) = aaSurvival(RS,P,V) .
  op aaResetAt : AaRules AaPacket String Float -> Bool .
  eq aaResetAt(nilAaRules,P,V,T) = false .
  eq aaResetAt(aaDrop(ID,V1,M,PROB) RS,P,V,T) = aaResetAt(RS,P,V,T) .
  eq aaResetAt(aaResetLease(ID,V1,Q,T1) RS,P,V,T) =
    (not aaIsBgp(P) and V == V1 and T < T1 and (P == Q or aaReverse(P) == Q))
    or aaResetAt(RS,P,V,T) .
  op aaPathLoss : AaRules AaPacket AaPath Float -> Float .
  eq aaPathLoss(RS,P,nilAaPath,T) = 0.0 .
  eq aaPathLoss(RS,P,aaVantage(V) ;aav PATH,T) =
    1.0 - (1.0 - aaLoss(RS,P,V,T)) * (1.0 - aaPathLoss(RS,P,PATH,T)) .
  op aaPathReset : AaRules AaPacket AaPath Float -> Bool .
  eq aaPathReset(RS,P,nilAaPath,T) = false .
  eq aaPathReset(RS,P,aaVantage(V) ;aav PATH,T) = aaResetAt(RS,P,V,T) or aaPathReset(RS,P,PATH,T) .
  op aaRemoveDrop : AaRules String -> AaRules .
  eq aaRemoveDrop(nilAaRules,ID) = nilAaRules .
  eq aaRemoveDrop(aaDrop(ID1,V,M,PROB) RS,ID) =
    (if ID == ID1 then nilAaRules else aaDrop(ID1,V,M,PROB) fi) aaRemoveDrop(RS,ID) .
  eq aaRemoveDrop(aaResetLease(ID1,V,P,T1) RS,ID) = aaResetLease(ID1,V,P,T1) aaRemoveDrop(RS,ID) .

  --- Registry contains established flows only. Stable ordering makes sampling
  --- independent of actor matching order. Retiring a generation cannot retire
  --- another connection that happens to have the same logical flow id.
  op aaRetire : AaFlows Nat Nat -> AaFlows .
  eq aaRetire(nilAaFlows,I,G) = nilAaFlows .
  eq aaRetire(aaFlow(J,H,P,PATH) FS,I,G) =
    (if I == J and G == H then nilAaFlows else aaFlow(J,H,P,PATH) fi) aaRetire(FS,I,G) .
  op aaRegister : AaFlows AaFlow -> AaFlows .
  eq aaRegister(FS,aaFlow(I,G,P,PATH)) = aaInsert(aaRetire(FS,I,G),aaFlow(I,G,P,PATH)) .
  op aaInsert : AaFlows AaFlow -> AaFlows .
  eq aaInsert(nilAaFlows,F) = F .
  eq aaInsert(aaFlow(J,H,Q,PATH1:AaPath) FS,aaFlow(I,G,P,PATH)) =
    if I < J or (I == J and G < H)
    then aaFlow(I,G,P,PATH) aaFlow(J,H,Q,PATH1:AaPath) FS
    else aaFlow(J,H,Q,PATH1:AaPath) aaInsert(FS,aaFlow(I,G,P,PATH)) fi .
  op aaFlowLive : AaFlows Nat Nat -> Bool .
  eq aaFlowLive(nilAaFlows,I,G) = false .
  eq aaFlowLive(aaFlow(J,H,P,PATH) FS,I,G) = (I == J and G == H) or aaFlowLive(FS,I,G) .
  op aaCandidates : AaFlows String AaMatch -> AaFlows .
  eq aaCandidates(nilAaFlows,V,M) = nilAaFlows .
  eq aaCandidates(aaFlow(I,G,P,PATH) FS,V,M) =
    (if aaOnPath(V,PATH) and aaMatches(aaTcp,P) and not aaIsBgp(P) and aaMatches(M,P)
     then aaFlow(I,G,P,PATH) else nilAaFlows fi) aaCandidates(FS,V,M) .
  op aaCount : AaFlows -> Nat .
  eq aaCount(nilAaFlows) = 0 .
  eq aaCount(F FS) = s(aaCount(FS)) .
  op aaNth : AaFlows Nat -> AaFlow .
  eq aaNth(F FS,0) = F .
  eq aaNth(F FS,s(N)) = aaNth(FS,N) .
  op aaWithout : AaFlows Nat -> AaFlows .
  eq aaWithout(F FS,0) = FS .
  eq aaWithout(F FS,s(N)) = F aaWithout(FS,N) .
  op aaCeil : Float -> Nat .
  eq aaCeil(PROB) = if PROB <= 0.0 then 0 else s(aaCeil(PROB - 1.0)) fi .
  op aaSample : AaFlows Nat Nat -> AaFlows .
  eq aaSample(FS,0,N) = nilAaFlows .
  eq aaSample(nilAaFlows,s(K),N) = nilAaFlows .
  ceq aaSample(FS,s(K),N) = aaNth(FS,J) aaSample(aaWithout(FS,J),K,s(N))
    if aaCount(FS) > 0 /\ J := random(N) rem aaCount(FS) .
  op aaLeases : AaFlows String String Float -> AaRules .
  eq aaLeases(nilAaFlows,ID,V,T) = nilAaRules .
  eq aaLeases(aaFlow(I,G,P,PATH) FS,ID,V,T) = aaResetLease(ID,V,P,T) aaLeases(FS,ID,V,T) .
  --- nft add element does not extend an already-present tuple's timeout.
  op aaMergeLeases : AaRules AaRules Float -> AaRules .
  eq aaMergeLeases(RS,nilAaRules,T) = RS .
  eq aaMergeLeases(RS,aaResetLease(ID,V,P,T1) RS1:AaRules,T) =
    aaMergeLeases((if aaResetAt(RS,P,V,T) then RS else RS aaResetLease(ID,V,P,T1) fi),RS1:AaRules,T) .

  op ActiveAdversary : -> ActorType [ctor] .
  op aaRules:_ : AaRules -> Attribute [ctor] .
  op aaFlows:_ : AaFlows -> Attribute [ctor] .
  op aaSeed:_ : Nat -> Attribute [ctor] .
  op aaTimeline:_ : AaTimeline -> Attribute [ctor] .
  op aaInstallDrop : String String AaMatch Float -> Content [ctor] .
  op aaInstallReset : String String AaMatch Float Float -> Content [ctor] .
  op aaRevert : String -> Content [ctor] .
  op aaWake : -> Content [ctor] .
  op aaRegisterFlow : AaFlow -> Content [ctor] .
  op aaRetireFlow : Nat Nat -> Content [ctor] .
  op mkActiveAdversary : Address Nat -> Actor .
  op mkActiveAdversary : Address Nat AaTimeline -> Actor .
  eq mkActiveAdversary(A,N) = mkActiveAdversary(A,N,nilAaTimeline) .
  eq mkActiveAdversary(A,N,TL) = < A : ActiveAdversary | aaRules: nilAaRules,
    aaFlows: nilAaFlows, aaSeed: N, aaTimeline: TL > .
  op aaApply : AttributeSet Content Float -> AttributeSet .
  eq aaApply((AS,aaRules: RS),aaInstallDrop(ID,V,M,PROB),T) =
    (AS,aaRules: (RS aaDrop(ID,V,M,max(0.0,min(1.0,PROB))))) .
  eq aaApply((AS,aaRules: RS),aaRevert(ID),T) = (AS,aaRules: aaRemoveDrop(RS,ID)) .
  ceq aaApply((AS,aaRules: RS,aaFlows: FS,aaSeed: N),aaInstallReset(ID,V,M,PROB,D),T) =
    (AS,aaRules: aaMergeLeases(RS,aaLeases(aaSample(aaCandidates(FS,V,M),K,N),ID,V,T + D),T),aaFlows: FS,aaSeed: (N + K))
    if K := aaCeil(float(aaCount(aaCandidates(FS,V,M))) * max(0.0,min(1.0,PROB))) .
  eq aaApply((AS,aaFlows: FS),aaRegisterFlow(F),T) = (AS,aaFlows: aaRegister(FS,F)) .
  eq aaApply((AS,aaFlows: FS),aaRetireFlow(I,G),T) = (AS,aaFlows: aaRetire(FS,I,G)) .
  eq aaApply(AS,aaWake,T) = AS .

  --- All network rules call aaSync BEFORE changing their flow registry. This
  --- gives adversary events priority over traffic at the same timestamp.
  op aaSync : AttributeSet Float -> AttributeSet .
  ceq aaSync((AS,aaTimeline: (aaAt(T1,E) ;aat TL)),T) =
    aaSync(aaApply((AS,aaTimeline: TL),E,T1),T) if T1 <= T .
  eq aaSync(AS,T) = AS [owise] .
  op aaGetRules : AttributeSet -> AaRules .
  eq aaGetRules((AS,aaRules: RS)) = RS .
  op aaGetFlows : AttributeSet -> AaFlows .
  eq aaGetFlows((AS,aaFlows: FS)) = FS .
  op aaSoonest : Float Float -> Float .
  eq aaSoonest(T,T1) = if T < 0.0 then T1 else if T1 < 0.0 then T else min(T,T1) fi fi .
  op aaNextExpiry : AaRules Float -> Float .
  eq aaNextExpiry(nilAaRules,T) = -1.0 .
  eq aaNextExpiry(aaDrop(ID,V,M,PROB) RS,T) = aaNextExpiry(RS,T) .
  eq aaNextExpiry(aaResetLease(ID,V,P,T1) RS,T) =
    aaSoonest((if T1 > T then T1 else -1.0 fi),aaNextExpiry(RS,T)) .
  op aaNextEvent : AttributeSet Float -> Float .
  eq aaNextEvent((AS,aaRules: RS,aaTimeline: nilAaTimeline),T) = aaNextExpiry(RS,T) .
  eq aaNextEvent((AS,aaRules: RS,aaTimeline: (aaAt(T1,E) ;aat TL)),T) = aaSoonest(T1,aaNextExpiry(RS,T)) .

  rl [aa-timed-event]:
    {T,(to A : E)} < A : ActiveAdversary | AS >
    => < A : ActiveAdversary | aaApply(aaSync(AS,T),E,T) > .
  rl [aa-timed-event-from]:
    {T,(to A from A1 : E)} < A : ActiveAdversary | AS >
    => < A : ActiveAdversary | aaApply(aaSync(AS,T),E,T) > .
endm
