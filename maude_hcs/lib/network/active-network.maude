--- Resumable, opt-in CP4 TCP transport over the existing channel message API.
--- Bind both legacy network peers with enableActiveTcp; add one socket per
--- bidirectional 4-tuple. A reset never automatically replays application data.
sload net_prob
sload active-adversary

mod ACTIVE-NETWORK-CONNECTION is
  inc NETWORK_CONNECTION .
  inc ACTIVE-ADVERSARY .
  inc TCP-RESUMABLE .

  ops ActiveTcpSocket ActiveTcpLane : -> ActorType [ctor] .
  op atLane : Address Bool -> Address [ctor] .
  op atSocket:_ : Address -> Attribute [ctor] .
  op atAdv:_ : Address -> Attribute [ctor] .
  op atSource:_ : Address -> Attribute [ctor] .
  op atDest:_ : Address -> Attribute [ctor] .
  op atPacket:_ : AaPacket -> Attribute [ctor] .
  op atPath:_ : AaPath -> Attribute [ctor] .
  op atId:_ : Nat -> Attribute [ctor] .
  op atEpoch:_ : Nat -> Attribute [ctor] .
  op atEstablished:_ : Bool -> Attribute [ctor] .
  op atConnecting:_ : Bool -> Attribute [ctor] .
  op atClosed:_ : Bool -> Attribute [ctor] .
  op atBusy:_ : Bool -> Attribute [ctor] .
  op atReadyAt:_ : Float -> Attribute [ctor] .
  op atLinks : AttributeSet AttributeSet -> Attribute [ctor] .
  op atLimit:_ : Nat -> Attribute [ctor] .
  op atTransfer:_ : TcpTransfer -> Attribute [ctor] .
  op atPayload:_ : Content -> Attribute [ctor] .
  op atObserver:_ : Address -> Attribute [ctor] .
  sort AtQueue .
  op atEmpty : -> AtQueue [ctor] .
  op atItem : Content -> AtQueue [ctor] .
  op _;at_ : AtQueue AtQueue -> AtQueue [ctor assoc id: atEmpty] .
  op atQueue:_ : AtQueue -> Attribute [ctor] .
  op atNoPayload : -> Content [ctor] .
  ops AtPump TcpReconnect TcpClose : -> Content [ctor] .
  op TcpReconnect : AaPacket -> Content [ctor] .
  op TcpReconnectWith : Address Address Content -> Content [ctor] .
  op AtAttempt : Nat -> Content [ctor] .
  op AtBroken : Nat String -> Content [ctor] .
  op TcpFailed : Nat Nat String Content -> Content [ctor] .
  --- Public completion/failure interface: content arrives unchanged, failures
  --- carry the original payload so a channel may explicitly replay it.
  op atObserve : Float Address Address Nat Nat Bool Bool -> Content [ctor] .

  vars S A L SRC DST OBS OTHER : Address .
  vars AS AS1 AA AA1 B1 B2 LS : AttributeSet .
  vars I G E N J J1 : Nat .
  vars T P READY WAIT : Float .
  vars PK PK0 : AaPacket .
  vars PATH FLOWPATH : AaPath .
  vars EST CLOSED BUSY DIR CONNECTING : Bool .
  vars X Y : TcpTransfer .
  var Q : AtQueue .
  var M : Content .
  vars WHY VERDICT : String .

  op mkActiveTcpConnection : Address Address Nat Address Address AaPacket AaPath
    AttributeSet AttributeSet Nat -> Config .
  eq mkActiveTcpConnection(S,A,I,SRC,DST,PK,PATH,B1,B2,N) =
    < S : ActiveTcpSocket | atAdv: A, atId: I, atEpoch: 1,
       atPacket: PK, atPath: PATH, atEstablished: false, atConnecting: false, atClosed: false >
    mkActiveTcpLane(S,true,SRC,DST,PK,PATH,B1,B2,N)
    mkActiveTcpLane(S,false,DST,SRC,aaReverse(PK),atReversePath(PATH),B2,B1,N) .
  op mkActiveTcpLane : Address Bool Address Address AaPacket AaPath
    AttributeSet AttributeSet Nat -> Actor .
  eq mkActiveTcpLane(S,DIR,SRC,DST,PK,PATH,B1,B2,N) =
    < atLane(S,DIR) : ActiveTcpLane | atSocket: S, atSource: SRC, atDest: DST,
      atPacket: PK, atPath: PATH, atLinks(B1,B2), atLimit: N,
      atQueue: atEmpty, atBusy: false, atReadyAt: 0.0, atPayload: atNoPayload,
      atTransfer: tcpStartTransfer(0,B1,B2,false,0), atObserver: nullAddr > .

  op atFailQueue : AtQueue Address Address Nat Nat String -> Config .
  eq atFailQueue(atEmpty,SRC,S,I,G,WHY) = null .
  eq atFailQueue(atItem(M) ;at Q,SRC,S,I,G,WHY) =
    [0.0,(to SRC from S : TcpFailed(I,G,WHY,M)),0]
    atFailQueue(Q,SRC,S,I,G,WHY) .

  --- Independent FIFO queues preserve each direction's stream ordering.
  crl [active-tcp-enqueue]:
    {T,(to tcp(DST) from SRC : M)}
    < L : ActiveTcpLane | AS, atSocket: S, atSource: SRC, atDest: DST, atQueue: Q >
    < S : ActiveTcpSocket | LS, atClosed: false >
    => < L : ActiveTcpLane | AS, atSocket: S, atSource: SRC, atDest: DST,
         atQueue: (Q ;at atItem(M)) >
       < S : ActiveTcpSocket | LS, atClosed: false >
       [0.0,(to L : AtPump),0]
    if true .
  rl [active-tcp-closed-write]:
    {T,(to tcp(DST) from SRC : M)}
    < L : ActiveTcpLane | AS, atSocket: S, atSource: SRC, atDest: DST >
    < S : ActiveTcpSocket | LS, atClosed: true, atId: I, atEpoch: G >
    => < L : ActiveTcpLane | AS, atSocket: S, atSource: SRC, atDest: DST >
       < S : ActiveTcpSocket | LS, atClosed: true, atId: I, atEpoch: G >
       [0.0,(to SRC from S : TcpFailed(I,G,"closed",M)),0] .

  --- Higher layers may model a wait before the first application record;
  --- the TCP handshake remains independently visible to adversary events.
  op atInitialPayloadWait : Content AttributeSet AttributeSet Bool -> Float .
  eq atInitialPayloadWait(M,B1,B2,EST) = 0.0 [owise] .
  --- After loss recovery, queued writes await the returning ACK. Arrival at
  --- the receiver alone does not reopen the sender's congestion window.
  op atRecoveryAckWait : TcpTransfer AttributeSet AttributeSet -> Float .
  eq atRecoveryAckWait(X,B1,B2) =
    if tcpRetries(X) > 0 then tcpLinkRtt(B1,B2) / 2.0 else 0.0 fi .

  crl [active-tcp-pump]:
    {T,(to L : AtPump)}
    < L : ActiveTcpLane | AS, atSocket: S, atQueue: (atItem(M) ;at Q),
       atBusy: false, atReadyAt: READY, atPayload: K:Content, atTransfer: X, atLinks(B1,B2) >
    < S : ActiveTcpSocket | LS, atClosed: false, atEpoch: G, atEstablished: EST, atConnecting: CONNECTING >
    => < L : ActiveTcpLane | AS, atSocket: S, atQueue: Q, atBusy: true,
         atPayload: M, atTransfer: Y, atLinks(B1,B2), atReadyAt: READY >
       < S : ActiveTcpSocket | LS, atClosed: false, atEpoch: G, atEstablished: EST, atConnecting: (not EST) >
       [tcpAttemptDelay(Y),(to L : AtAttempt(G)),0]
    if (EST or not CONNECTING) and T >= READY
    /\ Y := tcpStartTransferWithWait(getSize(M),B1,B2,not EST,G,
                atInitialPayloadWait(M,B1,B2,not EST)) .
  crl [active-tcp-pump-noop]:
    {T,(to L : AtPump)}
    < L : ActiveTcpLane | AS, atBusy: BUSY, atQueue: Q, atReadyAt: READY >
    => < L : ActiveTcpLane | AS, atBusy: BUSY, atQueue: Q, atReadyAt: READY >
    if BUSY or Q == atEmpty or T < READY .

  crl [active-tcp-pump-wait]:
    {T,(to L : AtPump)}
    < L : ActiveTcpLane | AS, atSocket: S >
    < S : ActiveTcpSocket | LS, atClosed: CLOSED, atEstablished: EST,
       atConnecting: CONNECTING >
    => < L : ActiveTcpLane | AS, atSocket: S >
       < S : ActiveTcpSocket | LS, atClosed: CLOSED, atEstablished: EST,
         atConnecting: CONNECTING >
    if CLOSED or (CONNECTING and not EST) .

  --- Each packet attempt consults rules at its simulated arrival, not at send
  --- submission. No irrevocable whole-message completion is scheduled ahead.
  crl [active-tcp-attempt]:
    {T,(to L : AtAttempt(G))}
    < L : ActiveTcpLane | AS, atSocket: S, atTransfer: X, atBusy: true,
       atPacket: PK, atPath: PATH, atSource: SRC, atDest: DST, atPayload: M,
       atLimit: N, atObserver: OBS, atLinks(B1,B2), atReadyAt: READY >
    < S : ActiveTcpSocket | LS, atAdv: A, atId: I, atEpoch: G,
       atEstablished: EST, atConnecting: CONNECTING, atClosed: false, atPacket: PK0, atPath: FLOWPATH >
    < A : ActiveAdversary | AA >
    rCtr(J)
    => < L : ActiveTcpLane | AS, atSocket: S, atTransfer: Y,
         atBusy: (not tcpTransferDone(Y)), atPacket: PK, atPath: PATH,
         atSource: SRC, atDest: DST, atPayload: M, atLimit: N, atObserver: OBS,
         atLinks(B1,B2), atReadyAt: (if tcpTransferDone(Y) then T + WAIT else READY fi) >
       < S : ActiveTcpSocket | LS, atAdv: A, atId: I, atEpoch: G,
         atEstablished: (EST or tcpHandshakeDone(Y)),
         atConnecting: (not (EST or tcpHandshakeDone(Y))), atClosed: false,
         atPacket: PK0, atPath: FLOWPATH >
       < A : ActiveAdversary | atRegisterEstablished(AA1,I,G,PK0,FLOWPATH,tcpConnectionEstablished(Y)) >
       rCtr(J1)
       (if tcpTransferDone(Y)
        then [0.0,(to DST from SRC : M),0] [WAIT,(to L : AtPump),0]
        else [tcpAttemptDelay(Y),(to L : AtAttempt(G)),0] fi)
       (if not EST and tcpHandshakeDone(Y)
        then [0.0,(to atLane(S,true) : AtPump),0] [0.0,(to atLane(S,false) : AtPump),0]
        else null fi)
       atObservation(OBS,T,SRC,DST,atFlowKey(I,G),tcpAttemptWireBytes(X),atFirstPacket(X),not LOST:Bool)
    if AA1 := aaSync(AA,T)
    /\ atVerdict(VERDICT,J1) := (if tcpTransferDone(X) then atVerdict("pass",J)
                                    else atPolicy(atRules(AA1),PK,PATH,T,J) fi)
    /\ VERDICT =/= "rst"
    /\ LOST:Bool := (VERDICT == "drop")
    /\ Y := (if tcpTransferDone(X) then X else (if LOST:Bool then tcpLoseAt(X,T,B1,B2) else tcpAccept(X) fi) fi)
    /\ tcpRetries(Y) <= N
    /\ WAIT := atRecoveryAckWait(Y,B1,B2) .

  crl [active-tcp-failure]:
    {T,(to L : AtAttempt(G))}
    < L : ActiveTcpLane | AS, atSocket: S, atTransfer: X, atBusy: true,
      atPacket: PK, atPath: PATH, atLimit: N, atSource: SRC, atDest: DST, atObserver: OBS >
    < S : ActiveTcpSocket | LS, atAdv: A, atId: I, atEpoch: G, atClosed: false, atEstablished: EST >
    < A : ActiveAdversary | AA > rCtr(J)
    => < L : ActiveTcpLane | AS, atSocket: S, atTransfer: X, atBusy: true,
         atPacket: PK, atPath: PATH, atLimit: N, atSource: SRC, atDest: DST, atObserver: OBS >
       < S : ActiveTcpSocket | LS, atAdv: A, atId: I, atEpoch: G, atClosed: true, atEstablished: EST >
       < A : ActiveAdversary | atRetire(AA1,I,G) > rCtr(J1)
       [0.0,(to atLane(S,true) : AtBroken(G,WHY)),0]
       [0.0,(to atLane(S,false) : AtBroken(G,WHY)),0]
       atObservation(OBS,T,SRC,DST,atFlowKey(I,G),tcpAttemptWireBytes(X),atFirstPacket(X),false)
    if AA1 := aaSync(AA,T)
    /\ not tcpTransferDone(X)
    /\ atVerdict(VERDICT,J1) := atPolicy(atRules(AA1),PK,PATH,T,J)
    /\ WHY := (if VERDICT == "rst" then "rst" else "timeout" fi)
    /\ (VERDICT == "rst" or (VERDICT == "drop" and tcpRetries(tcpLose(X)) > N)) .

  rl [active-tcp-broken]:
    {T,(to L : AtBroken(G,WHY))}
    < L : ActiveTcpLane | AS, atSocket: S, atTransfer: X, atBusy: BUSY,
      atQueue: Q, atPayload: M, atSource: SRC >
    < S : ActiveTcpSocket | LS, atId: I, atEpoch: G >
    => < L : ActiveTcpLane | AS, atSocket: S, atTransfer: tcpAbort(X),
         atBusy: false, atQueue: atEmpty, atPayload: atNoPayload, atSource: SRC >
       < S : ActiveTcpSocket | LS, atId: I, atEpoch: G >
       (if BUSY then [0.0,(to SRC from S : TcpFailed(I,G,WHY,M)),0] else null fi)
       atFailQueue(Q,SRC,S,I,G,WHY) .
  crl [active-tcp-stale-attempt]:
    {T,(to L : AtAttempt(G))}
    < L : ActiveTcpLane | AS, atBusy: BUSY, atTransfer: X >
    => < L : ActiveTcpLane | AS, atBusy: BUSY, atTransfer: X >
    if not BUSY or G =/= tcpGeneration(X) .

  crl [active-tcp-retired-attempt]:
    {T,(to L : AtAttempt(G))}
    < L : ActiveTcpLane | AS, atSocket: S >
    < S : ActiveTcpSocket | LS, atEpoch: E, atClosed: CLOSED >
    => < L : ActiveTcpLane | AS, atSocket: S >
       < S : ActiveTcpSocket | LS, atEpoch: E, atClosed: CLOSED >
    if CLOSED or G =/= E .

  --- Recovery is an explicit channel/application decision, never automatic.
  --- The active message blocks scheduler advancement until the socket has
  --- reopened, so the zero-delay submission cannot race the reconnect.
  eq {T,(to S : TcpReconnectWith(SRC,DST,M))} =
     {T,(to S : TcpReconnect)} [0.0,(to tcp(DST) from SRC : M),0] .
  eq {T,(to S : TcpReconnect)}
     < S : ActiveTcpSocket | AS, atPacket: PK > =
     {T,(to S : TcpReconnect(PK))}
     < S : ActiveTcpSocket | AS, atPacket: PK > .
  --- Atomically retire both directions before accepting a new epoch. Any old
  --- queued/current message is returned to its sender; replay is explicit.
  rl [active-tcp-reconnect]:
    {T,(to S : TcpReconnect(PK))}
    < S : ActiveTcpSocket | AS, atAdv: A, atId: I, atEpoch: G,
      atEstablished: EST, atConnecting: CONNECTING, atClosed: CLOSED, atPacket: PK0 >
    < atLane(S,true) : ActiveTcpLane | FWD:AttributeSet, atSource: SRC,
      atBusy: FB:Bool, atTransfer: FX:TcpTransfer, atQueue: FQ:AtQueue,
      atPayload: FM:Content, atPacket: FPK:AaPacket, atReadyAt: FR:Float >
    < atLane(S,false) : ActiveTcpLane | REV:AttributeSet, atSource: DST,
      atBusy: RB:Bool, atTransfer: RX:TcpTransfer, atQueue: RQ:AtQueue,
      atPayload: RM:Content, atPacket: RPK:AaPacket, atReadyAt: RR:Float >
    < A : ActiveAdversary | AA >
    => < S : ActiveTcpSocket | AS, atAdv: A, atId: I, atEpoch: s G,
         atEstablished: false, atConnecting: false, atClosed: false, atPacket: PK >
       < atLane(S,true) : ActiveTcpLane | FWD:AttributeSet, atSource: SRC,
         atBusy: false, atTransfer: tcpAbort(FX:TcpTransfer), atQueue: atEmpty,
         atPayload: atNoPayload, atPacket: PK, atReadyAt: 0.0 >
       < atLane(S,false) : ActiveTcpLane | REV:AttributeSet, atSource: DST,
         atBusy: false, atTransfer: tcpAbort(RX:TcpTransfer), atQueue: atEmpty,
         atPayload: atNoPayload, atPacket: aaReverse(PK), atReadyAt: 0.0 >
       < A : ActiveAdversary | atRetire(aaSync(AA,T),I,G) >
       (if FB:Bool then [0.0,(to SRC from S : TcpFailed(I,G,"reconnect",FM:Content)),0] else null fi)
       (if RB:Bool then [0.0,(to DST from S : TcpFailed(I,G,"reconnect",RM:Content)),0] else null fi)
       atFailQueue(FQ:AtQueue,SRC,S,I,G,"reconnect")
       atFailQueue(RQ:AtQueue,DST,S,I,G,"reconnect") .
  crl [active-tcp-stale-broken]:
    {T,(to L : AtBroken(G,WHY))}
    < L : ActiveTcpLane | AS, atSocket: S >
    < S : ActiveTcpSocket | LS, atEpoch: E >
    => < L : ActiveTcpLane | AS, atSocket: S >
       < S : ActiveTcpSocket | LS, atEpoch: E >
    if G =/= E .
  rl [active-tcp-close]:
    {T,(to S : TcpClose)}
    < S : ActiveTcpSocket | AS, atAdv: A, atId: I, atEpoch: G, atClosed: CLOSED, atEstablished: EST >
    < A : ActiveAdversary | AA >
    => < S : ActiveTcpSocket | AS, atAdv: A, atId: I, atEpoch: G, atClosed: true, atEstablished: EST >
       < A : ActiveAdversary | atRetire(aaSync(AA,T),I,G) >
       [0.0,(to atLane(S,true) : AtBroken(G,"closed")),0]
       [0.0,(to atLane(S,false) : AtBroken(G,"closed")),0] .

  --- Traverse vantages in packet direction. A packet dropped upstream cannot
  --- trigger a downstream RST. Within one vantage, drop precedes reset by model convention; the T&E
  --- package does not specify relative ordering of its separate firewall hooks.
  sort AtVerdict .
  op atVerdict : String Nat -> AtVerdict [ctor] .
  op atPolicy : AaRules AaPacket AaPath Float Nat -> AtVerdict .
  eq atPolicy(R:AaRules,PK,nilAaPath,T,J) = atVerdict("pass",J) .
  eq atPolicy(R:AaRules,PK,aaVantage(V:String) ;aav PATH,T,J) =
    if sampleBerWithPX(J,aaLoss(R:AaRules,PK,V:String,T))
    then atVerdict("drop",s J)
    else if aaResetAt(R:AaRules,PK,V:String,T) then atVerdict("rst",s J)
         else atPolicy(R:AaRules,PK,PATH,T,s J) fi fi .
  op atReversePath : AaPath -> AaPath .
  eq atReversePath(nilAaPath) = nilAaPath .
  eq atReversePath(aaVantage(V:String) ;aav PATH) =
    atReversePath(PATH) ;aav aaVantage(V:String) .

  op atRules : AttributeSet -> AaRules .
  eq atRules((AS,aaRules: R:AaRules)) = R:AaRules .
  op atRegisterEstablished : AttributeSet Nat Nat AaPacket AaPath Bool -> AttributeSet .
  eq atRegisterEstablished((AS,aaFlows: F:AaFlows),I,G,PK,PATH,true) =
    (AS,aaFlows: aaRegister(F:AaFlows,aaFlow(I,G,PK,PATH))) .
  eq atRegisterEstablished(AS,I,G,PK,PATH,false) = AS .
  op atRetire : AttributeSet Nat Nat -> AttributeSet .
  eq atRetire((AS,aaFlows: F:AaFlows),I,G) = (AS,aaFlows: aaRetire(F:AaFlows,I,G)) .

  --- Passive flow IDs distinguish reconnect generations even when the same
  --- endpoint pair and source port are reused (Cantor pairing of socket/epoch).
  op atFlowKey : Nat Nat -> Nat .
  eq atFlowKey(I,G) = ((I + G) * (I + G + 1)) quo 2 + G .

  op withActiveTcpObserver : Config Address -> Config .
  eq withActiveTcpObserver(< L : ActiveTcpLane | AS, atObserver: OTHER > C:Config,OBS) =
     < L : ActiveTcpLane | AS, atObserver: OBS > withActiveTcpObserver(C:Config,OBS) .
  eq withActiveTcpObserver(C:Config,OBS) = C:Config [owise] .
  op atFirstPacket : TcpTransfer -> Bool .
  eq atFirstPacket(X) = tcpAttemptStartsConnection(X) .

  --- Optional passive-observer adapter, preserving ingress observations of
  --- dropped attempts. nullAddr disables it without requiring an observer actor.
  op atObservation : Address Float Address Address Nat Nat Bool Bool -> Config .
  eq atObservation(nullAddr,T,SRC,DST,I,N,EST,BUSY) = null .
  eq atObservation(OBS,T,SRC,DST,I,0,EST,BUSY) = null .
  eq atObservation(OBS,T,SRC,DST,I,N,EST,BUSY) =
    [0.0,(to OBS : atObserve(T,SRC,DST,I,N,EST,BUSY)),0] [owise] .
  rl [active-tcp-observe]:
    {T,(to OBS : atObserve(P,SRC,DST,I,N,EST,BUSY))}
    < OBS : Adversary | AS >
    => < OBS : Adversary | addTPL2tcp(AS,tp(P,P,(if BUSY then P else infty fi),pkt(DST,SRC,EST,I,N))) > .
endm
