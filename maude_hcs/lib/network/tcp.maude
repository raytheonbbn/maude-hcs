sload ../../deps/dns_formalization/Maude/common/actor.maude
sload ../../deps/dns_formalization/Maude/common/parameters.maude
sload ../common/maude/_aux.maude
sload ../common/maude/common_sorts.maude
sload ../irc/irc-byteseq-interface.maude
sload tcp_socket.maude

--- ================================================================
--- TCP Analytical Model in Maude
--- ================================================================
---
--- Faithful translation of tcp_analytical_model.py into pure
--- equational Maude.  Computes E[T_k]: expected arrival time of
--- the k-th TCP data segment at the server, measured from the
--- client's first SYN transmission.
---
--- Models TCP as implemented in Ubuntu 22.04 (Linux 5.15+):
---   CUBIC congestion control, SACK, RACK-TLP loss detection,
---   3-way handshake, Slow Start, Congestion Avoidance,
---   Fast Retransmit / Fast Recovery via SACK, RTO on total loss.
---
--- Channel: IID packet loss model
---   dropP: packet drop probability p in [0, 1]
---   End-to-end 2-hop composite loss: p_e2e = 1 - (1 - p1) * (1 - p2)
---
--- Loss is bidirectional: data and reverse ACK recovery use the IID path.
--- ================================================================


--- ================================================================
--- Module: TCP-ANALYTICAL-MODEL
---   Channel model, flight analysis, timeline builder, public API.
--- ================================================================
mod TCP-ANALYTICAL-MODEL is
  pr COMMON_SORTS .

  --- Clip to [0, 1]
  op clip01 : Float -> Float .
  eq clip01(A:Float) =
     if A:Float < 0.0 then 0.0
     else (if A:Float > 1.0 then 1.0 else A:Float fi)
     fi .

  --- ============================================================
  ---  Utility functions
  --- ============================================================

  --- Float -> Nat  (floor, non-negative)
  --- Uses iterative subtraction; safe for values up to ~10000.
  op f2n : Float -> Nat .
  eq f2n(X:Float) =
     if X:Float < 5.0e-1 then 0
     else s(f2n(X:Float - 1.0))
     fi .

  --- Ceiling division for Nats:  ceil(A / B)
  op ceilDiv : Nat Nat -> Nat .
  eq ceilDiv(A1:Nat, B1:Nat) =
     if B1:Nat == 0 then 0
     else (A1:Nat + sd(B1:Nat, 1)) quo B1:Nat
     fi .

  --- Round a Float to nearest integer (as Float)
  op roundF : Float -> Float .
  eq roundF(X:Float) =
     if X:Float - floor(X:Float) == 5.0e-1
     then (if f2n(floor(X:Float)) rem 2 == 0
           then floor(X:Float) else floor(X:Float) + 1.0 fi)
     else floor(X:Float + 5.0e-1) fi .

  --- Cube root (positive values only; returns 0 for <= 0)
  op cbrt : Float -> Float .
  eq cbrt(X:Float) =
     if X:Float > 0.0
     then exp(log(X:Float) / 3.0)
     else 0.0
     fi .

  --- Power function for Float base and Nat exponent (binary exponentiation)
  op powF : Float Nat -> Float .
  eq powF(X:Float, 0) = 1.0 .
  eq powF(X:Float, 1) = X:Float .
  ceq powF(X:Float, N:Nat) =
     if N:Nat rem 2 == 0
     then powF(X:Float * X:Float, N:Nat quo 2)
     else X:Float * powF(X:Float * X:Float, N:Nat quo 2)
     fi
  if N:Nat > 1 .


  --- ============================================================
  ---  TCP / Network Constants (Ubuntu 22.04 defaults)
  --- ============================================================

  --- Per-packet serialization delay at 1 Gbps per single hop (seconds)
  --- = 1514 bytes * 8 bits / 1e9 bps
  op serDly1 : -> Float .
  eq serDly1 = 1514.0 * 8.0 / 1.0e9 .

  --- Per-packet serialization delay at 1 Gbps across 2 hops (seconds)
  --- = 2 * serDly1
  op serDly : -> Float .
  eq serDly = 2.0 * serDly1 .

  --- CUBIC constants
  op cubicC : -> Float .  eq cubicC = 4.0e-1 .
  op cubicB : -> Float .  eq cubicB = 7.0e-1 .

  --- RACK reordering window fraction (RTT / 4)
  op rackF : -> Float .   eq rackF = 2.5e-1 .

  --- Minimum retransmission timeout
  op rtoMinC : -> Float .  eq rtoMinC = 2.0e-1 .

  --- Linux delayed ACK minimum timer (40ms)
  op delackMinC : -> Float .  eq delackMinC = 4.0e-2 .

  --- Linux RFC 8985 Tail Loss Probe Timeout (PTO) for a flight of W segments
  op tlpPto : Nat Float -> Float .
  eq tlpPto(W:Nat, RTT0:Float) =
     if W:Nat <= 1
     then max(2.0 * RTT0, 1.5 * RTT0 + delackMinC)
     else 2.0 * RTT0
     fi .

  --- CUBIC W(t) = C * (t - K)^3 + wMax,   K = ((1-B)*wMax/C)^(1/3)
  --- Returns max(1.0, result)
  op cubicW : Float Float -> Float .
  ceq cubicW(T:Float, WM:Float) =
     max(1.0, cubicC * ((T:Float - K:Float) * (T:Float - K:Float)
                                             * (T:Float - K:Float)) + WM:Float)
     if K:Float := cbrt((1.0 - cubicB) * WM:Float / cubicC) .


  --- ============================================================
  ---  Channel Configuration (IID Loss Model)
  --- ============================================================

  sort ChannelCfg .
  ---          p_loss
  op chCfg : Float -> ChannelCfg [ctor] .

  var  CC CC_PATH : ChannelCfg .

  op chLossP : ChannelCfg -> Float .
  eq chLossP(chCfg(P:Float)) = P:Float .

  --- Compose two independent cascaded hops into an end-to-end path
  --- p_e2e = 1 - (1 - p1) * (1 - p2)
  op composeChannels : ChannelCfg ChannelCfg -> ChannelCfg .
  eq composeChannels(chCfg(P1:Float), chCfg(P2:Float)) =
     chCfg(clip01(1.0 - (1.0 - P1:Float) * (1.0 - P2:Float))) .

  --- Check if channel is lossless ("none" profile)
  op isNoneProfile : ChannelCfg -> Bool .
  eq isNoneProfile(chCfg(P:Float)) = P:Float <= 1.0e-10 .


  vars linkAttrs linkAttrs1 linkAttrs2 : AttributeSet .

  --- Make channel from AttributeSet
  --- Supports dropP: directly, or defaults to 0.0 (respects canDrop: false)
  op makeChannel : AttributeSet -> ChannelCfg .
  eq makeChannel((linkAttrs, canDrop: false)) = chCfg(0.0) .
  eq makeChannel((linkAttrs, dropP: P:Float)) = chCfg(clip01(P:Float)) .
  eq makeChannel(linkAttrs) = chCfg(0.0) [owise] .

  op makeChannel : Float -> ChannelCfg .
  eq makeChannel(P:Float) = chCfg(clip01(P:Float)) .

  op getOneWayDelay : AttributeSet -> Float .
  eq getOneWayDelay((linkAttrs, oneWayDelay: OW:Float)) = OW:Float .
  eq getOneWayDelay((linkAttrs, delayConst: D:Float)) = D:Float .
  eq getOneWayDelay(linkAttrs) = 0.0 [owise] .


  --- ============================================================
  ---  Flight Statistics (IID Loss Model)
  --- ============================================================

  --- Result of analysing one flight of W packets
  sort FlightResult .
  ---       p0     pa     el
  op fr : Float  Float  Float -> FlightResult [ctor] .

  var FR FR2 FRB FRB2 : FlightResult .

  op frP0 : FlightResult -> Float .
  op frPa : FlightResult -> Float .
  op frEl : FlightResult -> Float .
  eq frP0(fr(FP0:Float, FPA:Float, FEL:Float)) = FP0:Float .
  eq frPa(fr(FP0:Float, FPA:Float, FEL:Float)) = FPA:Float .
  eq frEl(fr(FP0:Float, FPA:Float, FEL:Float)) = FEL:Float .

  vars IDLE CWND_SS PL LP P0 : Float .

  --- flightStats(W, channelCfg)
  --- Computes closed-form IID loss statistics for a flight of W packets:
  ---   P0 = (1 - p)^W       (probability of zero losses)
  ---   Pa = p^W             (probability of all packets lost)
  ---   El = W * p           (expected number of losses)
  op flightStats : Nat ChannelCfg -> FlightResult .
  eq flightStats(0, CC) = fr(1.0, 0.0, 0.0) .
  ceq flightStats(W:Nat, chCfg(P:Float)) =
     fr(1.0, 0.0, 0.0)
  if P:Float <= 1.0e-15 .
  ceq flightStats(W:Nat, chCfg(P:Float)) =
     fr(0.0, 1.0, float(W:Nat))
  if P:Float >= (1.0 - 1.0e-15) .
  ceq flightStats(W:Nat, chCfg(P:Float)) =
     fr(clip01(powF(1.0 - P:Float, W:Nat)),
        clip01(powF(P:Float, W:Nat)),
        float(W:Nat) * P:Float)
  if P:Float > 1.0e-15 /\ P:Float < (1.0 - 1.0e-15) .



  --- TCP state persists the receiver QuickACK budget across transfers.
  --- -1 represents an unspecified Python None budget/timestamp.
  op cwnd:_ : Float -> Attribute [ctor] .
  op wMax:_ : Float -> Attribute [ctor] .
  op tSince:_ : Float -> Attribute [ctor] .
  op inSS:_ : Bool -> Attribute [ctor] .
  op lastSend:_ : Float -> Attribute [ctor] .
  op lastAck:_ : Float -> Attribute [ctor] .
  op quickacksLeft:_ : Float -> Attribute [ctor] .

  vars CW WM TS LS LA QF NOW OWD1 OWD2 OW RTT0 P PA PP
       DT DR PD OK FAIL DTS DTM FP0 PR PTS PTM CW1 WM1 TS1
       PLOSS WRENO WNO PRTO PFAST EDT : Float .
  vars N SG W F WNEXT IT K Q QR QN PF GROW : Nat .
  vars B INSS ISNEW HP PENDING : Bool .
  vars attrs attrs0 attrs1 ST ST1 : AttributeSet .
  vars DST IXP TD TI FL AL AI AS : FloatList .
  vars FS FLS : NatList .
  vars CC1 CC2 : ChannelCfg .

  op makeTcpState : Float Float Float Bool -> AttributeSet .
  op makeTcpState : Float Float Float Bool Float Float -> AttributeSet .
  op makeTcpState : Float Float Float Bool Float Float Float -> AttributeSet .
  eq makeTcpState(CW, WM, TS, B) = makeTcpState(CW, WM, TS, B, -1.0, -1.0) .
  eq makeTcpState(CW, WM, TS, B, LS, LA) = makeTcpState(CW, WM, TS, B, LS, LA, -1.0) .
  eq makeTcpState(CW, WM, TS, B, LS, LA, QF) =
     (cwnd: CW, wMax: WM, tSince: TS, inSS: B,
      lastSend: LS, lastAck: LA, quickacksLeft: QF) .
  op initTcpState : -> AttributeSet .
  eq initTcpState = makeTcpState(10.0, 10.0 / cubicB, 0.0, true) .

  op hasTcpState : AttributeSet -> Bool .
  eq hasTcpState((attrs, cwnd: CW, wMax: WM, tSince: TS, inSS: B,
                 lastSend: LS, lastAck: LA)) = true .
  eq hasTcpState(attrs) = false [owise] .
  op getLastAck : AttributeSet -> Float .
  eq getLastAck((attrs, lastAck: LA)) = LA .
  eq getLastAck(attrs) = 0.0 [owise] .
  op getLastSend : AttributeSet -> Float .
  eq getLastSend((attrs, lastSend: LS)) = LS .
  eq getLastSend(attrs) = -1.0 [owise] .
  op getQuickacksLeft : AttributeSet -> Float .
  eq getQuickacksLeft((attrs, quickacksLeft: QF)) = QF .
  eq getQuickacksLeft(attrs) = -1.0 [owise] .
  op stateStartTime : AttributeSet -> Float .
  eq stateStartTime(attrs) = max(0.0, getLastAck(attrs)) .

  --- Remove only modeled TCP fields; retain application/flow attributes.
  op clearTcpState : AttributeSet -> AttributeSet .
  eq clearTcpState((attrs, cwnd: CW)) = clearTcpState(attrs) .
  eq clearTcpState((attrs, wMax: WM)) = clearTcpState(attrs) .
  eq clearTcpState((attrs, tSince: TS)) = clearTcpState(attrs) .
  eq clearTcpState((attrs, inSS: B)) = clearTcpState(attrs) .
  eq clearTcpState((attrs, lastSend: LS)) = clearTcpState(attrs) .
  eq clearTcpState((attrs, lastAck: LA)) = clearTcpState(attrs) .
  eq clearTcpState((attrs, quickacksLeft: QF)) = clearTcpState(attrs) .
  eq clearTcpState(attrs) = attrs [owise] .
  op updateTcpState : AttributeSet AttributeSet -> AttributeSet .
  eq updateTcpState(attrs0, attrs1) = (clearTcpState(attrs0), attrs1) .

  op restartCwnd : Float Float -> Float .
  ceq restartCwnd(CW, DT) = restartCwnd(max(10.0, floor(CW * 5.0e-1)), DT - rtoMinC)
    if DT > rtoMinC and CW > 10.0 .
  eq restartCwnd(CW, DT) = CW [owise] .
  op prepareTcpStateForSend : AttributeSet Float -> AttributeSet .
  ceq prepareTcpStateForSend((attrs, cwnd: CW, wMax: WM, tSince: TS,
                             inSS: INSS, lastSend: LS, lastAck: LA), NOW) =
     updateTcpState((attrs, cwnd: CW, wMax: WM, tSince: TS,
                    inSS: INSS, lastSend: LS, lastAck: LA),
       makeTcpState(if B then restartCwnd(CW1, NOW - LS) else CW1 fi,
                    max(1.0, min(WM, 1000.0)),
                    if B then 0.0 else TS fi,
                    if B then true else INSS fi,
                    LS, LA, getQuickacksLeft(attrs)))
    if CW1 := max(2.0, min(CW, 1000.0))
    /\ B := (LS >= 0.0 and LA >= 0.0 and NOW >= LA and NOW - LS > rtoMinC) .
  eq prepareTcpStateForSend(ST, NOW) =
     prepareTcpStateForSend(updateTcpState(ST, initTcpState), NOW) [owise] .

  --- Flight metadata is carried with every segment for ACK-loss TLP recovery.
  sort ForwardResult .
  op forwardR : FloatList FloatList NatList AttributeSet -> ForwardResult [ctor] .
  op repeatNat : Nat Nat -> NatList .
  eq repeatNat(0, F) = nilNatList .
  eq repeatNat(s(N), F) = F :: repeatNat(N, F) .

  op genSSSegs : Nat Nat Nat Nat Float Float -> FloatList .
  eq genSSSegs(K, F, N, SG, DT, OW) =
     if K >= F or SG + K + 1 > N then nilFloatList
     else (DT + float(K) * OW) :: genSSSegs(s(K), F, N, SG, DT, OW) fi .
  op genSSSegsTLP : Nat Nat Nat Nat Float Float Float Float Float -> FloatList .
  eq genSSSegsTLP(K, F, N, SG, DT, OW, PD, DR, DTS) =
     if K >= F or SG + K + 1 > N then nilFloatList
     else (DT + float(K) * OW + PD *
            ((1.0 - powF(PD, sd(F, s(K)))) * DR
             + powF(PD, sd(F, s(K))) * DTS))
          :: genSSSegsTLP(s(K), F, N, SG, DT, OW, PD, DR, DTS) fi .

  --- Expected duration of a lossy flight, including reverse ACK loss.
  op lossyFlightTime : Nat Float Float -> Float .
  ceq lossyFlightTime(F, RTT0, P) =
       FP0 * ((1.0 - P) * RTT0 + P * DTS)
       + PR * (2.0 * RTT0 + RTT0 * rackF) + PTS * DTS + PTM * DTM
    if OK := (1.0 - P) * (1.0 - P)
    /\ FAIL := 1.0 - OK
    /\ DTS := tlpPto(F, RTT0) + OK * RTT0 + FAIL * rtoMinC
    /\ DTM := tlpPto(F, RTT0) + OK * (2.0 * RTT0) + FAIL * rtoMinC
    /\ FP0 := powF(1.0 - P, F)
    /\ PR := max(0.0, (1.0 - P) - FP0)
    /\ PTS := powF(1.0 - P, sd(F, 1)) * P
    /\ PTM := max(0.0, P - PTS) .

  --- Unified forward loop mirrors Python's SS and CA updates. The segment
  --- counter uses actual flight size in SS and the window size in CA.
  op forwardLoop : Nat Nat Nat Float Bool Float Float Float
                   Float Float ChannelCfg FloatList FloatList NatList -> ForwardResult .
  eq forwardLoop(0, N, SG, DT, INSS, CW, WM, TS, OWD1, OWD2, CC, DST, IXP, FS) =
     forwardR(DST, IXP, FS, makeTcpState(CW, WM, TS, INSS)) .
  ceq forwardLoop(s(IT), N, SG, DT, INSS, CW, WM, TS, OWD1, OWD2, CC, DST, IXP, FS) =
     forwardR(DST, IXP, FS, makeTcpState(CW, WM, TS, INSS))
    if SG >= N .

  ceq forwardLoop(s(IT), N, SG, DT, true, CW, WM, TS, OWD1, OWD2, CC, DST, IXP, FS) =
     forwardLoop(IT, N, SG + F, DT + EDT, not B, CW1, WM1, 0.0,
                 OWD1, OWD2, CC, DST ++ TD, IXP ++ TI, FS :: repeatNat(F, F))
    if SG < N
    /\ W := max(1, f2n(roundF(CW)))
    /\ F := min(min(W, 1000), sd(N, SG))
    /\ FR := flightStats(W, CC)
    /\ P0 := if isNoneProfile(CC) and SG + W > 1000
              then 1.0 - float(sd(SG + W, 1000)) / float(W) else frP0(FR) fi
    /\ PL := 1.0 - P0
    /\ RTT0 := 2.0 * (OWD1 + OWD2)
    /\ DR := (2.0 * RTT0 + RTT0 * rackF) * (if isNoneProfile(CC) then 5.0e-1 else 1.0 fi)
    /\ PD := if isNoneProfile(CC) then PL else chLossP(CC) fi
    /\ OK := (1.0 - PD) * (1.0 - PD)
    /\ DTS := tlpPto(F, RTT0) + OK * RTT0 + (1.0 - OK) * rtoMinC
    /\ TD := if isNoneProfile(CC)
              then genSSSegs(0, F, N, SG, DT + (OWD1 + OWD2) + PD * DR, serDly)
              else genSSSegsTLP(0, F, N, SG, DT + (OWD1 + OWD2), serDly, PD, DR, DTS) fi
    /\ TI := if isNoneProfile(CC)
              then genSSSegs(0, F, N, SG, DT + OWD1 + PD * DR, serDly1)
              else genSSSegsTLP(0, F, N, SG, DT + OWD1, serDly1, PD, DR, DTS) fi
    /\ EDT := if isNoneProfile(CC) then P0 * RTT0 + PL * DR
               else lossyFlightTime(F, RTT0, PD) fi
    /\ WNEXT := min(W + F, 1000)
    /\ FR2 := flightStats(WNEXT, CC)
    /\ B := (frEl(FR) >= 5.0e-1 or frEl(FR2) >= 5.0e-1
              or SG + F + W > 1000 or min(W, 1000) >= 1000)
    /\ LP := if PL == 0.0 then frP0(FR2) else P0 fi
    /\ CW1 := if B then max(2.0, min(LP * float(WNEXT)
                    + (1.0 - LP) * max(float(W) * cubicB, 2.0), 1000.0))
               else float(WNEXT) fi
    /\ WM1 := min(CW1 / cubicB, 1000.0) .

  ceq forwardLoop(s(IT), N, SG, DT, false, CW, WM, TS, OWD1, OWD2, CC, DST, IXP, FS) =
     forwardLoop(IT, N, SG + W, DT + EDT, false, CW1, WM1, TS1,
                 OWD1, OWD2, CC,
                 DST ++ genSSSegs(0, F, N, SG, DT + (OWD1 + OWD2), serDly),
                 IXP ++ genSSSegs(0, F, N, SG, DT + OWD1, serDly1),
                 FS :: repeatNat(F, F))
    if SG < N
    /\ W := max(1, f2n(roundF(CW)))
    /\ F := min(W, sd(N, SG))
    /\ FR := flightStats(W, CC)
    /\ P0 := if isNoneProfile(CC) and W > 1000 and W > f2n(roundF(WM))
              then max(0.0, 1.0 - float(sd(W, 1000)) / float(W)) else frP0(FR) fi
    /\ PA := if isNoneProfile(CC) and W > 1000 and W > f2n(roundF(WM))
              then 0.0 else frPa(FR) fi
    /\ PP := max(0.0, 1.0 - P0 - PA)
    /\ RTT0 := 2.0 * (OWD1 + OWD2)
    /\ P := chLossP(CC)
    /\ EDT := max((if isNoneProfile(CC) then float(W) else float(F) fi) * serDly,
                   if isNoneProfile(CC)
                   then P0 * RTT0 + PP * (2.0 * RTT0 + RTT0 * rackF) + PA * rtoMinC
                   else lossyFlightTime(F, RTT0, P) fi)
    /\ PLOSS := PP + PA
    /\ WM1 := if PLOSS > 1.0e-15 then (1.0 - PLOSS) * WM + PLOSS * CW else WM fi
    /\ TS1 := if PLOSS > 1.0e-15 then (1.0 - PLOSS) * (TS + EDT) else TS + EDT fi
    /\ WRENO := CW + float(F) / max(1.0, CW)
    /\ WNO := max(cubicW(TS1, WM1), WRENO)
    /\ PRTO := if isNoneProfile(CC) then PA else PA * (1.0 - (1.0 - P) * (1.0 - P)) fi
    /\ PFAST := if isNoneProfile(CC) then PP else max(0.0, (1.0 - P0) - PRTO) fi
    /\ CW1 := max(2.0, min(P0 * WNO + PFAST * (CW * cubicB) + PRTO * 1.0, 1000.0)) .

  --- Receiver-window growth is independent of sender slow start. Preserve
  --- Python's 72..264 segment/loss heuristic, including ties-to-even rounding.
  op growSurvivalSum : Nat Float Float Float -> Float .
  eq growSurvivalSum(0, P, DT, OW) = OW .
  eq growSurvivalSum(s(N), P, DT, OW) = growSurvivalSum(N, P, DT * P, OW + DT * P) .
  op receiverGrowEnd : Float -> Nat .
  eq receiverGrowEnd(P) =
     if P <= 1.0e-10 then 264
     else 72 + 2 * f2n(roundF(growSurvivalSum(192, 1.0 - P, 1.0, 0.0) / 2.0)) fi .

  --- Explicit emitted ACK events retain the triggering flight's actual size.
  sort AckEvents AckResult ReverseResult .
  op noAckEvents : -> AckEvents [ctor] .
  op ackCons : Float Nat AckEvents -> AckEvents [ctor] .
  op ackR : AckEvents Nat -> AckResult [ctor] .
  op revR : FloatList FloatList Float Float Bool -> ReverseResult [ctor] .
  vars AE : AckEvents .
  var AR : AckResult .
  vars T1 T2 PREV RUN DEAD AT EI ES NI NS REC RI RS : Float .
  op decQuick : Nat -> Nat .
  eq decQuick(0) = 0 .
  eq decQuick(s(Q)) = Q .
  op prependAck : Float Nat AckResult -> AckResult .
  eq prependAck(AT, F, ackR(AE, Q)) = ackR(ackCons(AT, F, AE), Q) .
  op ackLoop : FloatList NatList Nat Nat Bool Float Float Bool Float Nat Nat -> AckResult .
  eq ackLoop(nilFloatList, nilNatList, K, Q, HP, PREV, RUN, PENDING, DEAD, PF, GROW) =
     if PENDING then ackR(ackCons(DEAD, PF, noAckEvents), decQuick(Q)) else ackR(noAckEvents, Q) fi .
  ceq ackLoop(T1 :: FL, F :: FLS, K, Q, HP, PREV, RUN, true, DEAD, PF, GROW) =
     prependAck(DEAD, PF,
       ackLoop(T1 :: FL, F :: FLS, K, decQuick(Q), HP, PREV, RUN, false, 0.0, 0, GROW))
    if DEAD < max(RUN, T1) .
  ceq ackLoop(T1 :: FL, F :: FLS, K, Q, HP, PREV, RUN, PENDING, DEAD, PF, GROW) =
     if QN > 0 or PENDING
     then prependAck(AT, F,
            ackLoop(FL, FLS, s(K), decQuick(QN), true, AT, AT, false, 0.0, 0, GROW))
     else ackLoop(FL, FLS, s(K), QN, true, AT, AT, true, AT + delackMinC, F, GROW) fi
    if (not PENDING or not (DEAD < max(RUN, T1)))
    /\ AT := max(RUN, T1)
    /\ QR := if HP and AT - PREV > rtoMinC then 16 else Q fi
    /\ QN := if K > 72 and K <= GROW then max(QR, 1) else QR fi .

  --- Recover ACK coverage backwards across all flight boundaries. Reverse
  --- loss delays effective coverage; it preserves Python's emitted-ACK slots.
  op recoverAcks : AckEvents Float Float Float Float Float -> ReverseResult .
  eq recoverAcks(noAckEvents, OWD1, OWD2, P, PD, RTT0) =
     revR(nilFloatList, nilFloatList, 0.0, 0.0, false) .
  ceq recoverAcks(ackCons(AT, F, AE), OWD1, OWD2, P, PD, RTT0) =
     revR((EI + OWD2) :: AI, (ES + (OWD1 + OWD2)) :: AS, EI, ES, true)
    if revR(AI, AS, NI, NS, HP) := recoverAcks(AE, OWD1, OWD2, P, PD, RTT0)
    /\ OK := (1.0 - P) * (1.0 - P)
    /\ REC := AT + tlpPto(max(1, F), RTT0) + OK * RTT0 + (1.0 - OK) * rtoMinC
    /\ RI := if HP then min(NI, REC) else REC fi
    /\ RS := if HP then min(NS, REC) else REC fi
    /\ EI := (1.0 - PD) * AT + PD * RI
    /\ ES := (1.0 - P) * AT + P * RS .

  sort TimelineResult .
  op tlR : FloatList FloatList FloatList FloatList AttributeSet -> TimelineResult [ctor] .
  op tlR : FloatList FloatList AttributeSet -> TimelineResult .
  eq tlR(DST, IXP, ST) = tlR(DST, IXP, nilFloatList, nilFloatList, ST) .
  op tlDstTimes : TimelineResult -> FloatList .
  op tlIxpTimes : TimelineResult -> FloatList .
  op tlAckIxpTimes : TimelineResult -> FloatList .
  op tlAckSndTimes : TimelineResult -> FloatList .
  op tlState : TimelineResult -> AttributeSet .
  eq tlDstTimes(tlR(DST, IXP, AI, AS, ST)) = DST .
  eq tlIxpTimes(tlR(DST, IXP, AI, AS, ST)) = IXP .
  eq tlAckIxpTimes(tlR(DST, IXP, AI, AS, ST)) = AI .
  eq tlAckSndTimes(tlR(DST, IXP, AI, AS, ST)) = AS .
  eq tlState(tlR(DST, IXP, AI, AS, ST)) = ST .

  --- Compatibility helper for callers stamping an existing timeline record.
  op stampTcpState : TimelineResult Float Float -> TimelineResult .
  eq stampTcpState(tlR(DST, IXP, AI, AS,
                       (attrs, cwnd: CW, wMax: WM, tSince: TS, inSS: INSS,
                        lastSend: LS, lastAck: LA)), NOW, OW) =
     tlR(DST, IXP, AI, AS,
         updateTcpState((attrs, cwnd: CW, wMax: WM, tSince: TS, inSS: INSS,
                         lastSend: LS, lastAck: LA),
           makeTcpState(CW, WM, TS, INSS, NOW + maxFL(DST) - OW,
                        NOW + (if AS == nilFloatList then maxFL(DST) + OW else maxFL(AS) fi),
                        getQuickacksLeft(attrs)))) .

  --- Five forward and four reverse TCP/TLS handshake packets for new flows.
  op hsTimes : Float Float Float Bool -> FloatList .
  eq hsTimes(OWD1, OWD2, OW, true) =
     OW :: (2.0 * (OWD1 + OWD2) + OW) :: (2.0 * (OWD1 + OWD2) + OW) ::
     (4.0 * (OWD1 + OWD2) + OW) :: (4.0 * (OWD1 + OWD2) + OW) :: nilFloatList .
  eq hsTimes(OWD1, OWD2, OW, false) = nilFloatList .
  op hsAckTimes : Float Float Float Bool -> FloatList .
  eq hsAckTimes(OWD1, OWD2, OW, true) =
     (OWD1 + OWD2 + OW) :: (3.0 * (OWD1 + OWD2) + OW) ::
     (3.0 * (OWD1 + OWD2) + OW) :: (5.0 * (OWD1 + OWD2) + OW) :: nilFloatList .
  eq hsAckTimes(OWD1, OWD2, OW, false) = nilFloatList .

  op finishTimeline : ForwardResult Bool AttributeSet Float Float Float ChannelCfg ChannelCfg -> TimelineResult .
  ceq finishTimeline(forwardR(DST, IXP, FS,
                       (attrs, cwnd: CW, wMax: WM, tSince: TS, inSS: INSS,
                        lastSend: LS, lastAck: LA)), ISNEW, ST, NOW, OWD1, OWD2, CC1, CC2) =
     tlR(hsTimes(OWD1, OWD2, OWD1 + OWD2, ISNEW) ++ DST,
         hsTimes(OWD1, OWD2, OWD1, ISNEW) ++ IXP,
         hsAckTimes(OWD1, OWD2, OWD2, ISNEW) ++ AI,
         hsAckTimes(OWD1, OWD2, OWD1 + OWD2, ISNEW) ++ AS,
         makeTcpState(CW, WM, TS, INSS,
                      NOW + maxFL(DST) - (OWD1 + OWD2),
                      NOW + (if AS == nilFloatList then maxFL(DST) + OWD1 + OWD2 else maxFL(AS) fi),
                      float(Q)))
    if CC_PATH := composeChannels(CC1, CC2)
    /\ P := if isNoneProfile(CC_PATH) then 0.0 else chLossP(CC_PATH) fi
    /\ PD := if isNoneProfile(CC_PATH) then 0.0 else chLossP(CC2) fi
    /\ HP := (not ISNEW and getLastSend(ST) >= 0.0 and getLastAck(ST) >= 0.0 and NOW >= getLastAck(ST))
    /\ ackR(AE, Q) := ackLoop(DST, FS, 1,
                             if ISNEW then 16 else f2n(floor(max(0.0, getQuickacksLeft(ST)))) fi,
                             HP, getLastSend(ST) + (OWD1 + OWD2) - NOW,
                             0.0, false, 0.0, 0, receiverGrowEnd(chLossP(CC_PATH)))
    /\ revR(AI, AS, EI, ES, B) := recoverAcks(AE, OWD1, OWD2, P, PD, 2.0 * (OWD1 + OWD2)) .

  op buildTimelineAt : Nat Float Float ChannelCfg ChannelCfg Bool AttributeSet Float -> TimelineResult .
  eq buildTimelineAt(N, OWD1, OWD2, CC1, CC2, true, ST, NOW) =
     finishTimeline(forwardLoop(100000, N, 0, 4.0 * (OWD1 + OWD2), true,
                                10.0, 10.0 / cubicB, 0.0, OWD1, OWD2,
                                composeChannels(CC1, CC2), nilFloatList, nilFloatList, nilNatList),
                    true, ST, NOW, OWD1, OWD2, CC1, CC2) .
  ceq buildTimelineAt(N, OWD1, OWD2, CC1, CC2, false, ST, NOW) =
     finishTimeline(forwardLoop(100000, N, 0, 0.0, INSS, CW, WM, TS,
                                OWD1, OWD2, composeChannels(CC1, CC2),
                                nilFloatList, nilFloatList, nilNatList),
                    false, ST1, NOW, OWD1, OWD2, CC1, CC2)
    if ST1 := prepareTcpStateForSend(ST, NOW)
    /\ (attrs, cwnd: CW, wMax: WM, tSince: TS, inSS: INSS,
         lastSend: LS, lastAck: LA) := ST1 .

  op buildTimelineResult : Nat Float Float ChannelCfg ChannelCfg Bool AttributeSet -> TimelineResult [memo] .
  eq buildTimelineResult(N, OWD1, OWD2, CC1, CC2, ISNEW, ST) =
     buildTimelineAt(N, OWD1, OWD2, CC1, CC2, ISNEW, ST, stateStartTime(ST)) .
  op buildFinalDestTimeline : Nat Float Float ChannelCfg ChannelCfg -> FloatList .
  op buildFinalDestTimeline : Nat Float Float ChannelCfg ChannelCfg Bool -> FloatList .
  eq buildFinalDestTimeline(N, OWD1, OWD2, CC1, CC2) = buildFinalDestTimeline(N, OWD1, OWD2, CC1, CC2, true) .
  eq buildFinalDestTimeline(N, OWD1, OWD2, CC1, CC2, ISNEW) =
     tlDstTimes(buildTimelineResult(N, OWD1, OWD2, CC1, CC2, ISNEW, initTcpState)) .
  op buildFirstHopTimeline : Nat Float Float ChannelCfg ChannelCfg -> FloatList .
  op buildFirstHopTimeline : Nat Float Float ChannelCfg ChannelCfg Bool -> FloatList .
  eq buildFirstHopTimeline(N, OWD1, OWD2, CC1, CC2) = buildFirstHopTimeline(N, OWD1, OWD2, CC1, CC2, true) .
  eq buildFirstHopTimeline(N, OWD1, OWD2, CC1, CC2, ISNEW) =
     tlIxpTimes(buildTimelineResult(N, OWD1, OWD2, CC1, CC2, ISNEW, initTcpState)) .

  op TCP-HEADER-BYTES : -> Nat .
  op IP-HEADER-BYTES : -> Nat .
  op MTU-SIZE-BYTES : -> Nat .
  op MSS-SIZE-BYTES : -> Nat .
  eq TCP-HEADER-BYTES = 32 [owise] .
  eq IP-HEADER-BYTES = 20 [owise] .
  eq MTU-SIZE-BYTES = 1500 [owise] .
  eq MSS-SIZE-BYTES = MTU-SIZE-BYTES - IP-HEADER-BYTES - TCP-HEADER-BYTES .
  op newCnx:_ : Bool -> Attribute [ctor] .
  op getNewCnx : AttributeSet -> Bool .
  eq getNewCnx((attrs, newCnx: B)) = B .
  eq getNewCnx(attrs) = true [owise] .
  op tcpTimelineResult : Nat AttributeSet AttributeSet Bool AttributeSet Float -> TimelineResult .
  eq tcpTimelineResult(N, linkAttrs1, linkAttrs2, B, ST, NOW) =
     buildTimelineAt(ceilDiv(N, MSS-SIZE-BYTES),
                     getOneWayDelay(linkAttrs1), getOneWayDelay(linkAttrs2),
                     makeChannel(linkAttrs1), makeChannel(linkAttrs2), B, ST, NOW) .
  op tcpFinalDestTimes : Nat AttributeSet AttributeSet Bool AttributeSet Float -> FloatList .
  eq tcpFinalDestTimes(N, linkAttrs1, linkAttrs2, B, ST, NOW) =
     tlDstTimes(tcpTimelineResult(N, linkAttrs1, linkAttrs2, B, ST, NOW)) .
  op tcpFirstHopTimes : Nat AttributeSet AttributeSet Bool AttributeSet Float -> FloatList .
  eq tcpFirstHopTimes(N, linkAttrs1, linkAttrs2, B, ST, NOW) =
     tlIxpTimes(tcpTimelineResult(N, linkAttrs1, linkAttrs2, B, ST, NOW)) .

  --- Packet sizes include both forward and reverse handshake packets.
  op $makeDeliverySizes : Nat Nat NatList -> NatList .
  eq $makeDeliverySizes(0, N, FS) = FS .
  eq $makeDeliverySizes(s(K), N, FS) = $makeDeliverySizes(K, N, FS :: N) .
  op hsSizes : Bool -> NatList .
  eq hsSizes(true) = (IP-HEADER-BYTES + TCP-HEADER-BYTES) ::
                    (IP-HEADER-BYTES + TCP-HEADER-BYTES) :: MTU-SIZE-BYTES ::
                    (IP-HEADER-BYTES + TCP-HEADER-BYTES) :: MTU-SIZE-BYTES :: nilNatList .
  eq hsSizes(false) = nilNatList .
  op hsAckSizes : Bool -> NatList .
  eq hsAckSizes(true) = (IP-HEADER-BYTES + TCP-HEADER-BYTES) ::
                       (IP-HEADER-BYTES + TCP-HEADER-BYTES) :: MTU-SIZE-BYTES ::
                       (IP-HEADER-BYTES + TCP-HEADER-BYTES) :: nilNatList .
  eq hsAckSizes(false) = nilNatList .
  op tcpDeliverySizes : Nat FloatList Bool -> NatList .
  eq tcpDeliverySizes(N, DST, B) =
     hsSizes(B) :: $makeDeliverySizes(sd(ceilDiv(N, MSS-SIZE-BYTES), 1), MTU-SIZE-BYTES, nilNatList)
     :: (sd(N, sd(ceilDiv(N, MSS-SIZE-BYTES), 1) * MSS-SIZE-BYTES) + IP-HEADER-BYTES + TCP-HEADER-BYTES) .
  op tcpDeliverySizes : Nat FloatList -> NatList .
  eq tcpDeliverySizes(N, DST) = tcpDeliverySizes(N, DST, lenFL(DST) > ceilDiv(N, MSS-SIZE-BYTES)) .
  sort PacketSizes .
  op packetSizes : NatList NatList -> PacketSizes [ctor] .
  op tcpDeliverySizes : Nat FloatList FloatList -> PacketSizes .
  op tcpDeliverySizes : Nat FloatList FloatList Bool -> PacketSizes .
  op nonnegativeDifference : Nat Nat -> Nat .
  eq nonnegativeDifference(N, K) = if N >= K then sd(N, K) else 0 fi .
  eq tcpDeliverySizes(N, DST, AL) =
     tcpDeliverySizes(N, DST, AL, lenFL(DST) > ceilDiv(N, MSS-SIZE-BYTES)) .
  eq tcpDeliverySizes(N, DST, AL, B) =
     packetSizes(tcpDeliverySizes(N, DST, B),
       hsAckSizes(B) :: $makeDeliverySizes(nonnegativeDifference(lenFL(AL), if B then 4 else 0 fi),
                                          IP-HEADER-BYTES + TCP-HEADER-BYTES, nilNatList)) .
endm


mod TCP_NODE is
  pr CP2_SORTS .
  pr ACTOR-MODEL .
  pr IRC-BYTESEQ-INTERFACE .
  pr TCP-ANALYTICAL-MODEL .

  vars content : Content .
  vars NOW : Float .
  vars msg : Msg .
  vars j msgSize  : Nat .
  vars b : Bool .
  vars attrs1 attrs2 : AttributeSet .

  op timePacketListAtDst:_ : FloatList     -> Attribute [ctor] .
  op timePacketListAtIxp:_ : FloatList     -> Attribute [ctor] .
  op timeAckListAtIxp:_    : FloatList     -> Attribute [ctor] .
  op timeAckListAtSender:_ : FloatList     -> Attribute [ctor] .
  op tcpState:_            : AttributeSet  -> Attribute [ctor] .
  op nextJ:_               : Nat           -> Attribute [ctor] .

  --- Current NetActor entry point, called by tcpSend for one queued message.
  --- attrs1/attrs2 are per-hop LinkData parameters. ST contains the selected
  --- flow's DNS/busy/TCP fields; tcpSend removes queuedMsgs before this call.
  --- Returns a calculation result record with timePacketListAtDst,
  --- timePacketListAtIxp, timeAckListAtIxp, timeAckListAtSender, tcpState, and nextJ.
  --- Extract tcpState for the computed flow fields; tcpSend restores the queue tail.
  --- Do not store this result wrapper itself as fwdFlow/revFlow.
  --- updateTcpState preserves the non-TCP fields supplied in ST.
  --- Segment times are relative to NOW; lastSend/lastAck in tcpState are absolute.
  ---                                   Seed  Msg Link1Attrs    Link2Attrs    tcpState      now
  op getSegmentDistribution :  Nat   Msg AttributeSet  AttributeSet  AttributeSet  Float -> AttributeSet .
  ceq getSegmentDistribution(j, msg, attrs1, attrs2, ST:AttributeSet, NOW)
    = (timePacketListAtDst: timesAtDst:FloatList,
       timePacketListAtIxp: timesAtIxp:FloatList,
       timeAckListAtIxp: ackTimesAtIxp:FloatList,
       timeAckListAtSender: ackTimesAtSender:FloatList,
       tcpState: updateTcpState(ST:AttributeSet, ST_OUT:AttributeSet),
       nextJ: j)
    if content := getContent(msg)
      /\ attrs1 =/= noneAS 
      /\ attrs2 =/= noneAS 
      /\ msgSize := getSize(content)
      /\ b := not hasTcpState(ST:AttributeSet)
      /\ tlR(timesAtDst:FloatList,
             timesAtIxp:FloatList,
             ackTimesAtIxp:FloatList,
             ackTimesAtSender:FloatList,
             ST_OUT:AttributeSet)
            := tcpTimelineResult(msgSize,
                                 attrs1,
                                 attrs2,
                                 b,
                                 ST:AttributeSet,
                                 NOW)
    [ print "Final-destination time dispersion of segments from " msgSize "B message is " timesAtDst:FloatList  "." ]
  .

  op msgDelay : FloatList -> Float .
  eq msgDelay(nilFloatList) = 0. .
  eq msgDelay(times:FloatList) = maxFL(times:FloatList) .

endm
eof

--- ================================================================
---  Verification / Test Commands
--- ================================================================

--- Test 1: IID Flight statistics for 10-packet flight with 1% loss
red flightStats(10, chCfg(0.01)) .

--- Test 2: Channel composition for two 1% loss links
red composeChannels(chCfg(0.01), chCfg(0.01)) .

--- Test 3: isNoneProfile checks
red isNoneProfile(chCfg(0.0)) .
red isNoneProfile(chCfg(0.01)) .

--- Test 4: Full delivery times for 50 segments (72400 bytes)
---   None profile (0% loss) + 20ms one-way delay (buffer-capacity path)
red tcpFinalDestTimes(72400, (dropP: 0.0, oneWayDelay: 2.0e-2), (dropP: 0.0, oneWayDelay: 2.0e-2), true, initTcpState, 0.0) .

--- Test 5: Full delivery times for 50 segments (72400 bytes)
---   1% loss profile + 20ms one-way delay
red tcpFinalDestTimes(72400, (dropP: 0.01, oneWayDelay: 2.0e-2), (dropP: 0.01, oneWayDelay: 2.0e-2), true, initTcpState, 0.0) .
