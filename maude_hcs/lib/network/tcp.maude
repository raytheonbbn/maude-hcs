sload ../../deps/dns_formalization/Maude/common/actor.maude
sload ../../deps/dns_formalization/Maude/common/parameters.maude
sload ../common/maude/_aux.maude
sload ../common/maude/cp2-interfaces.maude

mod TCP_SOCKET is
  pr ACTOR-MODEL .
  --- This indicates that the sending node wants a TCP connection.
  sorts TcpAddress .
  subsorts TcpAddress < Address .

  op tcp : Address -> TcpAddress .
endm

--- ================================================================
--- TCP Analytical Model in Maude
--- ================================================================
---
--- Faithful translation of tcp_analytical_model.py into pure
--- equational Maude.  Computes E[T_k]: expected arrival time of
--- the k-th TCP data segment at the server, measured from the
--- client's first SYN transmission.
---
--- Models TCP as implemented in Ubuntu 22.04 (Linux 5.15+):
---   CUBIC congestion control, SACK, RACK-TLP loss detection,
---   3-way handshake, Slow Start, Congestion Avoidance,
---   Fast Retransmit / Fast Recovery via SACK, RTO on total loss.
---
--- Channel: IID packet loss model
---   dropP: packet drop probability p in [0, 1]
---   End-to-end 2-hop composite loss: p_e2e = 1 - (1 - p1) * (1 - p2)
---
--- Loss is unidirectional: only client->server path is modelled.
--- ================================================================


--- ================================================================
--- Module: TCP-ANALYTICAL-MODEL
---   Channel model, flight analysis, timeline builder, public API.
--- ================================================================
mod TCP-ANALYTICAL-MODEL is
  pr NAT .
  pr INT .
  pr FLOAT .
  pr CONVERSION .
  pr PARAMETERS-BASE-COMMON .

  --- Clip to [0, 1]
  op clip01 : Float -> Float .
  eq clip01(A:Float) =
     if A:Float < 0.0 then 0.0
     else (if A:Float > 1.0 then 1.0 else A:Float fi)
     fi .

  --- ============================================================
  ---  FloatList
  --- ============================================================
  sort FloatList .
  sort NatList .
  subsort Nat < NatList .
  op nilNatList : -> NatList [ctor] .
  op _::_ : NatList NatList -> NatList [ctor assoc id: nilNatList] .
  op nilFL : -> FloatList [ctor] .
  subsort Float < FloatList .
  op _::_ : FloatList FloatList -> FloatList [ctor assoc id: nilFL] .

  vars F G : Float .
  vars L L1 L2 : FloatList .

  op lenFL : FloatList -> Nat .
  eq lenFL(nilFL) = 0 .
  eq lenFL(F :: L) = s(lenFL(L)) .

  op maxFL : FloatList -> Float .
  eq maxFL(nilFL) = 0.0 .
  eq maxFL(F :: L) = max(F, maxFL(L)) .

  op _++_ : FloatList FloatList -> FloatList .
  eq nilFL ++ L = L .
  eq (F :: L1) ++ L2 = F :: (L1 ++ L2) .


  --- ============================================================
  ---  Utility functions
  --- ============================================================

  --- Float -> Nat  (floor, non-negative)
  --- Uses iterative subtraction; safe for values up to ~10000.
  op f2n : Float -> Nat .
  eq f2n(X:Float) =
     if X:Float < 5.0e-1 then 0
     else s(f2n(X:Float - 1.0))
     fi .

  --- Ceiling division for Nats:  ceil(A / B)
  op ceilDiv : Nat Nat -> Nat .
  eq ceilDiv(A1:Nat, B1:Nat) =
     if B1:Nat == 0 then 0
     else (A1:Nat + sd(B1:Nat, 1)) quo B1:Nat
     fi .

  --- Round a Float to nearest integer (as Float)
  op roundF : Float -> Float .
  eq roundF(X:Float) = floor(X:Float + 5.0e-1) .

  --- Cube root (positive values only; returns 0 for <= 0)
  op cbrt : Float -> Float .
  eq cbrt(X:Float) =
     if X:Float > 0.0
     then exp(log(X:Float) / 3.0)
     else 0.0
     fi .

  --- Power function for Float base and Nat exponent (binary exponentiation)
  op powF : Float Nat -> Float .
  eq powF(X:Float, 0) = 1.0 .
  eq powF(X:Float, 1) = X:Float .
  ceq powF(X:Float, N:Nat) =
     if N:Nat rem 2 == 0
     then powF(X:Float * X:Float, N:Nat quo 2)
     else X:Float * powF(X:Float * X:Float, N:Nat quo 2)
     fi
  if N:Nat > 1 .


  --- ============================================================
  ---  TCP / Network Constants (Ubuntu 22.04 defaults)
  --- ============================================================

  --- Per-packet serialization delay at 1 Gbps per single hop (seconds)
  --- = 1514 bytes * 8 bits / 1e9 bps
  op serDly1 : -> Float .
  eq serDly1 = 1514.0 * 8.0 / 1.0e9 .

  --- Per-packet serialization delay at 1 Gbps across 2 hops (seconds)
  --- = 2 * serDly1
  op serDly : -> Float .
  eq serDly = 2.0 * serDly1 .

  --- CUBIC constants
  op cubicC : -> Float .  eq cubicC = 4.0e-1 .
  op cubicB : -> Float .  eq cubicB = 7.0e-1 .

  --- RACK reordering window fraction (RTT / 4)
  op rackF : -> Float .   eq rackF = 2.5e-1 .

  --- Minimum retransmission timeout
  op rtoMinC : -> Float .  eq rtoMinC = 2.0e-1 .

  --- CUBIC W(t) = C * (t - K)^3 + wMax,   K = ((1-B)*wMax/C)^(1/3)
  --- Returns max(1.0, result)
  op cubicW : Float Float -> Float .
  ceq cubicW(T:Float, WM:Float) =
     max(1.0, cubicC * ((T:Float - K:Float) * (T:Float - K:Float)
                                             * (T:Float - K:Float)) + WM:Float)
     if K:Float := cbrt((1.0 - cubicB) * WM:Float / cubicC) .


  --- ============================================================
  ---  Channel Configuration (IID Loss Model)
  --- ============================================================

  sort ChannelCfg .
  ---          p_loss
  op chCfg : Float -> ChannelCfg [ctor] .

  var  CC CC_PATH : ChannelCfg .

  op chLossP : ChannelCfg -> Float .
  eq chLossP(chCfg(P:Float)) = P:Float .

  --- Compose two independent cascaded hops into an end-to-end path
  --- p_e2e = 1 - (1 - p1) * (1 - p2)
  op composeChannels : ChannelCfg ChannelCfg -> ChannelCfg .
  eq composeChannels(chCfg(P1:Float), chCfg(P2:Float)) =
     chCfg(clip01(1.0 - (1.0 - P1:Float) * (1.0 - P2:Float))) .

  --- Check if channel is lossless ("none" profile)
  op isNoneProfile : ChannelCfg -> Bool .
  eq isNoneProfile(chCfg(P:Float)) = P:Float <= 1.0e-10 .


  vars linkAttrs linkAttrs1 linkAttrs2 : AttributeSet .

  --- Make channel from AttributeSet
  --- Supports dropP: directly, or defaults to 0.0 (respects canDrop: false)
  op makeChannel : AttributeSet -> ChannelCfg .
  eq makeChannel((linkAttrs, canDrop: false)) = chCfg(0.0) .
  eq makeChannel((linkAttrs, dropP: P:Float)) = chCfg(clip01(P:Float)) .
  eq makeChannel(linkAttrs) = chCfg(0.0) [owise] .

  op makeChannel : Float -> ChannelCfg .
  eq makeChannel(P:Float) = chCfg(clip01(P:Float)) .

  op getOneWayDelay : AttributeSet -> Float .
  eq getOneWayDelay((linkAttrs, oneWayDelay: OW:Float)) = OW:Float .
  eq getOneWayDelay((linkAttrs, delayConst: D:Float)) = D:Float .
  eq getOneWayDelay(linkAttrs) = 0.0 [owise] .


  --- ============================================================
  ---  Flight Statistics (IID Loss Model)
  --- ============================================================

  --- Result of analysing one flight of W packets
  sort FlightResult .
  ---       p0     pa     el
  op fr : Float  Float  Float -> FlightResult [ctor] .

  var FR FR1 FR2 FRB FRB2 : FlightResult .

  op frP0 : FlightResult -> Float .
  op frPa : FlightResult -> Float .
  op frEl : FlightResult -> Float .
  eq frP0(fr(FP0:Float, FPA:Float, FEL:Float)) = FP0:Float .
  eq frPa(fr(FP0:Float, FPA:Float, FEL:Float)) = FPA:Float .
  eq frEl(fr(FP0:Float, FPA:Float, FEL:Float)) = FEL:Float .

  vars P01 P02 PF1 PF2 P0S PAS ELS ELT CWND_SS CWND_SSB PL LP P0 EL : Float .

  --- flightStats(W, channelCfg)
  --- Computes closed-form IID loss statistics for a flight of W packets:
  ---   P0 = (1 - p)^W       (probability of zero losses)
  ---   Pa = p^W             (probability of all packets lost)
  ---   El = W * p           (expected number of losses)
  op flightStats : Nat ChannelCfg -> FlightResult .
  eq flightStats(0, CC) = fr(1.0, 0.0, 0.0) .
  ceq flightStats(W:Nat, chCfg(P:Float)) =
     fr(1.0, 0.0, 0.0)
  if P:Float <= 1.0e-15 .
  ceq flightStats(W:Nat, chCfg(P:Float)) =
     fr(0.0, 1.0, float(W:Nat))
  if P:Float >= (1.0 - 1.0e-15) .
  ceq flightStats(W:Nat, chCfg(P:Float)) =
     fr(clip01(powF(1.0 - P:Float, W:Nat)),
        clip01(powF(P:Float, W:Nat)),
        float(W:Nat) * P:Float)
  if P:Float > 1.0e-15 /\ P:Float < (1.0 - 1.0e-15) .


  --- ============================================================
  ---  Segment Time Generators
  --- ============================================================

  --- genSSSegs(i, W, N, seg, baseTime, ser)
  ---   Generates times for slow-start segments: seg+i+1 .. min(seg+W, N)
  ---   time_k = baseTime + i * ser
  op genSSSegs : Nat Nat Nat Nat Float Float -> FloatList .
  eq genSSSegs(I:Nat, W:Nat, N:Nat, SG:Nat, BT:Float, SR:Float) =
     if I:Nat >= W:Nat or (SG:Nat + I:Nat + 1) > N:Nat
     then nilFL
     else (BT:Float + float(I:Nat) * SR:Float)
          :: genSSSegs(s(I:Nat), W:Nat, N:Nat, SG:Nat, BT:Float, SR:Float)
     fi .

  --- genCASegs(kIdx, segEnd, N, segStart, E_del, W, t, O, ser)
  ---   Generates times for CA segments: kIdx .. min(segEnd, N)
  ---   fractional_offset = (kIdx - 1 - segStart) / max(1.0, E_del)
  ---   time_k = t + O + fractional_offset * W * ser
  op genCASegs : Nat Nat Nat Nat Float Nat Float Float Float -> FloatList .
  eq genCASegs(KI:Nat, SE:Nat, N:Nat, SS:Nat, ED:Float,
              W:Nat, T:Float, OW:Float, SR:Float) =
     if KI:Nat > SE:Nat or KI:Nat > N:Nat
     then nilFL
     else (T:Float + OW:Float +
           ((float(sd(KI:Nat, s(SS:Nat))) / max(1.0, ED:Float))
            * float(W:Nat) * SR:Float))
          :: genCASegs(s(KI:Nat), SE:Nat, N:Nat, SS:Nat, ED:Float,
                       W:Nat, T:Float, OW:Float, SR:Float)
     fi .


  --- ============================================================
  ---  Slow Start Phase
  --- ============================================================

  --- ============================================================
  ---  TCP Congestion State & Timeline Result
  --- ============================================================

  sort TcpState .
  ---                 cwnd   wMax   tSince inSS
  op tcpState :       Float  Float  Float  Bool -> TcpState [ctor] .
  op tcpState :       Float  Float  Float -> TcpState .
  eq tcpState(CWND, WMX, TS) = tcpState(CWND, WMX, TS, false) .
  op initTcpState :   -> TcpState .
  eq initTcpState =   tcpState(10.0, 10.0 / cubicB, 0.0, true) .

  op tcpState:_ :     TcpState -> Attribute [ctor] .

  op getTcpState : AttributeSet -> TcpState .
  eq getTcpState((attrs, tcpState: ST:TcpState)) = ST:TcpState .
  eq getTcpState(attrs) = initTcpState [owise] .

  op updateTcpState : AttributeSet TcpState -> AttributeSet .
  eq updateTcpState((attrs, tcpState: ST0:TcpState), ST:TcpState) = (attrs, tcpState: ST:TcpState) .
  eq updateTcpState(attrs, ST:TcpState) = (attrs, tcpState: ST:TcpState) [owise] .

  sort TimelineResult .
  ---                 times      state
  op tlR :            FloatList  TcpState -> TimelineResult [ctor] .
  op tlTimes :        TimelineResult -> FloatList .
  op tlState :        TimelineResult -> TcpState .
  eq tlTimes(tlR(FL:FloatList, S:TcpState)) = FL:FloatList .
  eq tlState(tlR(FL:FloatList, S:TcpState)) = S:TcpState .

  --- SSResult: state after slow start completes
  sort SSResult .
  ---         t       seg    flt    times     lastP0   Wss    inSS
  op ssR : Float    Nat    Nat    FloatList  Float    Nat    Bool
           -> SSResult [ctor] .

  --- ssLoop(t, seg, flt, Wss, N, O, OWOFF, SRHOP, CC, acc)
  --- Implements the slow-start while loop from _build_timeline
  --- (no-buffer path: LOCAL_MAX_CWND = 50)

  op ssLoop : Float Nat Nat Nat Nat Float Float Float ChannelCfg FloatList
              -> SSResult .

  vars T OW OWOFF SRHOP RTT0 DT PA PP EDel EDT WM0 TSC0 WR WNO CNX PLOSS OWD1 OWD2 DT_REC P_DROP : Float .
  vars CC1 CC2 : ChannelCfg .
  vars isNew ISNEW : Bool .
  vars CWND CWND0 : Float .
  vars CW0 CW1 CW2 WMX PLL CWF WMF TSCF TSCF0 EDT0 TS : Float .
  vars SG SG2 N W FLT WSS WNXT IT : Nat .
  var  SGS SGE : Nat .
  var  SEGF : Float .
  var  ACC FL : FloatList .
  vars SX  B INSS : Bool .
  vars ST ST_OUT ST0 S : TcpState .
  vars TLR : TimelineResult .
  vars attrs attrs0 attrs1 : AttributeSet .

  --- Buffer-path variables (ssLoopBuf / caLoopBuf)
  vars P0CH P0B PLB BDRP RTTB DTB DT_RECB : Float .
  vars P0CH2 PACH2 CADRP EDelB EDT0B EDTB : Float .
  vars CWFB WMFB TSCF0B TSCFB : Float .
  vars PLLB CWB0 CWB1 CWB2 WMXB : Float .
  var  WMR WNXTB : Nat .
  var  SXB : Bool .
  var  NSEGB NSB NSEGS NS : FloatList .

  --- Base case: all segments delivered during SS
  ceq ssLoop(T, SG, FLT, WSS, N, OW, OWOFF, SRHOP, CC, ACC) =
     ssR(T, SG, FLT, ACC, 1.0, WSS, true)
  if SG >= N .

  --- Recursive case: process one SS flight
  ceq ssLoop(T, SG, FLT, WSS, N, OW, OWOFF, SRHOP, CC, ACC) =
     if SX
     then ssR(T + DT, SG + f2n(CWND_SS), s(FLT), ACC ++ NSEGS,
              if PL > 1.0e-15 then P0 else frP0(FR2) fi, WSS, false)
     else ssLoop(T + DT, SG + f2n(CWND_SS), s(FLT), WNXT,
                 N, OW, OWOFF, SRHOP, CC, ACC ++ NSEGS)
     fi
  if SG < N
  /\ CWND_SS := min(float(WSS), 1000.0)
  /\ FR := flightStats(WSS, CC)
  /\ P0 := frP0(FR)
  /\ PL := 1.0 - P0
  /\ RTT0 := 2.0 * OW
  /\ DT_REC := 2.0 * RTT0 + RTT0 * rackF
  /\ DT := P0 * RTT0 + PL * DT_REC
  /\ P_DROP := chLossP(CC)
  /\ NSEGS := genSSSegs(0, f2n(CWND_SS), N, SG, T + OWOFF + P_DROP * DT_REC, SRHOP)
  /\ WNXT := min(WSS + WSS, 1000)
  /\ FR2 := flightStats(WNXT, CC)
  /\ SX := (frEl(FR) >= 5.0e-1 or frEl(FR2) >= 5.0e-1 or float(WSS) >= 1000.0)
  .


  --- ============================================================
  ---  Slow Start Phase — Buffer-Capacity Path
  --- ============================================================

  op ssLoopBuf : Float Nat Nat Nat Nat Float Float Float ChannelCfg FloatList
                 -> SSResult .

  --- Base case: all segments delivered
  ceq ssLoopBuf(T, SG, FLT, WSS, N, OW, OWOFF, SRHOP, CC, ACC) =
     ssR(T, SG, FLT, ACC, 1.0, WSS, true)
  if SG >= N .

  --- Recursive case: one buffer-path SS flight
  ceq ssLoopBuf(T, SG, FLT, WSS, N, OW, OWOFF, SRHOP, CC, ACC) =
     if SXB
     then ssR(T + DTB, SG + WSS, s(FLT),
              ACC ++ NSEGB,
              if PLB < 1.0e-15
              then frP0(FRB2)
              else P0B fi,
              WSS, false)
     else ssLoopBuf(T + DTB, SG + WSS, s(FLT),
                    WNXTB, N, OW, OWOFF, SRHOP, CC,
                    ACC ++ NSEGB)
     fi
  if SG < N
  --- Flight stats from channel
  /\ FRB := flightStats(WSS, CC)
  /\ P0CH := frP0(FRB)
  --- Buffer overflow: if seg + Wss > 1000, compute dropped packets
  /\ BDRP := if float(SG + WSS) > 1000.0
              then float(SG + WSS) - 1000.0
              else 0.0 fi
  --- Loss probability (buffer overflow overrides channel loss)
  /\ PLB := if BDRP > 1.0e-15
             then BDRP / float(WSS)
             else 1.0 - P0CH fi
  /\ P0B := 1.0 - PLB
  --- Time step: dt = p0*RTT + p_l*(2*RTT + RTT*rackF)*0.5
  /\ RTTB := 2.0 * OW
  /\ DT_RECB := (2.0 * RTTB + RTTB * rackF) * 5.0e-1
  /\ DTB := P0B * RTTB + PLB * DT_RECB
  --- Segments
  /\ NSEGB := genSSSegs(0, WSS, N, SG, T + OWOFF + PLB * DT_RECB, SRHOP)
  --- Next flight for exit check (cap at 1000)
  /\ WNXTB := if WSS + WSS > 1000 then 1000 else WSS + WSS fi
  /\ FRB2 := flightStats(WNXTB, CC)
  --- Exit: el > 0.5 or buffer overflow happened or at max cwnd
  /\ SXB := (frEl(FRB) >= 5.0e-1
             or frEl(FRB2) >= 5.0e-1
             or BDRP > 0.0
             or WSS >= 1000)
  .


  --- ============================================================
  ---  Congestion Avoidance Phase — No-Buffer Path
  --- ============================================================

  --- caPhase: transition from SS result to CA, then run CA loop
  --- (LOCAL_MAX_CWND = 1000)
  op caPhase : SSResult Nat Float Float Float ChannelCfg -> TimelineResult .

  ceq caPhase(ssR(T, SG, FLT, ACC, LP, WSS, INSS), N, OW, OWOFF, SRHOP, CC) =
     if INSS
     then tlR(ACC, tcpState(float(min(WSS, 1000)), float(min(WSS, 1000)) / cubicB, 0.0, true))
     else (if SG >= N
           then tlR(ACC, tcpState(CW2, WMX, 0.0, false))
           else caLoop(100000, T, float(SG), FLT, CW2, WMX,
                       0.0, N, OW, OWOFF, SRHOP, CC, ACC)
           fi)
     fi
  if PLL := 1.0 - LP
  /\ CW0 := LP * float(WSS + WSS)
                   + PLL * max(float(WSS) * cubicB, 2.0)
  /\ CW1 := max(2.0, CW0)
  /\ CW2 := max(2.0, min(CW1, 1000.0))
  /\ WMX := min(CW2 / cubicB, 1000.0)
  .

  --- caLoop(iter, t, segF, flt, cwnd, wMax, tSince,
  ---        N, O, OWOFF, SRHOP, CC, acc)
  --- Implements the congestion-avoidance for-loop from _build_timeline.
  --- (LOCAL_MAX_CWND = 1000)

  op caLoop : Nat Float Float Nat Float Float Float
              Nat Float Float Float ChannelCfg FloatList -> TimelineResult .

  --- Base: iteration limit
  eq caLoop(0, T, SEGF, FLT, CWND, WM0, TSC0,
            N, OW, OWOFF, SRHOP, CC, ACC) =
     tlR(ACC, tcpState(CWND, WM0, TSC0, false)) .

  --- Base: all segments delivered
  ceq caLoop(s(IT), T, SEGF, FLT, CWND, WM0, TSC0,
             N, OW, OWOFF, SRHOP, CC, ACC) =
     tlR(ACC, tcpState(CWND, WM0, TSC0, false))
  if SEGF >= float(N) .

  --- Recursive: one CA step
  ceq caLoop(s(IT), T, SEGF, FLT, CWND, WM0, TSC0,
             N, OW, OWOFF, SRHOP, CC, ACC) =
     caLoop(IT, T + EDT, SEGF + EDel, s(FLT), CWF,
            WMF, TSCF, N, OW, OWOFF, SRHOP, CC, ACC ++ NS)
  if SEGF < float(N)
  --- Window as integer
  /\ W := max(1, f2n(roundF(CWND)))
  --- Flight statistics
  /\ FR := flightStats(W, CC)
  /\ P0  := frP0(FR)
  /\ PA  := frPa(FR)
  /\ PP  := max(0.0, 1.0 - P0 - PA)
  --- RTT
  /\ RTT0 := 2.0 * OW
  --- Expected delivery step size (W segments)
  /\ EDel := float(W)
  --- Integer segment boundaries
  /\ SGS := f2n(floor(SEGF))
  /\ SGE := f2n(floor(SEGF + EDel))
  --- Expected time step
  /\ EDT0 := P0 * RTT0
                    + PP * (2.0 * RTT0 + RTT0 * rackF)
                    + PA * rtoMinC
  /\ EDT := max(EDel * serDly, EDT0)
  --- Generate segment times
  /\ NS := genCASegs(s(SGS), SGE, N, SGS, EDel,
                               W, T, OWOFF, SRHOP)
  --- Window dynamics
  /\ PLOSS := PP + PA
  /\ WMF :=
       if PLOSS > 1.0e-15
       then (1.0 - PLOSS) * WM0 + PLOSS * CWND
       else WM0
       fi
  /\ TSCF0 :=
       if PLOSS > 1.0e-15
       then (1.0 - PLOSS) * (TSC0 + EDT)
       else TSC0 + EDT
       fi
  /\ WR  := CWND + (1.0 / max(1.0, CWND))
  /\ WNO := max(cubicW(TSCF0, WMF), WR)
  /\ CNX := P0 * WNO + PP * (CWND * cubicB) + PA * 1.0
  /\ CWF := max(2.0, min(CNX, 1000.0))
  /\ TSCF := TSCF0
  .

  --- Fallback: return accumulated list if conditions cannot be met
  eq caLoop(IT, T, SEGF, FLT, CWND, WM0, TSC0,
            N, OW, OWOFF, SRHOP, CC, ACC) =
     tlR(ACC, tcpState(CWND, WM0, TSC0, false)) [owise] .


  --- ============================================================
  ---  Congestion Avoidance Phase — Buffer-Capacity Path
  --- ============================================================

  --- caPhaseBuf: transition from SS result to buffer CA loop
  op caPhaseBuf : SSResult Nat Float Float Float ChannelCfg -> TimelineResult .

  ceq caPhaseBuf(ssR(T, SG, FLT, ACC, LP, WSS, INSS), N, OW, OWOFF, SRHOP, CC) =
     if INSS
     then tlR(ACC, tcpState(float(min(WSS, 1000)), float(min(WSS, 1000)) / cubicB, 0.0, true))
     else (if SG >= N
           then tlR(ACC, tcpState(CWB2, WMXB, 0.0, false))
           else caLoopBuf(100000, T, float(SG), FLT, CWB2, WMXB,
                          0.0, N, OW, OWOFF, SRHOP, CC, ACC)
           fi)
     fi
  if PLLB := 1.0 - LP
  /\ CWB0 := LP * float(WSS + WSS)
               + PLLB * max(float(WSS) * cubicB, 2.0)
  /\ CWB1 := max(2.0, CWB0)
  /\ CWB2 := max(2.0, min(CWB1, 1000.0))
  /\ WMXB := min(CWB2 / cubicB, 1000.0)
  .

  --- caLoopBuf(iter, t, segF, flt, cwnd, wMax, tSince,
  ---           N, O, OWOFF, SRHOP, CC, acc)
  --- Buffer-capacity CA loop (MAX_CWND = 1000, BUFFER_CAPACITY = 1000).

  op caLoopBuf : Nat Float Float Nat Float Float Float
                 Nat Float Float Float ChannelCfg FloatList -> TimelineResult .

  --- Base: iteration limit
  eq caLoopBuf(0, T, SEGF, FLT, CWND, WM0, TSC0,
               N, OW, OWOFF, SRHOP, CC, ACC) =
     tlR(ACC, tcpState(CWND, WM0, TSC0, false)) .

  --- Base: all segments delivered
  ceq caLoopBuf(s(IT), T, SEGF, FLT, CWND, WM0, TSC0,
                N, OW, OWOFF, SRHOP, CC, ACC) =
     tlR(ACC, tcpState(CWND, WM0, TSC0, false))
  if SEGF >= float(N) .

  --- Recursive: one buffer CA step
  ceq caLoopBuf(s(IT), T, SEGF, FLT, CWND, WM0, TSC0,
                N, OW, OWOFF, SRHOP, CC, ACC) =
     caLoopBuf(IT, T + EDTB, SEGF + EDelB, s(FLT),
               CWFB, WMFB, TSCFB,
               N, OW, OWOFF, SRHOP, CC, ACC ++ NSB)
  if SEGF < float(N)
  --- Window as integer
  /\ W := max(1, f2n(roundF(CWND)))
  --- Flight statistics from channel
  /\ FR := flightStats(W, CC)
  /\ P0CH2 := frP0(FR)
  /\ PACH2 := frPa(FR)
  --- Buffer overflow in CA: W > 1000 and W > round(w_max)
  /\ WMR := max(1, f2n(roundF(WM0)))
  /\ CADRP := if W > 1000 and W > WMR
               then float(sd(W, 1000))
               else 0.0 fi
  --- Override p0/pa if buffer overflow
  /\ P0 := if CADRP > 1.0e-15
            then max(0.0, 1.0 - CADRP / float(W))
            else P0CH2 fi
  /\ PA := if CADRP > 1.0e-15
            then 0.0
            else PACH2 fi
  /\ PP := max(0.0, 1.0 - P0 - PA)
  --- RTT
  /\ RTT0 := 2.0 * OW
  --- Expected delivery step size (W segments)
  /\ EDelB := float(W)
  --- Integer segment boundaries
  /\ SGS := f2n(floor(SEGF))
  /\ SGE := f2n(floor(SEGF + EDelB))
  --- Expected time step (MAX_CWND = 1000)
  /\ EDT0B := P0 * RTT0
               + PP * (2.0 * RTT0 + RTT0 * rackF)
               + PA * rtoMinC
  /\ EDTB := max(EDelB * serDly, EDT0B)
  --- Generate segment times
  /\ NSB := genCASegs(s(SGS), SGE, N, SGS, EDelB,
                       W, T, OWOFF, SRHOP)
  --- Window dynamics (same structure, MAX_CWND = 1000)
  /\ PLOSS := PP + PA
  /\ WMFB :=
       if PLOSS > 1.0e-15
       then (1.0 - PLOSS) * WM0 + PLOSS * CWND
       else WM0
       fi
  /\ TSCF0B :=
       if PLOSS > 1.0e-15
       then (1.0 - PLOSS) * (TSC0 + EDTB)
       else TSC0 + EDTB
       fi
  /\ WR  := CWND + (1.0 / max(1.0, CWND))
  /\ WNO := max(cubicW(TSCF0B, WMFB), WR)
  /\ CNX := P0 * WNO + PP * (CWND * cubicB) + PA * 1.0
  /\ CWFB := max(2.0, min(CNX, 1000.0))
  /\ TSCFB := TSCF0B
  .

  --- Fallback
  eq caLoopBuf(IT, T, SEGF, FLT, CWND, WM0, TSC0,
               N, OW, OWOFF, SRHOP, CC, ACC) =
     tlR(ACC, tcpState(CWND, WM0, TSC0, false)) [owise] .


  --- ============================================================
  ---  Public API
  --- ============================================================

  op TCP-HEADER-BYTES : -> Nat .
  op IP-HEADER-BYTES  : -> Nat .
  op MTU-SIZE-BYTES   : -> Nat .
  op MSS-SIZE-BYTES   : -> Nat .
  eq TCP-HEADER-BYTES = 32 [owise] .
  eq IP-HEADER-BYTES  = 20 [owise] .
  eq MTU-SIZE-BYTES   = 1500 [owise] .
  eq MSS-SIZE-BYTES   = MTU-SIZE-BYTES - IP-HEADER-BYTES - TCP-HEADER-BYTES .

  op newCnx:_ : Bool -> Attribute [ctor] .

  --- Extract newCnx flag (defaults to true if not present)
  op getNewCnx : AttributeSet -> Bool .
  eq getNewCnx((linkAttrs, newCnx: B)) = B .
  eq getNewCnx(linkAttrs) = true [owise] .

  --- buildFinalDestResult(N, OWD1, OWD2, CC1, CC2, ISNEW, ST) - Destination Server (Hop 2 Arrival)
  op buildFinalDestResult : Nat Float Float ChannelCfg ChannelCfg Bool TcpState -> TimelineResult .
  eq buildFinalDestResult(N, OWD1, OWD2, CC1, CC2, ISNEW, ST:TcpState) =
     buildTimelineHop(N, OWD1, OWD2, OWD1 + OWD2, serDly, CC1, CC2, ISNEW, ST:TcpState) .

  op buildFirstHopResult : Nat Float Float ChannelCfg ChannelCfg Bool TcpState -> TimelineResult .
  eq buildFirstHopResult(N, OWD1, OWD2, CC1, CC2, ISNEW, ST:TcpState) =
     buildTimelineHop(N, OWD1, OWD2, OWD1, serDly1, CC1, CC2, ISNEW, ST:TcpState) .

  --- Legacy timeline builders returning FloatList
  op buildFinalDestTimeline : Nat Float Float ChannelCfg ChannelCfg -> FloatList .
  eq buildFinalDestTimeline(N, OWD1, OWD2, CC1, CC2) = buildFinalDestTimeline(N, OWD1, OWD2, CC1, CC2, true) .

  op buildFinalDestTimeline : Nat Float Float ChannelCfg ChannelCfg Bool -> FloatList .
  eq buildFinalDestTimeline(N, OWD1, OWD2, CC1, CC2, ISNEW) =
     tlTimes(buildFinalDestResult(N, OWD1, OWD2, CC1, CC2, ISNEW, initTcpState)) .

  op buildFirstHopTimeline : Nat Float Float ChannelCfg ChannelCfg -> FloatList .
  eq buildFirstHopTimeline(N, OWD1, OWD2, CC1, CC2) = buildFirstHopTimeline(N, OWD1, OWD2, CC1, CC2, true) .

  op buildFirstHopTimeline : Nat Float Float ChannelCfg ChannelCfg Bool -> FloatList .
  eq buildFirstHopTimeline(N, OWD1, OWD2, CC1, CC2, ISNEW) =
     tlTimes(buildFirstHopResult(N, OWD1, OWD2, CC1, CC2, ISNEW, initTcpState)) .

  --- buildTimelineHop(N, OWD1, OWD2, OW_offset, SR_hop, CC1, CC2, ISNEW, ST)
  ---
  --- Connection Setup Modeling:
  ---   - ISNEW == true  (New Connection):
  ---       Counts BOTH the TCP 3-Way Handshake (1 RTT) and the TLS Handshake (1 RTT),
  ---       totaling 2 RTT (4.0 * (OWD1 + OWD2)) setup delay before application data transmission.
  ---       Prepends 5 handshake packet timestamps to the output timeline:
  ---         1. SYN                   at t = 0.0 + OWOFF
  ---         2. ACK (TCP 3-way HS)   at t = 1.0 * RTT + OWOFF
  ---         3. TLS Client Hello      at t = 1.0 * RTT + OWOFF
  ---         4. ACK (TLS HS)         at t = 2.0 * RTT + OWOFF
  ---         5. TLS Change Cipher     at t = 2.0 * RTT + OWOFF
  ---       First application data segment(s) start transmitting at t = 2.0 * RTT (4.0 * (OWD1 + OWD2)).
  ---
  ---   - ISNEW == false (Reused Connection):
  ---       Bypasses all TCP and TLS handshakes and Slow Start.
  ---       Application data transmission starts immediately at t = 0.0 + OWOFF in Congestion Avoidance
  ---       with the supplied TcpState (cwnd, wMax, tSince).

  op buildTimelineHop : Nat Float Float Float Float ChannelCfg ChannelCfg Bool TcpState -> TimelineResult .

  --- Helper for prepending 5 TCP+TLS handshake timestamps (SYN, ACK, Client Hello, ACK, Change Cipher Spec)
  op hsTimes : Float Float Float Bool -> FloatList .
  eq hsTimes(OWD1, OWD2, OWOFF, true) =
    OWOFF ::
    (2.0 * (OWD1 + OWD2) + OWOFF) ::
    (2.0 * (OWD1 + OWD2) + OWOFF) ::
    (4.0 * (OWD1 + OWD2) + OWOFF) ::
    (4.0 * (OWD1 + OWD2) + OWOFF) :: nilFL .
  eq hsTimes(OWD1, OWD2, OWOFF, false) = nilFL .

  --- Buffer-capacity path: when both links are "none" profile
  --- ISNEW == true: run Handshake and Slow Start
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, true, ST:TcpState) =
     tlR(hsTimes(OWD1, OWD2, OWOFF, true) ++ tlTimes(TLR), tlState(TLR))
  if isNoneProfile(CC1) and isNoneProfile(CC2)
  /\ CC_PATH := composeChannels(CC1, CC2)
  /\ TLR := caPhaseBuf(
       ssLoopBuf(4.0 * (OWD1 + OWD2),
                 0, 1, 10,
                 N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH,
                 nilFL),
       N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH) .

  --- ISNEW == false, inSS == true: bypass Handshake, continue in Slow Start
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, false, tcpState(CWND, WMX, TS, true)) =
     caPhaseBuf(
       ssLoopBuf(0.0,
                 0, 1, max(1, f2n(roundF(CWND))),
                 N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH,
                 nilFL),
       N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH)
  if isNoneProfile(CC1) and isNoneProfile(CC2)
  /\ CC_PATH := composeChannels(CC1, CC2) .

  --- ISNEW == false, inSS == false: bypass Handshake and Slow Start, start directly in CA
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, false, tcpState(CWND, WMX, TS, false)) =
     caLoopBuf(100000, 0.0, 0.0, 1, CWND, WMX, TS,
               N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH, nilFL)
  if isNoneProfile(CC1) and isNoneProfile(CC2)
  /\ CC_PATH := composeChannels(CC1, CC2) .

  --- No-buffer path: all other profiles
  --- ISNEW == true: run Handshake and Slow Start
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, true, ST:TcpState) =
     tlR(hsTimes(OWD1, OWD2, OWOFF, true) ++ tlTimes(TLR), tlState(TLR))
  if (not (isNoneProfile(CC1) and isNoneProfile(CC2)))
  /\ CC_PATH := composeChannels(CC1, CC2)
  /\ TLR := caPhase(
       ssLoop(4.0 * (OWD1 + OWD2),
              0, 1, 10,
              N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH,
              nilFL),
       N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH) .

  --- ISNEW == false, inSS == true: bypass Handshake, continue in Slow Start
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, false, tcpState(CWND, WMX, TS, true)) =
     caPhase(
       ssLoop(0.0,
              0, 1, max(1, f2n(roundF(CWND))),
              N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH,
              nilFL),
       N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH)
  if (not (isNoneProfile(CC1) and isNoneProfile(CC2)))
  /\ CC_PATH := composeChannels(CC1, CC2) .

  --- ISNEW == false, inSS == false: bypass Handshake and Slow Start, start directly in CA
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, false, tcpState(CWND, WMX, TS, false)) =
     caLoop(100000, 0.0, 0.0, 1, CWND, WMX, TS,
            N, OWD1 + OWD2, OWOFF, SRHOP, CC_PATH, nilFL)
  if (not (isNoneProfile(CC1) and isNoneProfile(CC2)))
  /\ CC_PATH := composeChannels(CC1, CC2) .

  --- Fallback for ISNEW == true
  ceq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, true, ST:TcpState) =
     tlR(hsTimes(OWD1, OWD2, OWOFF, true) ++ tlTimes(TLR), tlState(TLR))
  if TLR := caPhase(
       ssLoop(4.0 * (OWD1 + OWD2),
              0, 1, 10,
              N, OWD1 + OWD2, OWOFF, SRHOP, composeChannels(CC1, CC2),
              nilFL),
       N, OWD1 + OWD2, OWOFF, SRHOP, composeChannels(CC1, CC2)) [owise] .

  --- Fallback for ISNEW == false
  eq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, false, tcpState(CWND, WMX, TS, false)) =
     caLoop(100000, 0.0, 0.0, 1, CWND, WMX, TS,
            N, OWD1 + OWD2, OWOFF, SRHOP, composeChannels(CC1, CC2), nilFL) [owise] .

  --- Convenience overloads
  op buildTimelineHop : Nat Float Float Float Float ChannelCfg ChannelCfg Bool -> FloatList .
  eq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, ISNEW) =
     tlTimes(buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, ISNEW, initTcpState)) .

  op buildTimelineHop : Nat Float Float Float Float ChannelCfg ChannelCfg -> FloatList .
  eq buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2) =
     buildTimelineHop(N, OWD1, OWD2, OWOFF, SRHOP, CC1, CC2, true) .

  --- tcpFinalDestResult & tcpFirstHopResult
  op tcpFinalDestResult : Nat AttributeSet AttributeSet Bool TcpState -> TimelineResult .
  ceq tcpFinalDestResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, ST:TcpState) =
    buildFinalDestResult(NSeg:Nat, getOneWayDelay(linkAttrs1), getOneWayDelay(linkAttrs2), CC1:ChannelCfg, CC2:ChannelCfg, B, ST:TcpState)
  if NSeg:Nat := ceilDiv(MSZ:Nat, MSS-SIZE-BYTES)
    /\ CC1:ChannelCfg := makeChannel(linkAttrs1)
    /\ CC2:ChannelCfg := makeChannel(linkAttrs2)
  .

  op tcpFinalDestResult : Nat AttributeSet AttributeSet Bool -> TimelineResult .
  eq tcpFinalDestResult(MSZ:Nat, linkAttrs1, linkAttrs2, B) =
     tcpFinalDestResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, initTcpState) .

  op tcpFinalDestResult : Nat AttributeSet -> TimelineResult .
  eq tcpFinalDestResult(MSZ:Nat, linkAttrs1) =
     tcpFinalDestResult(MSZ:Nat, linkAttrs1, linkAttrs1, true, initTcpState) .

  op tcpFirstHopResult : Nat AttributeSet AttributeSet Bool TcpState -> TimelineResult .
  ceq tcpFirstHopResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, ST:TcpState) =
    buildFirstHopResult(NSeg:Nat, getOneWayDelay(linkAttrs1), getOneWayDelay(linkAttrs2), CC1:ChannelCfg, CC2:ChannelCfg, B, ST:TcpState)
  if NSeg:Nat := ceilDiv(MSZ:Nat, MSS-SIZE-BYTES)
    /\ CC1:ChannelCfg := makeChannel(linkAttrs1)
    /\ CC2:ChannelCfg := makeChannel(linkAttrs2)
  .

  op tcpFirstHopResult : Nat AttributeSet AttributeSet Bool -> TimelineResult .
  eq tcpFirstHopResult(MSZ:Nat, linkAttrs1, linkAttrs2, B) =
     tcpFirstHopResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, initTcpState) .

  op tcpFirstHopResult : Nat AttributeSet -> TimelineResult .
  eq tcpFirstHopResult(MSZ:Nat, linkAttrs1) =
     tcpFirstHopResult(MSZ:Nat, linkAttrs1, linkAttrs1, true, initTcpState) .

  --- tcpFinalDestTimes & tcpFirstHopTimes
  op tcpFinalDestTimes : Nat AttributeSet AttributeSet Bool TcpState -> FloatList .
  eq tcpFinalDestTimes(MSZ:Nat, linkAttrs1, linkAttrs2, B, ST:TcpState) =
     tlTimes(tcpFinalDestResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, ST:TcpState)) .

  op tcpFinalDestTimes : Nat AttributeSet AttributeSet Bool -> FloatList .
  eq tcpFinalDestTimes(MSZ:Nat, linkAttrs1, linkAttrs2, B) =
     tlTimes(tcpFinalDestResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, initTcpState)) .

  op tcpFinalDestTimes : Nat AttributeSet -> FloatList .
  eq tcpFinalDestTimes(MSZ:Nat, linkAttrs1) =
     tcpFinalDestTimes(MSZ:Nat, linkAttrs1, linkAttrs1, true) .

  op tcpFirstHopTimes : Nat AttributeSet AttributeSet Bool TcpState -> FloatList .
  eq tcpFirstHopTimes(MSZ:Nat, linkAttrs1, linkAttrs2, B, ST:TcpState) =
     tlTimes(tcpFirstHopResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, ST:TcpState)) .

  op tcpFirstHopTimes : Nat AttributeSet AttributeSet Bool -> FloatList .
  eq tcpFirstHopTimes(MSZ:Nat, linkAttrs1, linkAttrs2, B) =
     tlTimes(tcpFirstHopResult(MSZ:Nat, linkAttrs1, linkAttrs2, B, initTcpState)) .

  op tcpFirstHopTimes : Nat AttributeSet -> FloatList .
  eq tcpFirstHopTimes(MSZ:Nat, linkAttrs1) =
     tcpFirstHopTimes(MSZ:Nat, linkAttrs1, linkAttrs1, true) .

  vars deliveryTimes : FloatList .
  vars msgSize lastPayloadBytes lastPktSizeBytes numOriginalSegments n : Nat .
  vars deliverySizes : NatList .

  --- Make a list of n segments with a certain size.
  ---                     NumSeg  TheirSize CurrentList (it is recursive).
  op $makeDeliverySizes : Nat     Nat       NatList -> NatList .
  eq $makeDeliverySizes(s n, msgSize, deliverySizes)
    = $makeDeliverySizes(n, msgSize, deliverySizes :: msgSize)
  .
  eq $makeDeliverySizes(0, msgSize, deliverySizes) = deliverySizes .

  --- Helper for prepending 5 TCP+TLS handshake delivery sizes (52B SYN, 52B ACK, 1500B Client Hello, 52B ACK, 1500B Change Cipher Spec)
  op hsSizes : Bool -> NatList .
  eq hsSizes(true) =
    (IP-HEADER-BYTES + TCP-HEADER-BYTES) ::
    (IP-HEADER-BYTES + TCP-HEADER-BYTES) ::
    MTU-SIZE-BYTES ::
    (IP-HEADER-BYTES + TCP-HEADER-BYTES) ::
    MTU-SIZE-BYTES :: nilNatList .
  eq hsSizes(false) = nilNatList .

  --- Get the TCP delivery sizes on the wire (in Bytes, including 52B headers)
  ---                   TotalMsgSize  DeliveryTimes  ISNEW
  ---
  --- For new connections (ISNEW == true), prepends the 5 handshake packet sizes on the wire:
  ---   (52B SYN :: 52B ACK :: 1500B TLS Client Hello :: 52B ACK :: 1500B TLS Change Cipher Spec)
  op tcpDeliverySizes : Nat           FloatList      Bool -> NatList .
  ceq tcpDeliverySizes(msgSize, deliveryTimes, ISNEW) =
    hsSizes(ISNEW) :: deliverySizes
    if numOriginalSegments := ceilDiv(msgSize, MSS-SIZE-BYTES)
      /\ lastPayloadBytes := sd(msgSize, (numOriginalSegments - 1) * MSS-SIZE-BYTES)
      /\ lastPktSizeBytes := lastPayloadBytes + IP-HEADER-BYTES + TCP-HEADER-BYTES
      /\ deliverySizes := $makeDeliverySizes(sd(numOriginalSegments, 1), MTU-SIZE-BYTES, nilNatList) :: lastPktSizeBytes
  .

  op tcpDeliverySizes : Nat FloatList -> NatList .
  eq tcpDeliverySizes(msgSize, deliveryTimes) =
    tcpDeliverySizes(msgSize, deliveryTimes, lenFL(deliveryTimes) > ceilDiv(msgSize, MSS-SIZE-BYTES)) .
endm

mod TCP_NODE is
  pr CP2_SORTS .
  pr ACTOR-MODEL .
  pr IRC-DISPATCHER-INTERFACE .
  pr TCP-ANALYTICAL-MODEL .

  vars src dst SRC DST : Address .
  vars attrs attrsNext : AttributeSet .
  vars content : Content .
  vars msg : Msg .
  vars j msgSize  : Nat .
  vars b : Bool .

  op timePacketList:_ : FloatList -> Attribute [ctor] .
  op nextJ:_          : Nat             -> Attribute [ctor] .

  vars attrs1 attrs2 : AttributeSet .
  vars curTcpState nextTcpState : TcpState .

  ---                         Seed  Msg Link1Attrs Link2Attrs isNew tcpState
  op getFinalDestSegmentDistribution : Nat   Msg AttributeSet AttributeSet Bool TcpState -> AttributeSet .
  ceq getFinalDestSegmentDistribution(j, msg, attrs1, attrs2, b, ST:TcpState) =
    (timePacketList: times:FloatList,
     tcpState: ST_OUT:TcpState,
     nextJ: j)
    if content := getContent(msg)
      /\ attrs1 =/= noneAS 
      /\ attrs2 =/= noneAS 
      /\ msgSize := getSize(content)
      /\ tlR(times:FloatList, ST_OUT:TcpState) := tcpFinalDestResult(msgSize, attrs1, attrs2, b, ST:TcpState)
    [ print "Final-destination time dispersion of segments from " msgSize "B message is " times:FloatList  "." ]
  .

  op getFinalDestSegmentDistribution : Nat Msg AttributeSet AttributeSet Bool -> AttributeSet .
  eq getFinalDestSegmentDistribution(j, msg, attrs1, attrs2, b) =
     getFinalDestSegmentDistribution(j, msg, attrs1, attrs2, b, initTcpState) .

  op getFirstHopSegmentDistribution : Nat Msg AttributeSet AttributeSet Bool TcpState -> AttributeSet .
  ceq getFirstHopSegmentDistribution(j, msg, attrs1, attrs2, b, ST:TcpState) =
    (timePacketList: times:FloatList,
     tcpState: ST_OUT:TcpState,
     nextJ: j)
    if content := getContent(msg)
      /\ attrs1 =/= noneAS 
      /\ attrs2 =/= noneAS 
      /\ msgSize := getSize(content)
      /\ tlR(times:FloatList, ST_OUT:TcpState) := tcpFirstHopResult(msgSize, attrs1, attrs2, b, ST:TcpState)
    [ print "First-hop time dispersion of segments from " msgSize "B message is " times:FloatList  "." ]
  .

  op getFirstHopSegmentDistribution : Nat Msg AttributeSet AttributeSet Bool -> AttributeSet .
  eq getFirstHopSegmentDistribution(j, msg, attrs1, attrs2, b) =
     getFirstHopSegmentDistribution(j, msg, attrs1, attrs2, b, initTcpState) .

  op msgDelay : FloatList -> Float .
  eq msgDelay(nilFL) = 0. .
  eq msgDelay(times:FloatList) = maxFL(times:FloatList) .

endm
eof

--- ================================================================
---  Verification / Test Commands
--- ================================================================

--- Test 1: IID Flight statistics for 10-packet flight with 1% loss
red flightStats(10, chCfg(0.01)) .

--- Test 2: Channel composition for two 1% loss links
red composeChannels(chCfg(0.01), chCfg(0.01)) .

--- Test 3: isNoneProfile checks
red isNoneProfile(chCfg(0.0)) .
red isNoneProfile(chCfg(0.01)) .

--- Test 4: Full delivery times for 50 segments (72400 bytes)
---   None profile (0% loss) + 20ms one-way delay (buffer-capacity path)
red tcpFinalDestTimes(72400, (dropP: 0.0, oneWayDelay: 2.0e-2)) .

--- Test 5: Full delivery times for 50 segments (72400 bytes)
---   1% loss profile + 20ms one-way delay
red tcpFinalDestTimes(72400, (dropP: 0.01, oneWayDelay: 2.0e-2)) .
