sload ./tcp_socket.maude
sload ./udp.maude

mod TRANSPORT is
 pr TCP_SOCKET .
 pr UDP_SOCKET .

  --- =========================================================
  --- Transport Wrapper (Default identity)
  --- =========================================================
  --- It can be nothing (transport(any:Address) = any:Address) or tcp.
  op transport : Address -> Address .
  eq transport(any:Address) = any:Address [owise] .
  --- Persistent transport, with a ConnxnId to differentiate them.
  ---             Addr    ConnxnId
  op transport :  Address Nat -> Address .
  eq transport(any:Address, CONNXN_ID:Nat) = any:Address [owise] .

  --- Check if an address has a transport.
  op hasTransport : Address -> Bool .
  eq hasTransport(tcp(any:Address)) = true .
  eq hasTransport(tcppersist(any:Address, CONNXN_ID:Nat)) = true .
  eq hasTransport(tcpOn(any:Address, H:ConnxnHandle)) = true .
  eq hasTransport(udp(any:Address)) = true .
  eq hasTransport(any:Address) = false [owise] .

  --- Check if a message is to a transport socket (tcp or udp).
  op hasTransport : Msg -> Bool .
  eq hasTransport(to DST:Address from SRC:Address : content:Content)
    = hasTransport(DST:Address)
  .
  eq hasTransport(to DST:Address : content:Content)
    = hasTransport(DST:Address)
  .
  eq hasTransport(to DST:Address from SRC:Address : content:Content :: flowAttrs:AttributeSet)
    = hasTransport(DST:Address)
  .
  eq hasTransport(to DST:Address : content:Content :: flowAttrs:AttributeSet)
    = hasTransport(DST:Address)
  .
  eq hasTransport(ANY:Config) = false [owise] .
endm

