sload ./skyhook_nondet
sload ../s3/s3_protocol

mod TEST_SKYHOOK is
  pr SKYHOOK .
  pr S3_PROTOCOL .

  ops puAddr ahAddr rbAddr userAddr awsAddr sdkAddr : -> Address .
  ops skyhookPU skyhookAH awsServer awsSdkActor : -> Actor .

  eq skyhookPU =
    < puAddr : SkyhookPublicUser |
        thisAddr: puAddr,
        raceboatAddr: rbAddr,
        awsAddr: sdkAddr,
        fetchBucket: "test-fetch-bucket",
        postBucket: "test-post-bucket",
        fetchObjUuid: "0",
        postObjUuid: "4"
    > .

  eq skyhookAH =
    < ahAddr : SkyhookAccountHolder |
        thisAddr: ahAddr,
        raceboatAddr: rbAddr,
        awsAddr: sdkAddr,
        fetchBucket: "test-fetch-bucket",
        postBucket: "test-post-bucket",
        region: "us-east-1",
        puttableUuids: emptyStringList,
        fetchableUuids: emptyStringList,
        initialFetchObjUuid: "0",
        initialPostObjUuid: "0",
        openObjects: 3,
        postObjUuid: "4"
    > .
    
  eq awsServer =
    < awsAddr : AwsS3HttpServer | thisAddr: awsAddr, s3DataMap: emptyS3DataMap > .

  eq awsSdkActor =
    < sdkAddr : S3SdkClient | realAwsAddr: awsAddr, nextId: 1, pendingReqs: emptyS3ReqMap > .

endm

--- Test 1: AccountHolder receives initial StartCmd, initializes internal queue to 1 element `sha256(initial)`
rew skyhookAH awsSdkActor awsServer
    (to ahAddr from rbAddr : SkyhookStartCmd)
  .

--- Test 2: AccountHolder handling FetchCmd from Raceboat using internal puttable queue
rew < ahAddr : SkyhookAccountHolder |
        thisAddr: ahAddr,
        raceboatAddr: rbAddr,
        awsAddr: sdkAddr,
        fetchBucket: "test-fetch-bucket",
        postBucket: "test-post-bucket",
        region: "us-east-1",
        puttableUuids: "1",
        fetchableUuids: emptyStringList,
        initialFetchObjUuid: "0",
        initialPostObjUuid: "0",
        openObjects: 3,
        postObjUuid: "4"
    > awsSdkActor awsServer
    (to ahAddr from rbAddr : SkyhookFetchCmd)
  .

--- Test 3: AccountHolder handles returned S3GetObjRes -> Rotate UUIDs, delete oldest, propagate backward
rew < ahAddr : SkyhookAccountHolder |
        thisAddr: ahAddr,
        raceboatAddr: rbAddr,
        awsAddr: sdkAddr,
        fetchBucket: "test-fetch-bucket",
        postBucket: "test-post-bucket",
        region: "us-east-1",
        puttableUuids: ("1" :: emptyStringList),
        fetchableUuids: emptyStringList,
        initialFetchObjUuid: "0",
        initialPostObjUuid: "0",
        openObjects: 3,
        postObjUuid: "4"
    > awsSdkActor awsServer
    (to ahAddr from sdkAddr : S3GetObjRes("test-fetch-bucket", "1", "s3-mock-data"))
  .


--- Test 4: AccountHolder underflow test (adds fetchable via successful put)
rew < ahAddr : SkyhookAccountHolder |
        thisAddr: ahAddr,
        raceboatAddr: rbAddr,
        awsAddr: sdkAddr,
        fetchBucket: "test-fetch-bucket",
        postBucket: "test-post-bucket",
        region: "us-east-1",
        puttableUuids: emptyStringList,
        fetchableUuids: ("1" :: emptyStringList),
        initialFetchObjUuid: "0",
        initialPostObjUuid: "0",
        openObjects: 3,
        postObjUuid: "4"
    > awsSdkActor awsServer
    (to ahAddr from sdkAddr : S3PutObjRes("test-post-bucket", "4"))
  .

--- Test 5: AccountHolder overflow test (drops oldest fetchable and adds newest via successful put)
rew < ahAddr : SkyhookAccountHolder |
        thisAddr: ahAddr,
        raceboatAddr: rbAddr,
        awsAddr: sdkAddr,
        fetchBucket: "test-fetch-bucket",
        postBucket: "test-post-bucket",
        region: "us-east-1",
        puttableUuids: emptyStringList,
        fetchableUuids: ("1" :: "2" :: "3" :: emptyStringList),
        initialFetchObjUuid: "0",
        initialPostObjUuid: "0",
        openObjects: 3,
        postObjUuid: "4"
    > awsSdkActor awsServer
    (to ahAddr from sdkAddr : S3PutObjRes("test-post-bucket", "4"))
  .

--- Test 6: PublicUser fetch
rew skyhookPU awsSdkActor awsServer
    (to puAddr from userAddr : SkyhookFetchCmd)
  .

--- Test 7: PublicUser post
rew skyhookPU awsSdkActor awsServer
    (to puAddr from userAddr : SkyhookPostCmd("hello_data"))
  .

--- Test 8: Public User successful fetch updates state tracking
rew skyhookPU awsSdkActor awsServer
    (to puAddr from sdkAddr : S3GetObjRes("test-fetch-bucket", "0", "mock-data"))
  .
