sload ../../deps/dns_formalization/Maude/common/apmaude.maude

mod S3_DELAYS is
  pr SCHEDULER-AUX .                                        
                                                          
  op S3SRVPROCDELAY : -> Float .
  eq S3SRVPROCDELAY = 0.003 .

  --- Add processing delay at the S3 server.
  --- TODO: Make it a function of its state.
  op scheduleWS3ProcDelay : AttributeSet Msg -> Config .
  eq scheduleWS3ProcDelay(ATTRS:AttributeSet, MSG:Msg)
    = [S3SRVPROCDELAY, MSG:Msg, 0]
    [owise]
.
endm

