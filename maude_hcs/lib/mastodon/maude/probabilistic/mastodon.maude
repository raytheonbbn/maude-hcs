*** load ../../../../deps/dns_formalization/Maude/dns/probabilistic-model/dns
sload ../common/_mas_aux.maude
sload ../common/mastodon_delays.maude
sload ../../../common/maude/delay-drop-x.maude

mod MASTODON is
  inc CP2-COMMON .
  inc MASAUX .
  pr MASTODON_DELAYS .
  pr DELAY-X .
  
  vars raceboatCl ADDR MAS_CLIENT_ADDR MAS_SERVER_ADDR : Address .
  vars attrs attrsNext : AttributeSet .
  vars msgs : Config .
  vars raceboatReq : Content .
  vars httpRequest : HttpRequest .
  vars httpResponse : HttpResponse .
  vars MEDIA : MediaFile .
  vars MEDIA_LIST : MediaFileList .
  vars POST_ID : MasId .
  vars msgIn msgOut : Msg .
  vars N j jnext : Nat .
  vars TEXT : String .
  vars HASHTAG TAG : Tag .
  vars T : Float . ---timestamp
  vars URL : Url .

  op insertTransport : Msg -> Msg .
  eq insertTransport((to DEST:Address from SRC:Address : content:Content))
    = (to transport(DEST:Address) from SRC:Address : content:Content)
  .
  eq insertTransport((to transport(DEST:Address) from SRC:Address : content:Content))
    = (to transport(DEST:Address) from SRC:Address : content:Content)
  .

  --- Conditionally add transport (if destined to the Mastodon server) and 
  --- schedule to send.
  ---                       ClientAttrs   Msg RandCounter
  --- It returns the scheduled message(s) and the updated random counter.
  op conditionalTransport : AttributeSet  Msg Nat -> ConfigNat .
  eq conditionalTransport(attrs,
                          (to DEST:Address from SRC:Address : content:Content),
                          j)
    = (if getMastodonServerAddr(attrs) == DEST:Address
        --- Destined to go out to the server.
        then scheduleSendMsgs((to transport(DEST:Address) from SRC:Address : content:Content),
                              j)
        --- Destined for app (done).
        else {[0., (to DEST:Address from SRC:Address : content:Content), 0], j}
      fi)
  .
   eq conditionalTransport(attrs, nullMsg, j) = {null, j} .
   eq conditionalTransport(attrs, MSG:Msg, j) = {MSG:Msg, j} [owise print "Error, cannot schedule " MSG:Msg] .

  -------------------------------
  --- [Mastodon Client] --- Rules
  -------------------------------
  --- Receive HTTP Response from server.
  crl [mascl-receive-http-resp]:
  rCtr(j)
  < MAS_CLIENT_ADDR : MasClient | attrs >
    {T, (to MAS_CLIENT_ADDR from MAS_SERVER_ADDR : httpResponse)}
  =>
  rCtr(jnext)
  < MAS_CLIENT_ADDR : MasClient | attrsNext >
    msgs
  if {attrsNext, msgOut} := handleReply(httpResponse, attrs)
    /\ opStack:OpStack := getOpStack(attrsNext)
    /\ {msgs, jnext} := conditionalTransport(attrs, msgOut, j)
  [print "(" T ") Mastodon Client " MAS_CLIENT_ADDR " handling HTTP Response from Server, sending " msgOut]
  .

  --- Receive Command from Raceboat or TGEN.
  crl [mascl-receive-requester-req]:
  rCtr(j)
  < MAS_CLIENT_ADDR : MasClient | attrs >
    {T, (to MAS_CLIENT_ADDR from raceboatCl : raceboatReq)}
  => 
  < MAS_CLIENT_ADDR : MasClient | attrsNext >
  rCtr(jnext)
    --- TODO: Figure out what the correct delay should be.
    msgs
  if { attrsNext, msgOut } := dispatchRaceboatCommand(attrs, raceboatReq)
    /\ opStack:OpStack := getOpStack(attrsNext)
    /\ {msgs, jnext} := scheduleSendMsgs(insertTransport(msgOut), j)
  [ print "(" T ") Mastodon Client " MAS_CLIENT_ADDR " handling command " raceboatReq " from Raceboat, sending " msgOut ]
  **** " | OPS: " opStack:OpStack 
  .  


  -------------------------------
  --- [Mastodon Server] --- Rules
  -------------------------------
  --- Receive HTTP request from the client.
  crl [massrv-receive-http-req]:
  rCtr(j)
  < MAS_SERVER_ADDR : MasServer | attrs >
    {T, (to MAS_SERVER_ADDR from MAS_CLIENT_ADDR : REQ:Content)}
  =>
  rCtr(jnext)
  < MAS_SERVER_ADDR : MasServer | attrsNext >
    msgs
  if { attrsNext, msgOut } := handleRequest((to MAS_SERVER_ADDR from MAS_CLIENT_ADDR : REQ:Content), j, attrs)
    --- The scheduleSendMsgs gets s j because handleRequest uses it to roll once.
    /\ {msgs, jnext} := scheduleSendMsgs(scheduleWMastodonProcDelay(attrs, insertTransport(msgOut)),
                                          s j)
  [print "(" T ") Mastodon Server handling HTTP Request, sending " msgOut]
  .

endm

