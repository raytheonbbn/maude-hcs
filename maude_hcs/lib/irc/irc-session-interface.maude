--- CP4 connection-oriented transport abstraction.
--- Network reachability, remote session validity, and locally known socket errors
--- are distinct. Lost traffic is not an immediate send error. A write to a closed
--- remote session elicits a reset; that write may succeed locally, later writes fail.
--- This deliberately does not emulate TCP retransmission or packet-level loss.
sload irc-byteseq-interface
sload common/_aux

mod IRC-SESSION-INTERFACE is
  inc IRC-BYTESEQ-INTERFACE .
  inc IRC_NODE .

  vars A B C U : Address .
  vars AS AS1 : AttributeSet .
  vars E F : Nat .
  vars T D L P : Float .
  vars M : IrcMsg .
  vars K : Content .
  vars R V X : Bool .

  op IrcSessionIface : -> ActorType [ctor] .
  op clientSide:_ : Bool -> Attribute [ctor] .
  op sessionEpoch:_ : Nat -> Attribute [ctor] .
  op sessionLive:_ : Bool -> Attribute [ctor] .
  op socketBroken:_ : Bool -> Attribute [ctor] .
  op sessionUser:_ : Address -> Attribute [ctor] .
  op wireDelay:_ : Float -> Attribute [ctor] .
  op idleSince:_ : Float -> Attribute [ctor] .
  op pingSent:_ : Float -> Attribute [ctor] .
  op registrationUntil:_ : Float -> Attribute [ctor] .

  op SessionWire : Nat IrcMsg -> ByteSeq [ctor] .
  op SessionReset : Nat -> ByteSeq [ctor] .
  op SessionRetired : Nat -> ByteSeq [ctor] .
  op SessionCheck : Nat -> Content [ctor] .
  op ProcessSessionInput : Nat IrcMsg -> Content [ctor] .

  --- Explicit simulation parameters, overridden by scenario input when available.
  op cp4WireDelay : Address -> Float .
  eq cp4WireDelay(A) = 0.001 [owise] .
  op cp4HandshakeRoundTrips : -> Float .
  eq cp4HandshakeRoundTrips = 4.0 .
  op cp4RegistrationPenalty : -> Float .
  eq cp4RegistrationPenalty = 1.0 .
  op cp4ServerIdle : -> Float .
  eq cp4ServerIdle = 10.0 .
  op cp4ServerPongWait : -> Float .
  eq cp4ServerPongWait = 20.0 .
  op cp4ServerScan : -> Float .
  eq cp4ServerScan = 1.0 .

  op mkIrcSessionIface : Address Address Address Bool Address -> Actor .
  eq mkIrcSessionIface(A, B, C, R, U) =
    < A : IrcSessionIface | ircAddress: B, epAddress: C, linkUp: true,
      clientSide: R, sessionEpoch: 0, sessionLive: false, socketBroken: false,
      sessionUser: U, wireDelay: cp4WireDelay(U), idleSince: 0.0,
      pingSent: -1.0, registrationUntil: 0.0 > .

  op epochOf : AttributeSet -> Nat .
  eq epochOf((AS, sessionEpoch: E)) = E .
  op liveSession : AttributeSet -> Bool .
  eq liveSession((AS, sessionLive: V)) = V .
  op brokenSocket : AttributeSet -> Bool .
  eq brokenSocket((AS, socketBroken: V)) = V .
  op setSession : AttributeSet Nat Bool Bool -> AttributeSet .
  eq setSession((AS, sessionEpoch: F, sessionLive: V, socketBroken: X), E, R, V1:Bool) =
    (AS, sessionEpoch: E, sessionLive: R, socketBroken: V1:Bool) .
  op heardSession : AttributeSet Float -> AttributeSet .
  eq heardSession((AS, idleSince: L, pingSent: P), T) = (AS, idleSince: T, pingSent: -1.0) .
  op setPingSent : AttributeSet Float -> AttributeSet .
  eq setPingSent((AS, pingSent: P), T) = (AS, pingSent: T) .
  op setRegistration : AttributeSet Float -> AttributeSet .
  eq setRegistration((AS, registrationUntil: L), T) = (AS, registrationUntil: T) .
  op isConnect : IrcMsg -> Bool .
  eq isConnect(ClientConnect(U, E)) = true .
  eq isConnect(M) = false [owise] .
  op isLivenessPing : IrcMsg -> Bool .
  eq isLivenessPing(Ping(N:IrcUserName, U)) = true .
  eq isLivenessPing(M) = false [owise] .

  rl [session-link-state]:
    < A : IrcSessionIface | AS >
    {T, (to A from B : SetLinkState(V))}
    => < A : IrcSessionIface | setLinkUp(AS, V) > .

  crl [session-connect]:
    < A : IrcSessionIface | AS, clientSide: true, ircAddress: B, epAddress: C, wireDelay: D >
    {T, (to A from B : ClientConnect(U, E))}
    => < A : IrcSessionIface | setSession(AS, E, true, false),
         clientSide: true, ircAddress: B, epAddress: C, wireDelay: D >
       (if getLinkUp(AS) then
         [(1.0 + 2.0 * cp4HandshakeRoundTrips) * D,
          (to C from A : SessionWire(E, ClientConnect(U, E))), 0]
        else null fi)
    if E > epochOf(AS) .

  crl [session-obsolete-connect]:
    < A : IrcSessionIface | AS >
    {T, (to A from B : ClientConnect(U, E))}
    => < A : IrcSessionIface | AS > if E <= epochOf(AS) .

  --- Teardown is local even during a partition. The peer learns it only if reachable.
  crl [session-retire]:
    < A : IrcSessionIface | AS, epAddress: C, wireDelay: D >
    {T, (to A from B : RetireSession(E))}
    => < A : IrcSessionIface | setSession(AS, E, false, true), epAddress: C, wireDelay: D >
       (if getLinkUp(AS) then [D, (to C from A : SessionRetired(E)), 0] else null fi)
    if E == epochOf(AS) .
  crl [session-retire-stale]:
    < A : IrcSessionIface | AS > {T, (to A from B : RetireSession(E))}
    => < A : IrcSessionIface | AS > if E =/= epochOf(AS) .

  rl [session-write]:
    < A : IrcSessionIface | AS, ircAddress: B >
    {T, (to A from B : ClientWrite(E, M))}
    => < A : IrcSessionIface | AS, ircAddress: B >
       (if E == epochOf(AS) and liveSession(AS) and not brokenSocket(AS)
        then [0.0, (to B from A : WriteAccepted(E, M)), 0]
             [0.0, (to A from B : ClientControl(E, M)), 0]
        else [0.0, (to B from A : WriteRejected(E, M)), 0] fi) .

  rl [session-client-control]:
    < A : IrcSessionIface | AS, ircAddress: B, epAddress: C, wireDelay: D >
    {T, (to A from B : ClientControl(E, M))}
    => < A : IrcSessionIface | AS, ircAddress: B, epAddress: C, wireDelay: D >
       (if E == epochOf(AS)
        then (if liveSession(AS) and not brokenSocket(AS)
              then (if getLinkUp(AS) then [D, (to C from A : SessionWire(E, M)), 0] else null fi)
              else (if isLivenessPing(M) then [0.0, (to B from A : ClientConnLost(E)), 0] else null fi) fi)
        else null fi) .

  rl [session-server-write]:
    < A : IrcSessionIface | AS, ircAddress: B, epAddress: C, wireDelay: D >
    {T, (to A from B : ServerWrite(E, M))}
    => < A : IrcSessionIface | AS, ircAddress: B, epAddress: C, wireDelay: D >
       (if E == epochOf(AS) and liveSession(AS) and getLinkUp(AS)
        then [D, (to C from A : SessionWire(E, M)), 0] else null fi) .

  crl [session-outgoing]:
    < A : IrcSessionIface | AS, clientSide: R, ircAddress: B, epAddress: C, wireDelay: D >
    {T, (to A from B : M)}
    => < A : IrcSessionIface | AS, clientSide: R, ircAddress: B, epAddress: C, wireDelay: D >
       (if liveSession(AS) and not brokenSocket(AS)
        then (if getLinkUp(AS) then [D, (to C from A : SessionWire(epochOf(AS), M)), 0] else null fi)
        else (if R and isLivenessPing(M)
              then [0.0, (to B from A : ClientConnLost(epochOf(AS))), 0] else null fi) fi)
    if not isConnect(M) .

  crl [session-server-open]:
    < A : IrcSessionIface | AS, clientSide: false, ircAddress: B, epAddress: C >
    {T, (to A from C : SessionWire(E, ClientConnect(U, E)))}
    => < A : IrcSessionIface | setRegistration(heardSession(setSession(AS, E, true, false), T),
            T + cp4RegistrationPenalty), clientSide: false, ircAddress: B, epAddress: C >
       {T, (to B from A : ClientConnect(U, E))}
       [cp4ServerScan, (to A from A : SessionCheck(E)), 0]
    if getLinkUp(AS) /\ E > epochOf(AS) .

  crl [session-server-input]:
    < A : IrcSessionIface | AS, clientSide: false, registrationUntil: L, epAddress: C >
    {T, (to A from C : SessionWire(E, M))}
    => < A : IrcSessionIface | heardSession(AS, T), clientSide: false, registrationUntil: L, epAddress: C >
       [max(0.0, L - T), (to A from A : ProcessSessionInput(E, M)), 0]
    if getLinkUp(AS) /\ liveSession(AS) /\ E == epochOf(AS) /\ not isConnect(M) .
  rl [session-process-input]:
    < A : IrcSessionIface | AS, ircAddress: B >
    {T, (to A from A : ProcessSessionInput(E, M))}
    => < A : IrcSessionIface | AS, ircAddress: B >
       (if liveSession(AS) and E == epochOf(AS) then {T, (to B from A : M)} else null fi) .

  crl [session-client-input]:
    < A : IrcSessionIface | AS, clientSide: true, ircAddress: B, epAddress: C >
    {T, (to A from C : SessionWire(E, M))}
    => < A : IrcSessionIface | AS, clientSide: true, ircAddress: B, epAddress: C >
       {T, (to B from A : SessionDelivery(E, M))}
    if getLinkUp(AS) /\ liveSession(AS) /\ not brokenSocket(AS) /\ E == epochOf(AS) .

  --- The failed network packet is not a failed send call. Feedback arrives later.
  crl [session-closed-peer-reset]:
    < A : IrcSessionIface | AS, clientSide: false, epAddress: C, wireDelay: D >
    {T, (to A from C : SessionWire(E, M))}
    => < A : IrcSessionIface | AS, clientSide: false, epAddress: C, wireDelay: D >
       [D, (to C from A : SessionReset(E)), 0]
    if getLinkUp(AS) /\ not liveSession(AS) /\ E == epochOf(AS) /\ not isConnect(M) .

  crl [session-discard-wire]:
    < A : IrcSessionIface | AS, clientSide: R, epAddress: C >
    {T, (to A from C : SessionWire(E, M))}
    => < A : IrcSessionIface | AS, clientSide: R, epAddress: C >
    if not getLinkUp(AS)
       or (R and (E =/= epochOf(AS) or not liveSession(AS) or brokenSocket(AS)))
       or (not R and ((isConnect(M) and E <= epochOf(AS)) or (not isConnect(M) and E =/= epochOf(AS)))) .

  rl [session-reset]:
    < A : IrcSessionIface | AS, epAddress: C >
    {T, (to A from C : SessionReset(E))}
    => < A : IrcSessionIface |
         (if getLinkUp(AS) and E == epochOf(AS) then setSession(AS, E, false, true) else AS fi), epAddress: C > .

  rl [session-peer-retired]:
    < A : IrcSessionIface | AS, ircAddress: B, sessionUser: U, epAddress: C >
    {T, (to A from C : SessionRetired(E))}
    => < A : IrcSessionIface |
         (if getLinkUp(AS) and E == epochOf(AS) then setSession(AS, E, false, true) else AS fi),
         ircAddress: B, sessionUser: U, epAddress: C >
       (if getLinkUp(AS) and E == epochOf(AS)
        then {T, (to B from A : SessionExpired(U, E))} else null fi) .

  crl [session-server-idle]:
    < A : IrcSessionIface | AS, ircAddress: B, sessionUser: U, idleSince: L, pingSent: P >
    {T, (to A from A : SessionCheck(E))}
    => < A : IrcSessionIface | AS1, ircAddress: B, sessionUser: U, idleSince: L >
       (if P >= 0.0 and T >= P + cp4ServerPongWait
        then {T, (to B from A : SessionExpired(U, E))}
        else [cp4ServerScan, (to A from A : SessionCheck(E)), 0]
          (if P < 0.0 and T - L > cp4ServerIdle
           then [0.0, (to A from B : Ping(makeIrcUserName(U), B)), 0] else null fi) fi)
    if E == epochOf(AS) /\ liveSession(AS)
    /\ AS1 := (if P >= 0.0 and T >= P + cp4ServerPongWait
               then setSession((AS, pingSent: P), E, false, false)
               else (AS, pingSent: (if P < 0.0 and T - L > cp4ServerIdle then T else P fi)) fi) .
  crl [session-server-check-obsolete]:
    < A : IrcSessionIface | AS > {T, (to A from A : SessionCheck(E))}
    => < A : IrcSessionIface | AS > if E =/= epochOf(AS) or not liveSession(AS) .
endm
