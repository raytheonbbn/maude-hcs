---- adapted from raceboatMastodon/maude/ircMonitor-cm
---- raceboatSkyhook/maude/irc-rbbyteseq-interface


set show advisories off .

sload ../../deps/dns_formalization/Maude/common/actor.maude
sload ../common/maude/byteseq
sload ../common/maude/delay-drop-x.maude
sload ../common/maude/cp2-interfaces
sload _irc_aux
sload ircMonitor

mod IRC-BYTESEQ-INTERFACE is
  inc ACTOR-MODEL .
  inc BYTESEQ .
  inc CP2-COMMON .
  inc DELAY-X .
  inc IRC_MONITOR .
  inc IRC_AUX  .
  
vars j j1 : Nat .
vars attrs attrs0 mattrs mattrs1 : AttributeSet .
vars ifAddr ircAddr epAddr monAddr : Address .
vars msg : Msg .
vars ircMsg IRC_MSG : IrcMsg .
vars IRC_MSGS : IrcMsgList .
vars byteseq : ByteSeq .
vars T : Float .
vars msgs smsgs : Config .

op ircMsgToByteseq : IrcMsg -> ByteSeq [ctor] .
op ircToByteseq : IrcMsgList -> ByteSeq [ctor] .
eq ircToByteseq(IRC_MSG ;; IRC_MSGS) = pack(ircToByteseqL(IRC_MSG ;; IRC_MSGS)) .
eq ircToByteseq(IRC_MSG) = ircMsgToByteseq(IRC_MSG) .
eq ircToByteseq(emptyIrcMsgList) = noBytes .
op ircToByteseqL : IrcMsgList -> ByteSeqL [ctor] .
eq ircToByteseqL(IRC_MSG ;; IRC_MSGS) = ircMsgToByteseq(IRC_MSG) :: ircToByteseqL(IRC_MSGS) .
eq ircToByteseqL(emptyIrcMsgList) = nilBS .
op ircFromByteseq : ByteSeq -> IrcMsg .
eq ircFromByteseq(ircMsgToByteseq(ircMsg)) = ircMsg .

eq getSize(ircMsgToByteseq(ircMsg)) = getSize(ircMsg) .
eq getSize(pack(byteseq)) = getSize(byteseq) .

 **** op getSrcAddr : ByteSeq -> Address .
 **** eq getSrcAddr(ircToByteseq(ircMsg))
 ****   = getIrcSrcAddr((ircMsg))
 **** .
 **** eq getSrcAddr(byteseq)  = nullAddr [owise] .

  eq getHashString(ircMsgToByteseq(ircMsg)) = getHashString(ircMsg) .

--- Indicate that this address handles ByteSeqs.
op byteSeq  : Address -> Address [ctor] .
--- Indicate that this address handles IrcMsg.
op ircMsg   : Address -> Address [ctor] .

--- Translate a config of messages (with IrcMsg as content) and turn into a list
--- of Irc Messages.
op configToIrcMsgList : Config -> IrcMsgList .
eq configToIrcMsgList(null) = emptyIrcMsgList .
eq configToIrcMsgList((to DST:Address from SRC:Address : ircMsg) rest:Config)
  = (ircMsg ;; configToIrcMsgList(rest:Config))
.

--- Decode messages from individual messages of a ByteSeq to IRC Messages.
op decodeIrcMsgs : Config -> Config .
eq decodeIrcMsgs(null) = null .
eq decodeIrcMsgs(
     (to DST:Address from SRC:Address : ircMsgToByteseq(IRC_MSG))
     REST:Config)
  = (to DST:Address from SRC:Address : IRC_MSG)
    decodeIrcMsgs(REST:Config)
.
--- Spread the messages to schedule delivery a small delta apart, this still
--- risks changing the order because Config does not preserve it.
op MSGSPREADS : -> Float .
eq MSGSPREADS = 0.00005 .
op $scheduleSpreadIrcMsgs : Config Float -> Config .
eq $scheduleSpreadIrcMsgs(null, Any:Float) = null .
eq $scheduleSpreadIrcMsgs(msg REST:Config, SPREAD_S:Float)
  = [SPREAD_S:Float, msg, 0] $scheduleSpreadIrcMsgs(REST:Config,
                                                    SPREAD_S:Float + MSGSPREADS)
.

rl [fromIrc2ep]:
  {T, (to byteSeq(epAddr) from ircAddr : IRC_MSGS)}
  < monAddr : IrcMonitor | mattrs >
 =>
  < monAddr : IrcMonitor | ircLogSent(mattrs, T, epAddr, ircAddr, IRC_MSGS) >
  [0., (to epAddr from ircMsg(ircAddr) : ircToByteseq(IRC_MSGS)), 0]
  [ print "(" T ") IRC Iface transforms " IRC_MSGS " to byteseqs." ]
.

crl [fromEp2Irc]:
  rCtr(j)
  {T, (to ircMsg(ircAddr) from epAddr : byteseq)}
  < monAddr : IrcMonitor | mattrs >
 =>
  rCtr(j)
  smsgs
  < monAddr : IrcMonitor | mattrs1 >
    --- Translate multiple (or a single) byteseq(IrcMsg) into multiple messages
    --- with a single IrcMsg.
  if MSGS:Config := decodeIrcMsgs(unpackToMsgs(byteseq, ircAddr, byteSeq(epAddr)))
    /\ smsgs := $scheduleSpreadIrcMsgs(MSGS:Config, 0.)
    /\ IRC_MSGS := configToIrcMsgList(MSGS:Config)
    /\ mattrs1 := ircLogRcvd(mattrs, T, ircAddr, epAddr, IRC_MSGS)
  [ print "(" T ") IRC Iface transforms " byteseq " to IrcMsg." ]
.

endm

mod TEST-IRC-BYTESEQ-INTERFACE is
  inc IRC-BYTESEQ-INTERFACE .
  
ops ifAd ircAd epAd  monAd : -> Address .

op ircMonAct : -> Actor .
eq ircMonAct = mkIrcMonitor(monAd,ircAd,epAd,"#xxx") .

op ircM : -> IrcMsg .
eq getSize(ircM) = 150 .

ops ircM0 ircM1 ircM2 ircM3 : -> IrcMsg .
eq ircM0 = PrivMsgReq(makeIrcChannelName("bbn"),
                      makeIrcUserName(ircAd),"msg 0") .
eq ircM1 = PrivMsgRes(makeIrcChannelName("bbn"),
                      makeIrcUserName(ircAd),"msg 0") .
eq ircM2 = PrivMsgReq(makeIrcChannelName("bbn"),
                      makeIrcUserName(ircAd),"msg 1") .
eq ircM3 = PrivMsgRes(makeIrcChannelName("bbn"),
                      makeIrcUserName(ircAd),"msg 1") .

endm  
eof

rew  rCtr(9) ircMonAct ircByteSeqIfAct {1.0,(to ifAd from ircAd : ircM0)} .

rew rCtr(10) ircMonAct ircByteSeqIfAct {1.1,(to ifAd from epAd : ircToByteseq(ircM1))} .
