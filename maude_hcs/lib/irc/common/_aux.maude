sload ./irc_name
sload ../../common/maude/_aux
sload ../_irc_aux
sload irc-msg-model
sload ../../network/transport.maude


mod IRC_NODE is
  pr TRANSPORT .
  pr IRC_NAMES .
  pr CP2_SORTS .
  pr IRC_AUX .
  inc IRC-MSG-MODEL .

  vars DST_ADDR SRC_ADDR IRC_CLIENT_ADDR IRC_SERVER_ADDR RB_ADDR : Address .
  vars ircClientAddrs IRC_CLIENT_ADDRS : AddrList .
  vars attrs attrsNext attrsTrans : AttributeSet .
  vars CLIENT_TIMESTAMP_MAP timestampMap : ClientTimestampMap .
  vars LAST_HEARD_TIME newHeardTime : Float .
  vars IRC_NAME ircName : IrcName .
  vars ircMsg IRC_MSG : IrcMsg .
  vars IRC_USER_NAME DST_IRC_USER_NAME SRC_IRC_USER_NAME : IrcUserName .
  vars IRC_USER_NAME_LIST : IrcUserNameList .
  vars CHANNEL_MAP : NameClientsMap .
  vars MSG_TEXT : String .

  vars CLIENT_ADDRESS_MAP  clientAddressMap : ClientAddressMap .
  
  op IRCOUTPUTDELAY : -> Float .
  eq IRCOUTPUTDELAY = 0.002 .

  ----------------
  --- [IRC Client]
  ----------------
  --- Attributes ---
  op IrcClient : -> ActorType [ctor] .
  --- This client's address.
  op thisAddr:_ : Address -> Attribute [ctor] .
  --- The Raceboat address.
  op raceboatAddr:_ : Address -> Attribute [ctor] .
  --- The IRC name.
  op ircName:_ : IrcUserName -> Attribute [ctor] .
 
  ---- attributes to support IRC Client message model
  --- The list of IRC messages to be sent to the layer below, per destination.
  op outputBufferTo_:_ : Address Config -> Attribute [ctor] .
  op msgSched:_ : IrcMsgDelayList -> Attribute [ctor] .
  op msgCtr:_ : Nat -> Attribute [ctor] .
  op userId:_ : String -> Attribute [ctor] .

  --- Client connection phases. Disconnected waits for ClientStartConnect;
  --- waiting-motd waits for registration; rtt-baseline collects three RTT samples;
  --- joining-channels waits for JOIN acknowledgments; connected can send chat;
  --- waiting-liveness-pong pauses queued sends while checking a stale connection.
  sort IrcConnState .
  ops disconnected waiting-motd rtt-baseline joining-channels connected waiting-liveness-pong : -> IrcConnState [ctor] .

  --- Ordered transport endpoints, visited cyclically on failure.
  op failoverList:_ : AddrList -> Attribute [ctor] .
  --- Zero-based position of the active endpoint in failoverList.
  op currentSidIdx:_ : Nat -> Attribute [ctor] .
  --- Current phase of connection establishment or liveness checking.
  op connState:_ : IrcConnState -> Attribute [ctor] .
  --- True once all requested channel joins have been acknowledged.
  op channelsReady:_ : Bool -> Attribute [ctor] .
  --- Desired channels, retained across reconnects for automatic rejoin.
  op joinedChannels:_ : IrcChannelNameList -> Attribute [ctor] .
  --- Channels still awaiting acknowledgment in the current connection attempt.
  op pendingJoins:_ : IrcChannelNameList -> Attribute [ctor] .
  --- Connection generation; rejects traffic/timers from earlier attempts.
  --- Epoch zero denotes an initially connected, idealized legacy transport.
  op pingEpoch:_ : Nat -> Attribute [ctor] .
  --- Number and total duration (seconds) of completed baseline RTT samples.
  op rttCount:_ : Nat -> Attribute [ctor] .
  op rttSum:_ : Float -> Attribute [ctor] .
  --- Mean baseline round-trip duration in seconds.
  op rttExpected:_ : Float -> Attribute [ctor] .
  --- Simulation time when the current baseline ping was sent.
  op lastPingSentAt:_ : Float -> Attribute [ctor] .
  --- Simulation time when valid traffic last arrived from the active endpoint.
  op lastRcvd:_ : Float -> Attribute [ctor] .
  --- Idle duration (seconds) before probing connection liveness.
  op pingTimeout:_ : Float -> Attribute [ctor] .
  --- Current response timeout (seconds), derived from the measured baseline RTT.
  op pongTimeout:_ : Float -> Attribute [ctor] .
  --- Initial registration/RTT timeout (seconds), restored on each reconnect.
  op basePongTimeout:_ : Float -> Attribute [ctor] .
  --- Count of user-model messages discarded while disconnected or on legacy loss.
  op droppedMsgCtr:_ : Nat -> Attribute [ctor] .
  --- Count of transitions to the next endpoint after a connection failure.
  op failoverCtr:_ : Nat -> Attribute [ctor] .
  --- Prevents starting the configured message schedule more than once.
  op schedStarted:_ : Bool -> Attribute [ctor] .

  --- FIFO of logical messages awaiting successful local send completion.
  sort IrcSendQueue .
  op emptySendQueue : -> IrcSendQueue [ctor] .
  op queued : IrcMsg -> IrcSendQueue [ctor] .
  op _++_ : IrcSendQueue IrcSendQueue -> IrcSendQueue [ctor assoc id: emptySendQueue] .
  op sendQueue:_ : IrcSendQueue -> Attribute [ctor] .
  --- True while the queue head has an outstanding local write acknowledgment.
  op writePending:_ : Bool -> Attribute [ctor] .
  --- Server-side association (client, transport endpoint, connection generation).
  --- Replies and expiry events use this record to reject superseded sessions.
  op sessionRecord : Address Address Nat -> Attribute [ctor] .
  op removeSessionRecord : AttributeSet Address -> AttributeSet .
  eq removeSessionRecord((attrs, sessionRecord(IRC_CLIENT_ADDR, RB_ADDR, n:Nat)), IRC_CLIENT_ADDR) = attrs .
  eq removeSessionRecord(attrs, IRC_CLIENT_ADDR) = attrs [owise] .

  op DefaultIrcPingTimeout : -> Float .
  eq DefaultIrcPingTimeout = 120.0 .
  op DefaultIrcPongTimeout : -> Float .
  eq DefaultIrcPongTimeout = 120.0 .

  --- Shared state for every client maker. Legacy entry points select an already
  --- connected singleton endpoint; CP4 entry points require explicit registration.
  --- Either can subsequently handle ClientStartConnect and the failover protocol.
  op initialIrcClientState : AddrList IrcChannelNameList Float Float IrcConnState Bool -> AttributeSet .
  eq initialIrcClientState(failoverEps:AddrList, chList:IrcChannelNameList,
                           pingTO:Float, basePongTO:Float, state:IrcConnState, ready:Bool) =
      (failoverList: failoverEps:AddrList,
       currentSidIdx: 0,
       connState: state:IrcConnState,
       channelsReady: ready:Bool,
       joinedChannels: chList:IrcChannelNameList,
       pendingJoins: emptyIrcChannelNameList,
       pingEpoch: 0,
       rttCount: 0,
       rttSum: 0.0,
       rttExpected: 0.0,
       lastPingSentAt: 0.0,
       lastRcvd: 0.0,
       pingTimeout: pingTO:Float,
       pongTimeout: basePongTO:Float,
       basePongTimeout: basePongTO:Float,
       droppedMsgCtr: 0,
       failoverCtr: 0,
       schedStarted: false,
       sendQueue: emptySendQueue,
       writePending: false)
  .

  --- User-model client with the same complete state as all other client makers.
  op mkIrcClient-v2 : Address Address String -> Actor .
  eq mkIrcClient-v2(IRC_CLIENT_ADDR, RB_ADDR, uid:String) =
    mkIrcClient(IRC_CLIENT_ADDR, RB_ADDR, uid:String, nilIMD) .

  --- Legacy clients start ready on their single endpoint, preserving existing
  --- scenarios that send user-model actions without a registration handshake.
  op mkIrcClient : Address Address -> Actor .
  eq mkIrcClient(IRC_CLIENT_ADDR, RB_ADDR) =
    mkIrcClient(IRC_CLIENT_ADDR, RB_ADDR, "", nilIMD) .

  op mkIrcClient : Address Address String -> Actor .
  eq mkIrcClient(IRC_CLIENT_ADDR, RB_ADDR, uid:String) =
    mkIrcClient(IRC_CLIENT_ADDR, RB_ADDR, uid:String, nilIMD) .

  op mkIrcClient : Address Address String IrcMsgDelayList -> Actor .
  eq mkIrcClient(IRC_CLIENT_ADDR, RB_ADDR, uid:String, delayMsgL:IrcMsgDelayList) =
    < IRC_CLIENT_ADDR : IrcClient |
        thisAddr: IRC_CLIENT_ADDR,
        raceboatAddr: RB_ADDR,
        ircName: makeIrcUserName(IRC_CLIENT_ADDR),
        userId: uid:String,
        msgCtr: 0,
        msgSched: delayMsgL:IrcMsgDelayList,
        initialIrcClientState(RB_ADDR, emptyIrcChannelNameList,
                              DefaultIrcPingTimeout, DefaultIrcPongTimeout, connected, true)
    >
  .

  --- Failover-capable client: (address, endpoints, user, channels, idle timeout,
  --- initial response timeout, message schedule). Starts disconnected until
  --- ClientStartConnect begins registration with the first endpoint.
  op mkIrcClient-cp4 : Address AddrList String IrcChannelNameList Float Float IrcMsgDelayList -> Actor .
  eq mkIrcClient-cp4(IRC_CLIENT_ADDR, failoverEps:AddrList, uid:String, chList:IrcChannelNameList, pingTO:Float, basePongTO:Float, delayMsgL:IrcMsgDelayList) =
    < IRC_CLIENT_ADDR : IrcClient |
        thisAddr: IRC_CLIENT_ADDR,
        raceboatAddr: getNthAddr(failoverEps:AddrList, 0),
        ircName: makeIrcUserName(IRC_CLIENT_ADDR),
        userId: uid:String,
        msgCtr: 0,
        msgSched: delayMsgL:IrcMsgDelayList,
        initialIrcClientState(failoverEps:AddrList, chList:IrcChannelNameList,
                              pingTO:Float, basePongTO:Float, disconnected, false)
    >
  .

  op mkIrcClient-cp4 : Address AddrList String IrcChannelNameList Float Float -> Actor .
  eq mkIrcClient-cp4(IRC_CLIENT_ADDR, failoverEps:AddrList, uid:String, chList:IrcChannelNameList, pingTO:Float, basePongTO:Float) =
    mkIrcClient-cp4(IRC_CLIENT_ADDR, failoverEps:AddrList, uid:String, chList:IrcChannelNameList, pingTO:Float, basePongTO:Float, nilIMD)
  .

  op mkIrcClient-cp4 : Address AddrList String IrcChannelNameList -> Actor .
  eq mkIrcClient-cp4(IRC_CLIENT_ADDR, failoverEps:AddrList, uid:String, chList:IrcChannelNameList) =
    mkIrcClient-cp4(IRC_CLIENT_ADDR, failoverEps:AddrList, uid:String, chList:IrcChannelNameList,
                    DefaultIrcPingTimeout, DefaultIrcPongTimeout, nilIMD)
  .

  op getThisAddr : AttributeSet -> Address .
  eq getThisAddr(attrs, thisAddr: IRC_CLIENT_ADDR) = IRC_CLIENT_ADDR .

  op getRaceboatAddr : AttributeSet -> Address .
  eq getRaceboatAddr(attrs, raceboatAddr: RB_ADDR) = RB_ADDR .

  op getIrcName : AttributeSet -> IrcUserName .
  eq getIrcName(attrs, ircName: IRC_USER_NAME) = IRC_USER_NAME .

  op getConnState : AttributeSet -> IrcConnState .
  eq getConnState(attrs, connState: cs:IrcConnState) = cs:IrcConnState .
  eq getConnState(attrs) = connected [owise] .

  op isChannelsReady : AttributeSet -> Bool .
  eq isChannelsReady(attrs, channelsReady: b:Bool) = b:Bool .
  eq isChannelsReady(attrs) = true [owise] .

  op isClientConnectedAndReady : AttributeSet -> Bool .
  eq isClientConnectedAndReady(attrs) =
    (getConnState(attrs) == connected or getConnState(attrs) == waiting-liveness-pong)
    and isChannelsReady(attrs) .

  op getDroppedMsgCtr : AttributeSet -> Nat .
  eq getDroppedMsgCtr(attrs, droppedMsgCtr: n:Nat) = n:Nat .
  eq getDroppedMsgCtr(attrs) = 0 [owise] .

  op incDroppedMsgCtr : AttributeSet -> AttributeSet .
  eq incDroppedMsgCtr((attrs, droppedMsgCtr: n:Nat)) = (attrs, droppedMsgCtr: s n:Nat) .
  eq incDroppedMsgCtr(attrs) = (attrs, droppedMsgCtr: 1) [owise] .

  op touchClientRcvd : AttributeSet Float -> AttributeSet .
  eq touchClientRcvd((attrs, lastRcvd: t0:Float), newHeardTime) = (attrs, lastRcvd: newHeardTime) .
  eq touchClientRcvd(attrs, newHeardTime) = attrs [owise] .
  
  op getNextDelayMsgText : AttributeSet -> String .
  eq getNextDelayMsgText(attrs,
                         userId: userid:String,
                         msgCtr: ctr:Nat,
                         msgSched: ((imd(txTime:Float, room:String, size:Nat) :: dml:IrcMsgDelayList)))
    = genIrcText(userid:String, ctr:Nat, size:Nat)
  .
  eq getNextDelayMsgText(attrs) = "DUMMY" [owise] .


  ----------------
  --- [IRC Server]
  ----------------
  op IrcServer : -> ActorType [ctor] .
  --- The channel name to user name map.
  op channelMap:_ : NameClientsMap -> Attribute [ctor] .
  --- The client timestamp map.
  op clientTimestampMap:_ : ClientTimestampMap -> Attribute [ctor] .
  --- The map of IRC name to address for multi client responses.
  op clientAddressMap:_ : ClientAddressMap -> Attribute [ctor] .
  --- CP4 Server-Server linked neighbor servers in the topology tree.
  op peerServers:_ : AddrList -> Attribute [ctor] .
  --- Channel memberships learned from peer servers. Kept separate from
  --- channelMap, whose users have local sockets in clientAddressMap.
  op remoteChannelMap:_ : NameClientsMap -> Attribute [ctor] .
  --- Other common attributes ---
  --- This server's address.
  ---op thisAddr:_ : Address -> Attribute [ctor] .
  --- The Raceboat address.
  ---op raceboatAddr:_ : Address -> Attribute [ctor] .
  --- The list of IRC messages to be sent to the layer below, per destination.
  ---op outputBuffer:_ : Config -> Attribute [ctor] .

  --- Make an IrcServer ItsAddr
  --- Needs nothing else: the client address map will select the right interface
  --- to each destination.
  op makeIrcServer :  Address -> Actor .
  eq makeIrcServer(IRC_SERVER_ADDR) = mkIrcServer(IRC_SERVER_ADDR) .

  --- Make an IrcServer ItsAddr without redundant argument
  op mkIrcServer :    Address  -> Actor .
  eq mkIrcServer(IRC_SERVER_ADDR) =
    < IRC_SERVER_ADDR : IrcServer |
        thisAddr: IRC_SERVER_ADDR,
        channelMap: emptyNameClientsMap,
        clientTimestampMap: emptyClientTimestampMap,
        clientAddressMap: emptyClientAddressMap
    >
  .

  --- Make a CP4 IrcServer with linked neighbor servers in the server tree
  op mkIrcServer : Address AddrList -> Actor .
  eq mkIrcServer(IRC_SERVER_ADDR, peerAddrs:AddrList) =
    < IRC_SERVER_ADDR : IrcServer |
        thisAddr: IRC_SERVER_ADDR,
        channelMap: emptyNameClientsMap,
        clientTimestampMap: emptyClientTimestampMap,
        clientAddressMap: emptyClientAddressMap,
        peerServers: peerAddrs:AddrList,
        remoteChannelMap: emptyNameClientsMap
    >
  .

  op getPeerServers : AttributeSet -> AddrList .
  eq getPeerServers((attrs, peerServers: peerAddrs:AddrList)) = peerAddrs:AddrList .
  eq getPeerServers(attrs) = nil [owise] .

  op getRemoteChannelMap : AttributeSet -> NameClientsMap .
  eq getRemoteChannelMap((attrs, remoteChannelMap: CHANNEL_MAP)) = CHANNEL_MAP .
  eq getRemoteChannelMap(attrs) = emptyNameClientsMap [owise] .

  --- Record a JOIN learned from another server in the tree. Remote members
  --- receive chat through peer relays, never through this server's client sockets.
  --- registerIrcUser keeps membership unique; a server without remoteChannelMap
  --- has no peer topology and is left unchanged by these helpers.
  op registerRemoteIrcUser : AttributeSet IrcChannelName Address -> AttributeSet .
  eq registerRemoteIrcUser((attrs, remoteChannelMap: CHANNEL_MAP),
                           IRC_CHANNEL_NAME:IrcChannelName,
                           IRC_CLIENT_ADDR)
    = (attrs, remoteChannelMap: registerIrcUser(CHANNEL_MAP,
                                                IRC_CHANNEL_NAME:IrcChannelName,
                                                IRC_CLIENT_ADDR))
  .
  eq registerRemoteIrcUser(attrs, IRC_CHANNEL_NAME:IrcChannelName, IRC_CLIENT_ADDR)
    = attrs [owise]
  .

  --- A relayed QUIT removes the remote user from every channel.
  op unregisterRemoteIrcUser : AttributeSet Address -> AttributeSet .
  eq unregisterRemoteIrcUser((attrs, remoteChannelMap: CHANNEL_MAP), IRC_CLIENT_ADDR)
    = (attrs, remoteChannelMap: unregisterIrcUser(CHANNEL_MAP, IRC_CLIENT_ADDR))
  .
  eq unregisterRemoteIrcUser(attrs, IRC_CLIENT_ADDR) = attrs [owise] .

  --- A relayed PART removes only this channel membership. A local JOIN also
  --- calls this helper when a previously remote user reconnects to this server.
  op unregisterRemoteIrcUserFromChannel : AttributeSet IrcChannelName Address -> AttributeSet .
  eq unregisterRemoteIrcUserFromChannel((attrs, remoteChannelMap: CHANNEL_MAP),
                                        IRC_CHANNEL_NAME:IrcChannelName,
                                        IRC_CLIENT_ADDR)
    = (attrs, remoteChannelMap: unregisterIrcUserFromChannel(CHANNEL_MAP,
                                                             IRC_CHANNEL_NAME:IrcChannelName,
                                                             IRC_CLIENT_ADDR))
  .
  eq unregisterRemoteIrcUserFromChannel(attrs, IRC_CHANNEL_NAME:IrcChannelName, IRC_CLIENT_ADDR)
    = attrs [owise]
  .

  op getClientTimestampMap : AttributeSet -> ClientTimestampMap .
  eq getClientTimestampMap(attrs, clientTimestampMap: CLIENT_TIMESTAMP_MAP)
    = CLIENT_TIMESTAMP_MAP
  .

  op getClientAddressMap : AttributeSet -> ClientAddressMap .
  eq getClientAddressMap((attrs, 
                          clientAddressMap: CLIENT_ADDRESS_MAP))
    = CLIENT_ADDRESS_MAP
  .

  --- Register an IRC user.
  op registerIrcUser : AttributeSet IrcChannelName Address -> AttributeSet .
  eq registerIrcUser((attrs, channelMap: CHANNEL_MAP),
                     IRC_CHANNEL_NAME:IrcChannelName,
                     IRC_CLIENT_ADDR)
    = (attrs, channelMap: registerIrcUser(CHANNEL_MAP,
                                          IRC_CHANNEL_NAME:IrcChannelName,
                                          IRC_CLIENT_ADDR))
  .

  op registerIrcUsers : AttributeSet IrcChannelName AddrList -> AttributeSet .
  eq registerIrcUsers((attrs, channelMap: CHANNEL_MAP),
                      IRC_CHANNEL_NAME:IrcChannelName,
                      IRC_CLIENT_ADDRS)
    = (attrs, 
       channelMap: registerIrcUsers(CHANNEL_MAP,
                           IRC_CHANNEL_NAME:IrcChannelName,
                           IRC_CLIENT_ADDRS))
  .

**** CLT Register  the connection address of an IRC user.
  op registerIrcUserAddress : AttributeSet IrcUserName Address -> AttributeSet .
  eq registerIrcUserAddress((attrs, 
                            clientAddressMap: clientAddressMap),
                           IRC_USER_NAME,
                           IRC_CLIENT_ADDR)
    = (attrs, clientAddressMap:  
                registerIrcUserAddress(clientAddressMap,
                                       IRC_USER_NAME,IRC_CLIENT_ADDR))
  .


  --- Unregister IRC users (from all its channels).
  op unregisterIrcUser : AttributeSet Address -> AttributeSet .
  eq unregisterIrcUser((attrs, 
                        channelMap: CHANNEL_MAP,
                        clientTimestampMap: timestampMap,
                        clientAddressMap: clientAddressMap),
                       IRC_CLIENT_ADDR)
    = (attrs, 
       channelMap: unregisterIrcUser(CHANNEL_MAP,IRC_CLIENT_ADDR),
       clientTimestampMap: pruneUser(timestampMap, IRC_CLIENT_ADDR),
       clientAddressMap: pruneUserAddr(clientAddressMap,IRC_CLIENT_ADDR))
    [ print "Unregister IRC user " IRC_CLIENT_ADDR ]
  .

  --- Handle a ping timeout for a user: check if stale, if so, unregister.
  ---            Attributes    Address Now
  op clearUser : AttributeSet  Address Float -> AttributeSet .
  eq clearUser(attrs,
               IRC_CLIENT_ADDR,
               now:Float)
    = (if isUserStale(getClientTimestampMap(attrs),
                      makeIrcUserName(IRC_CLIENT_ADDR),
                      now:Float)
        then unregisterIrcUser(attrs, IRC_CLIENT_ADDR)
        else attrs
      fi)
  .

  op clearUser : AttributeSet Address -> AttributeSet .
  eq clearUser(attrs, IRC_CLIENT_ADDR) = unregisterIrcUser(attrs, IRC_CLIENT_ADDR) .


  --- Get the channel map.
  op getChannelMap : AttributeSet -> NameClientsMap .
  eq getChannelMap(attrs, channelMap: CHANNEL_MAP:NameClientsMap)
    = CHANNEL_MAP:NameClientsMap
  .


  --- Create a message to go from a client to another client or all clients in 
  --- a channel.
  ---                    Attributes    Src IRC User  IRC dest users  Text
***** CLT NOT USED  
  op createPrivMsgReq :  AttributeSet  IrcUserName   IrcUserNameList String -> Config .
  eq createPrivMsgReq(attrs, SRC_IRC_USER_NAME, IRC_USER_NAME_LIST, MSG_TEXT)
    = createIrcMsg(attrs, SRC_IRC_USER_NAME, IRC_USER_NAME_LIST,
                   PrivMsgReq(SRC_IRC_USER_NAME,
                              SRC_IRC_USER_NAME,
                              MSG_TEXT))
  .
  ---                   Attributes    IrcNameDest IrcUseSrc   IRC User Dests  
  op createPrivMsgRes : AttributeSet  IrcName     IrcUserName IrcUserNameList
  ---                   Text
                        String -> Config .
  eq createPrivMsgRes(attrs,
                      ircName,
                      SRC_IRC_USER_NAME,
                      IRC_USER_NAME_LIST,
                      MSG_TEXT)
    = createIrcMsg(attrs,
                   SRC_IRC_USER_NAME,
                   IRC_USER_NAME_LIST,
                   PrivMsgRes(ircName,
                              SRC_IRC_USER_NAME,
                              MSG_TEXT))
  .


  --- Src IRC User is the IRC user that sent the message originally (and does 
  --- not need to receive it again).
  ---                Attributes    Src IRC User  IRC dest users  IrcMsg
  op createIrcMsg :  AttributeSet  IrcUserName   IrcUserNameList IrcMsg -> Config .
  eq createIrcMsg(attrs, SRC_IRC_USER_NAME, IRC_USER_NAME_LIST, ircMsg)
    = $createIrcMsg(getClientAddressMap(attrs),
                    getThisAddr(attrs),
                    SRC_IRC_USER_NAME,
                    ircMsg,
                    IRC_USER_NAME_LIST)
  .

  op $createIrcMsg : ClientAddressMap Address IrcUserName IrcMsg IrcUserNameList -> Config .
  ceq $createIrcMsg(clientAddressMap,  ----to lookup DST_ADDR,
                    SRC_ADDR,
                    SRC_IRC_USER_NAME,
                    ircMsg,
                    DST_IRC_USER_NAME : IRC_USER_NAME_LIST)
    = (if msg:Msg == nullMsg then null else msg:Msg fi)
      $createIrcMsg(clientAddressMap,  ---- DST_ADDR,
                    SRC_ADDR,
                    SRC_IRC_USER_NAME,
                    ircMsg,
                    IRC_USER_NAME_LIST)
    if DST_ADDR := getClientAddr(clientAddressMap, 
                                 DST_IRC_USER_NAME)
    /\ msg:Msg :=
      (if DST_IRC_USER_NAME == SRC_IRC_USER_NAME
        then nullMsg
        else (to transport(DST_ADDR) from SRC_ADDR : 
                setDest(ircMsg,
                        getAddressFromUserName(DST_IRC_USER_NAME)))
      fi)
    [ print "Create IRC msg " ircMsg " to " DST_IRC_USER_NAME ]
  .

  **** No [owise], this is the iteration end case
  eq $createIrcMsg(clientAddressMap, ----- DST_ADDR,
                   SRC_ADDR,
                   SRC_IRC_USER_NAME,
                   ircMsg,
                   emptyIrcUserNameList)
    = null
  .

  --- Create IRC message for all clients in list INCLUDING the source user,
  --- used by IRC server on JOIN so joining client receives self-join confirmation.
  op createIrcMsgIncludingSelf : AttributeSet IrcUserNameList IrcMsg -> Config .
  eq createIrcMsgIncludingSelf(attrs, IRC_USER_NAME_LIST, ircMsg)
    = $createIrcMsgIncludingSelf(getClientAddressMap(attrs),
                                 getThisAddr(attrs),
                                 ircMsg,
                                 IRC_USER_NAME_LIST)
  .

  op $createIrcMsgIncludingSelf : ClientAddressMap Address IrcMsg IrcUserNameList -> Config .
  ceq $createIrcMsgIncludingSelf(clientAddressMap,
                                 SRC_ADDR,
                                 ircMsg,
                                 DST_IRC_USER_NAME : IRC_USER_NAME_LIST)
    = (if DST_ADDR == nullAddr
       then null
       else (to transport(DST_ADDR) from SRC_ADDR :
               setDest(ircMsg, getAddressFromUserName(DST_IRC_USER_NAME)))
       fi)
      $createIrcMsgIncludingSelf(clientAddressMap,
                                 SRC_ADDR,
                                 ircMsg,
                                 IRC_USER_NAME_LIST)
    if DST_ADDR := getClientAddr(clientAddressMap, DST_IRC_USER_NAME)
  .
  eq $createIrcMsgIncludingSelf(clientAddressMap,
                                SRC_ADDR,
                                ircMsg,
                                emptyIrcUserNameList)
    = null
  .

  --- Forward server-to-server IRC message across linked neighbor servers in the
  --- server tree, excluding the link/server from which the message arrived.
  op createPeerSrvMsgs : Address AddrList Address Address IrcMsg -> Config .
  eq createPeerSrvMsgs(SRC_ADDR, nil, exclAddr1:Address, exclAddr2:Address, ircMsg)
    = null
  .
  eq createPeerSrvMsgs(SRC_ADDR,
                       peerAddr:Address ; peerAddrs:AddrList,
                       exclAddr1:Address,
                       exclAddr2:Address,
                       ircMsg)
    = (if (peerAddr:Address == exclAddr1:Address) or (peerAddr:Address == exclAddr2:Address)
       then null
       else (to transport(peerAddr:Address) from SRC_ADDR : setDest(ircMsg, peerAddr:Address))
       fi)
      createPeerSrvMsgs(SRC_ADDR,
                        peerAddrs:AddrList,
                        exclAddr1:Address,
                        exclAddr2:Address,
                        ircMsg)
  .

  --- Get the size of an IrcMsg.
  --- TODO: Fix and complete.
  op getSize : IrcMsg -> Nat .
  eq getSize(PrivMsgReq(IRC_NAME,
                        IRC_USER_NAME,
                        MSG_TEXT))
    = 109 **** Placeholder for now.  Will need to change.
  .
  eq getSize(PrivMsgRes(IRC_NAME,
                        IRC_USER_NAME,
                        MSG_TEXT))
    = 110 **** Placeholder for now.  Will need to change.
  .

  --- Get the source address of an IrcMsg.
  op getIrcSrcAddr : IrcMsg -> Address .
  eq getIrcSrcAddr(ircMsg) = getAddressFromUserName(getIrcSrc(ircMsg)) .

  --- Get the IRC source of an IrcMsg.
  op getIrcSrc : IrcMsg -> IrcName .
  eq getIrcSrc(PrivMsgReq(IRC_NAME, IRC_USER_NAME, MSG_TEXT))
    = IRC_USER_NAME
  .
  eq getIrcSrc(PrivMsgRes(IRC_NAME, IRC_USER_NAME, MSG_TEXT))
    = IRC_USER_NAME
  .
  eq getIrcSrc(PrivMsgReq(IRC_NAME, IRC_USER_NAME, MSG_TEXT, SRV:Address))
    = IRC_USER_NAME
  .
  eq getIrcSrc(JoinChannel(IRC_NAME, SRC_ADDR))
    = makeIrcUserName(SRC_ADDR)
  .
  eq getIrcSrc(Pong(IRC_USER_NAME, SRC_ADDR))
    = IRC_USER_NAME .
  eq getIrcSrc(IRC_MSG) = nilIrcUserName [owise] .

  --- Get the IRC destination of an IrcMsg.
  --- TODO: Fix and complete.
  op getIrcDest : IrcMsg -> IrcName .
  eq getIrcDest(PrivMsgReq(IRC_NAME,
                           IRC_USER_NAME,
                           MSG_TEXT)) = IRC_NAME .
  eq getIrcDest(PrivMsgRes(IRC_NAME,
                           IRC_USER_NAME,
                           MSG_TEXT)) = IRC_NAME .
  eq getIrcDest(PrivMsgReq(IRC_NAME,
                           IRC_USER_NAME,
                           MSG_TEXT,
                           SRV:Address)) = IRC_NAME .

  --- Get the text in an IrcMsg.
  --- TODO: Fix and complete.
  op getText : IrcMsg -> String .
  eq getText(PrivMsgReq(IRC_NAME,
                        IRC_USER_NAME,
                        MSG_TEXT)) = MSG_TEXT .
  eq getText(PrivMsgRes(IRC_NAME,
                        IRC_USER_NAME,
                        MSG_TEXT)) = MSG_TEXT .
  eq getText(PrivMsgReq(IRC_NAME,
                        IRC_USER_NAME,
                        MSG_TEXT,
                        SRV:Address)) = MSG_TEXT .

  --- Refresh the timestamp when server last heard from a client.
  op refreshUser : AttributeSet IrcUserName Float -> AttributeSet .
  eq refreshUser((attrs,
                  clientTimestampMap: timestampMap),
                 IRC_USER_NAME,
                 newHeardTime)
    = attrs,
      clientTimestampMap: refreshUser(timestampMap, IRC_USER_NAME, newHeardTime)
  .

  op refreshUser : AttributeSet Address Float -> AttributeSet .
  eq refreshUser((attrs, clientTimestampMap: timestampMap),
                 IRC_CLIENT_ADDR,
                 newHeardTime)
    = attrs,
      clientTimestampMap: refreshUser(timestampMap, makeIrcUserName(IRC_CLIENT_ADDR), newHeardTime)
  .

**** CLT nicer would be call to function AddrList -> IrcUserNameList .
  op refreshUsers : AttributeSet AddrList Float -> AttributeSet .
  eq refreshUsers((attrs,
                    clientTimestampMap: timestampMap),
                  IRC_CLIENT_ADDR ; IRC_CLIENT_ADDRS,
                  newHeardTime)
    = refreshUsers(refreshUser((attrs, clientTimestampMap: timestampMap),
                               makeIrcUserName(IRC_CLIENT_ADDR),
                               newHeardTime),
                   IRC_CLIENT_ADDRS,
                   newHeardTime)
  .

  op createUserQuitMsgs : AttributeSet Address -> Config .
  ceq createUserQuitMsgs(attrs, IRC_CLIENT_ADDR)
    = msgs:Config
    if CHANNEL_MAP := getChannelMap(attrs)
      /\ userChannels:IrcChannelNameList := getChannels(CHANNEL_MAP, IRC_CLIENT_ADDR)
      /\ IRC_USER_NAME_LIST := getAllClients(CHANNEL_MAP, userChannels:IrcChannelNameList)
      /\ msgs:Config := createIrcMsg(attrs,
                                     makeIrcUserName(IRC_CLIENT_ADDR),
                                     IRC_USER_NAME_LIST,
                                     Quit(IRC_CLIENT_ADDR, IRC_CLIENT_ADDR))
    [ print "Tell " IRC_USER_NAME_LIST " of " IRC_CLIENT_ADDR " quit." ]
    .
  eq createUserQuitMsgs(attrs, IRC_CLIENT_ADDR) = null [owise] .

endm


