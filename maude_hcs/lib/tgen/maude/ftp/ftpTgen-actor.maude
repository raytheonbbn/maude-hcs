--- MAUDE_HCS: maude_hcs
--- FTP Tgen Actor
---

sload ../../../common/maude/sampler-x
sload ../../../common/maude/cp2-interfaces
sload ./ftp_messages.maude
*** sload ../../../common/maude/delay-drop-x
sload ../../../common/maude/delay-drop-x-aux
sload ../../../common/maude/multi-msg-send

sload ../../../common/maude/delay-drop-x-aux
sload ./ftp-utils.maude
sload ../../../common/maude/user-action-actor-v2-aux

mod FTP-TGEN is
  inc CP2-COMMON .
  inc FTP-MESSAGES .
***  inc DELAY-X .
  inc DELAY-X-AUX .
  inc FTP-UTILS .
  inc CONVERSION .
  inc TGEN-INTERFACE .
****  inc DELAY-X .
  inc DELAY-X-AUX .
  inc MULTI-MSG-SEND .

  sorts FtpTask FtpTaskList FtpTaskListNat .
  op {_,_} : FtpTaskList Nat -> FtpTaskListNat [ctor] .
  subsort FtpTask < FtpTaskList .
  op emptyTasks : -> FtpTaskList .
  op _::_ : FtpTaskList FtpTaskList -> FtpTaskList [assoc id: emptyTasks] .

  --- Client Tasks
  op sendCmdTask : String String -> FtpTask . --- cmd, arg
  op sendDataTask : Nat -> FtpTask .       --- data payload size
  op waitDataTask : -> FtpTask .              --- waiting for ftpData
  op wait226Task : -> FtpTask .               --- waiting for 226
  op noTask : -> FtpTask .

  op FtpTgen : -> ActorType .

  --- Attributes
  op ftpRsv:_ : Address -> Attribute [ctor] . --- server
  op w4:_ : FtpTask -> Attribute [ctor] .
  op pendingTasks:_ : FtpTaskList -> Attribute [ctor] .
  op replyTo:_ : Config -> Attribute [ctor] .
  op nRetry:_ : Nat -> Attribute [ctor] .
  op retryTO:_ : Float -> Attribute [ctor] .
  op retryMax:_ : Nat -> Attribute [ctor] .
  op reqId:_ : Nat -> Attribute [ctor] .
  op umModelName:_ : String -> Attribute [ctor] .




  --- genFilesSize(rj, count, minS, maxS, accum) -> {accum', rj'}
  op genFilesSize : Nat Nat Nat Nat Nat -> NatNat .
  eq genFilesSize(rj, 0, minS, maxS, accum) = {accum, rj} .
  ceq genFilesSize(rj, s count, minS, maxS, accum) = 
      genFilesSize(rj1, count, minS, maxS, accum + size) 
      if {size, rj1} := getRand(rj, minS, maxS) .

  --- genDirsSize(rj, count, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum) -> {accum', rj'}
  op genDirsSize : Nat Nat Nat Nat Nat Nat Nat Nat Nat -> NatNat .
  eq genDirsSize(rj, 0, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum) = {accum, rj} .
  ceq genDirsSize(rj, s count, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum) = 
      genDirsSize(rj2, count, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum2)
      if {accum1, rj1} := genTreeSize(rj, depth + 1, maxDepth, maxDirs, maxFiles, minS, maxS, 0)
      /\ accum2 := accum + accum1 
      /\ rj2 := rj1 .

  --- genTreeSize(rj, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum) -> {accum', rj'}
  op genTreeSize : Nat Nat Nat Nat Nat Nat Nat Nat -> NatNat .
  ceq genTreeSize(rj, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum) = 
      if depth >= maxDepth 
      then {accum1, rj2} 
      else genDirsSize(rj3, numDirs, depth, maxDepth, maxDirs, maxFiles, minS, maxS, accum1) fi
      if {numFiles, rj1} := getRand(rj, 1, maxFiles) 
      /\ {accum1, rj2} := genFilesSize(rj1, numFiles, minS, maxS, accum)
      /\ {numDirs, rj3} := getRand(rj2, 1, maxDirs) .

  op genRandomZipSize : String Nat -> NatNat .
  ceq genRandomZipSize(mname, rj) =
    genTreeSize(rj, 1, maxDepth, maxDirs, maxFiles, minSize, maxSize, 0)
    if pars := getPars(mname) 
    /\ js(strDepth) := pars["max_zip_depth"]
    /\ maxDepth := rat(strDepth, 10)
    /\ js(strDirs) := pars["max_zip_dirs"]
    /\ maxDirs := rat(strDirs, 10)
    /\ js(strFiles) := pars["max_zip_files"]
    /\ maxFiles := rat(strFiles, 10)
    /\ js(strMinSize) := pars["min_file_size"]
    /\ minSize := rat(strMinSize, 10)
    /\ js(strMaxSize) := pars["max_file_size"]
    /\ maxSize := rat(strMaxSize, 10) .
    
  eq genRandomZipSize(mname, rj) = {100, rj} [owise] .

  vars strDepth strDirs strFiles strMinSize strMaxSize : String .
  vars maxDepth maxDirs maxFiles minSize maxSize zSize numFiles numDirs accum accum1 accum2 accum3 minS maxS count depth size rj0 rj2 rj3 : Nat .
  vars dAddr umAddr rsvAddr : Address .
  vars attrs attrs1 attrs2 : AttributeSet .
  vars msg msg1 msg0 : Msg .
  vars msgs msgs0 : MsgList .
  vars rj rj1 rj2 n n0 j j1 k nRetryMax reqId reqId0 : Nat .
  vars T retryTo : Float .
  vars pars ract : Map{String,JV} .
  vars mname : String .
  vars cmd arg status text dataStr : String .
  vars task task0 : FtpTask .
  vars tasks tasks1 : FtpTaskList .
  vars ac : Content .
  
  vars smsgs : Config .

  --- Attribute getters
  op getRetryTO : AttributeSet -> Float .
  eq getRetryTO((attrs, retryTO: retryTo)) = retryTo .

  op getRetryMax : AttributeSet -> Nat .
  eq getRetryMax((attrs, retryMax: n)) = n .

  op mkFtpTgenA : Address Address Float Nat String -> Actor .
  eq mkFtpTgenA(dAddr, rsvAddr, retryTo, nRetryMax, mname) =
    < dAddr : FtpTgen |
      ftpRsv: rsvAddr,
      w4: noTask,
      pendingTasks: emptyTasks,
      replyTo: null,
      nRetry: 0,
      retryTO: retryTo,
      retryMax: nRetryMax,
      reqId: 0,
      umModelName: mname
    > .

  --- Initial reception of actionQ
  crl [rcvFtpAction]:
    rCtr(rj)
    {T, (to dAddr from umAddr : actionQ(ract))}
    < dAddr : FtpTgen | attrs, w4: noTask, replyTo: null, pendingTasks: emptyTasks, reqId: reqId, retryMax: nRetryMax, ftpRsv: rsvAddr, nRetry: k, umModelName: mname >
  =>
    rCtr(rj2)
    < dAddr : FtpTgen | attrs1 >
    smsgs
****  delayMsgs(msgs, null)
    (if msgs0 == nilML then null else [getRetryTO(attrs) + genRandomX(rj, -0.00001, 0.00001), msgs0, 0] fi)
  if [attrs1, msgs, msgs0, rj1] := nextFtpTask((attrs, umModelName: mname, w4: noTask, replyTo: (to dAddr from umAddr : actionQ(ract)), pendingTasks: genTasks(ract), reqId: s reqId, retryMax: nRetryMax, nRetry: nRetryMax, ftpRsv: rsvAddr), dAddr, rsvAddr, s reqId, s rj)
  /\ {smsgs,rj2} := delayMsgLX(rj1,msgs)
  [print "(" T ") FtpTgen rcvFtpAction " ract] .

**** CLT note that from examination of genTasks, msgs is at most
**** one msg even tho the recursive call accumulating msgs
**** in the ftpData case looks like there might be more.
**** ftpData is always followed by a wait which only adds to msgs0

  --- Task Generation based on action
  op genTasks : Map{String,JV} String Nat -> FtpTaskListNat .
  op genTasksStr : String String Nat -> FtpTaskListNat .
  eq genTasks((ract, "type" |-> js(cmd)), mname, rj) = genTasksStr(cmd, mname, rj) .
  eq genTasks(ract, mname, rj) = genTasksStr("wait", mname, rj) [owise] .

  eq genTasksStr("browse_list", mname, rj) =
    {sendCmdTask("NOOP", "") :: sendCmdTask("PASV", "") :: sendCmdTask("MLSD", ".") :: waitDataTask :: wait226Task, rj} .
  eq genTasksStr("browse_stat", mname, rj) =
    {sendCmdTask("NOOP", "") :: sendCmdTask("PASV", "") :: sendCmdTask("MLSD", ".") :: waitDataTask :: wait226Task, rj} .
  eq genTasksStr("browse_cd", mname, rj) =
    {sendCmdTask("NOOP", "") :: sendCmdTask("CWD", "rand_dir") :: sendCmdTask("PASV", "") :: sendCmdTask("MLSD", ".") :: waitDataTask :: wait226Task :: sendCmdTask("CWD", "rand_dir2"), rj} .
  ceq genTasksStr("upload_store", mname, rj) =
    {sendCmdTask("NOOP", "") :: sendCmdTask("PASV", "") :: sendCmdTask("STOR", "rand_file") :: sendDataTask(zSize) :: wait226Task, rj1} 
    if {zSize, rj1} := genRandomZipSize(mname, rj) .
  ceq genTasksStr("upload_appe", mname, rj) =
    {sendCmdTask("NOOP", "") :: sendCmdTask("PASV", "") :: sendCmdTask("APPE", "rand_file") :: sendDataTask(zSize) :: wait226Task, rj1}
    if {zSize, rj1} := genRandomZipSize(mname, rj) .
  eq genTasksStr("download_retr", mname, rj) =
    {sendCmdTask("NOOP", "") :: sendCmdTask("PASV", "") :: sendCmdTask("RETR", "rand_file") :: waitDataTask :: wait226Task, rj} .
  eq genTasksStr("wait", mname, rj) = {sendCmdTask("NOOP", ""), rj} .
  eq genTasksStr("browse_noop", mname, rj) = {sendCmdTask("NOOP", ""), rj} .
  eq genTasksStr("upload_noop", mname, rj) = {sendCmdTask("NOOP", ""), rj} .
  eq genTasksStr("download_noop", mname, rj) = {sendCmdTask("NOOP", ""), rj} .
  eq genTasksStr(cmd, mname, rj) = {sendCmdTask("NOOP", ""), rj} [owise] .

  --- Step through tasks
  op nextFtpTask : AttributeSet Address Address Nat Nat -> AttributeSetMsgLMsgLNat .
  eq nextFtpTask((attrs, w4: task0, pendingTasks: emptyTasks), dAddr, rsvAddr, reqId, rj) =
    [ (attrs, w4: noTask, pendingTasks: emptyTasks), nilML, nilML, rj ] .
     
     
  eq nextFtpTask((attrs, w4: task0, pendingTasks: (sendCmdTask(cmd, arg) :: tasks)), dAddr, rsvAddr, reqId, rj) =
    [ (attrs, w4: sendCmdTask(cmd, arg), pendingTasks: tasks),
      (to transport(rsvAddr) from dAddr : ftpReq(reqId, cmd, arg)),
      (to dAddr : ftpTO(ftpReq(reqId, cmd, arg))),
      rj ] .
      
  ceq nextFtpTask((attrs, w4: task0, pendingTasks: (sendDataTask(zSize) :: tasks)), dAddr, rsvAddr, reqId, rj) =
    { attrs2, msgs (to to transport(rsvAddr) from dAddr : ftpData(reqId, zSize)), msgs0, rj1 }
  if {attrs2, msgs, msgs0, rj1} := nextFtpTask((attrs, w4: sendDataTask(zSize), pendingTasks: tasks), dAddr, rsvAddr, reqId, rj) .
  
  eq nextFtpTask((attrs, w4: task0, pendingTasks: (waitDataTask :: tasks)), dAddr, rsvAddr, reqId, rj) =
    [ (attrs, w4: waitDataTask, pendingTasks: tasks),
      nilML,
      (to dAddr : ftpDataTO(ftpReq(reqId, "WAIT", ""))),
      rj ] .
      
  eq nextFtpTask((attrs, w4: task0, pendingTasks: (wait226Task :: tasks)), dAddr, rsvAddr, reqId, rj) =
    [ (attrs, w4: wait226Task, pendingTasks: tasks),
      nilML,
      (to dAddr : ftpDataTO(ftpReq(reqId, "WAIT", ""))),
      rj ] .

  --- Handling responses
  crl [rcvFtpRes]:
    rCtr(rj)
    {T, (to dAddr from rsvAddr : ftpRes(reqId, status, text))}
    < dAddr : FtpTgen | ftpRsv: rsvAddr, w4: task, reqId: reqId, attrs >
  =>
    rCtr(rj2)
    < dAddr : FtpTgen | attrs1 >
 ****   delayMsgs(msgs, null)
    smsgs
    (if msgs0 == nilML then null else [getRetryTO(attrs) + genRandomX(rj, -0.00001, 0.00001), msgs0, 0] fi)
  if matchRes(task, status)
  /\ [attrs1, msgs, msgs0, rj1] := handleRes((ftpRsv: rsvAddr, w4: task, reqId: reqId, attrs), dAddr, rsvAddr, reqId, rj)
  /\ {smsgs,rj2} := delayMsgLX(s rj1,msgs)
  [print "(" T ") FtpTgen receives ftpRes " status " " text] .

  op matchRes : FtpTask String -> Bool .
  eq matchRes(sendCmdTask(cmd, arg), status) = true . --- Accept any response as progressing the task for now (e.g. 200, 227, 250, 150)
  eq matchRes(wait226Task, "226") = true .
  eq matchRes(waitDataTask, status) = false .
  eq matchRes(task, status) = false [owise] .

  crl [rcvFtpData]:
    rCtr(rj)
    {T, (to dAddr from rsvAddr : ftpData(reqId, zSize))}
    < dAddr : FtpTgen | ftpRsv: rsvAddr, w4: waitDataTask, reqId: reqId, attrs >
  =>
    rCtr(rj2)
    < dAddr : FtpTgen | attrs1 >
    delayMsgs(msgs, null)
    (if msgs0 == nilML then null else [getRetryTO(attrs) + genRandomX(rj, -0.00001, 0.00001), msgs0, 0] fi)
  if [attrs1, msgs, msgs0, rj1] := handleRes((ftpRsv: rsvAddr, w4: waitDataTask, reqId: reqId, attrs), dAddr, rsvAddr, reqId, rj)
  /\ {smsgs,rj2} := delayMsgLX(s rj,msgs)
  [print "(" T ") FtpTgen receives ftpData size " zSize] .

  op handleRes : AttributeSet Address Address Nat Nat -> AttributeSetMsgLMsgLNat .
  eq handleRes((attrs, w4: task0, pendingTasks: emptyTasks, replyTo: (to dAddr from umAddr : ac), nRetry: k), dAddr, rsvAddr, reqId, rj) =
    [ (attrs, pendingTasks: emptyTasks, replyTo: null, w4: noTask, nRetry: k),
      (to umAddr from dAddr : actionR("ok")),
      nilML,
      rj ] .

  eq handleRes((attrs, w4: task0, pendingTasks: (task :: tasks), replyTo: (to dAddr from umAddr : ac), nRetry: k, retryMax: nRetryMax), dAddr, rsvAddr, reqId, rj) =
    nextFtpTask((attrs, w4: task0, pendingTasks: (task :: tasks), replyTo: (to dAddr from umAddr : ac), nRetry: nRetryMax, retryMax: nRetryMax), dAddr, rsvAddr, reqId, rj) .
  
  eq handleRes(attrs, dAddr, rsvAddr, reqId, rj) = 
     [attrs, nilML, nilML, rj] [owise] .

  --- Timeout logic
  --- 1) Ignore bad timeouts
  crl [ftpTOignore]:
    {T, (to dAddr : ftpTO(ftpReq(reqId0, cmd, arg)))}
    < dAddr : FtpTgen | w4: task, reqId: reqId, attrs >
  =>
    < dAddr : FtpTgen | w4: task, reqId: reqId, attrs >
  if (reqId0 =/= reqId) or (task =/= sendCmdTask(cmd, arg))
  [print "(" T ") FtpTgen ignore TO"] .

  crl [ftpDataTOignore]:
    {T, (to dAddr : ftpDataTO(ftpReq(reqId0, "WAIT", "")))}
    < dAddr : FtpTgen | w4: task, reqId: reqId, attrs >
  =>
    < dAddr : FtpTgen | w4: task, reqId: reqId, attrs >
  if (reqId0 =/= reqId) or (not (task == waitDataTask or task == wait226Task))
  [print "(" T ") FtpTgen ignore data TO"] .

  --- 2) Retry
  crl [ftpTOretry]:
    rCtr(rj)
    {T, (to dAddr : ftpTO(ftpReq(reqId, cmd, arg)))}
    < dAddr : FtpTgen | nRetry: s n, w4: sendCmdTask(cmd, arg), ftpRsv: rsvAddr, reqId: reqId, attrs >
  =>
    rCtr(s rj1)
    < dAddr : FtpTgen | nRetry: n, w4: sendCmdTask(cmd, arg), ftpRsv: rsvAddr, reqId: reqId, attrs >
*****    [delayParamd(msg), msg, dropParamd(msg)]
    smsgs
    [getRetryTO(attrs) + genRandomX(rj, -0.0001, 0.0001), msg1, 0]
  if msg := (to transport(rsvAddr) from dAddr : ftpReq(reqId, cmd, arg))
  /\ msg1 := (to dAddr : ftpTO(ftpReq(reqId, cmd, arg)))
  /\ {smsgs,rj1} := delayMsgsX(s rj,msg,null)
  [print "(" T ") FtpTgen ftpTOretry nRetry left " n] .

  --- 3) Give up
  crl [ftpTOgiveup]:
    rCtr(rj)
    {T, (to dAddr : ftpTO(ftpReq(reqId, cmd, arg)))}
    < dAddr : FtpTgen | nRetry: 0, w4: sendCmdTask(cmd, arg), replyTo: (to dAddr from umAddr : ac), reqId: reqId, attrs >
  =>
    rCtr(rj1)
    < dAddr : FtpTgen | nRetry: 0, w4: noTask, replyTo: null, reqId: reqId, attrs >
****  delayMsgs(msg0, null)
  if msg0 := (to umAddr from dAddr : actionR("failed"))
  /\ {smsgs,rj1} := delayMsgsX(rj,msg0, null)
  [print "(" T ") FtpTgen ftpTOgiveup failed"] .

  --- Data timeout logic can follow the same ignore/retry/giveup patterns.
  --- Assuming simple ignore/giveup for data to avoid too much duplication, 
  --- or implementing retry for `WAIT` timeout.
  crl [ftpDataTOretry]:
    rCtr(rj)
    {T, (to dAddr : ftpDataTO(ftpReq(reqId, "WAIT", "")))}
    < dAddr : FtpTgen | nRetry: s n, w4: task, ftpRsv: rsvAddr, reqId: reqId, attrs >
  =>
    rCtr(s rj)
    < dAddr : FtpTgen | nRetry: n, w4: task, ftpRsv: rsvAddr, reqId: reqId, attrs >
    [getRetryTO(attrs) + genRandomX(rj, -0.0001, 0.0001), msg1, 0]
  if (task == waitDataTask or task == wait226Task)
  /\ msg1 := (to dAddr : ftpDataTO(ftpReq(reqId, "WAIT", "")))
  [print "(" T ") FtpTgen ftpDataTOretry left " n] .
  
  crl [ftpDataTOgiveup]:
    rCtr(rj)
    {T, (to dAddr : ftpDataTO(ftpReq(reqId, "WAIT", "")))}
    < dAddr : FtpTgen | nRetry: 0, w4: task, replyTo: (to dAddr from umAddr : ac), reqId: reqId, attrs >
  =>
    rCtr(s rj1)
    < dAddr : FtpTgen | nRetry: 0, w4: noTask, replyTo: null, reqId: reqId, attrs >
 ****   delayMsgs((to umAddr from dAddr : actionR("failed")), null)
  smsgs
  if (task == waitDataTask or task == wait226Task)
  /\ {smsgs,rj1} := 
     delayMsgsX(rj,(to umAddr from dAddr : actionR("failed")), null)
  [print "(" T ") FtpTgen ftpDataTOgiveup failed"] .

endm
