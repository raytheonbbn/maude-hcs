sload test-ftp-tgen-v2.maude
mod TEST is
  inc FTP-TGEN-V2-TEST .
  op testState : -> Config .
  eq testState =
    rCtr(2055) 
    {7.0267183081552844e+2, to ftpTGAddr from ftpSrvAddr : ftpData(119, 638)}
    < ftpTGAddr : FtpTgen | ftpRsv: ftpSrvAddr, w4: waitDataTask, pendingTasks: wait226Task, replyTo: (to ftpTGAddr from ftpUMAddr : actionQ("type" |-> js("browse_list"))), nRetry: 2, retryTO: 5.0, retryMax: 2, reqId: 119, umModelName: "ftp" > .
endm
set trace on .
set trace select on .
trace select rcvFtpData handleRes nextFtpTask delayMsgsX .
rew [1] testState .
