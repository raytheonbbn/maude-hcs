mod CM-RECEIVER-TEST is
  inc CONTENT-MANAGER-RECEIVER-AUX .

ops cmA edA mcA rcvA umA : -> Address .

op F0 : -> ByteSeq .
eq F0 = file(0,20) .

op FR0 : -> ByteSeq .
eq FR0 =  efrag(F0,20,0,20) .     


op F1 : -> ByteSeq .
eq F1 = file(0,120) .

ops FR1x0 FR1x1 : -> ByteSeq .
eq FR1x0 =  efrag(F1,60,0,60) .     
eq FR1x1 =  efrag(F1,120,1,60) .     

ops FrLS0  FrLS01 FrLS1x10 FrLS1x1 : -> FragLSet .
eq FrLS0 = addEfrags(FR0,mtFragL) .
eq FrLS1x1 = addEfrags(FR1x1,mtFragL) .
eq FrLS1x10 = addEfrags(FR1x0,FrLS1x1) .
eq FrLS01 = addEfrags(FR1x1 :: FR1x0, FrLS0) .

**** fle(efrag(file(0, 120), 60, 0, 60) :: efrag( file(0, 120), 120, 1, 60)) 
**** fle(efrag(file(0, 20), 20, 0, 20))

ops AtMsg0 AtMsg1x1 AtMsg1x10 AtMsg01
     : -> AttributeSetMsgs .
eq AtMsg0 =
  sendCompletedFiles(pendingFragLs: FrLS0,umA,cmA,rcvA) .
***( {pendingFragLs: mtFragL, 
      to rcvA from cmA : file(0, 20)} )      
      
eq AtMsg1x1 =
 sendCompletedFiles(pendingFragLs: FrLS1x1,umA,cmA,rcvA) .
***( {pendingFragLs: fle(efrag(file(0, 120), 120, 1, 60)),
      null})

eq AtMsg1x10 =
 sendCompletedFiles(pendingFragLs: FrLS1x10,umA,cmA,rcvA) .
***({pendingFragLs: mtFragL, 
     to rcvA from cmA : file(0, 120)})

eq AtMsg01 =
 sendCompletedFiles(pendingFragLs: FrLS01,umA,cmA,rcvA) .
***( {pendingFragLs: mtFragL, (to rcvA from
    cmA : file(0, 20)) to rcvA from cmA : file(0, 120)})


***(
red  sendCompletedFiles(pendingFragLs: (FrLS0 FrLS1x1),umA,cmA,rcvA) .

 {pendingFragLs: fle(efrag(file(0, 120), 120, 1, 60)), 
)
endm
eof









