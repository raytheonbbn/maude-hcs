  eq ircTgenObfs4UmAct  = mkIrcUMV2Actor(ircTgenObfs4UmAddr, "irc-tgen-irc-9", ircTgenObfs4TgAddr, ircServerAddr, ircTgenObfs4TgAddr) .
  eq ircTgenObfs4NetClAct = makeNetClient(ircTgenObfs4NetClAddr,
