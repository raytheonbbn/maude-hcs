  --- FTP TGEN: ftpTgenObfs1 (profile=fast, network=client_net_obfs)
  ops ftpTgenObfs1Act ftpTgenObfs1UmAct ftpTgenObfs1NetClAct : -> Actor .
  eq ftpTgenObfs1Act    = mkFtpTgenA(ftpTgenObfs1TgAddr, ftpSrvAddr, 5.0, 2, "ftp-tgen-fast") .
  eq ftpTgenObfs1UmAct  = mkTgenUMV2Actor(ftpTgenObfs1UmAddr, "ftp-tgen-fast", ftpTgenObfs1TgAddr) .
  eq ftpTgenObfs1NetClAct = makeNetClient(ftpTgenObfs1NetClAddr,
                                  ftpSrvAddr,
                                  ftpTgenObfs1TgAddr,
                                  true,
                                  corpObfsDnsAddr,
                                  nullName) .

  --- FTP TGEN: ftpTgenObfs2 (profile=medium, network=client_net_obfs)
  ops ftpTgenObfs2Act ftpTgenObfs2UmAct ftpTgenObfs2NetClAct : -> Actor .
  eq ftpTgenObfs2Act    = mkFtpTgenA(ftpTgenObfs2TgAddr, ftpSrvAddr, 5.0, 2, "ftp-tgen-medium") .
  eq ftpTgenObfs2UmAct  = mkTgenUMV2Actor(ftpTgenObfs2UmAddr, "ftp-tgen-medium", ftpTgenObfs2TgAddr) .
  eq ftpTgenObfs2NetClAct = makeNetClient(ftpTgenObfs2NetClAddr,
                                  ftpSrvAddr,
                                  ftpTgenObfs2TgAddr,
                                  true,
                                  corpObfsDnsAddr,
                                  nullName) .

  --- FTP TGEN: ftpTgenObfs3 (profile=slow, network=client_net_obfs)
  ops ftpTgenObfs3Act ftpTgenObfs3UmAct ftpTgenObfs3NetClAct : -> Actor .
  eq ftpTgenObfs3Act    = mkFtpTgenA(ftpTgenObfs3TgAddr, ftpSrvAddr, 5.0, 2, "ftp-tgen-slow") .
  eq ftpTgenObfs3UmAct  = mkTgenUMV2Actor(ftpTgenObfs3UmAddr, "ftp-tgen-slow", ftpTgenObfs3TgAddr) .
  eq ftpTgenObfs3NetClAct = makeNetClient(ftpTgenObfs3NetClAddr,
                                  ftpSrvAddr,
                                  ftpTgenObfs3TgAddr,
                                  true,
                                  corpObfsDnsAddr,
                                  nullName) .

  --- FTP TGEN: ftpTgenObfs4 (profile=slow, network=client_net_obfs)
  ops ftpTgenObfs4Act ftpTgenObfs4UmAct ftpTgenObfs4NetClAct : -> Actor .
  eq ftpTgenObfs4Act    = mkFtpTgenA(ftpTgenObfs4TgAddr, ftpSrvAddr, 5.0, 2, "ftp-tgen-slow") .
  eq ftpTgenObfs4UmAct  = mkTgenUMV2Actor(ftpTgenObfs4UmAddr, "ftp-tgen-slow", ftpTgenObfs4TgAddr) .
  eq ftpTgenObfs4NetClAct = makeNetClient(ftpTgenObfs4NetClAddr,
                                  ftpSrvAddr,
                                  ftpTgenObfs4TgAddr,
                                  true,
                                  corpObfsDnsAddr,
                                  nullName) .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =

    --- Baseline actor
    baseLineAct

    --- Core Infrastructure
    ircServer s3SrvAct iodineMonitor masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    corpRtDns corpRtNetCl

    corpSkyDns corpSkyNetCl

    --- OBFS4 Client 1
    obfsCl1Irc obfsCl1Um obfsCl1Iface obfsCl1SrvIface obfsCl1Cl obfsCl1Srv
    obfsCl1NetCl obfsCl1NetSrv
    --- OBFS4 Client 2
    obfsCl2Irc obfsCl2Um obfsCl2Iface obfsCl2SrvIface obfsCl2Cl obfsCl2Srv
    obfsCl2NetCl obfsCl2NetSrv
    corpObfsDns corpObfsNetCl

    corpIodDns corpIodNetCl

    corpMasDns corpMasNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- TGEN Shared Servers
    ftpSrvAct ftpNetSrvAct
    gorillaSrvAct gorillaNetSrvAct
    ircTgenSrvNet

    --- TGEN Instances
    ircTgenObfs1UmAct ircTgenObfs1Act ircTgenObfs1NetClAct
    ircTgenObfs2UmAct ircTgenObfs2Act ircTgenObfs2NetClAct
    ircTgenObfs3UmAct ircTgenObfs3Act ircTgenObfs3NetClAct
    ircTgenObfs4UmAct ircTgenObfs4Act ircTgenObfs4NetClAct
    gorTgenObfs1UmAct gorTgenObfs1Act gorTgenObfs1NetClAct
    gorTgenObfs2UmAct gorTgenObfs2Act gorTgenObfs2NetClAct
    gorTgenObfs3UmAct gorTgenObfs3Act gorTgenObfs3NetClAct
    gorTgenObfs4UmAct gorTgenObfs4Act gorTgenObfs4NetClAct
    ftpTgenObfs1UmAct ftpTgenObfs1Act ftpTgenObfs1NetClAct
    ftpTgenObfs2UmAct ftpTgenObfs2Act ftpTgenObfs2NetClAct
    ftpTgenObfs3UmAct ftpTgenObfs3Act ftpTgenObfs3NetClAct
    ftpTgenObfs4UmAct ftpTgenObfs4Act ftpTgenObfs4NetClAct

    --- Startup Timers

    [hcsDelay + 10.0 + genRandomX(j + 1, 0.0, 0.009), (to obfsCl1UmAddr from obfsCl1UmAddr : burstDelayTO), 0]
    [hcsDelay + 10.0 + genRandomX(j + 2, 0.0, 0.009), (to obfsCl2UmAddr from obfsCl2UmAddr : burstDelayTO), 0]

    --- TGEN User Model Burst Delay Timers (staggered)
    [tgenDelay + genRandomX(j + 3, 0.0, 0.009), (to ircTgenObfs1UmAddr from ircTgenObfs1UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 4, 0.0, 0.009), (to ircTgenObfs2UmAddr from ircTgenObfs2UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 5, 0.0, 0.009), (to ircTgenObfs3UmAddr from ircTgenObfs3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 6, 0.0, 0.009), (to ircTgenObfs4UmAddr from ircTgenObfs4UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 7, 0.0, 0.009), (to gorTgenObfs1UmAddr from gorTgenObfs1UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 8, 0.0, 0.009), (to gorTgenObfs2UmAddr from gorTgenObfs2UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 9, 0.0, 0.009), (to gorTgenObfs3UmAddr from gorTgenObfs3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 10, 0.0, 0.009), (to gorTgenObfs4UmAddr from gorTgenObfs4UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 11, 0.0, 0.009), (to ftpTgenObfs1UmAddr from ftpTgenObfs1UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 12, 0.0, 0.009), (to ftpTgenObfs2UmAddr from ftpTgenObfs2UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 13, 0.0, 0.009), (to ftpTgenObfs3UmAddr from ftpTgenObfs3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 14, 0.0, 0.009), (to ftpTgenObfs4UmAddr from ftpTgenObfs4UmAddr : burstDelayTO), 0]

[ksWindowDelay + genRandomX(j + 15, 0.0, 0.009), (to baseLineAddr from baseLineAddr : initKs),0]
    rCtr(j + 16)
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 910.0 [owise] .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = obfsCl1IrcAddr ; obfsCl2IrcAddr .
endm
eof
--- set print attribute on .
--- rew initConfig .
--- q