                                  nullName) .

  --- Gorilla TGEN: gorTgenObfs1 (profile=irc_12, network=client_net_obfs)
  ops gorTgenObfs1Act gorTgenObfs1UmAct gorTgenObfs1NetClAct : -> Actor .
  eq gorTgenObfs1Act    = mkGorillaChatTgenA(gorTgenObfs1TgAddr, gorillaSrvAddr) .
  eq gorTgenObfs1UmAct  = mkTgenUMV2Actor(gorTgenObfs1UmAddr, "gorilla-tgen-irc-12", gorTgenObfs1TgAddr) .
