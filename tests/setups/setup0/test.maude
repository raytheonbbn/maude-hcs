  eq ircTgenObfs3UmAct  = mkIrcUMV2Actor(ircTgenObfs3UmAddr, "irc-tgen-irc-9", ircTgenObfs3TgAddr, ircServerAddr, ircTgenObfs3TgAddr) .
  eq ircTgenObfs3NetClAct = makeNetClient(ircTgenObfs3NetClAddr,
