  (delayMean: 0.01),
  (delayConst: 0.0),
  (noiseMin: 0.),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.0)
  )
  .

  --- DNS composed link from/to mastodon_net to dns_net
  op LinkType-MastodonNet-DnsComposed : -> AttributeSet .
  eq LinkType-MastodonNet-DnsComposed =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.01),
  (delayConst: 0.02),
  (noiseMin: 0.),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.02)
  )
  .

  --- TCP link from/to dns_net to IXP
  op LinkType-DnsNet : -> AttributeSet .
  eq LinkType-DnsNet =
  (4stateLoss:
     (p13: 0.00022,
      p31: 0.0667,
      p32: 0.267,
      p23: 0.4,
      p14: 0.0005,
      oneWayDelay: 0.02)
  )
  .

  --- DNS link from/to dns_net to IXP
  op LinkType-DnsNet-Dns : -> AttributeSet .
  eq LinkType-DnsNet-Dns =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.01),
  (delayConst: 0.02),
  (noiseMin: 0.),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.02)
  )
  .

  ---------------------------------------------------
  --- Transport Equations (Readable Addresses Only)
  ---------------------------------------------------
  eq transport(obfsCl1ClientAddr) = tcp(obfsCl1ClientAddr) .
  eq transport(obfsCl1ServerAddr) = tcp(obfsCl1ServerAddr) .
  eq transport(obfsCl2ClientAddr) = tcp(obfsCl2ClientAddr) .
  eq transport(obfsCl2ServerAddr) = tcp(obfsCl2ServerAddr) .
  eq transport(s3SrvAddr) = tcp(s3SrvAddr) .
  eq transport(masSrvAddr) = tcp(masSrvAddr) .
  eq transport(ircTgenObfs1TgAddr) = tcp(ircTgenObfs1TgAddr) .
  eq transport(ircTgenObfs2TgAddr) = tcp(ircTgenObfs2TgAddr) .
  eq transport(ircTgenObfs3TgAddr) = tcp(ircTgenObfs3TgAddr) .
  eq transport(ircTgenObfs4TgAddr) = tcp(ircTgenObfs4TgAddr) .
  eq transport(gorTgenObfs1TgAddr) = tcp(gorTgenObfs1TgAddr) .
  eq transport(gorTgenObfs2TgAddr) = tcp(gorTgenObfs2TgAddr) .
  eq transport(gorTgenObfs3TgAddr) = tcp(gorTgenObfs3TgAddr) .
  eq transport(gorTgenObfs4TgAddr) = tcp(gorTgenObfs4TgAddr) .
  eq transport(ftpTgenObfs1TgAddr) = tcp(ftpTgenObfs1TgAddr) .
  eq transport(ftpTgenObfs2TgAddr) = tcp(ftpTgenObfs2TgAddr) .
  eq transport(ftpTgenObfs3TgAddr) = tcp(ftpTgenObfs3TgAddr) .
  eq transport(ftpTgenObfs4TgAddr) = tcp(ftpTgenObfs4TgAddr) .
  eq transport(ftpSrvAddr) = tcp(ftpSrvAddr) .
  eq transport(gorillaSrvAddr) = tcp(gorillaSrvAddr) .
  eq transport(ircServerAddr) = tcp(ircServerAddr) .

  --- UDP transport for DNS resolvers
  eq transport(publicDnsAddr) = publicDnsAddr .
  eq transport(corpMasDnsAddr) = corpMasDnsAddr .
  eq transport(corpRtDnsAddr) = corpRtDnsAddr .
  eq transport(corpObfsDnsAddr) = corpObfsDnsAddr .
  eq transport(corpSkyDnsAddr) = corpSkyDnsAddr .
  eq transport(corpIodDnsAddr) = corpIodDnsAddr .
  eq transport(servDnsAddr) = servDnsAddr .


  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- OBFS4 Client 1
    aaa(obfsCl1ClientAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, obfsCl1ClientAddr, LinkType-ClientNetObfs)
    aaa(obfsCl1ServerAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, obfsCl1ServerAddr, LinkType-ServerNet)
    --- OBFS4 Client 2
    aaa(obfsCl2ClientAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, obfsCl2ClientAddr, LinkType-ClientNetObfs)
    aaa(obfsCl2ServerAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, obfsCl2ServerAddr, LinkType-ServerNet)
    --- Obfs4 corp
    aaa(corpObfsNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsNetClAddr, LinkType-ClientNetObfs-Dns)
    aaa(corpObfsNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpObfsNetClAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(corpObfsNetClAddr, publicDnsAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(publicDnsAddr, corpObfsNetClAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(corpObfsDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsDnsAddr, LinkType-ClientNetObfs-Dns)
    aaa(corpObfsDnsAddr, publicDnsAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(publicDnsAddr, corpObfsDnsAddr, LinkType-ClientNetObfs-DnsComposed)

    --- Minio/S3 server
    aaa(s3SrvAddr, IXP-DEFAULT-ADDR, LinkType-MinioNet)
    aaa(IXP-DEFAULT-ADDR, s3SrvAddr, LinkType-MinioNet)

    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet-Dns)
    aaa(IXP-DEFAULT-ADDR, servDnsAddr, LinkType-ServerNet-Dns)
    aaa(servDnsAddr, publicDnsAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicDnsAddr, servDnsAddr, LinkType-ServerNet-DnsComposed)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-ServerNet-DnsComposed)
    aaa(servNetClAddr, publicDnsAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicDnsAddr, servNetClAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-DnsNet-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-DnsNet-Dns)

    aaa(ircServerAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, ircServerAddr, LinkType-ServerNet)

    --- TGEN Direct Links

    aaa(ftpTgenObfs1TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ftpTgenObfs1TgAddr, LinkType-ClientNetObfs)
    aaa(ftpTgenObfs2TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ftpTgenObfs2TgAddr, LinkType-ClientNetObfs)
    aaa(ftpTgenObfs3TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ftpTgenObfs3TgAddr, LinkType-ClientNetObfs)
    aaa(ftpTgenObfs4TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ftpTgenObfs4TgAddr, LinkType-ClientNetObfs)


    aaa(gorTgenObfs1TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, gorTgenObfs1TgAddr, LinkType-ClientNetObfs)
    aaa(gorTgenObfs2TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, gorTgenObfs2TgAddr, LinkType-ClientNetObfs)
    aaa(gorTgenObfs3TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, gorTgenObfs3TgAddr, LinkType-ClientNetObfs)
    aaa(gorTgenObfs4TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, gorTgenObfs4TgAddr, LinkType-ClientNetObfs)

    aaa(ircTgenObfs1TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ircTgenObfs1TgAddr, LinkType-ClientNetObfs)
    aaa(ircTgenObfs2TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ircTgenObfs2TgAddr, LinkType-ClientNetObfs)
    aaa(ircTgenObfs3TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ircTgenObfs3TgAddr, LinkType-ClientNetObfs)
    aaa(ircTgenObfs4TgAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs)
    aaa(IXP-DEFAULT-ADDR, ircTgenObfs4TgAddr, LinkType-ClientNetObfs)

    --- TGEN IXP Links
    aaa(ftpSrvAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, ftpSrvAddr, LinkType-ServerNet)
    aaa(gorillaSrvAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, gorillaSrvAddr, LinkType-ServerNet)
  .

  ---------------------------------------------------
  --- Visibility Map
  ---------------------------------------------------
  eq visibilityMap =
  (cl[1] |-> (
      obfsCl1ClientAddr ;; obfsCl2ClientAddr ;; corpObfsNetClAddr ;; corpObfsDnsAddr
      ;; ftpTgenObfs1TgAddr ;; ftpTgenObfs2TgAddr ;; ftpTgenObfs3TgAddr ;; ftpTgenObfs4TgAddr
      ;; gorTgenObfs1TgAddr ;; gorTgenObfs2TgAddr ;; gorTgenObfs3TgAddr ;; gorTgenObfs4TgAddr
      ;; ircTgenObfs1TgAddr ;; ircTgenObfs2TgAddr ;; ircTgenObfs3TgAddr ;; ircTgenObfs4TgAddr
    )) ,
  (dnsN |-> (
      publicResolverNetSrvAddr ;; publicDnsAddr
    )) ,
  (minN |-> s3SrvAddr) ,
  (srvN |-> (
      obfsCl1ServerAddr ;; obfsCl2ServerAddr ;; servDnsAddr ;; servNetClAddr
      ;; ircServerAddr ;; ftpSrvAddr ;; gorillaSrvAddr
    ))
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- OBFS4 Client 1 (IRC profile: irc_3)
  ops obfsCl1Irc obfsCl1Um obfsCl1Iface obfsCl1SrvIface : -> Actor .
  ops obfsCl1Cl obfsCl1Srv : -> Actor .
  ops obfsCl1NetCl obfsCl1NetSrv : -> Actor .
  eq obfsCl1Irc      = mkIrcClient-v2(obfsCl1IrcAddr, obfsCl1IfaceAddr, "ObfsClient1") .
  eq obfsCl1Um       = mkIrcUMV2Actor(obfsCl1UmAddr, "irc-irc-3", obfsCl1IrcAddr, ircServerAddr, obfsCl1SrvIfaceAddr) .
  eq obfsCl1Iface    = mkIrcByteSeqIface(obfsCl1IfaceAddr, obfsCl1IrcAddr, obfsCl1ClientAddr) .
  eq obfsCl1Cl       = makeObfs4Node(obfsCl1ClientAddr, obfsCl1IfaceAddr, obfsCl1ServerAddr) .
  eq obfsCl1SrvIface = mkIrcByteSeqIface(obfsCl1SrvIfaceAddr, ircServerAddr, obfsCl1ServerAddr) .
  eq obfsCl1Srv      = makeObfs4Node(obfsCl1ServerAddr, obfsCl1SrvIfaceAddr, obfsCl1ClientAddr) .
  eq obfsCl1NetCl    = makeNetClient(obfsCl1NetClientAddr,
                                       obfsCl1ServerAddr,
                                       obfsCl1ClientAddr,
                                       true,
                                       corpObfsDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq obfsCl1NetSrv   = makeNetServer(obfsCl1NetServerAddr, obfsCl1ServerAddr) .

  --- OBFS4 Client 2 (IRC profile: irc_3)
  ops obfsCl2Irc obfsCl2Um obfsCl2Iface obfsCl2SrvIface : -> Actor .
  ops obfsCl2Cl obfsCl2Srv : -> Actor .
  ops obfsCl2NetCl obfsCl2NetSrv : -> Actor .
  eq obfsCl2Irc      = mkIrcClient-v2(obfsCl2IrcAddr, obfsCl2IfaceAddr, "ObfsClient2") .
  eq obfsCl2Um       = mkIrcUMV2Actor(obfsCl2UmAddr, "irc-irc-3", obfsCl2IrcAddr, ircServerAddr, obfsCl2SrvIfaceAddr) .
  eq obfsCl2Iface    = mkIrcByteSeqIface(obfsCl2IfaceAddr, obfsCl2IrcAddr, obfsCl2ClientAddr) .
  eq obfsCl2Cl       = makeObfs4Node(obfsCl2ClientAddr, obfsCl2IfaceAddr, obfsCl2ServerAddr) .
  eq obfsCl2SrvIface = mkIrcByteSeqIface(obfsCl2SrvIfaceAddr, ircServerAddr, obfsCl2ServerAddr) .
  eq obfsCl2Srv      = makeObfs4Node(obfsCl2ServerAddr, obfsCl2SrvIfaceAddr, obfsCl2ClientAddr) .
  eq obfsCl2NetCl    = makeNetClient(obfsCl2NetClientAddr,
                                       obfsCl2ServerAddr,
                                       obfsCl2ClientAddr,
                                       true,
                                       corpObfsDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq obfsCl2NetSrv   = makeNetServer(obfsCl2NetServerAddr, obfsCl2ServerAddr) .

  --- Base Infrastructure
  ops ircServer s3SrvAct iodineMonitor advActor masNetSrv masSrvAct : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq s3SrvAct       = 
    < s3SrvAddr : AwsS3HttpServer |
        thisAddr: s3SrvAddr,
        s3DataMap: (
          ("/tgen/list-1" -> restToByteSeq("obj1.zip;obj2.zip;data/")) ;
          ("/tgen/stat-1" -> restToByteSeq("obj1.zip:1024:2025-01-01")) ;
          ("/tgen/cd-1" -> restToByteSeq("subdir1/;subdir2/")) ;
          ("/tgen/retr-1" -> restToByteSeq("mock_file_content_bytes"))
        )
    >
  .
  eq masSrvAct      = makeMastodonServer(masSrvAddr) .
  eq masNetSrv       = makeNetServer(masNetSrvAddr, masSrvAddr) .
  eq iodineMonitor  = mkWMonitor(iodineMonitorAddr) .
  eq advActor       = mkAdversaryCp3(advAddr, true) .

  --- DNS Infrastructure
  ops corpMasDns corpRtDns corpIodDns corpObfsDns corpSkyDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpMasNetCl corpRtNetCl corpIodNetCl corpObfsNetCl corpSkyNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpMasDns   = mkNameServer(corpMasDnsAddr, (zoneMasCom), corpMasNetClAddr) .
  eq corpRtDns    = mkNameServer(corpRtDnsAddr, (zoneRtCom), corpRtNetClAddr) .
  eq corpIodDns   = mkNameServer(corpIodDnsAddr, (zoneIodCom), corpIodNetClAddr) .
  eq corpObfsDns  = mkNameServer(corpObfsDnsAddr, (zoneObfsCom), corpObfsNetClAddr) .
  eq corpSkyDns   = mkNameServer(corpSkyDnsAddr, (zoneSkyCom), corpSkyNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpMasNetCl = mkFwdDnsNetC(corpMasNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpMasDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpRtNetCl  = mkFwdDnsNetC(corpRtNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpRtDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpIodNetCl = mkFwdDnsNetC(corpIodNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpIodDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpObfsNetCl  = mkFwdDnsNetC(corpObfsNetClAddr,
                                   publicResolverNetSrvAddr,
                                   publicDnsAddr,
                                   corpObfsDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .
  eq corpSkyNetCl = mkFwdDnsNetC(corpSkyNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr, 
                                 corpSkyDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- TGEN Actor Definitions
  ---------------------------------------------------
  --- Shared TGEN Servers
  ops ftpSrvAct ftpNetSrvAct : -> Actor .
  eq ftpSrvAct     = mkFtpServerA(ftpSrvAddr) .
  eq ftpNetSrvAct  = makeNetServer(ftpNetSrvAddr, ftpSrvAddr) .

  ops gorillaSrvAct gorillaNetSrvAct : -> Actor .
  eq gorillaSrvAct   = mkGorillaChatServer(gorillaSrvAddr, (gorTgenObfs1TgAddr addr gorTgenObfs2TgAddr addr gorTgenObfs3TgAddr addr gorTgenObfs4TgAddr)) .
  eq gorillaNetSrvAct = makeNetServer(gorillaNetSrvAddr, gorillaSrvAddr) .

  ops ircTgenSrvNet : -> Actor .
  eq ircTgenSrvNet = makeNetServer(ircTgenSrvNetAddr, ircServerAddr) .

  --- IRC TGEN: ircTgenObfs1 (profile=irc_7, network=client_net_obfs)
  ops ircTgenObfs1Act ircTgenObfs1UmAct ircTgenObfs1NetClAct : -> Actor .
  eq ircTgenObfs1Act    = mkIrcTgenClient(ircTgenObfs1TgAddr, ircServerAddr, "ircTgenObfs1") .
  eq ircTgenObfs1UmAct  = mkIrcUMV2Actor(ircTgenObfs1UmAddr, "irc-tgen-irc-7", ircTgenObfs1TgAddr, ircServerAddr, ircTgenObfs1TgAddr) .
  eq ircTgenObfs1NetClAct = makeNetClient(ircTgenObfs1NetClAddr,
                                  ircServerAddr,
                                  ircTgenObfs1TgAddr,
                                  true,
                                  nullAddr,
                                  nullName) .

