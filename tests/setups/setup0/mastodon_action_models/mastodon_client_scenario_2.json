{
    "markov": {
        "media": {
            "media_wait": 1.0
        },
        "media_wait": {
            "download": 1.0,
            "media": 0.0
        },
        "download": {
            "download_wait": 1.0
        },
        "download_wait": {
            "media": 1.0,
            "download": 0.0
        }
    },
    "actions": {
        "media_wait": {
            "type": "wait",
            "sleep": {
                "random": "gaussian",
                "mean": 6.5,
                "std": 1.0,
                "floor": 5.5
            },
            "start": true
        },
        "media": {
            "type": "media",
            "linkId": "mastodonCompositionReactiveFile/mastodonCompositionReactiveFile/LinkID_1",
            "contentType": "image",
            "numImages": {
                "random": "uniform",
                "min": 1,
                "max": 4
            }
        },
        "download_wait": {
            "type": "wait",
            "sleep": {
                "random": "gaussian",
                "mean": 6.5,
                "std": 2.0,
                "floor": 5.5
            }
        },
        "download": {
            "type": "download",
            "linkId": "mastodonCompositionReactiveFile/mastodonCompositionReactiveFile/LinkID_0"
        }
    },
    "parameters": {
        "model_steps": 100000
    }
}