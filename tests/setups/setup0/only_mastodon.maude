--- MAUDE_HCS: CP3 Scenario 1 Experiment ---
--- Autogenerated from scenario YAML ---

set clear rules off .
set print attribute off .
set show advisories off .

--- Core Infrastructure
sload ../../../../maude_hcs/lib/irc/irc_prob-v2
sload ../../../../maude_hcs/lib/irc/ircMonitor
sload ../../../../maude_hcs/lib/irc/irc-byteseq-interface
sload ../../../../maude_hcs/lib/common/maude/irc-action-actor-v2.maude
sload ../../../../maude_hcs/lib/irc/common/irc_name
sload ../../../../maude_hcs/lib/irc/common/_aux
sload ../../../../maude_hcs/lib/irc/common/app_chat
sload ../../../../maude_hcs/lib/irc/_irc_aux
sload ../../../../maude_hcs/deps/dns_formalization/Maude/common/apmaude.maude
sload ../../../../maude_hcs/lib/common/maude/user-action-actor
sload ../../../../maude_hcs/lib/raceboatMastodon/maude/enc-dec-actor
sload ../../../../maude_hcs/lib/raceboatMastodonBidir/maude/rb-cm-bidir-mas.maude
sload ../../../../maude_hcs/lib/mastodon/maude/probabilistic/mastodon
sload ../scenario1/mastodon_action_models/mastodon_client_scenario_1.maude
sload ../scenario1/mastodon_action_models/mastodon_server_scenario_1.maude
sload ../../../../maude_hcs/lib/common/maude/http-overhead.maude
sload ../../../../maude_hcs/lib/irc/common/irc-msg-model
sload ../../../../maude_hcs/lib/s3/s3_protocol
sload ../../../../maude_hcs/lib/dns/maude/probabilistic/iodine_dns.maude
sload ../../../../maude_hcs/lib/dns/maude/common/_aux.maude
sload ../../../../maude_hcs/lib/network/net_prob.maude
sload ../../../../maude_hcs/lib/network/net-dns_prob.maude
sload ../../../../maude_hcs/lib/common/maude/structured-addresses.maude

--- HCS IRC User Models (v2)
sload irc_user_models/irc_6.maude

--- For SMC
sload ../../../../maude_hcs/lib/common/maude/visibility

--- Address mapping
--- Special case for mastodon, since we're adding a new client
sload scenario1_mast_addresses

mod HCS_TEST is
  pr SCHEDULER .
  pr USER-ACTION-ACTOR .
  pr IRC-V2 .
  pr IRC-USER-ACTION-ACTOR-V2 .
  pr IRC-BYTESEQ-INTERFACE .
  inc ENC-DEC .
  inc CONTENT-MANAGER-BIDIR .
  inc MASTODON .
  inc MASTODON-CLIENT-SCENARIO-1-MAMODEL .
  inc MASTODON-SERVER-SCENARIO-1-MAMODEL .
  pr S3_PROTOCOL .
  pr IRC_MONITOR .
  pr APP_CHATS .
  pr IRC_NODE .
  pr IODINE_NODE .
  pr IODINE_DNS .
  pr TCP_SOCKET .
  pr NET-DNS .
  pr NETWORK_NODE .
  pr NETWORK_CONNECTION .
  inc STRUCTURED-ADDRESSES .
  inc IRC-IRC-6-MAMODEL-V2 .
  inc VISIBILITY .
  inc SCENARIO1-ADDRESSES .

  vars j : Nat .

  ---------------------------------------------------
  --- Global Constants
  ---------------------------------------------------
  eq encOH(fsize:Nat,ksize:Nat) = 0 .
  eq noiseMin(msg:Msg)          = 0.00001 .
  eq noiseMax(msg:Msg)          = 0.001 .
  eq packetSize                 = 1000 .
  eq maxPacketSize              = 967 .
  eq maxMinimiseCount           = 0 .
  --- how much to delay the HCS and TGENs
  ops hcsDelay tgenDelay : -> Float .
  eq hcsDelay  = 0. [owise] .
  eq tgenDelay = 30.0 [owise] .

  --- User Model Database (MAModelMap)
  eq MAModelMap =
    ("irc-irc-6" |-> irc-irc-6-ma-v2)
  .

  op ed-images : -> ByteSeqL .
  eq ed-images =
       image(1, 3779, 500)
    :: image(2, 2405, 1000)
    :: image(3, 36861, 1000)
    :: image(4, 25377, 500)
    :: image(5, 2440, 300)
    :: image(6, 1275, 300)
    :: image(7, 7710, 1000)
    :: image(8, 3577, 500)
    :: image(9, 3415, 300)
    :: image(10, 74123, 600)
  .

  ---------------------------------------------------
  --- DNS Zone Configurations
  ---------------------------------------------------
  op zone : -> List{Record} .
  eq zone =
    < root, soa, 360000.0, soaData(360000.0) >
    < root, ns, 360000.0, 'a . 'root-servers . 'net . root >
    < 'a . 'root-servers . 'net . root, a, 360000.0, rootDnsAddr >
    < 'com . root, ns, 360000.0, 'ns . 'com . root >
    < 'ns . 'com . root, a, 360000.0, tldDnsAddr >
  .

  op zoneCom : -> List{Record} .
  eq zoneCom =
    < 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'com . root, ns, 360000.0, 'ns . 'com . root >
    < 'ns . 'com . root, a, 360000.0, tldDnsAddr >
    < 'mas . 'com . root, ns, 360000.0, 'ns . 'mas . 'com . root >
    < 'ns . 'mas . 'com . root, a, 360000.0, corpMasDnsAddr >
    < 'serv . 'com . root, ns, 360000.0, 'ns . 'serv . 'com . root >
    < 'ns . 'serv . 'com . root, a, 360000.0, servDnsAddr >
  .

  op zoneInternetCom : -> List{Record} .
  eq zoneInternetCom =
    < 'internet . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >
    < 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >
    < 'mastodon . 'pwnd . 'com . root, a, 0.0, masSrvAddr >
    < wildcard . 'internet . 'com . root, a, 0.0, 1 . 1 . 1 . 2 >
  .

  op zoneMasCom : -> List{Record} .
  eq zoneMasCom =
    < 'mas . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'mas . 'com . root, ns, 360000.0, 'ns . 'mas . 'com . root >
    < 'ns . 'mas . 'com . root, a, 360000.0, corpMasDnsAddr >
    < 'tmp0 . 'mas . 'com . root, a, 0.0, 3 . 0 . 1 . 2 >
    < wildcard . 'mas . 'com . root, a, 0.0, 3 . 1 . 1 . 2 >
  .

  op zoneServCom : -> List{Record} .
  eq zoneServCom =
    < 'serv . 'com . root, soa, 360000.0, soaData(360000.0) >
    < 'serv . 'com . root, ns, 360000.0, 'ns . 'serv . 'com . root >
    < 'ns . 'serv . 'com . root, a, 360000.0, servDnsAddr >
    < 'tmp0 . 'serv . 'com . root, a, 0.0, 3 . 0 . 1 . 2 >
    < wildcard . 'serv . 'com . root, a, 0.0, 3 . 1 . 1 . 2 >
  .

  op sb : -> ZoneState .
  eq sb = < root ('a . 'root-servers . 'net . root |-> rootDnsAddr) > .

  op resolverCache : -> Cache .
  eq resolverCache =
    cacheEntry(< root, ns, 360000.0, 'a . 'root-servers . 'net . root >, 1)
    cacheEntry(< 'a . 'root-servers . 'net . root, a, 360000.0, rootDnsAddr >, 1)
    cacheEntry(< 'com . root, ns, 360000.0, 'ns . 'com . root >, 1)
    cacheEntry(< 'ns . 'com . root, a, 360000.0, tldDnsAddr >, 1)
    cacheEntry(< 'internet . 'com . root, ns, 360000.0, 'ns . 'internet . 'com . root >, 1)
    cacheEntry(< 'ns . 'internet . 'com . root, a, 360000.0, authDnsAddr >, 1)
    cacheEntry(< 'mas . 'com . root, ns, 360000.0, 'ns . 'mas . 'com . root >, 1)
    cacheEntry(< 'ns . 'mas . 'com . root, a, 360000.0, corpMasDnsAddr >, 1)
    cacheEntry(< 'serv . 'com . root, ns, 360000.0, 'ns . 'serv . 'com . root >, 1)
    cacheEntry(< 'ns . 'serv . 'com . root, a, 360000.0, servDnsAddr >, 1)
  .

  ---------------------------------------------------
  --- Link Model Parameters
  ---------------------------------------------------
  op LinkType-ClientNetMastodon : -> AttributeSet .
  eq LinkType-ClientNetMastodon =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.025)
  )
  .

  op LinkType-ServerNet : -> AttributeSet .
  eq LinkType-ServerNet =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.005)
  )
  .

  op LinkType-MastodonNet : -> AttributeSet .
  eq LinkType-MastodonNet =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.01)
  )
  .

  op LinkType-DnsNet : -> AttributeSet .
  eq LinkType-DnsNet =
  (4stateLoss:
     (p13: 0.0054,
      p31: 10.0,
      p32: 40.0,
      p23: 40.0,
      p14: 0.05,
      oneWayDelay: 0.005)
  )
  .

  op LinkType-Dns : -> AttributeSet .
  eq LinkType-Dns =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.01),
  (delayConst: 0.01),
  (noiseMin: 0.),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.01)
  )
  .

  op LinkType-DnsComposed : -> AttributeSet .
  eq LinkType-DnsComposed =
  (delayStd:  0.0),
  (delayType: "Constant"),
  (delayMean: 0.),
  (delayConst: 0.02),
  (noiseMin: 0.01),
  (noiseMax: 0.00001),
  (dropP: 0.),
  (canDrop: false),
  (4stateLoss:
     (p13: 0.0,
      p31: 1.0,
      p32: 0.0,
      p23: 0.0,
      p14: 0.0,
      oneWayDelay: 0.02)
  )
  .

  ---------------------------------------------------
  --- Transport Equations (Readable Addresses Only)
  ---------------------------------------------------
  eq transport(masCl9McacAddr) = tcp(masCl9McacAddr) .
  eq transport(masCl9McasAddr) = tcp(masCl9McasAddr) .
  eq transport(masSrvAddr) = tcp(masSrvAddr) .

  --- UDP transport for DNS resolvers
  eq transport(publicDnsAddr) = publicDnsAddr .
  eq transport(corpMasDnsAddr) = corpMasDnsAddr .
  eq transport(servDnsAddr) = servDnsAddr .

  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- Mastodon HCS Client 9
    aaa(masCl9McacAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon)
    aaa(IXP-DEFAULT-ADDR, masCl9McacAddr, LinkType-ClientNetMastodon)
    aaa(masCl9McasAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon)
    aaa(IXP-DEFAULT-ADDR, masCl9McasAddr, LinkType-ClientNetMastodon)
    aaa(masCl10McacAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon)
    aaa(IXP-DEFAULT-ADDR, masCl10McacAddr, LinkType-ClientNetMastodon)
    aaa(masCl10McasAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon)
    aaa(IXP-DEFAULT-ADDR, masCl10McasAddr, LinkType-ClientNetMastodon)
    aaa(masSrvAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon)
    aaa(IXP-DEFAULT-ADDR, masSrvAddr, LinkType-ClientNetMastodon)

    --- UDP DNS Links
    aaa(servNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servNetClAddr, LinkType-Dns)
    aaa(corpMasNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpMasNetClAddr, LinkType-Dns)

    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-Dns)

    aaa(publicResolverNetSrvAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, publicResolverNetSrvAddr, LinkType-Dns)

    *** IRC Server enclave DNS server ***
    aaa(servDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servDnsAddr, LinkType-DnsComposed)
    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servDnsAddr, LinkType-Dns)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-DnsComposed)
    aaa(servNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, servNetClAddr, LinkType-Dns)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-DnsComposed)
    *** Mastodon IRC Client enclave DNS server ***
    aaa(corpMasDnsAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpMasDnsAddr, LinkType-DnsComposed)
    aaa(corpMasDnsAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpMasDnsAddr, LinkType-Dns)
    aaa(corpMasNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpMasNetClAddr, LinkType-DnsComposed)
    aaa(corpMasNetClAddr, IXP-DEFAULT-ADDR, LinkType-Dns)
    aaa(IXP-DEFAULT-ADDR, corpMasNetClAddr, LinkType-Dns)
    aaa(corpMasNetClAddr, publicResolverNetSrvAddr, LinkType-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpMasNetClAddr, LinkType-DnsComposed)
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- Mastodon HCS Client 9 (IRC profile: irc_6)
  ops masCl9Irc masCl9Um masCl9Iface masCl9SrvIface : -> Actor .
  ops masCl9UmacAct masCl9CmacAct masCl9McacAct masCl9EdacAct : -> Actor .
  ops masCl9UmasAct masCl9CmasAct masCl9McasAct masCl9EdasAct : -> Actor .
  ops masCl9ClNet masCl9SrvNetCl masNetSrv masSrvAct : -> Actor .

  --- Mastodon HCS Client 10 (IRC profile: irc_6)
  ops masCl10Irc masCl10Um masCl10Iface masCl10SrvIface : -> Actor .
  ops masCl10UmacAct masCl10CmacAct masCl10McacAct masCl10EdacAct : -> Actor .
  ops masCl10UmasAct masCl10CmasAct masCl10McasAct masCl10EdasAct : -> Actor .
  ops masCl10ClNet masCl10SrvNetCl : -> Actor .
  eq masCl9Irc       = mkIrcClient-v2(masCl9IrcAddr, masCl9IfaceAddr, "MasClient9") .
  eq masCl9Um        = mkIrcUMV2Actor(masCl9UmAddr, "irc-irc-6", masCl9IrcAddr, ircServerAddr, masCl9SrvIfaceAddr) .
  eq masCl9Iface     = mkIrcByteSeqIface(masCl9IfaceAddr, masCl9IrcAddr, masCl9CmacAddr) .
  eq masCl9UmacAct   = mkUMactor(masCl9UmacAddr, mastodon-client-scenario-1-ma, masCl9CmacAddr) .
  eq masCl9CmacAct   = mkCMSndRcvActor(masCl9CmacAddr, masCl9EdacAddr, masCl9McacAddr, masCl9IfaceAddr, "client9", "server9") .
  eq masCl9McacAct   = makeMastodonClient(masCl9McacAddr, masSrvAddr, masCl9CmacAddr) .
  eq masCl9EdacAct   = makeDestiniActor(masCl9EdacAddr, ed-images) .
  eq masCl9SrvIface  = mkIrcByteSeqIface(masCl9SrvIfaceAddr, ircServerAddr, masCl9CmasAddr) .
  eq masCl9UmasAct   = mkUMactor(masCl9UmasAddr, mastodon-server-scenario-1-ma, masCl9CmasAddr) .
  eq masCl9CmasAct   = mkCMSndRcvActor(masCl9CmasAddr, masCl9EdasAddr, masCl9McasAddr, masCl9SrvIfaceAddr, "server9", "client9") .
  eq masCl9McasAct   = makeMastodonClient(masCl9McasAddr, masSrvAddr, masCl9CmasAddr) .
  eq masCl9EdasAct   = makeDestiniActor(masCl9EdasAddr, ed-images) .
  eq masCl9ClNet     = makeNetClient(masCl9ClNetAddr,
                                       masSrvAddr,
                                       masCl9McacAddr,
                                       false,
                                       corpMasDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq masNetSrv       = makeNetServer(masNetSrvAddr, masSrvAddr) .
  eq masCl9SrvNetCl  = makeNetClient(masCl9SrvNetClAddr,
                                       masSrvAddr,
                                       masCl9McasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  eq masCl10Irc       = mkIrcClient-v2(masCl10IrcAddr, masCl10IfaceAddr, "MasClient10") .
  eq masCl10Um        = mkIrcUMV2Actor(masCl10UmAddr, "irc-irc-6", masCl10IrcAddr, ircServerAddr, masCl10SrvIfaceAddr) .
  eq masCl10Iface     = mkIrcByteSeqIface(masCl10IfaceAddr, masCl10IrcAddr, masCl10CmacAddr) .
  eq masCl10UmacAct   = mkUMactor(masCl10UmacAddr, mastodon-client-scenario-1-ma, masCl10CmacAddr) .
  eq masCl10CmacAct   = mkCMSndRcvActor(masCl10CmacAddr, masCl10EdacAddr, masCl10McacAddr, masCl10IfaceAddr, "client10", "server10") .
  eq masCl10McacAct   = makeMastodonClient(masCl10McacAddr, masSrvAddr, masCl10CmacAddr) .
  eq masCl10EdacAct   = makeDestiniActor(masCl10EdacAddr, ed-images) .
  eq masCl10SrvIface  = mkIrcByteSeqIface(masCl10SrvIfaceAddr, ircServerAddr, masCl10CmasAddr) .
  eq masCl10UmasAct   = mkUMactor(masCl10UmasAddr, mastodon-server-scenario-1-ma, masCl10CmasAddr) .
  eq masCl10CmasAct   = mkCMSndRcvActor(masCl10CmasAddr, masCl10EdasAddr, masCl10McasAddr, masCl10SrvIfaceAddr, "server10", "client10") .
  eq masCl10McasAct   = makeMastodonClient(masCl10McasAddr, masSrvAddr, masCl10CmasAddr) .
  eq masCl10EdasAct   = makeDestiniActor(masCl10EdasAddr, ed-images) .
  eq masCl10ClNet     = makeNetClient(masCl10ClNetAddr,
                                       masSrvAddr,
                                       masCl10McacAddr,
                                       false,
                                       corpMasDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq masCl10SrvNetCl  = makeNetClient(masCl10SrvNetClAddr,
                                       masSrvAddr,
                                       masCl10McasAddr,
                                       false,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Base Infrastructure
  ops ircServer s3SrvAct masSrvAct advActor : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq s3SrvAct       = 
    < s3SrvAddr : AwsS3HttpServer |
        thisAddr: s3SrvAddr,
        s3DataMap: (
          ("/tgen/list-1" -> restToByteSeq("obj1.zip;obj2.zip/data/")) ;
          ("/tgen/stat-1" -> restToByteSeq("obj1.zip:1024:2025-01-01")) ;
          ("/tgen/cd-1" -> restToByteSeq("subdir1/;subdir2/")) ;
          ("/tgen/retr-1" -> restToByteSeq("mock_file_content_bytes"))
        )
    >
  .
  eq masSrvAct      = makeMastodonServer(masSrvAddr) .
  eq advActor       = mkAdversaryCp3(advAddr) .

  --- DNS Infrastructure
  ops corpMasDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpMasNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpMasDns   = mkNameServer(corpMasDnsAddr, (zoneMasCom), corpMasNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpMasNetCl = mkFwdDnsNetC(corpMasNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpMasDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =
    rCtr(j + 154)

    --- Core Infrastructure
    ircServer s3SrvAct masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    --- Mastodon HCS Client 9
    masCl9Irc masCl9Um masCl9Iface masCl9SrvIface
    masCl9UmacAct masCl9CmacAct masCl9McacAct masCl9EdacAct
    masCl9UmasAct masCl9CmasAct masCl9McasAct masCl9EdasAct
    masCl9ClNet masNetSrv masCl9SrvNetCl
    masCl10Irc masCl10Um masCl10Iface masCl10SrvIface
    masCl10UmacAct masCl10CmacAct masCl10McacAct masCl10EdacAct
    masCl10UmasAct masCl10CmasAct masCl10McasAct masCl10EdasAct
    masCl10ClNet masCl10SrvNetCl
    corpMasDns corpMasNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- Startup Timers
    [hcsDelay + 1.0 + genRandomX(j + 12, 0.0, 0.0001), (to masCl9UmacAddr from masCl9UmacAddr : actionR("ok")), 0]
    [hcsDelay + 1.0 + genRandomX(j + 13, 0.0, 0.0001), (to masCl9UmasAddr from masCl9UmasAddr : actionR("ok")), 0]
    [hcsDelay + 1.0 + genRandomX(j + 14, 0.0, 0.0001), (to masCl10UmacAddr from masCl10UmacAddr : actionR("ok")), 0]
    [hcsDelay + 1.0 + genRandomX(j + 15, 0.0, 0.0001), (to masCl10UmasAddr from masCl10UmasAddr : actionR("ok")), 0]

    --- IRC User Model Burst Delay Timers (staggered)
    [hcsDelay + 10.0 + genRandomX(j + 22, 0.0, 0.0001), (to masCl9UmAddr from masCl9UmAddr : burstDelayTO), 0]
    [hcsDelay + 10.0 + genRandomX(j + 23, 0.0, 0.0001), (to masCl10UmAddr from masCl10UmAddr : burstDelayTO), 0]
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 11700.0 .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = masCl9IrcAddr ; masCl10IrcAddr .
endm
set print attribute on .
rew initConfig .
q