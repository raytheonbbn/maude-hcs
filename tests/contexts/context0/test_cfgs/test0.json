{
    "name": "test0",
    "runner": "MAUDE",
    "regression": true,
    "args": {
        "markov_dirs": [
            {"path": "irc_user_models", "proto": "irc"},
            {"path": "mastodon_action_models", "proto": "mastodon"},
            {"path": "skyhook_action_models", "proto": "skyhook"},

            {"path": "tgen_user_models/dns", "proto": "dns-tgen"},
            {"path": "tgen_user_models/ftp", "proto": "ftp-tgen"},
            {"path": "tgen_user_models/gorilla", "proto": "gorilla-tgen"},
            {"path": "tgen_user_models/irc", "proto": "irc-tgen"},
            {"path": "tgen_user_models/mastodon", "proto": "mastodon-tgen"},
            {"path": "tgen_user_models/mastodon_monitor", "proto": "mastodon-monitor-tgen"},
            {"path": "tgen_user_models/minio", "proto": "minio-tgen"},
            {"path": "tgen_user_models/minio_monitor", "proto": "minio-monitor-tgen"},
            {"path": "tgen_user_models/tls", "proto": "tls-tgen"}
        ],
        "gen_args": {
            "yaml_file": "only_obfs.yaml",
            "baseline_time": 100.0,
            "run_time": 100.0,
            "hcs_delay": 10.0,
            "tgen_delay": 10.0,
            "no_tgens": false,
            "filter_vp_feat_combos": true,
            "filter_vp_feat_combos_2": false,
            "filter_vp_top_25": false,
            "filter_vp_feat_combo_4x5": false,
            "filter_vp_feat_ixp": false,
            "parallelize_baseline": false,
            "confidentiality": false,
            "performance": false
        },
        "test": "all-msgs-received(initConfig) and non-zero-msgs-received(initConfig)"
    }
}